---
/* src/layouts/Layout.astro */
import '../styles/global.css';
import { TooltipProvider } from "@/components/ui/tooltip";
import { SoundProvider } from '../context/SoundContext.tsx';
import Navigation from '../components/Navigation.tsx';
import Footer from '../components/Footer.astro';
import GridBackground from '../components/GridBackground.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.tsx';

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const isLandingPage = currentPath === "/" || currentPath === "/index.html";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-black text-foreground antialiased selection:bg-primary/30">
    <SoundProvider client:load>
      <TooltipProvider client:load>
        <GridBackground />
        
        {/* UPDATED: Only show Navigation if NOT on the landing page */}
        { !isLandingPage && <Navigation currentPath={currentPath} client:load /> }

        <ThemeSwitcher client:load />
        
        <div class="relative flex flex-col min-h-screen">
          <main class="flex-1 flex flex-col">
            <slot />
          </main>
          
          {/* Footer logic remains the same (hidden on landing) */}
          {!isLandingPage && <Footer />}
          
          {/* Copyright for Landing Page */}
          {isLandingPage && (
            <div class="absolute bottom-8 w-full text-center opacity-30 font-mono text-[10px] tracking-widest">
              © 2026 BITMAP.AUDIO — ALL RIGHTS RESERVED
            </div>
          )}
        </div>
      </TooltipProvider>
    </SoundProvider>

    <div id="cursor-glow" class="fixed w-32 h-32 bg-primary/20 rounded-full blur-[80px] pointer-events-none z-[9998] hidden md:block translate-x-[-50%] translate-y-[-50%] transition-transform duration-700 ease-out"></div>

    <script>
      const glow = document.getElementById('cursor-glow');
      const interactiveElements = document.querySelectorAll('a, button, [role="button"], .concept-card');

      document.addEventListener('mousemove', (e) => {
        window.requestAnimationFrame(() => {
          if (glow) {
            glow.style.left = `${e.clientX}px`;
            glow.style.top = `${e.clientY}px`;
          }
        });
      });

      interactiveElements.forEach(el => {
        el.addEventListener('mouseenter', () => {
          const text = el.textContent?.toLowerCase() || "";
          if (text.includes('explore')) el.classList.add('is-electric-primary');
          else el.classList.add('is-morphing');

          if (glow) {
            glow.classList.add('animate-glow-pulse');
            if (text.includes('audio')) glow.style.backgroundColor = 'hsl(var(--accent) / 0.3)';
          }
        });

        el.addEventListener('mouseleave', () => {
          el.classList.remove('is-electric-primary', 'is-morphing');
          if (glow) {
            glow.classList.remove('animate-glow-pulse');
            glow.style.backgroundColor = 'hsl(var(--primary) / 0.2)';
          }
        });
      });
    </script>
  </body>
</html>