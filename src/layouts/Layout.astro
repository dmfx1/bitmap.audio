---
/* src/layouts/Layout.astro */
import '../styles/global.css';
import { TooltipProvider } from "@/components/ui/tooltip";
import { SoundProvider } from '../context/SoundContext.tsx';
import Navigation from '../components/Navigation.tsx';
import Footer from '../components/Footer.astro';
import GridBackground from '../components/GridBackground.astro';
import { resolvePageName } from '../config/brandMotion';

const { title, description = "", canonical = "" } = Astro.props;
const currentPath = Astro.url.pathname;
const pageName = resolvePageName(currentPath);
const isLandingPage = currentPath === "/" || currentPath === "/index.html";
const isReturnsPage = currentPath === "/returns" || currentPath === "/returns/" || currentPath === "/returns2" || currentPath === "/returns2/";
// v2 redesign POC — full-bleed, no edge binary rain, nav brand hidden (CornerMark takes over)
const isV2Page = currentPath === "/about-v2" || currentPath === "/about-v2/";
const isFullBleed = isLandingPage || isReturnsPage || isV2Page;
const siteUrl = "https://bitmap.audio";
const resolvedCanonical = canonical || `${siteUrl}${currentPath}`;

---

<!doctype html>
<!-- data-smooth="off" on the returns pages: they own their own GSAP normalizeScroll,
     so global Lenis must not attach there (see src/lib/smooth-scroll.ts). -->
<html lang="en" class="dark" data-smooth={isReturnsPage ? "off" : "on"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-1 0.5 7 8' shape-rendering='crispEdges' fill='black' stroke='black' stroke-width='0.25'><rect x='0' y='1' width='1' height='1' /><rect x='1' y='2' width='1' height='5' /><rect x='0' y='4' width='4' height='1' /><rect x='4' y='4' width='1' height='3' /><rect x='1' y='7' width='3' height='1' /></svg>" />
    <title>{title}</title>
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/images/logo-b.white-bg.png`} />
    <meta property="og:site_name" content="bitmap.audio" />
    <!-- JSON-LD: Organization + WebSite -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "bitmap.audio",
          "url": siteUrl,
          "logo": `${siteUrl}/images/logo-b.png`,
          "description": "Sonic branding and immersive audio agency designing sound identity and experiential audio for digital products and brands.",
          "sameAs": [
            "https://instagram.com/bitmap.audio",
            "https://threads.net/@bitmap.audio",
            "https://linkedin.com/company/bitmapaudio"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "bitmap.audio",
          "publisher": { "@id": `${siteUrl}/#organization` }
        }
      ]
    })} />
    <slot name="head" />
  </head>
  
  <body class="bg-background text-foreground antialiased selection:bg-primary/30 opacity-0 animate-page-in">
    <SoundProvider client:load>
      <TooltipProvider client:load>
        
        {/* v2: binary rain backdrop instead of the bitmap grid (trial on about-v2;
            at rollout, scope rain to hero sections rather than the whole page). */}
        {/* Bitmap grid removed site-wide (only the returns pages keep it, since
            those are left untouched). Rain stays. */}
        <GridBackground
          showRain={isV2Page ? true : (!isLandingPage && !isReturnsPage)}
          showGrid={isReturnsPage}
        />

        { !isLandingPage && <Navigation currentPath={currentPath} pageName={pageName} client:load /> }

        {/* Solid cap over the very top so NOTHING shows through the nav bar at the
            top of the page (scrollY 0) — the binary rain is hidden behind it. Sits
            below the nav (z-50) + brand (z-60), above the rain. Fades out on scroll,
            so content shows through the nav once you start scrolling. Site-wide
            (except landing/returns). */}
        {!isLandingPage && !isReturnsPage && (
          <div id="nav-top-cover" class="fixed top-0 left-0 right-0 h-48 z-40 pointer-events-none bg-gradient-to-b from-background from-[70%] to-transparent"></div>
        )}

        {/* HEADER BAR — the "squish then normalise" surface. Transparent at the very top
            (brand floats over the hero); as you scroll it fades in as a SOLID bar and the
            brand + nav squish into it, locking into a compact sticky header. Its bottom
            border sits on the page-title baseline (calc gutter + brandH). Background is
            hsl(var(--background)) so it ADAPTS to the section theme (dark hero -> beige
            body once the Phase-4 colour handoff lands). Below nav/brand, above content. */}
        {!isLandingPage && !isReturnsPage && (
          <div
            id="header-bar"
            class="fixed top-0 left-0 right-0 z-30 pointer-events-none"
            style="height: calc(var(--page-gutter) + var(--brandH, 6.5rem)); background: hsl(var(--background) / 0.5); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); opacity: var(--header-solid, 0);"
          ></div>
        )}

        <div class="relative flex flex-col min-h-svh">
          <main class="flex-1 flex flex-col items-center"> 
            {isFullBleed ? (
              <>
                <div class="w-full flex-1 flex flex-col">
                  <slot />
                </div>
                {!isLandingPage && !isReturnsPage && <Footer />}
              </>
            ) : (
              /* Unified: every page is full-bleed at this level; width + gutters are
                 owned by .container-page inside each Section (single source of truth).
                 (Retired the old max-w-[1400px] card frame.) */
              <>
                <div class="w-full flex-1 flex flex-col">
                  <slot />
                </div>
                <Footer />
              </>
            )}
          </main>
        </div>
      </TooltipProvider>
    </SoundProvider>

    <div id="cursor-glow" class="fixed w-32 h-32 bg-primary/20 rounded-full blur-[80px] pointer-events-none z-[9998] hidden md:block translate-x-[-50%] translate-y-[-50%] transition-transform duration-700 ease-out"></div>

    <script is:inline>
      const glow = document.getElementById('cursor-glow');
      
      document.addEventListener('mousemove', (e) => {
        window.requestAnimationFrame(() => {
          if (glow) {
            glow.style.left = `${e.clientX}px`;
            glow.style.top = `${e.clientY}px`;
          }
        });
      });

      document.body.addEventListener('mouseover', (e) => {
        const target = e.target.closest('a, button, [role="button"], .concept-card');
        if (!target) return;
        const text = target.textContent?.toLowerCase() || "";
        if (text.includes('explore')) target.classList.add('is-electric-primary');
        else target.classList.add('is-morphing');
        if (glow) glow.classList.add('animate-glow-pulse');
      });

      document.body.addEventListener('mouseout', (e) => {
        const target = e.target.closest('a, button, [role="button"], .concept-card');
        if (!target) return;
        target.classList.remove('is-electric-primary', 'is-morphing');
        if (glow) glow.classList.remove('animate-glow-pulse');
      });

      // ==========================================
      // THE LATERAL FIX: MANUAL PAGE TRANSITIONS
      // ==========================================
      document.querySelectorAll('a[href^="/"]').forEach(link => {
        link.addEventListener('click', (e) => {
          if (e.ctrlKey || e.metaKey || e.shiftKey) return;
          
          const targetPath = link.getAttribute('href');
          if (targetPath === window.location.pathname) return;

          e.preventDefault();
          document.body.classList.remove('animate-page-in');
          document.body.classList.add('animate-page-out');
          
          // Exactly 150ms to match the signalFadeOut animation
          setTimeout(() => {
            window.location.href = targetPath;
          }, 150);
        });
      });
    </script>

    <script is:inline>
      if (window.innerWidth < 768) {
        const updateGlow = () => {
          const els = document.querySelectorAll('.mobile-viewport-active');
          const viewportCenter = window.innerHeight / 2;
          els.forEach(el => {
            const rect = el.getBoundingClientRect();
            const elCenter = rect.top + rect.height / 2;
            const distance = Math.abs(elCenter - viewportCenter);
            const maxDistance = window.innerHeight * 0.5;
            const intensity = Math.max(0, 1 - distance / maxDistance);
            el.style.setProperty('--glow-intensity', intensity.toFixed(3));
          });
        };

        window.addEventListener('scroll', () => {
          window.requestAnimationFrame(updateGlow);
        }, { passive: true });

        updateGlow();
      }
    </script>

    {/* Fade the nav top-cover out as the page scrolls: solid at the very top
        (nothing shows through the nav), gone by ~160px (content shows through). */}
    <script is:inline>
      (function () {
        const cover = document.getElementById('nav-top-cover');
        if (!cover) return;
        const update = () => {
          const o = Math.max(0, 1 - window.scrollY / 160);
          cover.style.opacity = o.toFixed(3);
        };
        window.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
        update();
      })();
    </script>

    {/* Header squish-then-normalise. On scroll the brand + nav gently squish (--nav-scale)
        AND a solid header bar fades in (--header-solid), locking into a compact sticky bar.
        Both use smoothstep. Kept gentle (MIN 0.86) so it's not too dramatic. */}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        /* Brand squishes MORE (BRAND_MIN) than the nav (NAV_MIN) — a combo of the two.
           HEADER_START: px of scroll BEFORE the header reacts, so the hero TEXT starts
           pulling first and the header/nav only squish after — stops it feeling like the
           page is just scrolling down. SQUISH_DIST/SOLID_DIST run AFTER that offset. */
        const BRAND_MIN = 0.72, NAV_MIN = 0.86, HEADER_START = 220, SQUISH_DIST = 800, SOLID_DIST = 160;
        const smooth = (x) => x * x * (3 - 2 * x);
        const prog = (y, dist) => smooth(Math.max(0, Math.min(1, (y - HEADER_START) / dist)));

        // Heights used to raise the nav so its TOP meets the title TOP when squished.
        let brandH = 104, panelH = 66;
        const remeasure = () => {
          const b = document.querySelector('a[aria-label="Home"]');
          const pn = document.querySelector('nav .backdrop-blur-md.border');
          if (b && b.offsetHeight) brandH = b.offsetHeight;
          if (pn && pn.offsetHeight) panelH = pn.offsetHeight;
        };
        window.addEventListener('load', remeasure);
        window.addEventListener('resize', remeasure, { passive: true });
        remeasure();

        const update = () => {
          const y = window.scrollY;
          const p = prog(y, SQUISH_DIST);   // 0 until HEADER_START, then squishes
          const navScale = 1 - p * (1 - NAV_MIN);
          // Brand + nav shrink toward their own corners (origins set in Navigation).
          root.style.setProperty('--brand-scale', (1 - p * (1 - BRAND_MIN)).toFixed(3));
          root.style.setProperty('--nav-scale', navScale.toFixed(3));
          // Nav-lift: bottom-aligned at full (p=0) -> top meets the title top when squished (p=1).
          root.style.setProperty('--nav-lift', (-(brandH - panelH) * navScale * p).toFixed(1) + 'px');
          root.style.setProperty('--header-solid', prog(y, SOLID_DIST).toFixed(3));
        };
        window.addEventListener('scroll', () => window.requestAnimationFrame(update), { passive: true });
        update();
      })();
    </script>

    {/* Global smooth-scroll foundation: Lenis + GSAP/ScrollTrigger (bundled module).
        Gated off on returns pages via <html data-smooth="off">. See src/lib/smooth-scroll.ts. */}
    <script>
      import '../lib/smooth-scroll';
    </script>
  </body>
</html>