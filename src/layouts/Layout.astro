---
/* src/layouts/Layout.astro */
import '../styles/global.css';
import Navigation from '../components/Navigation.tsx';
import Footer from '../components/Footer.astro';
import Solaris from '../components/Solaris.astro';
import GridBackground from '../components/GridBackground.astro';
import { resolvePageName } from '../config/brandMotion';

const { title, description = "", canonical = "" } = Astro.props;
const currentPath = Astro.url.pathname;
const pageName = resolvePageName(currentPath);
// NB: "/" (index.astro) is a standalone redirect and never renders this layout, so there is no
// landing-page branch here. The returns page is the only full-bleed page: it owns its own
// scroll + GSAP, so it opts out of the global header chrome, rain, footer and fader.
const isReturnsPage = currentPath === "/returns" || currentPath === "/returns/";
const isFaqPage = currentPath === "/faq" || currentPath === "/faq/";
const showChrome = !isReturnsPage;
const siteUrl = "https://bitmap.audio";
const resolvedCanonical = canonical || `${siteUrl}${currentPath}`;

---

<!doctype html>
<!-- data-smooth="off" on the returns pages: they own their own GSAP normalizeScroll,
     so global Lenis must not attach there (see src/lib/smooth-scroll.ts). -->
<html lang="en" class="dark" data-smooth={isReturnsPage ? "off" : "on"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Entry intro (nav curtain + body fade) plays ONCE PER SESSION — the first page load of a
        session — and can be force-replayed with ?intro=1. Sets html.intro-play before paint so
        BOTH the body fade (CSS) and the nav intro (Navigation.tsx reads this class) gate off ONE
        flag. Every later navigation within the session has the flag off, so no per-load animation.
        Navigation sets sessionStorage bitmap_intro_seen when the intro plays. */}
    <script is:inline>
      (function () {
        var replay = new URLSearchParams(location.search).has('intro');
        var seen = false;
        try { seen = !!sessionStorage.getItem('bitmap_intro_seen'); } catch (e) {}
        // Home ALWAYS plays the intro; every other page plays it only if it's the session's first
        // page (intro not yet seen). So a direct link to /about intros, but /about after browsing does not.
        var p = location.pathname;
        var isHome = p === '/' || p === '/home' || p === '/home/';
        if (replay || isHome || !seen) document.documentElement.classList.add('intro-play');
      })();
    </script>
    <meta name="robots" content="index, follow" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {/* Google Fonts loaded in parallel from <head> (was a render-blocking @import chained inside
        global.css). Same families/weights; the --font-mono switch in global.css still applies. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=DM+Mono:wght@300;400&display=swap" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-1 0.5 7 8' shape-rendering='crispEdges' fill='black' stroke='black' stroke-width='0.25'><rect x='0' y='1' width='1' height='1' /><rect x='1' y='2' width='1' height='5' /><rect x='0' y='4' width='4' height='1' /><rect x='4' y='4' width='1' height='3' /><rect x='1' y='7' width='3' height='1' /></svg>" />
    <title>{title}</title>
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/images/logo-b.white-bg.png`} />
    <meta property="og:site_name" content="bitmap.audio" />
    <!-- JSON-LD: Organization + WebSite -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${siteUrl}/#organization`,
          "name": "bitmap.audio",
          "url": siteUrl,
          "logo": `${siteUrl}/images/logo-b.png`,
          "description": "Sonic branding and immersive audio agency designing sound identity and experiential audio for digital products and brands.",
          "sameAs": [
            "https://instagram.com/bitmap.audio",
            "https://threads.net/@bitmap.audio",
            "https://linkedin.com/company/bitmapaudio"
          ]
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "bitmap.audio",
          "publisher": { "@id": `${siteUrl}/#organization` }
        }
      ]
    })} />
    <slot name="head" />
  </head>
  
  <body class="bg-background text-foreground antialiased selection:bg-primary/30">
    {/* ONE rAF-throttled scroll scheduler shared by every inline scroll effect below (fader, nav
        contrast, nav cover, mobile glow, section docking, header squish). Previously each script
        added its own scroll listener and queued a rAF per scroll EVENT, so a busy frame ran every
        handler several times. Each handler is a pure function of scroll position, so running them
        once per frame is visually identical. Resize/load listeners stay with their own scripts. */}
    <script is:inline>
      (function () {
        var fns = [], queued = false;
        function run() { queued = false; for (var i = 0; i < fns.length; i++) fns[i](); }
        window.addEventListener('scroll', function () {
          if (!queued) { queued = true; window.requestAnimationFrame(run); }
        }, { passive: true });
        window.__bmOnScroll = function (fn) { fns.push(fn); };
      })();
    </script>

    {/* Bitmap grid removed site-wide (only the returns page keeps it). Rain everywhere else. */}
    <GridBackground showRain={showChrome} showGrid={isReturnsPage} />

    <Navigation currentPath={currentPath} pageName={pageName} client:load />

    {showChrome && (
      <Fragment>
        {/* Solid cap over the very top so NOTHING shows through the nav bar at scrollY 0 — the binary
            rain is hidden behind it. Below the nav (z-50) + brand (z-60), above the rain. Fades out on
            scroll so content shows through the nav once you start scrolling. */}
        <div id="nav-top-cover" class="fixed top-0 left-0 right-0 h-48 z-40 pointer-events-none bg-gradient-to-b from-background from-[70%] to-transparent"></div>

        {/* HEADER BAR — the "squish then normalise" surface. Transparent at the top (brand floats over
            the hero); on scroll it fades in as a solid bar and the brand + nav squish into it. Below
            nav/brand, above content. Driven by --header-solid (header squish script below). */}
        <div
          id="header-bar"
          class="fixed top-0 left-0 right-0 z-[33] pointer-events-none"
          style="height: var(--header-h); background: hsl(183 34% 18% / 0.34); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); opacity: var(--header-solid, 0);"
        ></div>

        {/* DOCK TITLE — the section title rendered crisp ABOVE the glass header (below logo/nav) so it
            stays legible when the solaris bar docks behind the glass. Driven by the docking script. */}
        <div
          id="dock-title"
          aria-hidden="true"
          class="fixed top-0 left-0 right-0 z-[35] pointer-events-none flex items-center justify-center"
          style="height: var(--header-h); opacity: 0; transition: opacity 0.2s ease;"
        ><span class="solaris-text"></span></div>
      </Fragment>
    )}

    <div class="relative flex flex-col min-h-svh">
      <main class="flex-1 flex flex-col items-center">
        <div class="w-full flex-1 flex flex-col">
          <slot />
        </div>

        {/* Footer on every chrome page except FAQ (which ends flush at its content). The returns
            page is full-bleed: no footer, but it keeps the bottom runway. */}
        {showChrome && !isFaqPage && (
          <div class="w-full relative z-20">
            {/* Solaris beam lives inside the Footer (was doubled here). */}
            <Footer />
          </div>
        )}

        {/* Bottom "sandwich" — transparent runway so the fixed binary rain shows at the foot of the
            page, mirroring the hero at the top. Tune with --page-bottom-runway. */}
        {!isFaqPage && <div class="page-bottom-runway w-full" aria-hidden="true"></div>}
      </main>
    </div>

    <div id="cursor-glow" class="fixed w-32 h-32 bg-primary/20 rounded-full blur-[80px] pointer-events-none z-[9998] hidden md:block translate-x-[-50%] translate-y-[-50%] transition-transform duration-700 ease-out"></div>
    {/* Adaptive bitmap cursor — mix-blend-difference (see global.css #cursor-bit) so it stays visible
        on ANY background. JS positions it + toggles has-bit-cursor (hides the native dot). */}
    <div id="cursor-bit"></div>

    {/* GLOBAL bitmap fader scrollbar + position tracker (bottom-left). Off on returns. */}
    {showChrome && (
      <Fragment>
        <div class="scroll-fader" aria-hidden="true">
          <div class="scroll-fader-fill" data-fader-fill></div>
          <div class="scroll-fader-cap" data-fader-cap>▬</div>
        </div>
        <div id="dev-hud" aria-hidden="true">p 0.000&nbsp;&nbsp;y 0</div>
      </Fragment>
    )}

    <script is:inline>
      const glow = document.getElementById('cursor-glow');
      const bit = document.getElementById('cursor-bit');
      // Opt in to the blend cursor only on a pointer device wide enough for it, and only once the
      // element exists — so the native --cursor-dot remains a safe fallback everywhere else.
      const bitOn = bit && window.matchMedia('(min-width: 768px) and (pointer: fine)').matches;
      if (bitOn) document.documentElement.classList.add('has-bit-cursor');

      // One rAF per frame, painting the LATEST pointer position (was one rAF per mousemove event).
      let mx = 0, my = 0, cursorQueued = false;
      const paintCursor = () => {
        cursorQueued = false;
        if (glow) {
          glow.style.left = `${mx}px`;
          glow.style.top = `${my}px`;
        }
        if (bitOn) {
          bit.style.left = `${mx}px`;
          bit.style.top = `${my}px`;
        }
      };
      document.addEventListener('mousemove', (e) => {
        mx = e.clientX; my = e.clientY;
        if (!cursorQueued) { cursorQueued = true; window.requestAnimationFrame(paintCursor); }
      });

      // Any element with its OWN native cursor (links, buttons, form fields) hides the blend dot so
      // there's never a double cursor; the MORPH/glow hover treatment stays limited to the original
      // interactive set (not form fields).
      const DOT_HIDE = 'a, button, [role="button"], .concept-card, .cursor-pointer, input, textarea, select, [contenteditable="true"]';
      const MORPH = 'a, button, [role="button"], .concept-card';

      document.body.addEventListener('mouseover', (e) => {
        if (bitOn && e.target.closest(DOT_HIDE)) bit.classList.add('is-hover');
        const target = e.target.closest(MORPH);
        if (!target) return;
        const text = target.textContent?.toLowerCase() || "";
        if (text.includes('explore')) target.classList.add('is-electric-primary');
        else target.classList.add('is-morphing');
        if (glow) glow.classList.add('animate-glow-pulse');
      });

      document.body.addEventListener('mouseout', (e) => {
        if (bitOn && e.target.closest(DOT_HIDE)) bit.classList.remove('is-hover');
        const target = e.target.closest(MORPH);
        if (!target) return;
        target.classList.remove('is-electric-primary', 'is-morphing');
        if (glow) glow.classList.remove('animate-glow-pulse');
      });

    </script>

    {/* GLOBAL fader + tracker driver — reflects document-scroll progress. On stage pages (which have
        #stage-track) the page's own timeline onUpdate enriches #dev-hud with the timeline `t`; here we
        only own the fader on those pages and leave the HUD text to the stage. */}
    <script is:inline>
      (function () {
        function initGlobalFader() {
          const cap = document.querySelector('[data-fader-cap]');
          const fill = document.querySelector('[data-fader-fill]');
          const hud = document.getElementById('dev-hud');
          if (!cap && !hud) return;
          if (cap && cap.dataset.init === '1') return;
          if (cap) cap.dataset.init = '1';
          const hasStage = !!document.getElementById('stage-track');
          const update = function () {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
            const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
            const top = 2 * rem;                        // --page-gutter (2rem) — aligns with the nav's top edge
            const bottom = window.innerHeight * 0.08;   // matches .scroll-fader::before bottom (8vh)
            const trackH = window.innerHeight - top - bottom;
            if (fill) fill.style.height = (p * trackH) + 'px';
            if (cap) cap.style.top = (top + p * trackH) + 'px';
            if (hud && !hasStage) hud.textContent = 'p ' + p.toFixed(3) + '  y ' + Math.round(window.scrollY);
          };
          const onResize = function () { window.requestAnimationFrame(update); };
          const lenis = window.__lenis;
          if (lenis && lenis.on) lenis.on('scroll', update);
          window.__bmOnScroll(update);
          window.addEventListener('resize', onResize, { passive: true });
          update();
        }
        document.addEventListener('astro:page-load', initGlobalFader);
        if (document.readyState === 'complete') initGlobalFader();
        else window.addEventListener('load', initGlobalFader);
      })();
    </script>

    {/* NAV CONTRAST — flip the nav/brand tokens dark when the beige "oat" world is behind them.
        Samples the element just below the header (elementFromPoint skips the pointer-events-none
        header glass + hidden/faded scenes), so it works on both the vertical pages and the stage. */}
    <script is:inline>
      (function () {
        function initNavContrast() {
          const root = document.documentElement;
          const update = function () {
            const mobile = window.innerWidth < 768;
            const bar = document.getElementById('header-bar');
            const headerH = bar ? bar.offsetHeight : 140;
            // mobile: sample under the logo; only sections marked data-oat-mobile are actually oat there
            // (other .theme-oat scenes go transparent on the rain on mobile).
            let overOat;
            if (mobile) {
              const y = 40;   // the logo's line
              overOat = Array.prototype.some.call(document.querySelectorAll('[data-oat-mobile]'), function (s) {
                // ignore the faded buffer (its padding) — flip only once the logo is over solid oat
                const r = s.getBoundingClientRect(); const f = (parseFloat(getComputedStyle(s).paddingTop) || 0) * 0.6;
                return r.top + f <= y && r.bottom - f >= y;
              });
            } else {
              const el = document.elementFromPoint(Math.round(window.innerWidth / 2), headerH + 8);
              overOat = !!(el && el.closest && el.closest('.theme-oat'));
            }
            root.classList.toggle('nav-over-oat', overOat);
          };
          const onResize = function () { window.requestAnimationFrame(update); };
          const lenis = window.__lenis;
          if (lenis && lenis.on) lenis.on('scroll', update);
          window.__bmOnScroll(update);
          window.addEventListener('resize', onResize, { passive: true });
          update();
        }
        document.addEventListener('astro:page-load', initNavContrast);
        if (document.readyState === 'complete') initNavContrast();
        else window.addEventListener('load', initNavContrast);
      })();
    </script>

    <script is:inline>
      if (window.innerWidth < 768) {
        const updateGlow = () => {
          const els = document.querySelectorAll('.mobile-viewport-active');
          const viewportCenter = window.innerHeight / 2;
          els.forEach(el => {
            const rect = el.getBoundingClientRect();
            const elCenter = rect.top + rect.height / 2;
            const distance = Math.abs(elCenter - viewportCenter);
            const maxDistance = window.innerHeight * 0.5;
            const intensity = Math.max(0, 1 - distance / maxDistance);
            el.style.setProperty('--glow-intensity', intensity.toFixed(3));
          });
        };

        window.__bmOnScroll(updateGlow);

        updateGlow();
      }
    </script>

    {/* Fade the nav top-cover out as the page scrolls: solid at the very top
        (nothing shows through the nav), gone by ~160px (content shows through). */}
    <script is:inline>
      (function () {
        const cover = document.getElementById('nav-top-cover');
        if (!cover) return;
        const update = () => {
          const o = Math.max(0, 1 - window.scrollY / 160);
          cover.style.opacity = o.toFixed(3);
        };
        window.__bmOnScroll(update);
        update();
      })();
    </script>

    {/* Analysis "boxes" fly-in: arm on load, reveal each [data-fly] when it scrolls into view. */}
    <script>
      (() => {
        document.documentElement.classList.add('fly-ready');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
        const scan = () => document.querySelectorAll('[data-fly]:not([data-fly-seen])').forEach((el) => {
          el.setAttribute('data-fly-seen', ''); io.observe(el);
        });
        scan();
        new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
      })();
    </script>

    {/* Section-bar DOCKING (desktop): a sticky solaris section bar first appears under the header,
        then as you keep scrolling it rises into the header zone and docks at the top — one bar with
        the logo, the section title and the nav. Drives --dock (0→1) per bar + html.nav-docked. */}
    <script is:inline>
      (function () {
        if (window.innerWidth < 768) return;
        const root = document.documentElement;
        const headerBar = document.getElementById('header-bar');
        const DOCK_DIST = 260;   // px of scroll past the stick line over which it docks
        let holds = [];
        const collect = () => { holds = Array.prototype.slice.call(document.querySelectorAll('.section-bar-hold')); };
        const dockTitle = document.getElementById('dock-title');
        const dockLabel = dockTitle ? dockTitle.querySelector('span') : null;
        const clamp01 = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
        const update = () => {
          if (!holds.length) return;   // pages without section bars (e.g. home) drive docking themselves
          const hh = headerBar ? headerBar.offsetHeight : 0;
          let bestOp = 0, bestTitle = '';
          for (let i = 0; i < holds.length; i++) {
            const hold = holds[i];
            const parent = hold.parentElement;
            if (!parent) continue;
            // --dock drives the slide-up + height morph (0 → 1 as the bar rises into the header).
            const dock = clamp01((hh - parent.getBoundingClientRect().top) / DOCK_DIST);
            hold.style.setProperty('--dock', dock.toFixed(3));
            // Title overlay follows the bar's ACTUAL position: fades in as it reaches the top (rTop→0)
            // and fades back out as it scrolls up and leaves the header zone (rTop→ -headerH).
            const bar = hold.querySelector('.solaris');
            if (bar && hh) {
              const op = clamp01(1 - Math.abs(bar.getBoundingClientRect().top) / hh);
              if (op > bestOp) {
                bestOp = op;
                const t = hold.querySelector('.solaris-text');
                bestTitle = t ? (t.textContent || '') : '';
              }
            }
          }
          root.classList.toggle('nav-docked', bestOp > 0.6);
          if (dockTitle) {
            dockTitle.style.opacity = bestOp.toFixed(3);
            if (dockLabel && dockLabel.textContent !== bestTitle) dockLabel.textContent = bestTitle;
          }
        };
        collect();
        window.__bmOnScroll(update);
        window.addEventListener('resize', function () { collect(); update(); }, { passive: true });
        window.addEventListener('load', function () { collect(); update(); });
        update();
      })();
    </script>

    {/* Header squish-then-normalise. On scroll the brand + nav gently squish (--nav-scale)
        AND a solid header bar fades in (--header-solid), locking into a compact sticky bar.
        Brand floors at 0.62 so it sits CENTRED with even top/bottom padding inside the
        solaris-height compact bar; the nav holds FULL size (NAV_MIN 1) and centres vertically. */}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        /* Brand squishes MORE (BRAND_MIN) than the nav (NAV_MIN) — a combo of the two.
           HEADER_START: px of scroll BEFORE the header reacts, so the hero TEXT starts
           pulling first and the header/nav only squish after — stops it feeling like the
           page is just scrolling down. SQUISH_DIST/SOLID_DIST run AFTER that offset. */
        /* BRAND_MIN = compact brand size at rest (was 0.62 → 0.68, +10%, 2026-11-09). */
        const BRAND_MIN = 0.68, NAV_MIN = 1.00, HEADER_START = 220, SQUISH_DIST = 800, SOLID_DIST = 160;
        // Compact header matches the solaris bar: shrink the gutter so header-h -> --solaris-height
        // while the brand holds its floor. GUTTER_PX = --page-gutter (2rem) resolved to px.
        const GUTTER_PX = parseFloat(getComputedStyle(root).fontSize) * 2 || 32;
        // Compact header height — its own token now (was tied to --solaris-height).
        const SOLARIS_H = parseFloat(getComputedStyle(root).getPropertyValue('--header-compact-h'))
          || parseFloat(getComputedStyle(root).getPropertyValue('--solaris-height')) || 96;
        const smooth = (x) => x * x * (3 - 2 * x);
        const prog = (y, dist) => smooth(Math.max(0, Math.min(1, (y - HEADER_START) / dist)));

        // Heights used to raise the nav so its TOP meets the title TOP when squished.
        let brandH = 104, panelH = 46;
        const remeasure = () => {
          const b = document.querySelector('a[aria-label="Home"]');
          const pn = document.querySelector('nav .backdrop-blur-md.border');
          if (b && b.offsetHeight) brandH = b.offsetHeight;
          if (pn && pn.offsetHeight) panelH = pn.offsetHeight;
        };
        window.addEventListener('load', remeasure);
        window.addEventListener('resize', remeasure, { passive: true });
        remeasure();

        const update = () => {
          const y = window.scrollY;
          const p = prog(y, SQUISH_DIST);   // 0 until HEADER_START, then squishes
          const navScale = 1 - p * (1 - NAV_MIN);
          // Brand + nav shrink toward their own corners (origins set in Navigation).
          root.style.setProperty('--brand-scale', (1 - p * (1 - BRAND_MIN)).toFixed(3));
          root.style.setProperty('--nav-scale', navScale.toFixed(3));
          // Gutter shrinks so the squished header-h equals --solaris-height; padCompact centres the
          // floored brand inside that solaris-tall bar. Brand + nav ride up via top: var(--header-pad).
          const padCompact = Math.max(2, (SOLARIS_H - brandH * BRAND_MIN) / 2);
          root.style.setProperty('--header-pad', (GUTTER_PX - p * (GUTTER_PX - padCompact)).toFixed(1) + 'px');
          root.style.setProperty('--header-solid', prog(y, SOLID_DIST).toFixed(3));
        };
        window.__bmOnScroll(update);
        update();
      })();
    </script>

    {/* Global smooth-scroll foundation: Lenis + GSAP/ScrollTrigger (bundled module).
        Gated off on returns pages via <html data-smooth="off">. See src/lib/smooth-scroll.ts. */}
    <script>
      import '../lib/smooth-scroll';
    </script>
  </body>
</html>