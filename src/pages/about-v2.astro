---
/* src/pages/about-v2.astro
 *
 * PROOF OF CONCEPT — v2 redesign of the About page.
 * The original about.astro is left untouched for side-by-side cross-reference.
 *
 * What's different here:
 *  - afternow-style intro sequence (IntroSequence) replaces a landing page.
 *  - Brand wordmark moved OUT of the nav into a persistent CornerMark (top-left),
 *    which scrambles bitmap.audio -> "about us".
 *  - ALL AI photographic imagery removed. The hero's right side + the layer the
 *    blurred sections scroll over is a generative SonicVisual, not a photo.
 *  - Full bleed (Layout treats /about-v2 as full-bleed; edge binary rain gated off).
 *  - Sticky hero + backdrop-blur sub-sections retained.
 *
 * Review tip: append ?intro=1 to replay the intro (otherwise it's once-per-session).
 */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
// Solaris bar is now the page-level persistent #page-bar (below), not per-section <Solaris/>.
import PhilosophyScene from '../components/modules/PhilosophyScene.astro';
import AboutHeroV2 from '../components/modules/AboutHeroV2.tsx';
import Founders from '../components/modules/Founders.tsx';
import FoundersScene from '../components/modules/FoundersScene.astro';
import FocusColumns from '../components/modules/FocusColumns.astro';
import FocusScroll from '../components/FocusScroll.astro';
// import AboutPhilosophy from '../components/modules/AboutPhilosophy.tsx'; // HIDDEN — kept for reference while the PhilosophyScene replaces it
// import Values from '../components/modules/Values.tsx'; // replaced by <FocusColumns/> below
import Clients from '../components/modules/Clients.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="About bitmap.audio | Sonic Branding Agency"
  description="bitmap.audio is a sonic branding and immersive audio agency founded by Dom Storrs-Fox and Nick Granville-Fall. We design sound identities for digital brands."
>
  {/* The entry animation now lives entirely in the nav brand lockup
      (Navigation.tsx): the b is instantiated on load and the wordmark fades in +
      scrambles to the page name IN PLACE — no separate overlay, seamless by
      construction. All timing is in src/config/brandMotion.ts. */}

  {/* Hero: fills the viewport and sticks; blurred sections scroll up over it.
      AboutHeroV2 is flex-1 + justify-end so its text ends at the bottom.
      #hero-sticky is the (unanimated) ScrollTrigger anchor for the hero squish. */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh flex flex-col">
    <AboutHeroV2 client:load />
  </div>

  {/* Hero runway — the sticky hero HOLDS while its copy recedes into the void + the binary-rain
      parallax reads, BEFORE the beige world scrolls up over it. Transparent + TOP-LEVEL (a sibling
      of the hero, NOT inside theme-oat) so the hero shows through. Tune with --hero-runway. */}
  <div class="hero-runway" aria-hidden="true"></div>

  {/* ══════════ PERSISTENT SOLARIS BAR ══════════
      ONE bar for the whole page journey. It GROWS in from the left as the header/nav shrink
      (initPageBar, below), then stays fixed under the header while its label SCRAMBLES between
      section names as each section reaches centre. Replaces the old per-section bars (founders bar,
      phil-bar, and every section-bar-hold). Desktop only for now — mobile trial is bar-less. */}
  <div id="page-bar" aria-hidden="true">
    <span class="solaris-text" data-page-label></span>
  </div>
  <style>
    #page-bar {
      position: fixed; top: var(--header-h); left: 0; right: 0; z-index: 30;
      height: var(--solaris-height);
      background: linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      box-shadow: var(--solaris-glow);
      display: flex; align-items: center; justify-content: center;
      /* FLIPS DOWN from the header's bottom edge — folded up (hidden) until the founders fog is fully
         in, then GSAP rotates it flat. transform-origin is the TOP edge so it hinges off the header. */
      transform-origin: top center;
      transform: perspective(800px) rotateX(-90deg);
      pointer-events: none;
      /* per-section colour is set in JS (setLabel) — transition so the swap morphs, not snaps */
      transition: background 0.45s ease, box-shadow 0.45s ease;
    }
    #page-bar [data-page-label] {
      opacity: 0;                 /* revealed once first section is active */
      white-space: nowrap;
      text-align: center;
      transition: color 0.45s ease;
    }
    @media (max-width: 767px) { #page-bar { display: none; } }
  </style>

  {/* ══════════ FOUNDERS SCENE (TRIAL) — the "scene deck": this section PINS and assembles in
      place — beige FOGS IN on approach, then a bitmap PIXEL VEIL dissolves in random order to reveal
      the founders. The persistent bar (above) already carries the "Who We Are" label. ══════════ */}
  <FoundersScene />

  {/* Beige "Cool Oat" world — the rest of the sections (still scroll/lock for now). */}
  <div class="relative z-10 theme-oat">
    {/* Philosophy — the PERSISTENT bar (above) carries the label; it scrambles to "Our Philosophy"
        as this scene reaches centre. The old phil-bar + its slide/ghost sync are removed for this
        trial (the bar just stays put and the text changes). */}
    <div class="relative" id="sec-philosophy">
      <PhilosophyScene />
    </div>

    {/* Our Values — STICKY focus columns, pulled up over philosophy's END (after its TV-out has
        fully finished — tune --scene-follow-pull: bigger = covers sooner, smaller = TV-out gets
        more room / a touch more beige first), led by a solaris bar. */}
    <div class="scene-follow" id="sec-values" style="--scene-follow-pull: 40svh">
      {/* Bar label handled by the persistent bar (scrambles to "Our Values" here). pinnedBar drops
          the floating heading and re-centres the columns below the header + bar. */}
      <FocusColumns
        heading="Our Values"
        pinnedBar
        columns={[
          { id: "01", title: "Precision", desc: "Sound should feel deliberate and every frequency intentional." },
          { id: "02", title: "Empathy", desc: "Sound should feel intuitive, not intrusive and systems should be collaborative." },
          { id: "03", title: "Innovation", desc: "Sonunds should remain adaptable and allow scope for future development." },
        ]}
      />
    </div>

    {/* Clients — bar sticks under the header, the terminal locks in below it, then they release
        together. The old [ CLIENT_TERMINAL ] label is now carried by the Solaris bar. */}
    <div class="relative" id="sec-clients">
      <FocusScroll count={1} barOffset id="clients" class="!bg-background-blur/50 backdrop-blur-xl">
        {/* Side gutters; the grid fills the rest. */}
        <div class="px-4 md:px-12 lg:px-24 w-full">
          <Clients client:visible />
        </div>
      </FocusScroll>
    </div>

    {/* CTA — bar sticks under the header, the CTA locks in below it, then they release together. */}
    <div class="relative" id="sec-cta">
      <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <CTA
            client:visible
            title="Define your brand's audio identity"
            description="Let's explore how a sonic brand can strengthen your identity and deepen audience connection."
            buttonText="START YOUR SONIC BRAND"
          />
        </div>
      </FocusScroll>
    </div>
  </div>

  {/* PERSISTENT SOLARIS BAR driver. The binary rain NEVER stops now (the beige just fogs in over
      it), so there's no rain-freeze here. The bar grows in as the header shrinks, then its label
      scrambles between section names as you scroll the page. */}
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { scrambleIn } from '../lib/scene-kit';
    gsap.registerPlugin(ScrollTrigger);

    function initPageBar() {
      const bar = document.getElementById('page-bar');
      if (!bar || bar.dataset.init === '1') return;
      bar.dataset.init = '1';
      const label = bar.querySelector<HTMLElement>('[data-page-label]');
      if (!label) return;

      // FLIP DOWN — the bar hinges down from the header's bottom edge, but ONLY once the founders
      // beige fog is fully in (the founders scene reaches the top / pins). It stays down for the rest
      // of the page. Driven off the scene's ScrollTrigger so it updates under Lenis (a plain scroll
      // listener doesn't fire here).
      gsap.set(bar, { transformPerspective: 800, transformOrigin: 'top center', rotationX: -90 });
      let down = false;
      const flip = (toDown: boolean) => {
        if (toDown === down) return;
        down = toDown;
        gsap.to(bar, { rotationX: toDown ? 0 : -90, duration: 0.55, ease: toDown ? 'power3.out' : 'power2.in' });
      };
      ScrollTrigger.create({
        trigger: '#founders-scene',
        start: 'top top',                       // fog is fully instantiated at this point
        onEnter: () => flip(true),
        onLeaveBack: () => flip(false),
      });

      // LABEL + COLOUR — scramble to the ACTIVE section's name (fires in both scroll directions).
      // The bar stays put throughout; the text changes and, per section, so can the bar colour.
      // Add `bg` / `text` / `glow` to any entry to override the default solaris beam for that section
      // (e.g. the philosophy scene gets a WHITE bar).
      const DEFAULT_BG = 'linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%)';
      const DEFAULT_GLOW = 'var(--solaris-glow)';
      const SECTIONS = [
        { sel: '#founders-scene', name: 'Who We Are' },
        { sel: '#sec-philosophy', name: 'Our Philosophy', bg: '#ffffff', text: '#141414', glow: '0 0 24px rgba(255,255,255,0.35)' },
        { sel: '#sec-values',     name: 'Our Values' },
        { sel: '#sec-clients',    name: 'Client Terminal' },
        { sel: '#sec-cta',        name: 'Get In Touch' },
      ];
      let current = '';
      const setLabel = (s: { name: string; bg?: string; text?: string; glow?: string }) => {
        if (s.name === current) return;
        current = s.name;
        label.style.opacity = '1';
        label.style.color = s.text ?? '';            // '' falls back to .solaris-text (dark)
        bar.style.background = s.bg ?? DEFAULT_BG;
        bar.style.boxShadow = s.glow ?? DEFAULT_GLOW;
        scrambleIn(label, s.name, { duration: 650 });
      };
      // Fire the label change at the START of each section (its top reaching the top of the viewport),
      // in BOTH directions — index bookkeeping so scrolling back up restores the previous section.
      let idx = -1;
      const apply = (i: number) => {
        if (i === idx) return;
        idx = i;
        if (i < 0) { current = ''; label.style.opacity = '0'; return; } // back above the first scene
        setLabel(SECTIONS[i]);
      };
      SECTIONS.forEach((s, i) => {
        const el = document.querySelector(s.sel);
        if (!el) return;
        ScrollTrigger.create({
          trigger: el, start: 'top top',
          onEnter: () => apply(i),
          onLeaveBack: () => apply(i - 1),
        });
      });
    }

    document.addEventListener('astro:page-load', initPageBar);
    if (document.readyState === 'complete') initPageBar();
    else window.addEventListener('load', initPageBar);
  </script>
</Layout>
