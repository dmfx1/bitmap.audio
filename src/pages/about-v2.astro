---
/* src/pages/about-v2.astro
 *
 * PROOF OF CONCEPT — v2 redesign of the About page.
 * The original about.astro is left untouched for side-by-side cross-reference.
 *
 * What's different here:
 *  - afternow-style intro sequence (IntroSequence) replaces a landing page.
 *  - Brand wordmark moved OUT of the nav into a persistent CornerMark (top-left),
 *    which scrambles bitmap.audio -> "about us".
 *  - ALL AI photographic imagery removed. The hero's right side + the layer the
 *    blurred sections scroll over is a generative SonicVisual, not a photo.
 *  - Full bleed (Layout treats /about-v2 as full-bleed; edge binary rain gated off).
 *  - Sticky hero + backdrop-blur sub-sections retained.
 *
 * Review tip: append ?intro=1 to replay the intro (otherwise it's once-per-session).
 */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Solaris from '../components/Solaris.astro';
import PhilosophyScene from '../components/modules/PhilosophyScene.astro';
import AboutHeroV2 from '../components/modules/AboutHeroV2.tsx';
import Founders from '../components/modules/Founders.tsx';
// import AboutPhilosophy from '../components/modules/AboutPhilosophy.tsx'; // HIDDEN — kept for reference while the PhilosophyScene replaces it
import Values from '../components/modules/Values.tsx';
import Clients from '../components/modules/Clients.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="About bitmap.audio | Sonic Branding Agency"
  description="bitmap.audio is a sonic branding and immersive audio agency founded by Dom Storrs-Fox and Nick Granville-Fall. We design sound identities for digital brands."
>
  {/* The entry animation now lives entirely in the nav brand lockup
      (Navigation.tsx): the b is instantiated on load and the wordmark fades in +
      scrambles to the page name IN PLACE — no separate overlay, seamless by
      construction. All timing is in src/config/brandMotion.ts. */}

  {/* Hero: fills the viewport and sticks; blurred sections scroll up over it.
      AboutHeroV2 is flex-1 + justify-end so its text ends at the bottom.
      #hero-sticky is the (unanimated) ScrollTrigger anchor for the hero squish. */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh flex flex-col">
    <AboutHeroV2 client:load />
  </div>

  {/* HORIZONTAL SCROLL (trial, About only): the founders panel slides in from the RIGHT
      over the dark hero, led by the vertical solaris beam, with the binary rain frozen
      (GSAP <script> at the bottom). Replaces the vertical rise here. */}
  <div id="peel" class="relative z-10">
    <div class="peel-pin">
      <div id="peel-reveal" class="theme-oat">
        <div id="peel-beam" aria-hidden="true"></div>
        <Section id="founders" delay="0s" className="min-h-svh flex flex-col justify-center">
          <Founders client:visible />
        </Section>
      </div>
    </div>
  </div>

  {/* Content: the beige "Cool Oat" world — the rest of the sections after the peel. */}
  <div class="relative z-10 theme-oat">
    {/* HIDDEN — original AboutPhilosophy kept for reference; the PhilosophyScene below replaces it.
        Re-enable by uncommenting this block AND its import at the top of the file.
    <Section id="philosophy" invert delay="0.3s" className="!bg-background/50 backdrop-blur-xl">
      <AboutPhilosophy client:visible />
    </Section>
    */}

    {/* The bitmap-pixel scroll SCENE (reusable Scene framework). */}
    <PhilosophyScene />


    <Section id="Values" delay="0.4s" className="!bg-background/50 backdrop-blur-xl" grainBg>
      <Values client:visible />
    </Section>

    {/* THE FULL BLEED CLIENT TERMINAL */}
    <Section
      id="clients"
      delay="0.5s"
      isFullWidth={true}
      noPadding={true}
      hasBorder={true}
      className="!bg-background-blur/50 backdrop-blur-xl pb-8"
    >
      <div class="container-page mb-8 pt-8">
        <p class="text-base font-mono tracking-[0.5em] uppercase text-accent">
          [ CLIENT_TERMINAL ]
        </p>
      </div>
      <Clients client:visible />
    </Section>

    <Section id="cta" delay="0.6s" className="!bg-background/50 backdrop-blur-xl" grainBg>
      <CTA
        client:visible
        title="Define your brand's audio identity"
        description="Let's explore how a sonic brand can strengthen your identity and deepen audience connection."
        buttonText="START YOUR SONIC BRAND"
      />
    </Section>
  </div>

  {/* HORIZONTAL SCROLL driver (About trial). Pins the stage and scrubs --peel 0%→100%,
      sliding the founders panel in from the right (the vertical solaris beam leads it), and
      freezes the binary rain while pinned so the dark hero behind stays static.
      Desktop only; reduced-motion just shows the founders. Tune: end (scroll length),
      --solaris-height (beam thickness), --solaris-* (beam colours). */}
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    function initPeel() {
      const peel = document.getElementById('peel');
      const pin = document.querySelector('.peel-pin');
      if (!peel || !pin || peel.dataset.peelInit === '1') return;
      const desktop = window.matchMedia('(min-width: 768px)').matches;
      if (!desktop) return; // mobile: CSS shows the founders as a normal section
      peel.dataset.peelInit = '1';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        pin.style.setProperty('--peel', '100%'); // no animation — just reveal
        return;
      }
      gsap.fromTo(pin, { '--peel': '0%' }, {
        '--peel': '100%',
        ease: 'none',
        scrollTrigger: {
          trigger: peel,
          start: 'top top',
          end: '+=120%',
          scrub: true,
          pin: pin,
          pinSpacing: true,
          invalidateOnRefresh: true,
          onToggle: (self) => {
            document.documentElement.dataset.rainFrozen = self.isActive ? '1' : '0';
          },
        },
      });
    }

    document.addEventListener('astro:page-load', initPeel);
    if (document.readyState === 'complete') initPeel();
    else window.addEventListener('load', initPeel);
  </script>
</Layout>
