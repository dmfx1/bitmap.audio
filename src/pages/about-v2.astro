---
/* src/pages/about-v2.astro
 *
 * PROOF OF CONCEPT — v2 redesign of the About page.
 * The original about.astro is left untouched for side-by-side cross-reference.
 *
 * What's different here:
 *  - afternow-style intro sequence (IntroSequence) replaces a landing page.
 *  - Brand wordmark moved OUT of the nav into a persistent CornerMark (top-left),
 *    which scrambles bitmap.audio -> "about us".
 *  - ALL AI photographic imagery removed. The hero's right side + the layer the
 *    blurred sections scroll over is a generative SonicVisual, not a photo.
 *  - Full bleed (Layout treats /about-v2 as full-bleed; edge binary rain gated off).
 *  - Sticky hero + backdrop-blur sub-sections retained.
 *
 * Review tip: append ?intro=1 to replay the intro (otherwise it's once-per-session).
 */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Solaris from '../components/Solaris.astro';
import PhilosophyScene from '../components/modules/PhilosophyScene.astro';
import AboutHeroV2 from '../components/modules/AboutHeroV2.tsx';
import Founders from '../components/modules/Founders.tsx';
import FocusColumns from '../components/modules/FocusColumns.astro';
import FocusScroll from '../components/FocusScroll.astro';
// import AboutPhilosophy from '../components/modules/AboutPhilosophy.tsx'; // HIDDEN — kept for reference while the PhilosophyScene replaces it
// import Values from '../components/modules/Values.tsx'; // replaced by <FocusColumns/> below
import Clients from '../components/modules/Clients.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="About bitmap.audio | Sonic Branding Agency"
  description="bitmap.audio is a sonic branding and immersive audio agency founded by Dom Storrs-Fox and Nick Granville-Fall. We design sound identities for digital brands."
>
  {/* The entry animation now lives entirely in the nav brand lockup
      (Navigation.tsx): the b is instantiated on load and the wordmark fades in +
      scrambles to the page name IN PLACE — no separate overlay, seamless by
      construction. All timing is in src/config/brandMotion.ts. */}

  {/* Hero: fills the viewport and sticks; blurred sections scroll up over it.
      AboutHeroV2 is flex-1 + justify-end so its text ends at the bottom.
      #hero-sticky is the (unanimated) ScrollTrigger anchor for the hero squish. */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh flex flex-col">
    <AboutHeroV2 client:load />
  </div>

  {/* Hero runway — the sticky hero HOLDS while its copy recedes into the void + the binary-rain
      parallax reads, BEFORE the beige world scrolls up over it. Transparent + TOP-LEVEL (a sibling
      of the hero, NOT inside theme-oat) so the hero shows through. Tune with --hero-runway. */}
  <div class="hero-runway" aria-hidden="true"></div>

  {/* Beige "Cool Oat" world — scrolls up OVER the sticky hero. No horizontal peel — all vertical. */}
  <div class="relative z-10 theme-oat">
    {/* Founders — first section over the hero. Bar sticks under the header, founders lock in
        below it, then release together (section-bar-hold + FocusScroll, same as Values). */}
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="Who we are" /></div>
      <FocusScroll count={1} barOffset id="founders" class="!bg-background">
        <Founders client:visible />
      </FocusScroll>
    </div>

    {/* Philosophy — bar sticks under the header while the pixel scene plays. NOTE: the scene is a
        GSAP-pinned scene, so this uses a PLAIN sticky bar (not the full-height .section-bar-hold,
        which needs an overlap margin on its sibling and would risk the scene's pin). Trade-off:
        the bar can linger briefly at the very end (the short-bar behaviour). A scene-integrated
        bar — pinned WITH the stage in scene.ts — is the clean fix, as a careful follow-up. */}
    <div class="relative">
      {/* Plain sticky bar (scene untouched). A JS pass (below) slides it up in sync with the scene
          so it doesn't linger, AND flips it to the ghost variant (transparent + accent) only once
          the stage background actually goes dark — solaris orange while the scene is still beige. */}
      <div id="phil-bar" class="sticky top-[var(--header-h)] z-20"><Solaris text="Our Philosophy" /></div>
      {/* The bitmap-pixel scroll SCENE (scene.ts pin) — untouched. */}
      <PhilosophyScene />
    </div>

    {/* Our Values — STICKY focus columns, pulled up over philosophy's END (after its TV-out has
        fully finished — tune --scene-follow-pull: bigger = covers sooner, smaller = TV-out gets
        more room / a touch more beige first), led by a solaris bar. */}
    <div class="scene-follow" style="--scene-follow-pull: 40svh">
      {/* The Solaris bar arrives under the header FIRST (as before), but sits in a full-height
          .section-bar-hold so it releases in SYNC with the columns instead of lingering. pinnedBar
          drops the floating heading and re-centres the columns below the header + bar. */}
      <div class="section-bar-hold"><Solaris text="Our Values" /></div>
      <FocusColumns
        heading="Our Values"
        pinnedBar
        columns={[
          { id: "01", title: "Precision", desc: "Sound should feel deliberate and every frequency intentional." },
          { id: "02", title: "Empathy", desc: "Sound should feel intuitive, not intrusive and systems should be collaborative." },
          { id: "03", title: "Innovation", desc: "Sonunds should remain adaptable and allow scope for future development." },
        ]}
      />
    </div>

    {/* Clients — bar sticks under the header, the terminal locks in below it, then they release
        together. The old [ CLIENT_TERMINAL ] label is now carried by the Solaris bar. */}
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="Client Terminal" /></div>
      <FocusScroll count={1} barOffset id="clients" class="!bg-background-blur/50 backdrop-blur-xl">
        {/* Side gutters; the grid fills the rest. */}
        <div class="px-4 md:px-12 lg:px-24 w-full">
          <Clients client:visible />
        </div>
      </FocusScroll>
    </div>

    {/* CTA — bar sticks under the header, the CTA locks in below it, then they release together. */}
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="Get In Touch" /></div>
      <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <CTA
            client:visible
            title="Define your brand's audio identity"
            description="Let's explore how a sonic brand can strengthen your identity and deepen audience connection."
            buttonText="START YOUR SONIC BRAND"
          />
        </div>
      </FocusScroll>
    </div>
  </div>

  {/* Rain freeze: once the beige world starts covering the sticky hero, stop the binary rain so the
      hero reads as a static backdrop as sections scroll over it. Unfreeze when scrolled back up. */}
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    function initRainFreeze() {
      const founders = document.getElementById('founders');
      if (!founders || founders.dataset.rainInit === '1') return;
      founders.dataset.rainInit = '1';
      ScrollTrigger.create({
        trigger: founders,
        start: 'top bottom', // founders begins coming over the hero
        onEnter: () => { document.documentElement.dataset.rainFrozen = '1'; },
        onLeaveBack: () => { document.documentElement.dataset.rainFrozen = '0'; },
      });
    }

    // Slide the philosophy bar UP in sync with the pinned scene so it doesn't linger. The scene is
    // GSAP-pinned (CSS-sticky hold can't sync to that), so this drives the bar off the scene's own
    // scroll extent instead. Desktop only.
    function initPhilBarSync() {
      const bar = document.getElementById('phil-bar');
      const scene = document.querySelector('[data-scene="bitmap-philosophy"]');
      const stage = scene && scene.querySelector('.scene-stage');
      const solaris = bar && bar.querySelector('.solaris');
      if (!bar || !scene || bar.dataset.syncInit === '1') return;
      bar.dataset.syncInit = '1';
      if (!window.matchMedia('(min-width: 768px)').matches) return;
      let raf = 0;
      const update = () => {
        raf = 0;
        // The scene section (incl. its pin-spacer) spans the scene's whole scroll extent. While the
        // scene fills/pins, its bottom sits below the viewport → shift 0 (bar stuck under header).
        // Once its bottom rises above the viewport bottom (scene ready to scroll up), the bar slides
        // up in lockstep so it LEAVES with the scene.
        const rect = scene.getBoundingClientRect();
        const shift = Math.min(0, rect.bottom - window.innerHeight);
        bar.style.transform = 'translateY(' + shift + 'px)';
        // Flip to the ghost variant (transparent + accent) only once the stage bg actually goes
        // DARK; keep the solaris orange bar while the scene is still on the beige world.
        if (stage && solaris) {
          const m = getComputedStyle(stage).backgroundColor.match(/\d+/g);
          if (m) {
            const lum = 0.299 * +m[0] + 0.587 * +m[1] + 0.114 * +m[2];
            solaris.classList.toggle('solaris--ghost', lum < 90);
          }
        }
      };
      const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }

    function initAboutV2() { initRainFreeze(); initPhilBarSync(); }

    document.addEventListener('astro:page-load', initAboutV2);
    if (document.readyState === 'complete') initAboutV2();
    else window.addEventListener('load', initAboutV2);
  </script>
</Layout>
