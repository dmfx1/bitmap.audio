---
/* src/pages/about-v2.astro
 *
 * PROOF OF CONCEPT — v2 redesign of the About page.
 * The original about.astro is left untouched for side-by-side cross-reference.
 *
 * What's different here:
 *  - afternow-style intro sequence (IntroSequence) replaces a landing page.
 *  - Brand wordmark moved OUT of the nav into a persistent CornerMark (top-left),
 *    which scrambles bitmap.audio -> "about us".
 *  - ALL AI photographic imagery removed. The hero's right side + the layer the
 *    blurred sections scroll over is a generative SonicVisual, not a photo.
 *  - Full bleed (Layout treats /about-v2 as full-bleed; edge binary rain gated off).
 *  - Sticky hero + backdrop-blur sub-sections retained.
 *
 * Review tip: append ?intro=1 to replay the intro (otherwise it's once-per-session).
 */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import AboutHeroV2 from '../components/modules/AboutHeroV2.tsx';
import Founders from '../components/modules/Founders.tsx';
import AboutPhilosophy from '../components/modules/AboutPhilosophy.tsx';
import Values from '../components/modules/Values.tsx';
import Clients from '../components/modules/Clients.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="About bitmap.audio | Sonic Branding Agency"
  description="bitmap.audio is a sonic branding and immersive audio agency founded by Dom Storrs-Fox and Nick Granville-Fall. We design sound identities for digital brands."
>
  {/* The entry animation now lives entirely in the nav brand lockup
      (Navigation.tsx): the b is instantiated on load and the wordmark fades in +
      scrambles to the page name IN PLACE — no separate overlay, seamless by
      construction. All timing is in src/config/brandMotion.ts. */}

  {/* Hero: fills the viewport and sticks; blurred sections scroll up over it.
      AboutHeroV2 is flex-1 + justify-end so its text ends at the bottom. */}
  <div class="md:sticky top-0 z-[1] min-h-svh flex flex-col">
    <AboutHeroV2 client:load />
  </div>

  {/* Content: glass panels scroll over the sticky hero.
      Each Section is full bleed (isFullWidth removes the centred max-w-7xl). */}
  <div class="relative z-10">
    <Section id="founders" delay="0.2s" isFullWidth={true} className="!bg-background/50 backdrop-blur-2xl">
      {/* NOTE: Founders still renders founder headshots — real photos, not AI.
          Flagged for a decision on whether "remove all imagery" includes these. */}
      <Founders client:visible />
    </Section>

    <Section id="philosophy" invert delay="0.3s" isFullWidth={true} className="!bg-background/50 backdrop-blur-xl">
      <AboutPhilosophy client:visible />
    </Section>

    <Section id="Values" delay="0.4s" isFullWidth={true} className="!bg-background/50 backdrop-blur-xl" grainBg>
      <Values client:visible />
    </Section>

    {/* THE FULL BLEED CLIENT TERMINAL */}
    <Section
      id="clients"
      delay="0.5s"
      isFullWidth={true}
      noPadding={true}
      hasBorder={true}
      className="!bg-background-blur/50 backdrop-blur-xl pb-8"
    >
      <div class="w-full max-w-7xl mx-auto px-4 md:px-8 lg:px-12 mb-8 pt-8">
        <p class="text-base font-mono tracking-[0.5em] uppercase text-accent">
          [ CLIENT_TERMINAL ]
        </p>
      </div>
      <Clients client:visible />
    </Section>

    <Section id="cta" delay="0.6s" isFullWidth={true} className="!bg-background/50 backdrop-blur-xl" grainBg>
      <CTA
        client:visible
        title="Define your brand's audio identity"
        description="Let's explore how a sonic brand can strengthen your identity and deepen audience connection."
        buttonText="START YOUR SONIC BRAND"
      />
    </Section>
  </div>
</Layout>
