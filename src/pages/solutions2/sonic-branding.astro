---
/* src/pages/solutions2/sonic-branding.astro — TRIAL copy of /solutions/sonic-branding with the "for…" hero (2026-11-12). Delete whichever version loses. */
import Layout from '../../layouts/Layout.astro';
import Solaris from '../../components/Solaris.astro';
import FocusScroll from '../../components/FocusScroll.astro';
import SolutionForHero from '../../components/modules/solutions/SolutionForHero.astro';
import SolutionForHead from '../../components/modules/solutions/SolutionForHead.astro';
import SolutionAnalysis from '../../components/modules/solutions/SolutionAnalysis.astro';
import CtaScene from '../../components/modules/CtaScene.astro';
import SonicWaves from '../../components/modules/SonicWaves.astro';

// Page copy for the shared hero + analysis components.
const hero = {
  title: "Define your brand's\naudio DNA",
  blurb: [
    "Visual identity can only go so far. ",
    "Brands with a unique sonic footprint significantly enhance recognition and recall.",
  ],
  reelSlug: "sonic-branding",
};
const analysis = {
  challenge: {
    heading: "In a world of visual noise, sound cuts through.",
    paragraphs: [
      "Your audience encounters thousands of visual messages daily. But sound operates differently - it bypasses rational filters and connects directly to emotion and memory.",
      "A thoughtfully crafted sonic brand becomes instantly recognisable, consistently memorable, and emotionally resonant across every touchpoint.",
    ],
  },
  approach: {
    heading: "From brand essence to sonic expression.",
    paragraphs: [
      "We begin by understanding your brand's core values and how you want them to communicate. We design for each of them and build them into a collective expression.",
      "The result is a comprehensive asset library that scales from a two-second notification sound to a full musical composition - providing broad utilisation across your branding network.",
    ],
  },
};
---

<Layout
  title="Sonic Branding Services | Audio Identity Design | bitmap.audio"
  description="bitmap.audio creates comprehensive sonic brand systems — audio logos, brand sound guidelines, adaptive audio assets, and hold music for digital-first companies."
>
  <Fragment slot="head">
    <SolutionForHead />
    <meta name="robots" content="noindex" />  {/* TRIAL page */}
    <script is:inline type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Sonic Branding",
      "description": "Comprehensive sonic brand systems including audio logos, brand sound guidelines, adaptive audio assets, notification sounds, and podcast/video intros for digital-first companies.",
      "provider": {
        "@type": "Organization",
        "@id": "https://bitmap.audio/#organization",
        "name": "bitmap.audio"
      },
      "serviceType": "Sonic Branding",
      "areaServed": "Worldwide",
      "url": "https://bitmap.audio/solutions/sonic-branding"
    })}</script>
  </Fragment>
  <SolutionForHero line="how you speak to others." label="Sonic branding" description={hero.blurb.join("")} reelSlug={hero.reelSlug} video="https://stream.mux.com/DJ8AxkwZ9LR3ZOyuZ4TrENraXlkh500FSexKzyTsWWic/1080p.mp4" reelSrc="https://stream.mux.com/DJ8AxkwZ9LR3ZOyuZ4TrENraXlkh500FSexKzyTsWWic/1080p.mp4" />  {/* TRIAL: description = the old hero blurb for now */}

  {/* Each section: bar sticks under the header, content locks in centred below it, then release
      together (same pattern as about-v2 / home). Section titles now ride on the bars. */}
  <div class="relative z-10 theme-oat sol-body sol-gradient" style="--sol-grad: linear-gradient(to right, hsl(48 20% 90%), hsl(44 14% 80%))">
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="The Analysis" /></div>
      <FocusScroll count={1} barOffset id="analysis" class="!bg-background/50 backdrop-blur-xl">
        <SonicWaves page />
        <div class="container-page w-full">
          <SolutionAnalysis {...analysis} />
        </div>
      </FocusScroll>
    </div>

  </div>

  {/* CTA — dark oversized finale (vertical page: shows without pixelating in). */}
  <div class="relative z-10 sol-cta">
    <div class="section-bar-hold cta-mobile-bar"><Solaris text="Get in touch" /></div>
    <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
      <div class="container-page w-full">
        <CtaScene head="Ready to sound<br/>like yourself?" href="/contact" linkLabel="start_your_sonic_brand" pixelate={false} />
      </div>
    </FocusScroll>
  </div>

  {/* CTA is the same dark colour as the footer — drop the Solaris seam beam between them. */}
  <style is:global>
    .solaris:has(+ footer) { display: none; }
  </style>
</Layout>