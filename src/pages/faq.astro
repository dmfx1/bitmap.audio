---
/* src/pages/faq.astro */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import FAQContent from '../components/modules/FAQContent.tsx';
---

<Layout
  title="FAQ | Sonic Branding & Audio Design | bitmap.audio"
  description="Answers to common questions about sonic branding, UI/UX sound design, immersive audio, our process, and how to start a project with bitmap.audio."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How do we start a project?", "acceptedAnswer": { "@type": "Answer", "text": "Every project begins with a 'Sonic Audit'. We map your existing touchpoints and identify opportunities for sonic infrastructure improvements. Once the blueprint is approved, we move to synthesis." } },
        { "@type": "Question", "name": "What is the typical timeline?", "acceptedAnswer": { "@type": "Answer", "text": "A standard sonic branding package typically requires a 4-6 week sprint from audit to delivery." } },
        { "@type": "Question", "name": "What is 'Sonic UI'?", "acceptedAnswer": { "@type": "Answer", "text": "Sonic UI refers to the functional audio cues within a digital interface. It is the sound of a successful transaction, a notification, or a data-upload completion—designed to reduce cognitive load." } },
        { "@type": "Question", "name": "Do you provide spatial audio?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. We engineer immersive assets specifically for Atmos, Binaural, and VR/AR environments using object-based audio mapping." } }
      ]
    })}</script>
  </Fragment>

  {/* Whole page = one section on the plain background (no binary rain — gated off in Layout). */}
  <Section id="faq" className="min-h-svh bg-background/10 backdrop-blur-sm">
    <div class="container-page w-full pt-[calc(var(--header-h)+var(--page-gutter))] pb-24 md:pb-32">
      <header class="mb-16 md:mb-48 md:mt-16">
        <h1 class="heading-hero whitespace-nowrap">
          System <span class="text-accent">[Enquiries]</span>
        </h1>
        <p class="mt-6 text-muted-foreground font-mono text-base leading-relaxed tracking-wide opacity-60">
          Documentation for our process, technical standards, and engagement models.
        </p>
      </header>

      <FAQContent client:visible />
    </div>
  </Section>

  {/* FAQ-only: the header bar sits on a SOLID bg from the start (no scroll-blur fade-in), so the
      nav never overlaps the title before the blur kicks in like it can on other pages. Hard-coded here. */}
  <style is:global>
    #header-bar {
      opacity: 1 !important;
      background: hsl(var(--background)) !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
  </style>
</Layout>
