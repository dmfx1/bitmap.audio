---
/* src/pages/about.astro — ABOUT (rebuilt 2026-11-09)
 *
 * WHY / WHO, not what / how (home does that). One idea per screen, alternating dark + oat beats:
 *   hero (dark) → the problem (oat) → who we are (DARK) → the team (oat) → why "bitmap" (oat)
 *   → what we believe (oat) → different is the point (DARK) → brands we've made sound for (oat)
 *   → let's talk (dark, the rain returns — "reverse the void").
 *
 * Desktop: the scene stage (same as home) — a pinned frame, stacked .scene layers, ONE scrubbed master
 * timeline. Dark beats get a WHITE page bar, oat beats the SOLARIS bar; the bar hides + is recoloured
 * between them (never changes colour while visible). Track length is computed from the timeline.
 * Mobile: scenes unstack into a normal scroll; oat beats get the eased dark→oat buffer, dark beats sit
 * on the binary rain; every section opens with a terminal tag.
 *
 * Pages COMPOSE (see CLAUDE.md): Beat.astro (single-idea scene), Founders.tsx, Beliefs.astro
 * (+ lib/scenes/beliefs.ts), Clients.tsx (the client terminal — unchanged), SoftCta.astro.
 * The previous page is kept, unrouted, at src/pages/_about-v3-old.astro (cleanup list in CLAUDE.md).
 */
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/modules/AboutHero.tsx';
import Founders, { type Founder } from '../components/modules/Founders.tsx';
import Clients from '../components/modules/Clients.tsx';
import Beat from '../components/modules/Beat.astro';
import Beliefs from '../components/modules/Beliefs.astro';
import SoftCta from '../components/modules/SoftCta.astro';
import TermTag from '../components/modules/TermTag.astro';

// ══════════ COPY — ⚠ FILLER (2026-11-09), built from dom's homework answers. DOM TO REWRITE. ══════════
const HERO = {
  title: 'Sound is easy.\nVoice is rare.',
  sub: "We're Dom and Nick. We build sonic identities that sound like you, everywhere you show up.",
  cta: 'BOOK A CALL',
};
const PROBLEM = {
  head: 'Most sonic logos',
  accent: 'are sound effects.',
  sub: "A swoosh to match the animation, then silence. Nothing in the app, the ad or the room that sounds like the brand.\n\nThat isn't an identity. It's a jingle with good timing.",
};
const WHO = {
  head: 'We started as',
  accent: "each other's backup.",
  sub: "Two freelance sound designers, same clients. When one of us was booked up, the job went to the other, because we trusted the ear on the other end. bitmap.audio is that trust, made official.",
  // ⚠ FILLER NUMBERS — confirm before launch.
  stats: [
    { value: '20+', label: 'years in sound between us' },
    { value: '24', label: 'brands we\'ve made sound for' },
    { value: '2', label: 'studios: Manchester + Scarborough' },
  ],
};
const TEAM: Founder[] = [
  {
    name: '[dom.storrs-fox]',
    role: 'Manchester · travel + space',
    focus: 'Surround for film · Dolby Atmos · MPEG-H',
    bio: "I've spent over a decade making sound for advertising and animation, and more recently mixing surround for film. These days I'm deep in Dolby Atmos and MPEG-H, building sound that moves around you.",
    image: { src: '/images/dom-headshot-01.webp', scale: 1.0, position: 'center 45%', vignetteAt: '50% 50%' },
  },
  {
    name: '[nick.granville-fall]',
    role: 'Scarborough · surf + off grid',
    focus: 'Installations · galleries · museums',
    bio: "I've made sound for advertising and for installations in galleries and museums, where people walk through it rather than past it. I'm obsessed with why a sound makes you feel something, and how to make it happen on purpose.",
    image: { src: '/images/nick-headshot-01.webp', scale: 1.0, position: 'center 45%', vignetteAt: '50% 50%' },
  },
];
const NAME = {
  head: 'Why',
  accent: '"bitmap"?',
  sub: 'In computer science, a bitmap maps tiny data points across a grid to build a complete image.\n\nWe do the same with sound: small, deliberate pieces that add up to one voice you recognise anywhere.',
};
const BELIEFS = [
  { title: 'Hairs on the neck', body: "If it doesn't move us, it won't move anyone. We don't mind how a sound gets made, only how it makes you feel." },
  { title: 'Happy accidents', body: 'The best discoveries rarely come from the plan. We leave room for them, then chase them down.' },
  { title: 'Better than fine', body: 'Play it safe and you get "fine". We push past the obvious until it sounds like nobody else.' },
];
const FOR = {
  head: 'Different',
  accent: 'is the point.',
  sub: "Sonic identity is new ground for most brands, so feeling a little nervous is normal. We'll take you somewhere you didn't expect, and keep it unmistakably you.\n\nIf you'd rather not be challenged, we're probably not your team.",
};
const WORK = {
  head: "Brands we've made sound for",
  sub: 'Over our freelance careers, before bitmap.audio. Not bitmap.audio clients (yet).',
};
const CLOSE = {
  head: "Let's make you",
  accent: 'sound like you.',
  sub: "Book a free 30-minute call with Dom and Nick. Bring the brand; we'll bring the questions.",
  label: 'Book a call',
};
const PEOPLE = [{ name: 'Dom', src: '/images/dom-cutout.webp' }, { name: 'Nick', src: '/images/nick-cutout.webp' }];
---
<Layout
  title="About | bitmap.audio"
  description="Meet Dom and Nick: two sound designers building sonic identities that sound like your brand, from the logo to the app to the room."
>
  {/* Persistent bar — page-level FIXED; revealed + relabelled by the stage timeline. */}
  <div id="page-bar" aria-hidden="true">
    <span class="solaris-text" data-page-label></span>
  </div>

  <div id="stage-track">
    <div class="stage-pin" id="hero-sticky">
      <div class="scene" data-scene="hero" style="z-index:0">
        <AboutHero client:load title={HERO.title} sub={HERO.sub} ctaLabel={HERO.cta} />
      </div>
      <div class="stage-fog" data-stage="fog" aria-hidden="true"></div>
      <div class="stage-portal" data-stage="portal" aria-hidden="true"></div>

      {/* 1 · THE PROBLEM — oat */}
      <div class="scene theme-oat oat-fade-mobile" data-scene="problem" data-oat-mobile style="z-index:10">
        <TermTag label="The problem" />
        <div class="scene-body"><Beat head={PROBLEM.head} accent={PROBLEM.accent} sub={PROBLEM.sub} /></div>
      </div>

      {/* 2 · WHO WE ARE — DARK (hero layout) + stats */}
      <div class="scene beat-dark" data-scene="who" style="z-index:15">
        <TermTag label="Who we are" />
        <div class="scene-body"><Beat head={WHO.head} accent={WHO.accent} sub={WHO.sub} stats={WHO.stats} /></div>
      </div>

      {/* 3 · THE TEAM — oat (founder cards) */}
      <div class="scene theme-oat oat-fade-mobile oat-join-below" data-scene="team" data-oat-mobile style="z-index:20">
        <TermTag label="The team" />
        <div class="scene-body container-page">
          <Founders client:visible people={TEAM} />
        </div>
      </div>

      {/* 4 · WHY "BITMAP" — oat */}
      <div class="scene theme-oat oat-fade-mobile oat-join-above oat-join-below" data-scene="name" data-oat-mobile style="z-index:25">
        <TermTag label="Why bitmap" />
        <div class="scene-body"><Beat head={NAME.head} accent={NAME.accent} sub={NAME.sub} /></div>
      </div>

      {/* 5 · WHAT WE BELIEVE — oat (focus columns) */}
      <div class="scene theme-oat oat-fade-mobile oat-join-above beliefs-scene" data-scene="beliefs" data-oat-mobile style="z-index:30">
        <TermTag label="What we believe" />
        <div class="scene-body"><Beliefs items={BELIEFS} /></div>
      </div>

      {/* 6 · DIFFERENT IS THE POINT — DARK */}
      <div class="scene beat-dark" data-scene="for" style="z-index:35">
        <TermTag label="Who we're for" />
        <div class="scene-body"><Beat head={FOR.head} accent={FOR.accent} sub={FOR.sub} /></div>
      </div>

      {/* 7 · BRANDS WE'VE MADE SOUND FOR — oat; the client terminal, unchanged, with honest framing above */}
      <div class="scene theme-oat oat-fade-mobile work-scene" data-scene="work" data-oat-mobile style="z-index:40">
        <TermTag label="Our work" />
        <div class="scene-body">
          <div class="work-wrap">
            <div class="work-head container-page">
              <h2 class="type-title work-head__title">{WORK.head}<span class="text-accent">_</span></h2>
              <p class="type-body work-head__sub">{WORK.sub}</p>
            </div>
            <Clients client:visible heightClass="h-[100svh] md:h-[52vh]" />
          </div>
        </div>
      </div>

      {/* 8 · LET'S TALK — dark tint over the returning rain ("reverse the void"), the soft CTA */}
      <div class="scene close-scene" data-scene="close" style="z-index:45">
        <TermTag label="Let's talk" />
        <div class="scene-body">
          <SoftCta
            head={CLOSE.head}
            accent={CLOSE.accent}
            sub={CLOSE.sub}
            label={CLOSE.label}
            people={PEOPLE}
            peopleNote="You'll talk to us, not a sales team."
          />
        </div>
      </div>
    </div>
  </div>

  <style>
    #stage-track { position: relative; height: 1500vh; } /* fallback only — the stage script sets the real height from the timeline (VH_PER_UNIT). */
    .stage-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
    .scene { position: absolute; top: 0; left: 0; right: 0; height: 100svh; }
    .scene[data-scene="hero"] { display: flex; flex-direction: column; padding-top: var(--header-h); box-sizing: border-box; }
    /* Desktop: non-hero scenes start hidden in CSS (GSAP autoAlpha reveals them) — no first-paint flash,
       and the nav-contrast check doesn't see an oat layer over the hero. */
    @media (min-width: 768px) { .stage-pin > .scene:not([data-scene="hero"]) { visibility: hidden; } }
    .scene-body {
      position: absolute; left: 0; right: 0;
      top: calc(var(--header-h) + var(--solaris-height)); height: calc(100svh - var(--header-h) - var(--solaris-height));
      display: flex; flex-direction: column; justify-content: center;
    }
    .stage-fog { position: absolute; inset: 0; z-index: 5; background-color: hsl(var(--content-background)); opacity: 0; pointer-events: none; }
    .stage-portal {
      position: absolute; inset: 0; z-index: 6; transform-origin: 50% 45%;
      background: radial-gradient(circle at 50% 45%, rgba(255,250,238,0.7) 0%, rgba(255,250,238,0.22) 24%, transparent 58%);
      opacity: 0; pointer-events: none;
    }

    /* Tones */
    .theme-oat.scene { background-color: hsl(var(--content-background)); }
    .beat-dark { background-color: hsl(var(--background)); }
    .close-scene { background-color: hsl(var(--background) / 0.7); }   /* the rain shows through as the void reverses */

    /* Work — framing line + the terminal, centred as one block */
    .work-wrap { display: flex; flex-direction: column; gap: clamp(1rem, 3vh, 2rem); width: 100%; }
    .work-head { display: flex; flex-direction: column; gap: 0.5rem; }
    .work-head__title { margin: 0; color: hsl(var(--foreground)); }
    .work-head__sub { margin: 0; color: hsl(var(--foreground) / 0.7); font-family: var(--font-mono); }
    .work-scene :global(astro-island) { display: block; padding-inline: clamp(1rem, 6vw, 6rem); }

    #page-bar {
      position: fixed; top: var(--header-h); left: 0; right: 0; z-index: 40;
      height: var(--solaris-height);
      background: linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      box-shadow: var(--solaris-glow);
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
      clip-path: inset(0 0 100% 0);
      transition: background 0.45s ease, box-shadow 0.45s ease;
    }
    #page-bar [data-page-label] { opacity: 0; white-space: nowrap; text-align: center; transition: color 0.45s ease; }

    /* ── MOBILE: unstack into a normal scroll. Oat beats: .oat-fade-mobile (eased buffer, global.css);
       dark beats: transparent on the binary rain, light text. Terminal tags open every section. ── */
    @media (max-width: 767px) {
      #stage-track { height: auto !important; }
      .stage-pin { position: static; height: auto; overflow: visible; }
      .scene { position: relative; inset: auto; height: auto; margin-bottom: 0; padding-top: 0; visibility: visible !important; opacity: 1 !important; }
      .scene[data-scene="hero"] { min-height: 100svh; }
      .stage-fog, .stage-portal, #page-bar { display: none; }
      .scene-body { position: static; top: auto; height: auto; padding-block: 3rem; display: flex; flex-direction: column; justify-content: center; }
      .beat-dark, .close-scene { background-color: transparent; }
      .scene.theme-oat { --foreground: var(--content-foreground); }
      /* Team: cards run full-bleed */
      .scene[data-scene="team"] .scene-body { padding-inline: 0; padding-block: 0; }
      /* Work: the terminal fills the width */
      .work-scene .scene-body { padding-block: 0; }
      .work-scene :global(astro-island) { padding-inline: 0; }
      .work-head { padding-bottom: 1.5rem; }
    }
  </style>

  <style is:global>
    /* Founders: the React island sits inside <astro-island>, so target by class. Fill the scene body. */
    #stage-track [data-scene="team"] .grid { height: 100%; }
    #stage-track [data-scene="team"] .grid > div { min-height: 0 !important; }
    @media (max-width: 767px) { #stage-track [data-scene="team"] .grid { height: auto; } }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { createStageTimeline, createPageBar, stageLabels, prepareVoid, enterTheVoid, pushInBar, type BarCfg } from '../lib/stage';
    import { initBeliefsFocus } from '../lib/scenes/beliefs';
    gsap.registerPlugin(ScrollTrigger);

    function initStage() {
      const track = document.getElementById('stage-track');
      const pin = track?.querySelector<HTMLElement>('.stage-pin');
      if (!track || !pin || track.dataset.init === '1') return;
      track.dataset.init = '1';
      if (!window.matchMedia('(min-width: 768px)').matches) return; // desktop only

      const fog = pin.querySelector<HTMLElement>('[data-stage="fog"]')!;
      const portal = pin.querySelector<HTMLElement>('[data-stage="portal"]')!;
      const gridBg = document.getElementById('grid-bg');
      const bar = document.getElementById('page-bar')!;
      const pageBar = createPageBar(bar);
      const q = (id: string) => pin.querySelector<HTMLElement>(`.scene[data-scene="${id}"]`)!;

      // ── SCENE ORDER — tone decides the bar colour (oat → solaris, dark → white). hold = scroll units on it. ──
      const WHITE = { bg: '#ffffff', text: '#141414', glow: '0 0 24px rgba(255,255,255,0.35)' };
      type Beat = { el: HTMLElement; tone: 'oat' | 'dark'; cfg: BarCfg; hold: number };
      const beat = (id: string, tone: 'oat' | 'dark', name: string, hold: number): Beat =>
        ({ el: q(id), tone, cfg: tone === 'dark' ? { name, ...WHITE } : { name }, hold });
      const BEATS: Beat[] = [
        beat('problem', 'oat',  'The Problem',     0.9),
        beat('who',     'dark', 'Who We Are',      1.1),
        beat('team',    'oat',  'The Team',        1.2),
        beat('name',    'oat',  'Why bitmap',      0.9),
        beat('beliefs', 'oat',  'What We Believe', 1.4),
        beat('for',     'dark', "Who We're For",   1.0),
        beat('work',    'oat',  'Our Work',        1.4),
        beat('close',   'dark', "Let's Talk",      1.0),
      ];
      // ── TIMING KNOBS (timeline units). The track height follows the timeline (VH_PER_UNIT). ──
      const T = { heroHold: 0.8, fogStart: 0.8, fogDur: 1.0, portalStart: 0.5, voidScale: 3.0, barPush: 1.72, crossDur: 0.9 };
      const OV = T.crossDur * 0.6;      // incoming starts once the outgoing is ~60% gone
      const BAR_OUT = 0.3;              // bar fade out / back in around a dark↔oat switch
      const VH_PER_UNIT = 95;           // scroll per timeline unit (home ≈ 106). Lower = faster page.

      prepareVoid(fog, portal);
      BEATS.forEach((b) => gsap.set(b.el, { autoAlpha: 0 }));

      const tl = createStageTimeline(track);
      const { boundary, atDir, crossLabel } = stageLabels(tl, pageBar, T.crossDur);
      const dir = () => (tl.scrollTrigger ? tl.scrollTrigger.direction : 1);
      const SOLARIS_BG = 'linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%)';
      const paint = (c: BarCfg) => { bar.style.background = c.bg ?? SOLARIS_BG; bar.style.boxShadow = c.glow ?? 'var(--solaris-glow)'; };

      // HERO → ENTER THE VOID → the first oat beat fades in through the fog; the bar pushes down.
      enterTheVoid(tl, { fog, portal, gridBg }, T);
      tl.to(BEATS[0].el, { autoAlpha: 1, ease: 'power2.out', duration: 0.45 }, T.fogStart + T.fogDur);
      pushInBar(tl, bar, T.barPush);
      boundary(1.91, BEATS[0].cfg, null);
      tl.to({}, { duration: BEATS[0].hold });

      // Each next beat: a cross-fade. Same tone → a plain label swap. Tone change → the bar hides, is
      // recoloured while hidden, and returns with the new label (both scroll directions).
      for (let i = 1; i < BEATS.length; i++) {
        const prev = BEATS[i - 1], next = BEATS[i];
        const L = `b${i}`;
        tl.addLabel(L, '>');
        tl.to(prev.el, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, L)
          .to(next.el, { autoAlpha: 1, ease: 'none', duration: T.crossDur }, `${L}+=${OV}`);
        if (prev.tone === next.tone) {
          crossLabel(L, next.cfg, prev.cfg);
        } else {
          tl.to(bar, { autoAlpha: 0, ease: 'none', duration: BAR_OUT }, L)
            .to(bar, { autoAlpha: 1, ease: 'none', duration: BAR_OUT }, `${L}+=${OV + BAR_OUT}`);
          atDir(L, 1, null);
          tl.call(() => paint(dir() === 1 ? next.cfg : prev.cfg), [], `${L}+=${BAR_OUT}`);
          atDir(`${L}+=${OV + BAR_OUT}`, 1, next.cfg);
          atDir(`${L}+=${OV + BAR_OUT}`, -1, null);
          atDir(`${L}+=${BAR_OUT * 0.8}`, -1, prev.cfg);
        }
        // REVERSE THE VOID on the close: the oat fog lifts and the rain zooms back out behind the tint.
        if (next.el.dataset.scene === 'close') {
          tl.to(fog, { opacity: 0, ease: 'none', duration: T.crossDur }, L);
          if (gridBg) tl.to(gridBg, { scale: 1, ease: 'power2.out', duration: T.crossDur + OV }, L);
        }
        tl.to({}, { duration: next.hold });
      }

      // The bar collapses back up into the header, then the stage releases into the footer.
      tl.to(bar, { clipPath: 'inset(0 0 100% 0)', opacity: 0.35, ease: 'steps(6)', duration: 0.3 });
      tl.to({}, { duration: 0.4 });

      // Track length follows the timeline (scroll distance = track height − one viewport).
      track.style.height = `${Math.ceil(tl.duration() * VH_PER_UNIT + 100)}vh`;

      initBeliefsFocus(q('beliefs'));

      ScrollTrigger.refresh();
      const fonts = (document as any).fonts;
      if (fonts?.ready) fonts.ready.then(() => ScrollTrigger.refresh());
    }

    document.addEventListener('astro:page-load', initStage);
    if (document.readyState === 'complete') initStage();
    else window.addEventListener('load', initStage);
  </script>

  <script>
    // MOBILE-only: reveal each unstacked scene as it enters (desktop uses the GSAP stage).
    import { initMobileSceneReveal } from '../lib/pixel-veil';
    document.addEventListener('astro:page-load', initMobileSceneReveal);
    if (document.readyState === 'complete') initMobileSceneReveal();
    else window.addEventListener('load', initMobileSceneReveal);
  </script>
</Layout>
