---
/* src/pages/about.astro */
import { getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import AboutIntro from '../components/modules/AboutIntro.tsx';
import Founders from '../components/modules/Founders.tsx';
import AboutPhilosophy from '../components/modules/AboutPhilosophy.tsx';
import Values from '../components/modules/Values.tsx';
import Clients from '../components/modules/Clients.tsx';
import CTA from '../components/modules/CTA.tsx';
import heroAboutTwoMinds from '../assets/images/hero-about-two-minds-03.png';
import philosophyBg from '../assets/images/about-bitmap-philosophy-bg-01.png';

const heroImage = await getImage({
  src: heroAboutTwoMinds,
  format: 'webp',
  width: 1200,
  quality: 85,
});

const philosophyBgImage = await getImage({
  src: philosophyBg,
  format: 'webp',
  width: 1200,
  quality: 80,
});
---

<Layout
  title="About bitmap.audio | Sonic Branding Agency"
  description="bitmap.audio is a sonic branding and immersive audio agency founded by Dom Storrs-Fox and Nick Granville-Fall. We design sound identities for digital brands."
>
  {/* Hero: sticks at top of container, content scrolls over it */}
  <div class="md:sticky top-12 md:top-0 z-[1] min-h-svh md:min-h-0 md:h-[90vh]">
    <div class="pt-20 pb-8">
      <AboutIntro client:load imageSrc={heroImage.src} />
    </div>
  </div>

  {/* Content: scrolls over the sticky hero */}
  <div class="relative z-10">
    <Section id="founders" delay="0.2s" className="!bg-background/50 backdrop-blur-xl">
      <Founders client:visible />
    </Section>

    <Section id="philosophy" invert delay="0.3s" className="!bg-background/50 backdrop-blur-xl" bgSrc={philosophyBgImage.src}>
      <AboutPhilosophy client:visible />
    </Section>

    <Section id="Values" delay="0.4s" className="!bg-background/50 backdrop-blur-xl">
      <Values client:visible />
    </Section>

    {/* THE FULL BLEED BINARY WALL */}
    <Section 
      id="clients" 
      delay="0.5s" 
      isFullWidth={true} 
      noPadding={true} 
      hasBorder={true}
      className="!bg-background-blur/50 backdrop-blur-xl pb-8"
    >
      {/* 1. Header: Added pt-16 md:pt-32 to give it breathing room at the top */}
      <div class="w-full max-w-7xl mx-auto px-4 md:px-8 lg:px-12 mb-8 pt-8">
        <p class="text-base font-mono tracking-[0.5em] uppercase text-accent">
          [ CLIENT_TERMINAL ]
        </p>
      </div>
      
      {/* 2. The Grid: Spans 100vw and sits totally flush at the bottom */}
      <Clients client:visible />
    </Section>

    <Section id="cta" delay="0.6s" className="!bg-background/50 backdrop-blur-xl">
      <CTA
        client:visible
        title="Define your brand's audio identity"
        description="Let's explore how a sonic brand can strengthen your identity and deepen audience connection."
        buttonText="START YOUR SONIC BRAND"
      />
    </Section>
  </div>
</Layout>
