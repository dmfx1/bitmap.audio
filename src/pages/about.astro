---
/* src/pages/about.astro — ABOUT (rebuilt 2026-11-09)
 *
 * WHY / WHO, not what / how (home does that). One idea per screen, alternating dark + oat beats:
 *   SPLIT HERO ("Two minds, / one voice.") → curtain → who we are (oat) → the problem (DARK)
 *   → why "bitmap" (DARK) → the team (oat) → what we believe (oat) → who we're for (DARK)
 *   → brands we've made sound for (oat) → let's talk (dark, the rain returns — "reverse the void").
 *
 * Desktop: the scene stage (same as home) — a pinned frame, stacked .scene layers, ONE scrubbed master
 * timeline. Dark beats get a WHITE page bar, oat beats the SOLARIS bar; the bar hides + is recoloured
 * between them (never changes colour while visible). Track length is computed from the timeline.
 * Mobile: scenes unstack into a normal scroll; oat beats get the eased dark→oat buffer, dark beats sit
 * on the binary rain; every section opens with a terminal tag.
 *
 * Pages COMPOSE (see CLAUDE.md): Beat.astro (single-idea scene), Founders.tsx, Beliefs.astro
 * (+ lib/scenes/beliefs.ts), Clients.tsx (the client terminal — unchanged), SoftCta.astro.
 * The previous page is kept, unrouted, at src/pages/_about-v3-old.astro (cleanup list in CLAUDE.md).
 */
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/modules/AboutHero.tsx';   // previous single hero — kept (unused) until sign-off
import AboutSplitHero from '../components/modules/AboutSplitHero.tsx';
import Founders, { type Founder } from '../components/modules/Founders.tsx';
import Clients from '../components/modules/Clients.tsx';
import Beat from '../components/modules/Beat.astro';
import Beliefs from '../components/modules/Beliefs.astro';
import SoftCta from '../components/modules/SoftCta.astro';
import BitMapSplit from '../components/modules/BitMapSplit.astro';
import FounderSplit, { type Person } from '../components/modules/FounderSplit.astro';
import TermTag from '../components/modules/TermTag.astro';
import Rain from '../components/Rain.astro';

// ══════════ COPY — ⚠ FILLER (2026-11-09), built from dom's homework answers. DOM TO REWRITE. ══════════
// SPLIT HERO — left half dark (Dom), right half oat (Nick); the title runs across the seam.
const HERO = {
  // Titles only (dom, 22:32). Optional per side: name / meta; optional ctaLabel on the component.
  left:  { title: 'Two minds,' },
  right: { title: 'one voice.' },
};
const WHO = {
  head: 'Moving in',
  accent: "the same orbit.",
  // ⚠ DRAFT sub (Claude's tightening of dom's rough, 2026-11-10) — dom to approve / rewrite
  sub: "What started as two freelancers in the same circle of clients turned into a partnership. When the work got heavy, we\'d pass it across, trusting the ear on the other end. After years of making sound for some of the world\'s biggest brands, it felt right to build something of our own.",
  summary: 'bitmap.audio is that trust, made official.',   // the payoff line (.copy-summary)
  // ⚠ FILLER NUMBERS — confirm before launch.
  stats: [
    { value: '20+', label: 'years in sound between us' },
    { value: '40+', label: 'brands we\'ve made sound for' },
    { value: '2', label: 'studios: Manchester + Scarborough' },
  ],
};
// (previous single-hero filler: 'Sound is easy. / Voice is rare.')
const PROBLEM = {
  head: 'Sound as an',
  accent: 'afterthought.',
  sub: "It\'s the most common mistake we come across. Sounds only added to a logo once the animation\'s finished. App sounds pulled from a library or prompt. Installations where sound fills the gaps, when it could lift the whole experience into a new dimension. Anyone can make a sound in seconds; not everyone can plan an identity. The earlier we\'re in the room, the more it pays off.",
  summary: 'We don\'t start with the sound, we start with what you want it to say.'
};

// WHY "BITMAP" — the name split in two (copy LOCKED 2026-11-10). Old version kept below for reference.
const NAME = {
  left:  { title: 'bit',  body: "The parts of the sum. The bits that make you whole. Every piece a detail, and all of them considered.", payoff: 'Small parts.' },
  right: { title: 'map', body: 'Where we bring all those bits together: one sonic framework across your branding, product or space.', payoff: 'One whole.' },
};

// THE TEAM on the bit|map split (2026-11-10). QUOTES ARE PLACEHOLDERS — Dom + Nick write their own.
const FOUNDERS: { left: Person; right: Person } = {
  left: {
    name: '[dom.storrs-fox]', meta: 'Manchester · travel + space',
    quote: "I'm obsessed by the way sound can totally transform any experience. It can dictate how you feel about it and the possibilities are endless.",
    posterPhoto: '/images/dom-headshot-clean.webp',   // full headshot (background kept) behind the poster — ✦ mark removed
    quoteSr: "I'm obsessed by the way sound can transform any experience. The possibilities are endless.",   // what screen readers hear (the poster without its punctuation)
    quoteLines: ['I\'m obsessed by the', 'way sound can', 'transform', 'any experience. The', 'possibilities are', 'endless.'],   // POSTER trial — dom's line distilled (11 words)
    focus: 'Dolby Atmos · surround for film · MPEG-H', photo: '/images/dom-cutout-lg.webp',
  },
  right: {
    name: '[nick.granville-fall]', meta: 'Scarborough · surf + off grid',
    quote: "The craft and the journey from starting with nothing to full blown immersive experiences is what drives me. I love the challenge of a blank canvas.",
    posterPhoto: '/images/nick-headshot-01.webp',
    quoteLines: ["Starting with no-", 'thing and creating', 'something', 'new. I love the', 'challenge of', 'a blank canvas.'],   // POSTER trial — placeholder
    focus: 'Installations · galleries · museums', photo: '/images/nick-cutout-lg.webp',
  },
};

const BELIEFS = [
  { title: 'Hairs on the neck', body: "If it doesn't move us, it won't move anyone. We don't mind how a sound gets made, only how it makes you feel." },
  { title: 'Happy accidents', body: 'The best discoveries rarely come from the plan. We leave room for them, then chase them down.' },
  { title: 'Better than fine', body: 'Play it safe and you get "fine". We push past the obvious until it sounds like nobody else.' },
];

const FOR = {
  head: 'Different',
  accent: 'is the point.',
  sub: "Sonic identity is new ground for most brands, so feeling a little nervous is normal. We'll take you somewhere you didn't expect, and keep it unmistakably you.\n\nIf you'd rather not be challenged, we're probably not your team.",
};

const WORK = {
  head: "Brands we've made sound for",
  sub: 'Over our freelance careers, before bitmap.audio. Not bitmap.audio clients (yet).',
};
const CLOSE = {
  head: "Let's make you",
  accent: 'sound like you.',
  sub: "Book a free 30-minute call with Dom and Nick. Bring the brand; we'll bring the questions.",
  label: 'Book a call',
};
const PEOPLE = [{ name: 'Dom', src: '/images/dom-cutout.webp' }, { name: 'Nick', src: '/images/nick-cutout.webp' }];
---
<Layout
  title="About | bitmap.audio"
  description="Meet Dom and Nick: two sound designers building sonic identities that sound like your brand, from the logo to the app to the room."
>
  {/* Persistent bar — page-level FIXED; revealed + relabelled by the stage timeline. */}
  <div id="page-bar" aria-hidden="true">
    <span class="solaris-text" data-page-label></span>
  </div>

  <div id="stage-track" data-rain-all>{/* rain throughout — opt a scene out with class="no-rain" */}
    <div class="stage-pin" id="hero-sticky">
      <div class="scene no-rain" data-scene="hero" data-header-clear style="z-index:0">{/* split hero has its own two rains */}
        {/* Split backgrounds + seam fill the WHOLE scene (under the header too); the hero copy sits on top. */}
        <div class="split-bg" aria-hidden="true">
          <div class="split-bg__dark"></div>
          <div class="split-bg__oat"><Rain tone="oat" /></div>
          <div class="split-bg__seam" data-split-seam></div>
        </div>
        <AboutSplitHero client:load left={HERO.left} right={HERO.right} />
        {/* The exit WIPE: the seam splits into two bars that sweep out left + right, oat behind them. */}
        <div class="split-wipe split-wipe--l" data-split-wipe="l" aria-hidden="true"></div>
        <div class="split-wipe split-wipe--r" data-split-wipe="r" aria-hidden="true"></div>
      </div>
      <div class="stage-fog theme-oat" data-stage="fog" aria-hidden="true"></div>{/* .theme-oat: once it is IN, the header reads it as oat (see timeline) */}
      <div class="stage-portal" data-stage="portal" aria-hidden="true"></div>

      {/* ORDER (2026-11-10): the hero's "two minds" is paid off FIRST (who we are), then the problem they kept
          seeing, then the answer (bitmap). Tones: oat → dark → dark → oat → oat → dark → oat → dark. */}

      {/* 1 · WHO WE ARE — oat (revealed by the hero's curtain) + stats */}
      <div class="scene theme-oat oat-fade-mobile oat-join-above" data-scene="who" data-header-clear data-oat-mobile style="z-index:10">
        <TermTag label="Who we are" />
        <div class="scene-body"><Beat head={WHO.head} accent={WHO.accent} sub={WHO.sub} summary={WHO.summary} stats={WHO.stats} pinStats /></div>
      </div>

      {/* 2 · THE PROBLEM — DARK */}
      <div class="scene beat-dark" data-scene="problem" style="z-index:15">
        <TermTag label="The problem" />
        <div class="scene-body"><Beat head={PROBLEM.head} accent={PROBLEM.accent} sub={PROBLEM.sub} summary={PROBLEM.summary} ctaLabel="Book a call" /></div>
      </div>

      {/* 3 · WHY "BITMAP" — the name SPLIT: bit (dark) | map. (oat). No solaris bar; the split runs under the header. */}
      <div class="scene beat-dark" data-scene="name" data-no-bar style="z-index:20">
        <div class="split-bg" aria-hidden="true">
          <div class="split-bg__dark"></div>
          <div class="split-bg__oat"><Rain tone="oat" /></div>
          <div class="split-bg__seam"></div>
        </div>
        <TermTag label="Why bitmap" />
        <div class="scene-body"><BitMapSplit left={NAME.left} right={NAME.right} /></div>
      </div>

      {/* 4 · THE TEAM — oat (founder cards) */}
      {/* data-same-bg: shares Why bitmap's split — only the content swaps (timeline), the halves stay put */}
      <div class="scene beat-dark no-rain" data-scene="team" data-no-bar data-same-bg style="z-index:25">{/* no-rain: the founders sit on their photos, no binary rain */}
        <div class="split-bg" aria-hidden="true">
          <div class="split-bg__dark"></div>
          <div class="split-bg__oat"></div>
          <div class="split-bg__seam"></div>
        </div>
        <TermTag label="The team" />
        <div class="scene-body"><FounderSplit left={FOUNDERS.left} right={FOUNDERS.right} poster /></div>
        {/* <Founders client:visible people={TEAM} /> — old cards, unused */}
      </div>

      {/* 5 · WHAT WE BELIEVE — oat (focus columns) */}
      <div class="scene theme-oat oat-fade-mobile oat-join-above beliefs-scene" data-scene="beliefs" data-oat-mobile style="z-index:30">
        <TermTag label="What we believe" />
        <div class="scene-body"><Beliefs items={BELIEFS} /></div>
      </div>

      {/* 6 · DIFFERENT IS THE POINT — DARK */}
      <div class="scene beat-dark" data-scene="for" style="z-index:35">
        <TermTag label="Who we're for" />
        <div class="scene-body"><Beat head={FOR.head} accent={FOR.accent} sub={FOR.sub} /></div>
      </div>

      {/* 7 · BRANDS WE'VE MADE SOUND FOR — oat; the client terminal, unchanged, with honest framing above */}
      <div class="scene theme-oat oat-fade-mobile work-scene" data-scene="work" data-oat-mobile style="z-index:40">
        <TermTag label="Our work" />
        <div class="scene-body">
          <div class="work-wrap">
            <div class="work-head container-page">
              <h2 class="type-title work-head__title">{WORK.head}<span class="text-accent">_</span></h2>
              <p class="type-body work-head__sub">{WORK.sub}</p>
            </div>
            <Clients client:visible heightClass="h-[100svh] md:h-[52vh]" />
          </div>
        </div>
      </div>

      {/* 8 · LET'S TALK — dark tint over the returning rain ("reverse the void"), the soft CTA */}
      <div class="scene close-scene no-rain" data-scene="close" style="z-index:45">{/* the REAL rain shows through its tint */}
        <TermTag label="Let's talk" />
        <div class="scene-body">
          <SoftCta
            head={CLOSE.head}
            accent={CLOSE.accent}
            sub={CLOSE.sub}
            label={CLOSE.label}
            people={PEOPLE}
            peopleNote="You'll talk to us, not a sales team."
          />
        </div>
      </div>
    </div>
  </div>

  <style>
    #stage-track { position: relative; height: 1500vh; } /* fallback only — the stage script sets the real height from the timeline (VH_PER_UNIT). */
    .stage-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
    .scene { position: absolute; top: 0; left: 0; right: 0; height: 100svh; }
    .scene[data-scene="hero"] { display: flex; flex-direction: column; padding-top: var(--header-h); box-sizing: border-box; }
    /* Desktop: non-hero scenes start hidden in CSS (GSAP autoAlpha reveals them) — no first-paint flash,
       and the nav-contrast check doesn't see an oat layer over the hero. */
    @media (min-width: 768px) { .stage-pin > .scene:not([data-scene="hero"]) { visibility: hidden; } }
    .scene-body {
      position: absolute; left: 0; right: 0;
      top: calc(var(--header-h) + var(--solaris-height)); height: calc(100svh - var(--header-h) - var(--solaris-height));
      display: flex; flex-direction: column; justify-content: center;
    }
    .stage-fog { position: absolute; inset: 0; z-index: 5; background-color: hsl(var(--content-background)); opacity: 0; pointer-events: none; }
    .stage-portal {
      position: absolute; inset: 0; z-index: 6; transform-origin: 50% 45%;
      background: radial-gradient(circle at 50% 45%, rgba(255,250,238,0.7) 0%, rgba(255,250,238,0.22) 24%, transparent 58%);
      opacity: 0; pointer-events: none;
    }

    /* ── SPLIT HERO — two halves + a solaris seam. Backgrounds here; copy layout below (global, the copy
       is a React island). The dark half is transparent so the global white rain (#grid-bg) shows; the oat
       half carries its own DARK rain (the same pattern, inverted). ── */
    /* The split titles centre on the WHOLE screen (the header is ignored — it floats over, clear). */
    .scene[data-scene="hero"] { isolation: isolate; padding-top: 0; }
    .split-bg { position: absolute; inset: 0; z-index: -1; display: grid; grid-template-columns: 1fr 1fr; pointer-events: none; }
    .split-bg__dark { background: transparent; }
    .split-bg__oat { position: relative; background-color: hsl(var(--content-background)); overflow: hidden; }
    .split-bg__oat { isolation: isolate; --rain-o: 0.55; }   /* the shared oat rain (Rain.astro); strength here */
    .split-bg__seam {
      position: absolute; top: 0; bottom: 0; left: 50%; width: var(--split-seam-w, 22px); transform: translateX(-50%);   /* seam thickness */
      transform-origin: 50% 50%;
      background: linear-gradient(to bottom, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      box-shadow: var(--solaris-glow);
    }

    .split-wipe {
      position: absolute; top: 0; bottom: 0; width: 0; z-index: 3; pointer-events: none;
      background: transparent;   /* just the travelling solaris EDGE — the section behind is revealed by its clip */
      visibility: hidden;
    }
    /* Each travelling edge is LITERALLY half the seam: same solaris gradient, half its width, hard edges, no glow
       (dom, 2026-11-10 — the old soft glow read as smooth, not bitmappy). Flicker = opacity via --edge-o. */
    .split-wipe::before {
      content: ''; position: absolute; top: 0; bottom: 0; width: calc(var(--split-seam-w, 22px) / 2);
      background: linear-gradient(to bottom, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      opacity: var(--edge-o, 1);
    }
    .split-wipe--l { right: 50%; }
    .split-wipe--l::before { left: calc(var(--split-seam-w, 22px) / -2); }   /* rides just outside the revealed edge; at width 0 the two halves = the seam */
    .split-wipe--r { left: 50%; }
    .split-wipe--r::before { right: calc(var(--split-seam-w, 22px) / -2); }

    /* Tones */
    .theme-oat.scene { background-color: hsl(var(--content-background)); }
    .beat-dark { background-color: hsl(var(--background)); }
    .close-scene { background-color: hsl(var(--background) / 0.7); }   /* the rain shows through as the void reverses */

    /* Work — framing line + the terminal, centred as one block */
    .work-wrap { display: flex; flex-direction: column; gap: clamp(1rem, 3vh, 2rem); width: 100%; }
    .work-head { display: flex; flex-direction: column; gap: 0.5rem; }
    .work-head__title { margin: 0; color: hsl(var(--foreground)); }
    .work-head__sub { margin: 0; color: hsl(var(--foreground) / 0.7); font-family: var(--font-mono); }
    .work-scene :global(astro-island) { display: block; padding-inline: clamp(1rem, 6vw, 6rem); }

    #page-bar {
      position: fixed; top: var(--header-h); left: 0; right: 0; z-index: 40;
      height: var(--solaris-height);
      background: linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      box-shadow: var(--solaris-glow);
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
      clip-path: inset(0 0 100% 0);
      transition: background 0.45s ease, box-shadow 0.45s ease;
    }
    #page-bar [data-page-label] { opacity: 0; white-space: nowrap; text-align: center; transition: color 0.45s ease; }

    /* ── MOBILE: unstack into a normal scroll. Oat beats: .oat-fade-mobile (eased buffer, global.css);
       dark beats: transparent on the binary rain, light text. Terminal tags open every section. ── */
    @media (max-width: 767px) {
      #stage-track { height: auto !important; }
      .stage-pin { position: static; height: auto; overflow: visible; }
      .scene { position: relative; inset: auto; height: auto; margin-bottom: 0; padding-top: 0; visibility: visible !important; opacity: 1 !important; }
      .scene[data-scene="hero"] { min-height: 100svh; }
      /* split hero stacks: the halves carry their own backgrounds on mobile (heights follow the copy) */
      .split-bg { display: none; }
      .stage-fog, .stage-portal, #page-bar { display: none; }
      .scene-body { position: static; top: auto; height: auto; padding-block: 3rem; display: flex; flex-direction: column; justify-content: center; }
      .beat-dark, .close-scene { background-color: transparent; }
      .scene.theme-oat { --foreground: var(--content-foreground); }
      /* Team: cards run full-bleed */
      .scene[data-scene="team"] .scene-body { padding-inline: 0; padding-block: 0; }
      /* Work: the terminal fills the width */
      .work-scene .scene-body { padding-block: 0; }
      .work-scene :global(astro-island) { padding-inline: 0; }
      .work-head { padding-bottom: 1.5rem; }
    }
  </style>

  <style is:global>
    /* SPLIT HERO copy (AboutSplitHero.tsx — a React island, so global). Same 50/50 grid as .split-bg. */
    .split-hero { display: grid; grid-template-columns: 1fr 1fr; }
    /* Everything CENTRED within its own half. */
    .split-hero__half { display: grid; grid-template-rows: 1fr 1fr; justify-items: center; text-align: center; padding: var(--page-gutter) var(--page-gutter-x); min-height: 0; }
    .split-hero__title-wrap { align-self: end; justify-self: center; }
    .split-hero__title { margin: 0 0 clamp(1rem, 4vh, 2.5rem); min-height: 0; white-space: nowrap; font-size: min(var(--type-display), 5vw); }   /* each half's line stays on ONE line */
    .split-hero__title--left > span.animate-pulse { display: none; }   /* one cursor only — at the end of the right half */
    /* titles only: one centred line per half */
    .split-hero--titles .split-hero__half { grid-template-rows: 1fr; align-items: center; }
    .split-hero--titles .split-hero__title-wrap { align-self: center; }
    .split-hero--titles .split-hero__title { margin: 0; }
    .split-hero__lower { display: flex; flex-direction: column; justify-content: flex-start; align-items: center; }
    .split-hero__name { margin: 0 0 0.35rem; }
    .split-hero__meta { margin: 0; }
    @media (max-width: 767px) {
      .split-hero { grid-template-columns: 1fr; }
      .split-hero__half { grid-template-rows: auto auto; align-content: center; gap: 1.5rem; min-height: 50svh; }
      .split-hero__half { min-height: auto; padding-block: 2.5rem; }

      .split-hero__half--oat {
        position: relative; padding-left: var(--page-gutter-x);
        background-color: hsl(var(--content-background));
        border-top: 8px solid transparent;
        border-image: linear-gradient(90deg, var(--solaris-from), var(--solaris-mid) 55%, var(--solaris-to)) 1;
      }
      .split-hero__half--oat { isolation: isolate; --rain-o: 0.45; }
      .split-hero__title { margin: 0; font-size: var(--type-display); white-space: normal; }
      .split-hero--titles .split-hero__half { min-height: 50svh; }
    }
    /* Founders: the React island sits inside <astro-island>, so target by class. Fill the scene body. */
    #stage-track [data-scene="team"] .grid { height: 100%; }
    #stage-track [data-scene="team"] .grid > div { min-height: 0 !important; }
    @media (max-width: 767px) { #stage-track [data-scene="team"] .grid { height: auto; } }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { createStageTimeline, createPageBar, stageLabels, prepareVoid, enterTheVoid, pushInBar, type BarCfg } from '../lib/stage';
    import { initBeliefsFocus } from '../lib/scenes/beliefs';
    import { buildSplitHeroEntrance } from '../lib/scenes/split-hero';
    gsap.registerPlugin(ScrollTrigger);

    function initStage() {
      const track = document.getElementById('stage-track');
      const pin = track?.querySelector<HTMLElement>('.stage-pin');
      if (!track || !pin || track.dataset.init === '1') return;
      track.dataset.init = '1';
      if (!window.matchMedia('(min-width: 768px)').matches) return; // desktop only

      const fog = pin.querySelector<HTMLElement>('[data-stage="fog"]')!;
      const portal = pin.querySelector<HTMLElement>('[data-stage="portal"]')!;
      const gridBg = document.getElementById('grid-bg');
      const bar = document.getElementById('page-bar')!;
      const pageBar = createPageBar(bar);
      const q = (id: string) => pin.querySelector<HTMLElement>(`.scene[data-scene="${id}"]`)!;

      // ── SCENE ORDER — tone decides the bar colour (oat → solaris, dark → white). hold = scroll units on it. ──
      const WHITE = { bg: '#ffffff', text: '#141414', glow: '0 0 24px rgba(255,255,255,0.35)' };
      type Beat = { el: HTMLElement; tone: 'oat' | 'dark'; cfg: BarCfg; hold: number };
      const beat = (id: string, tone: 'oat' | 'dark', name: string, hold: number): Beat =>
        ({ el: q(id), tone, cfg: tone === 'dark' ? { name, ...WHITE } : { name }, hold });
      const BEATS: Beat[] = [
        beat('who',     'oat',  'Who We Are',      1.1),
        beat('problem', 'dark', 'The Problem',     0.9),
        beat('name',    'dark', 'Why bitmap',      0.9),
        beat('team',    'dark', 'The Team',        1.2),
        beat('beliefs', 'oat',  'What We Believe', 1.4),
        beat('for',     'dark', "Who We're For",   1.0),
        beat('work',    'oat',  'Our Work',        1.4),
        beat('close',   'dark', "Let's Talk",      1.0),
      ];
      // ── TIMING KNOBS (timeline units). The track height follows the timeline (VH_PER_UNIT). ──
      // About's entrance is the split-hero WIPE: it starts on the first scroll (WIPE.start 0), and the oat fog
      // overtakes it BEFORE the bars reach the screen edges (fog fully in at fogStart + fogDur < WIPE end).
      const WIPE = { start: 0, dur: 1.0, steps: 16 };   // steps = how "bitmappy" (fewer = chunkier jumps)
      const T = { heroHold: 0.8, fogStart: 0.3, fogDur: 0.5, portalStart: 0.15, voidScale: 3.0, barPush: WIPE.start + WIPE.dur + 0.05, crossDur: 0.9 };
      const OV = T.crossDur * 0.6;      // incoming starts once the outgoing is ~60% gone
      const BAR_OUT = 0.3;              // bar fade out / back in around a dark↔oat switch
      const VH_PER_UNIT = 95;           // scroll per timeline unit (home ≈ 106). Lower = faster page.

      prepareVoid(fog, portal);
      BEATS.forEach((b) => gsap.set(b.el, { autoAlpha: 0 }));

      const tl = createStageTimeline(track);
      const { boundary, atDir, crossLabel } = stageLabels(tl, pageBar, T.crossDur);
      const dir = () => (tl.scrollTrigger ? tl.scrollTrigger.direction : 1);
      const SOLARIS_BG = 'linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%)';
      const paint = (c: BarCfg) => { bar.style.background = c.bg ?? SOLARIS_BG; bar.style.boxShadow = c.glow ?? 'var(--solaris-glow)'; };

      // HERO → THE CURTAIN: the seam splits and the two solaris edges step outward (bitmappy), OPENING the hero
      // like curtains to reveal "The problem" underneath — no white-out, no dive into the rain. Once it's fully
      // open the fog is set behind everything (it's the oat base the later scenes sit on).
      tl.to({}, { duration: WIPE.start + WIPE.dur });   // the hero's stretch of scroll
      buildSplitHeroEntrance(tl, {
        seam: pin.querySelector<HTMLElement>('[data-split-seam]'),
        wipeL: pin.querySelector<HTMLElement>('[data-split-wipe="l"]'),
        wipeR: pin.querySelector<HTMLElement>('[data-split-wipe="r"]'),
        reveal: BEATS[0].el,
      }, WIPE);
      tl.set(fog, { opacity: 1, pointerEvents: 'auto' }, WIPE.start + WIPE.dur);
      // once fully open, the hero leaves the stack — otherwise it shows through the close's tint when the fog lifts
      tl.set(pin.querySelector<HTMLElement>('.scene[data-scene="hero"]'), { autoAlpha: 0 }, WIPE.start + WIPE.dur);
      void portal; void enterTheVoid;   // the void entrance isn't used on About (kept imported for reference)
      // data-no-bar: put it on a scene and the solaris bar hides while that scene is showing (2026-11-10).
      const noBar = (b: { el: HTMLElement }) => b.el.hasAttribute('data-no-bar');
      if (noBar(BEATS[0])) tl.set(bar, { autoAlpha: 0 }, T.barPush);   // the push-in still runs, just invisibly
      pushInBar(tl, bar, T.barPush);
      if (!noBar(BEATS[0])) boundary(T.barPush + 0.19, BEATS[0].cfg, null);   // label once the push-in has landed
      tl.to({}, { duration: BEATS[0].hold });

      // Each next beat: a cross-fade. Same tone → a plain label swap. Tone change → the bar hides, is
      // recoloured while hidden, and returns with the new label (both scroll directions).
      for (let i = 1; i < BEATS.length; i++) {
        const prev = BEATS[i - 1], next = BEATS[i];
        const L = `b${i}`;
        tl.addLabel(L, '>');
        if (next.el.hasAttribute('data-same-bg')) {
          // SAME BACKGROUND (data-same-bg): the backgrounds don't move — the old content steps out, the new scene
          // (identical backgrounds) takes over, and its content builds in: photos stepped, then the text.
          const pb = prev.el.querySelector<HTMLElement>('.scene-body'), nb = next.el.querySelector<HTMLElement>('.scene-body');
          const OUT = 0.4;
          if (pb) tl.to(pb, { autoAlpha: 0, ease: 'steps(6)', duration: OUT }, L);
          tl.set(next.el, { autoAlpha: 1 }, `${L}+=${OUT}`).set(prev.el, { autoAlpha: 0 }, `${L}+=${OUT}`);
          if (nb) {
            const photos = nb.querySelectorAll('[data-enter="photo"]'), text = nb.querySelectorAll('[data-enter="text"]');
            // start states set up front (a staggered fromTo only pre-renders its FIRST target)
            gsap.set(photos, { autoAlpha: 0 }); gsap.set(text, { autoAlpha: 0 });
            tl.to(photos, { autoAlpha: 1, ease: 'steps(8)', duration: 0.4, stagger: 0.2 }, `${L}+=${OUT}`);
            tl.to(text, { autoAlpha: 1, ease: 'steps(4)', duration: 0.2, stagger: 0.06 }, `${L}+=${OUT + 0.3}`);
          }
        } else {
          tl.to(prev.el, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, L)
            .to(next.el, { autoAlpha: 1, ease: 'none', duration: T.crossDur }, `${L}+=${OV}`);
        }
        if (noBar(prev) && noBar(next)) {
          // bar stays hidden
        } else if (noBar(next)) {
          // INTO a no-bar scene: the bar (and its label) fade out together with the outgoing scene
          tl.to(bar, { autoAlpha: 0, ease: 'none', duration: BAR_OUT }, L);
          atDir(`${L}+=${BAR_OUT}`, 1, null);
          tl.call(() => { if (dir() === -1) paint(prev.cfg); }, [], `${L}+=${BAR_OUT}`);   // up: right colour before it returns
          atDir(`${L}+=${BAR_OUT * 0.8}`, -1, prev.cfg);
        } else if (noBar(prev)) {
          // OUT of a no-bar scene: the bar comes back, already recoloured, with the incoming scene
          tl.call(() => { if (dir() === 1) paint(next.cfg); }, [], L);
          tl.to(bar, { autoAlpha: 1, ease: 'none', duration: BAR_OUT }, `${L}+=${OV}`);
          atDir(`${L}+=${OV}`, 1, next.cfg);
          atDir(`${L}+=${OV}`, -1, null);
        } else if (prev.tone === next.tone) {
          crossLabel(L, next.cfg, prev.cfg);
        } else {
          tl.to(bar, { autoAlpha: 0, ease: 'none', duration: BAR_OUT }, L)
            .to(bar, { autoAlpha: 1, ease: 'none', duration: BAR_OUT }, `${L}+=${OV + BAR_OUT}`);
          atDir(`${L}+=${BAR_OUT}`, 1, null);   // the label leaves WITH the bar (cleared once it's hidden), not before it
          tl.call(() => paint(dir() === 1 ? next.cfg : prev.cfg), [], `${L}+=${BAR_OUT}`);
          atDir(`${L}+=${OV + BAR_OUT}`, 1, next.cfg);
          atDir(`${L}+=${OV + BAR_OUT}`, -1, null);
          atDir(`${L}+=${BAR_OUT * 0.8}`, -1, prev.cfg);
        }
        // REVERSE THE VOID on the close: the oat fog lifts and the rain zooms back out behind the tint.
        if (next.el.dataset.scene === 'close') {
          tl.to(fog, { opacity: 0, ease: 'none', duration: T.crossDur }, L);
          if (gridBg) tl.to(gridBg, { scale: 1, ease: 'power2.out', duration: T.crossDur + OV }, L);
        }
        tl.to({}, { duration: next.hold });
      }

      // The bar collapses back up into the header, then the stage releases into the footer.
      tl.to(bar, { clipPath: 'inset(0 0 100% 0)', opacity: 0.35, ease: 'steps(6)', duration: 0.3 });
      tl.to({}, { duration: 0.4 });

      // Track length follows the timeline (scroll distance = track height − one viewport).
      track.style.height = `${Math.ceil(tl.duration() * VH_PER_UNIT + 100)}vh`;

      initBeliefsFocus(q('beliefs'));

      ScrollTrigger.refresh();
      const fonts = (document as any).fonts;
      if (fonts?.ready) fonts.ready.then(() => ScrollTrigger.refresh());
    }

    document.addEventListener('astro:page-load', initStage);
    if (document.readyState === 'complete') initStage();
    else window.addEventListener('load', initStage);
  </script>

  <script>
    // RAIN THROUGHOUT: give every scene (except .no-rain) its own rain — lib/rain.ts. Motion comes from
    // GridBackground's scroll loop, so it's in step with the page rain.
    import { mountSceneRain } from '../lib/rain';
    const mount = () => mountSceneRain();
    document.addEventListener('astro:page-load', mount);
    if (document.readyState !== 'loading') mount(); else document.addEventListener('DOMContentLoaded', mount);
  </script>

  <script>
    // MOBILE-only: reveal each unstacked scene as it enters (desktop uses the GSAP stage).
    import { initMobileSceneReveal } from '../lib/pixel-veil';
    document.addEventListener('astro:page-load', initMobileSceneReveal);
    if (document.readyState === 'complete') initMobileSceneReveal();
    else window.addEventListener('load', initMobileSceneReveal);
  </script>
</Layout>
