---
/* src/pages/about.astro */
import Layout from '../layouts/Layout.astro';
import Solaris from '../components/Solaris.astro';
import Section from '../components/Section.astro';
import FocusScroll from '../components/FocusScroll.astro';
import AboutIntro from '../components/modules/AboutIntro.tsx';
import Founders from '../components/modules/Founders.tsx';
import AboutPhilosophy from '../components/modules/AboutPhilosophy.tsx';
import Values from '../components/modules/Values.tsx';
import Clients from '../components/modules/Clients.tsx';
import CtaScene from '../components/modules/CtaScene.astro';
---

<Layout
  title="About bitmap.audio | Sonic Branding Agency"
  description="bitmap.audio is a sonic branding and immersive audio agency founded by Dom Storrs-Fox and Nick Granville-Fall. We design sound identities for digital brands."
>
  {/* Hero: sticks at top of container, content scrolls over it */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh">
    <div class="h-full">
      <AboutIntro client:load />
    </div>
  </div>

  <div class="hero-runway" aria-hidden="true"></div>

  {/* Content: scrolls over the sticky hero */}
  <Solaris />

  <div class="relative z-10 theme-oat">
    <Section id="founders" delay="0.2s" className="!bg-background/50 backdrop-blur-xl">
      <Founders client:visible />
    </Section>

    <Section id="philosophy" invert delay="0.3s" className="!bg-background/50 backdrop-blur-xl">
      <AboutPhilosophy client:visible />
    </Section>

    <Section id="Values" delay="0.4s" className="!bg-background/50 backdrop-blur-xl" grainBg>
      <Values client:visible />
    </Section>

    {/* THE FULL BLEED BINARY WALL */}
    <Section 
      id="clients" 
      delay="0.5s" 
      isFullWidth={true} 
      noPadding={true} 
      hasBorder={true}
      className="!bg-background-blur/50 backdrop-blur-xl pb-8"
    >
      {/* 1. Header: Added pt-16 md:pt-32 to give it breathing room at the top */}
      <div class="w-full max-w-7xl mx-auto px-4 md:px-8 lg:px-12 mb-8 pt-8">
        <p class="text-base font-mono tracking-[0.5em] uppercase text-accent">
          [ CLIENT_TERMINAL ]
        </p>
      </div>
      
      {/* 2. The Grid: Spans 100vw and sits totally flush at the bottom */}
      <Clients client:visible />
    </Section>

  </div>

  {/* CTA — dark oversized finale; sticky "Get in touch" bar snaps it into focus like the other sections. */}
  <div class="relative z-10">
    <div class="section-bar-hold"><Solaris text="Get in touch" /></div>
    <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
      <div class="container-page w-full">
        <CtaScene head="Define your brand's<br/>audio identity" href="/contact" linkLabel="start_your_sonic_brand" pixelate={false} />
      </div>
    </FocusScroll>
  </div>

  <style is:global>.solaris:has(+ footer) { display: none; }</style>
</Layout>
