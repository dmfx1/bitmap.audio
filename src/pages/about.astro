---
/* src/pages/about.astro
 *
 * SCENE-STAGE PROTOTYPE — "in-situ" about page. The hero/header stays LOCKED in the viewport the
 * whole time; nothing ever scrolls up or down. Every scene is a full-screen LAYER stacked in one
 * pinned frame. Scroll is only a TIMELINE: it drives a fog fade-in, then a pixel reveal, then plain
 * OPACITY cross-fades from one stacked layer to the next. No translation, vertical or horizontal.
 *
 * Structure:
 *   #stage-track  — a tall (empty) scroll track; its height IS the scrub distance.
 *   .stage-pin    — position: sticky; stays put for the whole track (the fixed "stage").
 *     .scene[hero] → .stage-fog → #page-bar → .scene[founders] → values → clients → cta  (stacked)
 *
 * The reusable scene-stage pattern, shared with the home page.
 */
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/modules/AboutHero.tsx';
import Founders from '../components/modules/Founders.tsx';
import Clients from '../components/modules/Clients.tsx';
// The philosophy scene moved to the HOME page (2026-11-09). Founders → values → clients → cta.
---
<Layout
  title="About v3 (scene stage) | bitmap.audio"
  description="Scene-stage prototype."
>
  {/* Persistent solaris bar — page-level FIXED so it carries across the WHOLE page (the pinned stage
      AND the scrolling sections after it). Revealed by the stage timeline (bitmap push-down at
      barPush); its label is swapped per section. */}
  <div id="page-bar" aria-hidden="true">
    <span class="solaris-text" data-page-label></span>
  </div>

  {/* ══════════ THE PINNED STAGE — hero + founders assemble IN PLACE (fog / void / portal). ══════════ */}
  <div id="stage-track">
    {/* id="hero-sticky" is the anchor useHeroSquish looks for. */}
    <div class="stage-pin" id="hero-sticky">
      <div class="scene" data-scene="hero" style="z-index:0">
        <AboutHero client:load />
      </div>
      <div class="stage-fog" data-stage="fog" aria-hidden="true"></div>
      <div class="stage-portal" data-stage="portal" aria-hidden="true"></div>
      <div class="scene theme-oat" data-scene="founders" style="z-index:10; --veil-color: hsl(var(--content-background))">
        <div class="scene-body container-page">
          <Founders client:visible />
          <div class="scene-veil" data-veil aria-hidden="true"></div>
        </div>
      </div>

      {/* ── LAYER: values — cross-fades in over founders. (The philosophy scene moved to HOME, 2026-11-09.) ── */}
      <div class="scene values-scene theme-oat" data-scene="values" style="z-index:30; opacity:0">
        <div class="scene-body">
          <div class="values-cols">
            <div class="values-col" data-vcol>
              <span class="values-id" data-vhi>01</span>
              <h3 data-vhi>Precision</h3>
              <p>Sound should feel deliberate and every frequency intentional.</p>
              <div class="bitmap-progress values-progress" data-vprogress></div>
            </div>
            <div class="values-col" data-vcol>
              <span class="values-id" data-vhi>02</span>
              <h3 data-vhi>Empathy</h3>
              <p>Sound should feel intuitive, not intrusive and systems should be collaborative.</p>
              <div class="bitmap-progress values-progress" data-vprogress></div>
            </div>
            <div class="values-col" data-vcol>
              <span class="values-id" data-vhi>03</span>
              <h3 data-vhi>Innovation</h3>
              <p>Sounds should remain adaptable and allow scope for future development.</p>
              <div class="bitmap-progress values-progress" data-vprogress></div>
            </div>
          </div>
        </div>
      </div>

      {/* ── LAYER: clients ("Client Terminal") — cross-fades in over values. Same scrambling binary →
          client-name terminal as about-v2 (Clients.tsx), themed beige to sit in the oat world. ── */}
      <div class="scene clients-scene theme-oat" data-scene="clients" style="z-index:35; opacity:0">
        <div class="scene-body">
          <div class="clients-wrap">
            <Clients client:visible />
          </div>
        </div>
      </div>

      {/* ── LAYER: CTA (finale) — oversized Departure Mono, PIXELATES in via a bitmap veil, on the void. ── */}
      <div class="scene cta-scene oat-on-mobile mobile-fill" data-scene="cta" style="z-index:40; opacity:0; --veil-color: hsl(var(--background))">
        <div class="scene-body container-page">
          <div class="cta-copy">
            <h2 class="cta-head">Let's make you<br/>sound like you.</h2>
            <a class="cta-link" href="/contact"><span class="cta-caret">&gt;</span> start_project<span class="cta-cursor">_</span></a>
          </div>
          <div class="scene-veil" data-cta-veil aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>

  {/* The bitmap fader scrollbar + #dev-hud tracker are now GLOBAL (Layout.astro / global.css). This
      page's master timeline still writes the richer `t / total` readout into #dev-hud via onUpdate. */}

  <style>
    #stage-track { position: relative; height: 605vh; } /* hero + founders + values + clients + cta, all in one pin. ~36vh per timeline unit (unchanged pace); measured 13.92u after the philosophy moved to home (2026-11-09). */
    /* .scroll-fader + #dev-hud styles are GLOBAL now (global.css). */
    .stage-pin {
      position: sticky; top: 0; height: 100svh; overflow: hidden;
    }
    /* Explicit viewport height (NOT inset:0 — the sticky pin's containing block was resolving to 2×
       viewport here, so inset-based children came out double-height). */
    .scene { position: absolute; top: 0; left: 0; right: 0; height: 100svh; }
    /* Hero fills the frame so AboutHero's flex-1 / row layout (title + blurb) distributes as before. */
    .scene[data-scene="hero"] { display: flex; flex-direction: column; padding-top: var(--header-h); box-sizing: border-box; }
    .scene-body {
      position: absolute; left: 0; right: 0;
      top: calc(var(--header-h) + var(--solaris-height)); height: calc(100svh - var(--header-h) - var(--solaris-height));
      display: flex; flex-direction: column; justify-content: center;
    }

    /* Fog — a BEIGE takeover that EMANATES from the centre (radial + scaled from the void point),
       so it opens like a portal rather than a flat fade. */
    /* Fog — SOLID beige, uniform, full coverage (no radial cutoff at top/bottom). */
    .stage-fog {
      position: absolute; inset: 0; z-index: 5;
      background-color: hsl(var(--content-background));
      opacity: 0; pointer-events: none;
    }
    /* Portal — a SOFT warm bloom from the centre that just follows the receding text into the void. */
    .stage-portal {
      position: absolute; inset: 0; z-index: 6;
      transform-origin: 50% 45%;
      background: radial-gradient(circle at 50% 45%,
        rgba(255,250,238,0.7) 0%,
        rgba(255,250,238,0.22) 24%,
        transparent 58%);
      opacity: 0; pointer-events: none;
    }

    /* Pixel veil (built in JS). Colour comes from each scene's --veil-color. */
    .scene-veil { position: absolute; inset: 0; z-index: 50; display: grid; pointer-events: none; }

    /* ── VALUES layer — beige, cross-fades in over founders. Focus-columns look/feel from
       about-v2 (each column grows + goes accent in turn, a bitmap loading bar fills under it). ── */
    .values-scene { background-color: hsl(var(--content-background)); }
    .values-scene .scene-body { align-items: center; }
    .values-cols { display: flex; flex-direction: row; gap: clamp(2rem, 6vw, 5rem); width: min(90vw, 82rem); }
    .values-col { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; will-change: transform, opacity; }
    .values-id { font-family: var(--font-mono); font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 300; color: hsl(var(--content-foreground)); }
    .values-col h3 { font-family: var(--font-mono); font-size: clamp(1.25rem, 2vw, 1.5rem); color: hsl(var(--content-foreground)); margin: 0; }
    .values-col p { font-family: var(--font-mono); font-size: 1rem; line-height: 1.6; color: hsl(var(--content-foreground) / 0.82); max-width: 20rem; }
    .values-progress { margin-top: 0.75rem; }

    /* ── CTA layer (finale) — oversized Departure Mono on the void; pixelates in. ── */
    /* Clients ("Client Terminal") — beige oat world; centre the terminal grid with page gutters. */
    .clients-scene { background-color: hsl(var(--content-background)); }
    .clients-scene .scene-body { align-items: center; }
    .clients-wrap { width: 100%; padding-inline: clamp(1rem, 6vw, 6rem); }

    .cta-scene { background-color: hsl(var(--background)); }
    .cta-kicker { font-family: var(--font-departure); text-transform: uppercase; letter-spacing: 0.25em; color: hsl(var(--accent)); font-size: 0.95rem; margin-bottom: 1.8rem; }
    .cta-head { font-family: var(--font-departure); font-size: clamp(2.6rem, 8vw, 7rem); line-height: 1.05; color: hsl(var(--foreground)); margin: 0 0 2.6rem; }
    .cta-link { font-family: var(--font-departure); font-size: clamp(1.3rem, 3vw, 2.1rem); color: hsl(var(--foreground)); display: inline-flex; align-items: center; gap: 0.5ch; text-decoration: none; transition: color 0.2s ease; pointer-events: auto; }
    .cta-link:hover { color: hsl(var(--accent)); }
    .cta-caret, .cta-cursor { color: hsl(var(--accent)); }
    .cta-cursor { animation: cta-blink 1s steps(1) infinite; }
    @keyframes cta-blink { 50% { opacity: 0; } }

    /* Persistent solaris bar — flips down from the header edge once the fog is in. */
    #page-bar {
      position: fixed; top: var(--header-h); left: 0; right: 0; z-index: 40;
      height: var(--solaris-height);
      background: linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      box-shadow: var(--solaris-glow);
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
      /* revealed via a stepped clip-path "data load" push-down (set in JS); start clipped away */
      clip-path: inset(0 0 100% 0);
      transition: background 0.45s ease, box-shadow 0.45s ease;
    }
    #page-bar [data-page-label] { opacity: 0; white-space: nowrap; text-align: center; transition: color 0.45s ease; }

    /* ── MOBILE (≤767px): the scene-stage unstacks into a NORMAL vertical scroll (matches home —
       no scroll-snap). Desktop GSAP stage is gated off (<768px). Each scene reveals with a subtle
       rise/fade via .mob-reveal (progressive-enhanced). svh only. ── */
    @media (max-width: 767px) {
      #stage-track { height: auto; }
      .stage-pin { position: static; height: auto; overflow: visible; }
      .scene {
        position: relative; inset: auto; height: auto;
        margin-bottom: 0; padding-top: 0;   /* cancel the global .scene desktop pin-tail (-100svh) + lead */
        opacity: 1 !important; visibility: visible !important;
      }
      .scene[data-scene="hero"] { min-height: 100svh; }
      .stage-fog, .stage-portal, .scene-veil, #page-bar { display: none; }
      .scene-body {
        position: static; top: auto; height: auto;
        padding-block: 3rem;  /* vertical only — let container-page supply the side gutter */
        display: flex; flex-direction: column; justify-content: center;
      }

      /* ── Light scenes: CLIENTS stays rain-through (its terminal carries its own panel);
         FOUNDERS + VALUES are solid OAT (override the theme-oat transparent above). ── */
      .scene.theme-oat { background-color: transparent; }
      .scene[data-scene="founders"], .scene[data-scene="values"] { background-color: hsl(var(--content-background)); }

      /* FOUNDERS — full-bleed oat (no side gutter) */
      .scene[data-scene="founders"] .scene-body { padding-inline: 0; padding-block: 0; }
      .scene[data-scene="founders"] { border-top: 2px solid hsl(var(--accent)); border-bottom: 2px solid hsl(var(--accent)); }

      /* VALUES — each point is its OWN full-screen oat slide: dark text, generous padding */
      .values-scene .scene-body { align-items: stretch; padding-block: clamp(4rem, 12vh, 7rem); }
      .values-cols { flex-direction: column; gap: 0; width: 100%; }
      .values-col {
        min-height: max(100svh, 34rem);
        align-items: flex-start; text-align: left; justify-content: center;
        padding: 3rem var(--page-gutter-x); gap: 1.25rem;
      }
      .values-id, .values-col h3, .values-col p { color: hsl(var(--content-foreground)); }
      .values-col p { max-width: 75%; }

      /* CLIENTS — full-width, full-screen terminal; no bands so it butts flush to values + cta */
      .scene[data-scene="clients"] { min-height: 0; }
      .clients-scene .scene-body { padding-inline: 0; padding-block: 0; }
      .clients-wrap { padding-inline: 0; }
      /* CTA button — bordered, dark/background colour, accent flashing underscore (matches home) */
      .cta-link {
        font-size: clamp(1.25rem, 5vw, 1.75rem);
        color: hsl(var(--foreground));
        border: 2px solid hsl(var(--foreground));
        padding: 0.6em 1.1em; margin-top: 0.6rem; min-height: 44px;
      }
      .cta-link .cta-caret { color: hsl(var(--foreground)); }
      .cta-link .cta-cursor { color: hsl(var(--accent)); }
      .cta-link:active { background: hsl(var(--foreground)); color: hsl(var(--background)); }

      /* entrance fade-up removed on mobile — every section stays visible (no black->oat flash,
         and philosophy no longer gets hidden after first paint). The JS still tags .mob-reveal/.is-in
         but this neutralises it. */
      .mob-reveal .scene { opacity: 1 !important; transform: none !important; transition: none !important; }
    }
  </style>

  {/* Veil cell rule must be global (cells are built in JS, outside Astro's scoped styles). */}
  <style is:global>
    /* This page uses the custom .scroll-fader, so hide the native scrollbar here. */
    ::-webkit-scrollbar { width: 0 !important; height: 0 !important; }
    html { scrollbar-width: none; }
    .scene-veil > i {
      display: block;
      background: var(--veil-color, hsl(var(--content-background)));
      opacity: clamp(0, calc((var(--o) - var(--reveal, 0)) * 26), 1);
    }

    /* Founders fill the FULL section height with the usual big-text styling (like the old about page).
       The scene-height bug is fixed, so the cards fit the frame without shrinking the type.
       NB: the React island is wrapped in <astro-island>, so target by CLASS, not > child. */
    #stage-track [data-scene="founders"] .grid { height: 100%; }
    #stage-track [data-scene="founders"] .grid > div { min-height: 0 !important; }

    /* CTA is the same dark colour as the footer, so drop the Solaris seam beam between them —
       the CTA reads straight into the footer as one continuous section. (The moving #page-bar
       is its own element, not a .solaris, so it is untouched.) */
    .solaris:has(+ footer) { display: none; }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { createStageTimeline, createPageBar, stageLabels, prepareVoid, enterTheVoid, pushInBar, type BarCfg } from '../lib/stage';
    import { fillPixelVeil } from '../lib/pixel-veil';
    gsap.registerPlugin(ScrollTrigger);

    function initStage() {
      const track = document.getElementById('stage-track');
      const pin = track?.querySelector<HTMLElement>('.stage-pin');
      if (!track || !pin || track.dataset.init === '1') return;
      track.dataset.init = '1';
      if (!window.matchMedia('(min-width: 768px)').matches) return; // desktop only

      const fog = pin.querySelector<HTMLElement>('[data-stage="fog"]')!;
      const portal = pin.querySelector<HTMLElement>('[data-stage="portal"]')!;
      const scFounders = pin.querySelector<HTMLElement>('.scene[data-scene="founders"]')!;
      const scValues = pin.querySelector<HTMLElement>('.scene[data-scene="values"]')!;
      const scClients = pin.querySelector<HTMLElement>('.scene[data-scene="clients"]')!;
      const scCta = pin.querySelector<HTMLElement>('.scene[data-scene="cta"]')!;
      const vCta = scCta.querySelector<HTMLElement>('[data-cta-veil]')!;
      const vFounders = scFounders.querySelector<HTMLElement>('[data-veil]')!;
      const gridBg = document.getElementById('grid-bg'); // fixed binary-rain layer — for the "enter the void" zoom

      // Build a pixel veil (large cells) sized to its scene body (falls back to the viewport size).
      const buildVeil = (veil: HTMLElement) => {
        const host = veil.parentElement as HTMLElement;
        fillPixelVeil(veil, host.clientWidth || window.innerWidth, host.clientHeight || window.innerHeight);
      };
      // BOOKMARK (pixels): the pixel veil is dropped for now — founders just fade in. Re-enable
      // buildVeil + the two veil tweens in the timeline to bring the pixel break-up back.
      // buildVeil(vFounders);
      // vFounders.style.setProperty('--reveal', '-0.05');
      void vFounders; void buildVeil; // keep refs alive while bookmarked
      prepareVoid(fog, portal); // solid beige fog + soft bloom from the void centre, both hidden
      // autoAlpha (opacity + visibility) so a faded-OUT scene goes visibility:hidden and stops
      // intercepting the pointer — otherwise the top-z scene (e.g. CTA at z40) dictates the cursor
      // even at opacity 0, giving a light (dark-scene) cursor over the beige scenes. With autoAlpha
      // the VISIBLE scene wins, so its own cursor rule (theme-oat → dark dot; dark → light dot) applies.
      gsap.set(scFounders, { autoAlpha: 0 }); // shown only AFTER the fog is fully in
      gsap.set(scValues, { autoAlpha: 0 });   // cross-faded in after founders
      gsap.set(scClients, { autoAlpha: 0 });  // cross-faded in after values (the client terminal)
      gsap.set(scCta, { autoAlpha: 0 });      // cross-faded in after clients, then pixelates in
      buildVeil(vCta);                      // CTA pixel veil (dark cells, --veil-color = void)
      vCta.style.setProperty('--reveal', '-0.05'); // start fully covered

      // ── Persistent bar ────────────────────────────────────────────────────────
      const bar = document.getElementById('page-bar')!;
      const pageBar = createPageBar(bar);
      const FOUNDERS: BarCfg = { name: 'Who We Are' };
      const VALUES: BarCfg = { name: 'Our Values' };
      const CLIENTS: BarCfg = { name: 'Client Terminal' };
      const CONTACT: BarCfg = { name: 'Get In Touch' };

      // ── Master scrubbed timeline (1 unit ≈ 1 viewport of scroll) ──
      //   hero holds while the copy recedes into the void (useHeroSquish, first ~80vh) → DARK void
      //   delay → fog takes over CLEAN + slow (no pixels yet) → founders veil appears seamlessly →
      //   pixel reveal → hold → opacity cross-fade to philosophy → hold.
      // ── TIMING KNOBS — units ≈ viewports of scroll. Tune the whole entrance here. ──
      //   Overlap pixStart with the fog so the beige "breaks up" WHILE the fog is still arriving
      //   (binary rain → pixels, entering a new dimension) rather than fog-then-pixelate.
      const T = {
        heroHold:    0.8,   // hero holds while the copy recedes into the void (kept short)
        fogStart:    0.8,   // when the beige fog begins (≈ when the words have receded)
        fogDur:      1.0,   // fog fade duration
        portalStart: 0.5,   // soft white bloom starts EARLY — follows the receding text into the void
        foundersHold:0.7,   // settle on founders
        crossDur:    0.9,   // scene cross-fade
        voidScale:   3.0,   // ENTER THE VOID — how far the binary rain rushes toward you (zoom)
        barPush:     1.72,  // solaris bar "data-load" push-down (t) — just as the beige fully occupies
        // bookmarked pixel knobs — only used if the veil is re-enabled
        veilInStart: 1.0, veilInDur: 0.2, pixStart: 1.5, pixDur: 1.0,
      };
      // Incoming layer starts fading in only after the outgoing is ~60% gone — small overlap, not a
      // long simultaneous cross-fade (stops scenes smearing into each other).
      const OV = T.crossDur * 0.6;
      const tl = createStageTimeline(track);
      // Direction-aware bar labels: `boundary` at a scene edge (label = CURRENT scene both ways);
      // `crossLabel` on a cross-fade (DOWN waits until the incoming scene is in focus, UP is snappy).
      const { boundary, crossLabel } = stageLabels(tl, pageBar, T.crossDur);
      // ENTER THE VOID — hero holds + copy recedes, binary rain zooms, portal blooms, beige fog takes over.
      enterTheVoid(tl, { fog, portal, gridBg }, T);
      // BOOKMARK (pixels): founders just FADE in for now. Re-enable these two to bring pixels back:
      //   tl.to(scFounders, { opacity: 1, duration: T.veilInDur }, T.veilInStart);
      //   tl.to(vFounders, { '--reveal': 1, duration: T.pixDur }, T.pixStart);
      tl.to(scFounders, { autoAlpha: 1, ease: 'none', duration: 0.9 }, T.fogStart + T.fogDur);  // founders fade in (no pixels)
      // SOLARIS BAR — bitmappy "data-load" push-down from the header, then the label scrambles in
      // (binary) — in place + scrambled by ~t 1.90.
      pushInBar(tl, bar, T.barPush);
      boundary(1.91, FOUNDERS, null);   // down → "Who We Are"; up → clear (back to hero)
      tl.to({}, { duration: T.foundersHold });      // settle on the resolved founders

      // ── VALUES — cross-fade in over founders (same beige world), hold. (Philosophy moved to HOME.) ──
      tl.addLabel('valuesIn', '>');
      tl.to(scFounders, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, 'valuesIn')
        .to(scValues, { autoAlpha: 1, ease: 'none', duration: T.crossDur }, 'valuesIn+=' + OV);
      crossLabel('valuesIn', VALUES, FOUNDERS);   // down (buffered) → values; up (snappy) → founders
      tl.to({}, { duration: 1.4 }); // hold on the values

      // ── CLIENTS ("Client Terminal") — cross-fade in over values (same beige world), hold. ──
      tl.addLabel('clientsIn', '>');
      tl.to(scValues, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, 'clientsIn')
        .to(scClients, { autoAlpha: 1, ease: 'none', duration: T.crossDur }, 'clientsIn+=' + OV);
      crossLabel('clientsIn', CLIENTS, VALUES);   // down (buffered) → clients; up (snappy) → values
      tl.to({}, { duration: 1.4 }); // hold on the client terminal

      // ── CTA (finale) — clients fades out, the CTA layer appears (veil covering), then PIXELATES in. ──
      tl.addLabel('ctaIn', '>');
      tl.to(scClients, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, 'ctaIn')
        .to(scCta, { autoAlpha: 1, ease: 'none', duration: 0.3 }, 'ctaIn+=' + OV);   // veil (dark) still covering
      crossLabel('ctaIn', CONTACT, CLIENTS);   // down (buffered) → CTA; up (snappy) → clients
      tl.to(vCta, { '--reveal': 1, ease: 'none', duration: 1.6 }, 'ctaIn+=' + (OV + 0.3)); // pixel break-up reveal
      // Dwell on the fully-revealed CTA before the stage unpins into the footer (pixelation settles first).
      tl.to({}, { duration: 2.4 });

      // ── VALUES focus cycle (same feel as about-v2 FocusColumns): while the values layer is VISIBLE,
      //    each column grows + goes accent in turn and its bitmap loading bar fills; hover overrides. ──
      (() => {
        const readToken = (name: string, el: Element) => {
          const raw = getComputedStyle(el).getPropertyValue(name).trim();
          return !raw ? '' : (/^#|^rgb|^hsl/.test(raw) ? raw : `hsl(${raw.split(/\s+/).join(', ')})`);
        };
        const vcols = Array.from(scValues.querySelectorAll<HTMLElement>('[data-vcol]'));
        if (!vcols.length) return;
        const vhi = vcols.map((c) => c.querySelectorAll<HTMLElement>('[data-vhi]'));
        const vbars = vcols.map((c) => c.querySelector<HTMLElement>('[data-vprogress]'));
        const accent = readToken('--accent', scValues);
        const ink = readToken('--content-foreground', scValues) || readToken('--foreground', scValues);
        const FOCUS_SCALE = 1.18, DULL = 0.28, FOCUS_DUR = 0.4, INTERVAL = 4500;
        gsap.set(vcols, { transformOrigin: '50% 50%' });
        const applyFocus = (a: number) => {
          vcols.forEach((col, i) => {
            gsap.to(col, { scale: i === a ? FOCUS_SCALE : 1, opacity: i === a ? 1 : DULL, duration: FOCUS_DUR, ease: 'power2.out' });
            gsap.to(vhi[i], { color: i === a ? accent : ink, duration: FOCUS_DUR });
          });
        };
        const setProg = (idx: number, p: number) => vbars.forEach((b, i) => { if (b) b.style.setProperty('--progress', String(i === idx ? p : 0)); });
        applyFocus(0); setProg(0, 0);
        let active = 0, hover: number | null = null, elapsed = 0, last: number | undefined;
        // Read the opacity GSAP writes inline (autoAlpha) instead of getComputedStyle — this runs every
        // frame, and getComputedStyle forced a synchronous style recalc on each one. Falls back to the
        // computed value only if no inline opacity has been set.
        const visible = () => {
          const o = scValues.style.opacity;
          return parseFloat(o !== '' ? o : getComputedStyle(scValues).opacity) > 0.5;
        };
        const stepV = (t: number) => {
          const dt = last === undefined ? 0 : t - last; last = t;
          if (hover !== null) { elapsed = 0; setProg(hover, 1); }
          else if (visible()) {
            elapsed += dt;
            const p = Math.min(1, elapsed / INTERVAL);
            setProg(active, p);
            if (p >= 1) { active = (active + 1) % vcols.length; applyFocus(active); elapsed = 0; }
          }
          requestAnimationFrame(stepV);
        };
        requestAnimationFrame(stepV);
        vcols.forEach((col, i) => {
          col.addEventListener('mouseenter', () => { hover = i; applyFocus(i); });
          col.addEventListener('mouseleave', () => { hover = null; applyFocus(active); });
        });
      })();

      ScrollTrigger.refresh();
    }

    document.addEventListener('astro:page-load', initStage);
    if (document.readyState === 'complete') initStage();
    else window.addEventListener('load', initStage);
  </script>

  <script>
    // MOBILE-only: reveal each unstacked scene as it enters (desktop uses the GSAP stage).
    import { initMobileSceneReveal } from '../lib/pixel-veil';
    document.addEventListener('astro:page-load', initMobileSceneReveal);
    if (document.readyState === 'complete') initMobileSceneReveal();
    else window.addEventListener('load', initMobileSceneReveal);
  </script>

  {/* The bitmap fader driver is GLOBAL now (Layout.astro). */}
</Layout>
