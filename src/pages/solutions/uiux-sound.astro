---
/* src/pages/solutions/uiux-sound.astro
 *
 * Simple VERTICAL SCROLL WITH LOCK (same pattern as sonic-branding / spatial): a sticky hero that the
 * beige sections rise over, each section locking under its Solaris bar then releasing. (Reverted from
 * the "into the void" scene-stage — that model is kept for home / about only.)
 */
import Layout from '../../layouts/Layout.astro';
import Solaris from '../../components/Solaris.astro';
import FocusScroll from '../../components/FocusScroll.astro';
import UIUXHero from '../../components/modules/solutions/UIUXHero.tsx';
import UIUXAnalysis from '../../components/modules/solutions/UIUXAnalysis.tsx';
import ConceptGrid from '../../components/modules/ConceptGrid.tsx';
import CtaScene from '../../components/modules/CtaScene.astro';

const uiuxApplications = [
  { id: 1, title: "Mobile Apps", icon: "mobile", desc: "Haptic-synced audio, gesture feedback and navigation sounds." },
  { id: 2, title: "Web Applications", icon: "web", desc: "Form interactions, loading states, real-time updates and collaboration cues." },
  { id: 3, title: "Hardware Products", icon: "hardware", desc: "Power states, connectivity, errors and physical button feedback sounds." },
];
---

<Layout
  title="UI/UX Sound Design | Interface Audio for Apps | bitmap.audio"
  description="bitmap.audio designs interaction sound libraries, notification hierarchies, and feedback audio for mobile apps, web applications, and hardware products."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "UI/UX Sound Design",
      "description": "Interaction sound libraries, state and feedback sounds, notification hierarchies, error and success indicators, and loading audio for mobile apps, web applications, and hardware products.",
      "provider": { "@type": "Organization", "@id": "https://bitmap.audio/#organization", "name": "bitmap.audio" },
      "serviceType": "UI/UX Sound Design",
      "areaServed": "Worldwide",
      "url": "https://bitmap.audio/solutions/uiux-sound"
    })}</script>
  </Fragment>

  {/* Hero: sticks at top of container, content scrolls over it */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh flex flex-col pt-[var(--header-h)]">
    <UIUXHero client:load />
  </div>

  <div class="hero-runway" aria-hidden="true"></div>

  {/* Each section: bar sticks under the header, content locks in centred below it, then releases. */}
  <div class="relative z-10 theme-oat">
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="The Analysis" /></div>
      <FocusScroll count={1} barOffset id="analysis" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <UIUXAnalysis client:visible />
        </div>
      </FocusScroll>
    </div>

    <div class="relative">
      <div class="section-bar-hold"><Solaris text="Applications" /></div>
      <FocusScroll count={1} barOffset id="applications" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <ConceptGrid
            client:visible
            eyebrow="Applications"
            sectionTitle="Where UI/UX sound makes a difference"
            items={uiuxApplications}
            mobileGlow={true}
            animateIcons={true}
          />
        </div>
      </FocusScroll>
    </div>

  </div>

  {/* CTA — dark oversized finale (vertical page: shows without pixelating in). */}
  <div class="relative z-10">
    <div class="section-bar-hold"><Solaris text="Get in touch" /></div>
    <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
      <div class="container-page w-full">
        <CtaScene head="Make your product<br/>speak." href="/contact" linkLabel="discuss_your_product" pixelate={false} />
      </div>
    </FocusScroll>
  </div>

  {/* CTA is the same dark colour as the footer — drop the Solaris seam beam between them. */}
  <style is:global>
    .solaris:has(+ footer) { display: none; }
  </style>
</Layout>
