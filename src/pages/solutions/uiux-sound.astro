---
/* src/pages/solutions/uiux-sound.astro */
import Layout from '../../layouts/Layout.astro';
import Solaris from '../../components/Solaris.astro';
import Section from '../../components/Section.astro';
import UIUXHero from '../../components/modules/solutions/UIUXHero.tsx';
import UIUXAnalysis from '../../components/modules/solutions/UIUXAnalysis.tsx';
import ConceptGrid from '../../components/modules/ConceptGrid.tsx';
import DeliverablesGrid from '../../components/modules/solutions/DeliverablesGrid.tsx';
import CTA from '../../components/modules/CTA.tsx';

// DEFINING THE DATA SET FOR THIS PAGE
const uiuxApplications = [
  {
    id: 1,
    title: "Mobile Apps",
    icon: "mobile",
    desc: "Haptic-synced audio, gesture feedback and navigation sounds."
  },
  {
    id: 2,
    title: "Web Applications",
    icon: "web",
    desc: "Form interactions, loading states, real-time updates and collaboration cues."
  },
  {
    id: 3,
    title: "Hardware Products",
    icon: "hardware",
    desc: "Power states, connectivity, errors and physical button feedback sounds."
  }
];

const uiuxDeliverables = [
  "UI/UX Audit & Interaction Analysis",
  "Approach Guidelines & Strategy",
  "State & Feedback Sounds",
  "Interface Indicators",
  "Ongoing Support & Iteration",
  "Implementation Guidelines"
];
---

<Layout
  title="UI/UX Sound Design | Interface Audio for Apps | bitmap.audio"
  description="bitmap.audio designs interaction sound libraries, notification hierarchies, and feedback audio for mobile apps, web applications, and hardware products."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "UI/UX Sound Design",
      "description": "Interaction sound libraries, state and feedback sounds, notification hierarchies, error and success indicators, and loading audio for mobile apps, web applications, and hardware products.",
      "provider": {
        "@type": "Organization",
        "@id": "https://bitmap.audio/#organization",
        "name": "bitmap.audio"
      },
      "serviceType": "UI/UX Sound Design",
      "areaServed": "Worldwide",
      "url": "https://bitmap.audio/solutions/uiux-sound"
    })}</script>
  </Fragment>
  {/* Hero: sticks at top of container, content scrolls over it */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh">
    <div class="h-full">
      <UIUXHero client:load />
    </div>
  </div>

  <div class="hero-runway" aria-hidden="true"></div>

  {/* Content: scrolls over the sticky hero — sections are frosted glass so hero colours bleed through */}
  <Solaris />

  <div class="relative z-10 theme-oat">
    <Section id="analysis" delay="0.5s" className="!bg-background/50 backdrop-blur-xl" grainBg>
      <UIUXAnalysis client:visible />
    </Section>

    <Section id="applications" invert delay="0.8s" className="!bg-background/50 backdrop-blur-xl">
      <ConceptGrid
        client:visible
        eyebrow="Applications"
        sectionTitle="Where UI/UX sound makes a difference"
        items={uiuxApplications}
        mobileGlow={true}
      />
    </Section>

    <Section id="deliverables" delay="1.2s" className="!bg-background/50 backdrop-blur-xl">
      <DeliverablesGrid
        client:visible
        items={uiuxDeliverables}
        sectionTitle="What you'll receive"
      />
    </Section>

    <Section id="cta" delay="1.5s" className="!bg-background/50 backdrop-blur-xl" grainBg>
      <CTA
        client:visible
        title="Make your product speak"
        description="Let's design sound that makes your digital product feel alive, responsive, and human."
        buttonText="Discuss your product"
      />
    </Section>
  </div>
</Layout>