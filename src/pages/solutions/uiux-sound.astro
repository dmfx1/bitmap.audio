---
/* src/pages/solutions/uiux-sound.astro */
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import UIUXHero from '../../components/modules/solutions/UIUXHero.tsx';
import UIUXAnalysis from '../../components/modules/solutions/UIUXAnalysis.tsx';
import ConceptGrid from '../../components/modules/ConceptGrid.tsx';
import DeliverablesGrid from '../../components/modules/solutions/DeliverablesGrid.tsx';
import CTA from '../../components/modules/CTA.tsx';

// DEFINING THE DATA SET FOR THIS PAGE
const uiuxApplications = [
  { 
    title: "Mobile Apps", 
    desc: "Haptic-synced audio, gesture feedback, navigation sounds, and notification hierarchies." 
  },
  { 
    title: "Web Applications", 
    desc: "Form interactions, loading states, real-time updates, and collaboration cues." 
  },
  { 
    title: "Hardware Products", 
    desc: "Power states, connectivity, errors, and physical button feedback sounds." 
  }
];

const uiuxDeliverables = [
  "Interaction Sound Library",
  "State & Feedback Sounds",
  "Notification Hierarchy",
  "Error & Success Indicators",
  "Loading & Progress Audio",
  "Implementation Guidelines"
];
---

<Layout title="bitmap.audio | ui/uxSound">
  <Section id="hero" delay="0.1s">
    <UIUXHero client:load />
  </Section>

  <Section id="analysis" delay="0.5s">
    <UIUXAnalysis client:visible />
  </Section>

  {/* FIXED: Passing the defined items to ConceptGrid */}
  <Section id="applications" delay="0.8s">
    <ConceptGrid
      client:visible
      eyebrow="Applications"
      sectionTitle="Where UI/UX sound makes a difference"
      items={uiuxApplications}
      mobileGlow={true}
    />
  </Section>

  <Section id="deliverables" delay="1.2s">
    <DeliverablesGrid 
      client:visible 
      items={uiuxDeliverables} 
      sectionTitle="What you'll receive" 
    />
  </Section>

  <Section id="cta" delay="1.5s">
    <CTA 
      client:visible
      title="Make your product speak"
      description="Let's design sound that makes your digital product feel alive, responsive, and human."
      buttonText="Discuss your product"
    />
  </Section>
</Layout>