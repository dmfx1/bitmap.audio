---
/* src/pages/solutions/sonic-branding.astro */
import Layout from '../../layouts/Layout.astro';
import Solaris from '../../components/Solaris.astro';
import Section from '../../components/Section.astro';
import FocusScroll from '../../components/FocusScroll.astro';
import SonicHero from '../../components/modules/solutions/SonicHero.tsx';
import SonicAnalysis from '../../components/modules/solutions/SonicAnalysis.tsx';
import DeliverablesGrid from '../../components/modules/solutions/DeliverablesGrid.tsx';
import CTA from '../../components/modules/CTA.tsx';

const sonicDeliverables = [
  "Sonic Audit & Brand Analysis",
  "Approach Guidelines & Strategy",
  "Adaptive Audio Assets",
  "Notification & Alert Sounds",
  "Sonic Logo",
  "Bespoke Hero Music"
];
---

<Layout
  title="Sonic Branding Services | Audio Identity Design | bitmap.audio"
  description="bitmap.audio creates comprehensive sonic brand systems — audio logos, brand sound guidelines, adaptive audio assets, and hold music for digital-first companies."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Sonic Branding",
      "description": "Comprehensive sonic brand systems including audio logos, brand sound guidelines, adaptive audio assets, notification sounds, and podcast/video intros for digital-first companies.",
      "provider": {
        "@type": "Organization",
        "@id": "https://bitmap.audio/#organization",
        "name": "bitmap.audio"
      },
      "serviceType": "Sonic Branding",
      "areaServed": "Worldwide",
      "url": "https://bitmap.audio/solutions/sonic-branding"
    })}</script>
  </Fragment>
  {/* Hero: sticks at top of container, content scrolls over it */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh flex flex-col">
    <SonicHero client:load />
  </div>

  <div class="hero-runway" aria-hidden="true"></div>

  {/* Each section: bar sticks under the header, content locks in centred below it, then release
      together (same pattern as about-v2 / home). Section titles now ride on the bars. */}
  <div class="relative z-10 theme-oat">
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="The Analysis" /></div>
      <FocusScroll count={1} barOffset id="analysis" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <SonicAnalysis client:visible />
        </div>
      </FocusScroll>
    </div>

    <div class="relative">
      <div class="section-bar-hold"><Solaris text="Get In Touch" /></div>
      <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <CTA
            client:visible
            title="Ready to sound like yourself?"
            description="Let's explore how a sonic brand can strengthen your identity and deepen audience connection."
            buttonText="START YOUR SONIC BRAND"
          />
        </div>
      </FocusScroll>
    </div>
  </div>
</Layout>