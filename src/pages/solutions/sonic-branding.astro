---
import Layout from '../../layouts/Layout.astro';
import { ArrowRight, ArrowLeft, CheckCircle } from "lucide-react";
import { Button } from "@/components/ui/button";

const deliverables = [
  "Audio Logo / Sonic Mnemonic",
  "Brand Sound Guidelines",
  "Adaptive Audio Assets",
  "Notification & Alert Sounds",
  "Hold Music & Ambience",
  "Podcast & Video Intros/Outros",
];
---

<Layout title="Sonic Branding | bitmap.audio">
  <section class="pt-32 pb-20 px-6">
    <div class="container mx-auto max-w-4xl">
      <a href="/home" class="inline-flex items-center gap-2 font-mono text-sm text-muted-foreground hover:text-primary transition-colors mb-8">
        <ArrowLeft className="w-4 h-4" /> Back to Home
      </a>
      
      <p class="font-mono text-sm uppercase tracking-widest text-primary mb-4 animate-fade-in">
        Solutions / Sonic Branding
      </p>
      <h1 class="font-mono text-4xl md:text-5xl lg:text-6xl font-medium text-foreground mb-8 animate-fade-in-up leading-tight">
        Define your brand's<br />
        <span class="text-primary text-glow">audio DNA</span>
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl animate-fade-in-up">
        Just as your visual identity communicates who you are, your sonic identity creates emotional 
        connections that words and images alone cannot achieve.
      </p>
    </div>
  </section>

  <section class="py-20 px-6 border-t border-border">
    <div class="container mx-auto max-w-4xl">
      <h2 class="font-mono text-2xl md:text-3xl font-medium text-foreground mb-12 text-center">
        What you'll receive
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {deliverables.map((item) => (
          <div class="flex items-center gap-4 border border-border p-4 bg-card/50 backdrop-blur-sm card-glow">
            <CheckCircle className="w-5 h-5 text-primary flex-shrink-0" />
            <span class="font-mono text-sm text-foreground">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 px-6 border-t border-border text-center">
    <Button variant="glow" size="xl" asChild>
      <a href="mailto:hello@bitmap.audio">
        Start Your Sonic Brand <ArrowRight className="w-5 h-5 ml-2" />
      </a>
    </Button>
  </section>
</Layout>