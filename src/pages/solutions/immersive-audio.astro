---
import Layout from '../../layouts/Layout.astro';
import { CheckCircle, ArrowLeft } from 'lucide-react';
const deliverables = ["3D Audio Design", "Ambisonics", "Interactive Systems", "Generative Sound"];
---

<Layout title="Immersive Audio | bitmap.audio">
  <section class="pt-32 pb-20 px-6">
    <div class="container mx-auto max-w-4xl">
      <a href="/home" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary mb-8 transition-colors">
        <ArrowLeft className="w-4 h-4" /> Back
      </a>
      <h1 class="font-mono text-5xl mb-8">Sound in <span class="text-primary">Space</span></h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {deliverables.map(d => (
          <div class="flex items-center gap-4 border border-border p-4 bg-card/50">
            <CheckCircle className="w-5 h-5 text-primary" />
            <span class="font-mono text-sm">{d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>