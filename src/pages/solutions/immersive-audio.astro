---
/* src/pages/solutions/immersive-audio.astro */
import Layout from '../../layouts/Layout.astro';
import Solaris from '../../components/Solaris.astro';
import FocusScroll from '../../components/FocusScroll.astro';
import SolutionHero from '../../components/modules/solutions/SolutionHero.tsx';
import SolutionAnalysis from '../../components/modules/solutions/SolutionAnalysis.astro';
import ConceptGrid from '../../components/modules/ConceptGrid.tsx';
import CtaScene from '../../components/modules/CtaScene.astro';
import SpatialDepth from '../../components/modules/SpatialDepth.astro';

// DEFINING THE DATA SET FOR THIS PAGE
const immersiveAudioApplications = [
  {
    id: 1,
    title: "Virtual Reality",
    subtitle: "VR Experiences & Games",
    icon: "vr",
    desc: "3D audio design including ambisonic soundscapes, interactive object audio and spatial music."
  },
  {
    id: 2,
    title: "Augmented Reality",
    subtitle: "AR Applications",
    icon: "ar",
    desc: "Audio that anchors virtual objects in real space through precise spatial audio cues."
  },
  {
    id: 3,
    title: "Physical Space",
    subtitle: "Installations & Exhibitions",
    icon: "space",
    desc: "Multi-channel audio installations for exhibitions that respond to visitor movement."
  },
  {
    id: 4,
    title: "Generative",
    subtitle: "Interactive Soundscapes",
    icon: "generative",
    desc: "Generative audio systems that create unique, never-repeating sonic environments."
  }
];

// Page copy for the shared hero + analysis components.
const hero = {
  title: "Sound that exists\nin space",
  blurb: [
    "We design immersive audio experiences for physical installations and augmented reality experiences to bring experiences to life through the feeling of sound.",
  ],
  reelSlug: "immersive-audio",
};
const analysis = {
  challenge: {
    heading: "Flat audio breaks immersion",
    paragraphs: [
      "Traditional stereo audio exists on a flat plane. In immersive environments, sound needs to exist in three dimensions, responding to movement, orientation, and space.",
      "By leveraging spatial audio techniques with object-based audio and immersive audio mixing we can take that flat audio pane and manufacture believable virtual worlds and spaces.",
    ],
  },
  approach: {
    heading: "Engineering presence through sound.",
    paragraphs: [
      "We combine artistic vision with technical expertise in spatial audio formats and audio middleware to create experiences that feel real and respond to their environment.",
      "Whether it's a VR experience, AR application or a physical installation, we architect sound that responds to space and movement naturally.",
    ],
  },
};
---

<Layout
  title="Immersive Audio & Spatial Sound Design | bitmap.audio"
  description="bitmap.audio creates 3D spatial audio, ambisonics, generative soundscapes, and interactive audio systems for VR, AR, installations, and experiential environments."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Immersive Audio",
      "description": "3D and spatial audio design, ambisonics and binaural mixes, interactive audio systems, generative soundscapes, installation audio, and technical integration for VR, AR, and experiential environments.",
      "provider": {
        "@type": "Organization",
        "@id": "https://bitmap.audio/#organization",
        "name": "bitmap.audio"
      },
      "serviceType": "Immersive Audio Design",
      "areaServed": "Worldwide",
      "url": "https://bitmap.audio/solutions/immersive-audio"
    })}</script>
  </Fragment>
  {/* Hero: sticks at top of container, content scrolls over it */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh flex flex-col pt-[var(--header-h)]">
    <SolutionHero client:load {...hero} />
  </div>

  <div class="hero-runway" aria-hidden="true"></div>

  {/* Each section: bar sticks under the header, content locks in centred below it, then release
      together (same pattern as about-v2 / home). Section titles ride on the bars. */}
  <div class="relative z-10 theme-oat sol-body sol-gradient" style="--sol-grad: linear-gradient(to right, hsl(44 14% 80%), hsl(42 13% 62%))">
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="The Analysis" /></div>
      <FocusScroll count={1} barOffset id="analysis" class="!bg-background/50 backdrop-blur-xl">
        <SpatialDepth page />
        <div class="container-page w-full">
          <SolutionAnalysis {...analysis} />
        </div>
      </FocusScroll>
    </div>

    <div class="relative">
      <div class="section-bar-hold"><Solaris text="Applications" /></div>
      <FocusScroll count={1} barOffset id="applications" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <ConceptGrid
            client:visible
            sectionTitle="Where we create"
            items={immersiveAudioApplications}
            mobileGlow={true}
            columns={2}
            animateIcons={true}
          />
        </div>
      </FocusScroll>
    </div>

  </div>

  {/* CTA — dark oversized finale (vertical page: shows without pixelating in). */}
  <div class="relative z-10 sol-cta">
    <div class="section-bar-hold cta-mobile-bar"><Solaris text="Get in touch" /></div>
    <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
      <div class="container-page w-full">
        <CtaScene head="Enter new<br/>dimensions." href="/contact" linkLabel="explore_possibilities" pixelate={false} />
      </div>
    </FocusScroll>
  </div>

  {/* CTA is the same dark colour as the footer — drop the Solaris seam beam between them. */}
  <style is:global>
    .solaris:has(+ footer) { display: none; }
  </style>
</Layout>