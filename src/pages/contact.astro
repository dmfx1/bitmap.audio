---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import ContactHero from '../components/modules/ContactHero.tsx';
import ConceptGrid from '../components/modules/ConceptGrid.tsx';
import SocialsGrid from '@/components/modules/SocialsGrid';
import CTA from '../components/modules/CTA.tsx';

const contactCards = [
  {
    title: "EMAIL US",
    subtitle: "hello@bitmap.audio",
    desc: "For project inquiries, collaborations, or just to say hello.",
    icon: "mail" 
  },
  {
    title: "LOCATION",
    subtitle: "Remote / Global",
    desc: "We work remotely with clients worldwide from our modular hubs.",
    icon: "map"
  }
];
---

<Layout title="bitmap.audio | contact">
  <Section id="hero" delay="0.1s">
    <ContactHero client:load />
  </Section>

  <Section id="details" delay="0.5s">
    <ConceptGrid
      client:visible
      items={contactCards}
      className="py-0"
      mobileGlow={true}
    />
  </Section>

  <Section id="socials" delay="1.2s">
    <SocialsGrid client:visible />
  </Section>
</Layout>