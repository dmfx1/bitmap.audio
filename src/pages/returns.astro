      <svg id="end-logo" width="48" height="56" viewBox="-1 0.5 7 8" shape-rendering="crispEdges" fill="hsl(var(--primary))" stroke="hsl(var(--primary))" stroke-width="0.25" class="animate-pulse-glow-svg" aria-hidden="true">
        <rect x="0" y="1" width="1" height="1" />
        <rect x="1" y="2" width="1" height="5" />
        <rect x="0" y="4" width="4" height="1" />
        <rect x="4" y="4" width="1" height="3" />
        <rect x="1" y="7" width="3" height="1" />
      </svg>
      <p class="font-mono text-xs uppercase tracking-[0.4em] text-muted-foreground">bitmap.audio</p>
      <div class="flex flex-col items-center gap-4 mt-4">
        <a href="/home" class="font-mono text-xs uppercase tracking-widest text-accent hover:brightness-125 transition-all">
          ← Return to Site
        </a>
        <a href="/contact" class="font-mono text-sm uppercase tracking-widest text-primary/60 hover:text-primary transition-colors">
          Start a Project
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  const initStickyScroll = () => {
    const strip = document.querySelector("#horizontal-strip") as HTMLElement;
    const track = document.querySelector("#scroll-track") as HTMLElement;
    const indicators = gsap.utils.toArray(".indicator-line") as HTMLElement[];

    const parallaxGrid = document.querySelector("#parallax-grid");
    // Grab the new fading phone layer
    const phoneFadeLayer = document.querySelector("#phone-fade-layer");
    const bookFadeLayer = document.querySelector("#book-fade-layer"); // NEW
    const baseHandsLayer = document.querySelector("#base-hands-layer"); // NEW
    
    // Grab the new Train layer
    const trainFadeLayer = document.querySelector("#train-fade-layer"); // NEW

    // Grab the new SVG Data Map elements
    const dataPaths = gsap.utils.toArray(".data-path");
    const dataNodes = gsap.utils.toArray(".data-node");

    const visualsFadeText = document.querySelector("#visuals-fade-text"); // NEW
    const soundGrowText = document.querySelector("#sound-grow-text"); // NEW

    // Grab the tiger image
    const tigerFocusLayer = document.querySelector("#tiger-focus-layer");

    // METRICS SECTION ANIMATIONS (Pressure Line & Sliding Cards)
    const metricsSection = document.querySelector("#metrics-section") as HTMLElement;
    const pressureLine = document.querySelector("#pressure-line");
    const statCards = gsap.utils.toArray(".stat-card") as HTMLElement[];

    // AMPLIFIED ROI SECTION ANIMATION
    const roiSection = document.querySelector("#roi-section") as HTMLElement;
    const roiCounter = document.querySelector("#roi-counter") as HTMLElement;
    const roiWrapper = document.querySelector("#roi-text-wrapper");
    const roiGhosts = gsap.utils.toArray(".roi-ghost") as HTMLElement[];
    const roiWaves = gsap.utils.toArray(".roi-wave") as HTMLElement[];
    const roiWord = document.querySelector("#roi-word");
    const ghostCounters = document.querySelectorAll(".ghost-counter");

    //Success Counter Elements
    const successSection = document.querySelector("#success-section") as HTMLElement; // Add 'as HTMLElement'
    const successCounter = document.querySelector("#task-success-counter") as HTMLElement; // Add this too for good measure
    const successRing = document.querySelector("#success-ring") as SVGElement;


    if (!strip || !track) return;

    const isMobile = window.innerWidth < 768;

    if (isMobile) {
      document.documentElement.classList.add('is-mobile-snap');
      // Adjust data map SVG viewBox to better fill 9:16 portrait
      const archSvg = document.querySelector('section[data-sidebar="2"] svg');
      if (archSvg) {
        archSvg.setAttribute('viewBox', '80 250 480 860');
      }
      return;
    }

    // Returns an absolute scroll position as a fraction of the total scrollable range,
    // so all triggers scale correctly regardless of track height.
    const scrollAt = (fraction: number) => (track.offsetHeight - window.innerHeight) * fraction;

    gsap.to(strip, {
      x: () => -(strip.scrollWidth - window.innerWidth),
      ease: "none",
      scrollTrigger: {
        trigger: track,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.5, 
      }
    });

    if (parallaxGrid) {
      gsap.to(parallaxGrid, {
        y: "-50vh", 
        ease: "none",
        scrollTrigger: {
          trigger: track,
          start: "top top",
          end: "bottom bottom",
          scrub: 0.1, 
        }
      });
    }

    // Measure where each sidebar section actually centers horizontally,
    // then resize asides and set indicator triggers to match those real positions.
    const sidebarEl = document.getElementById('sidebar-track') as HTMLElement;
    const sidebarAsides = sidebarEl ? (Array.from(sidebarEl.querySelectorAll('aside')) as HTMLElement[]) : [];
    const sidebarSections = (Array.from(strip.querySelectorAll('[data-sidebar]')) as HTMLElement[])
      .sort((a, b) => parseInt(a.dataset.sidebar!) - parseInt(b.dataset.sidebar!));

    const totalH = strip.scrollWidth - window.innerWidth;
    const totalV = track.offsetHeight - window.innerHeight;

    // Vertical scroll position at which each section is horizontally centered
    const sectionScrollPos = sidebarSections.map(sec => {
      const centerH = sec.offsetLeft + sec.offsetWidth / 2 - window.innerWidth / 2;
      return Math.max(0, (centerH / totalH) * totalV);
    });

    // Resize each aside so its vertical center is at the viewport midpoint
    // exactly when scrollY equals that section's horizontal center position.
    let cumTop = 0;
    sidebarAsides.forEach((aside, i) => {
      if (i >= sectionScrollPos.length) return;
      const targetDocCenter = sectionScrollPos[i] + window.innerHeight / 2;
      const height = Math.max(window.innerHeight * 0.5, 2 * (targetDocCenter - cumTop));
      aside.style.height = `${height}px`;
      cumTop += height;
    });

    // Indicator lines animate across each section's scroll window
    indicators.forEach((ind, i) => {
      if (i >= sectionScrollPos.length) return;
      const start = sectionScrollPos[i];
      const end = i + 1 < sectionScrollPos.length ? sectionScrollPos[i + 1] : totalV;
      gsap.to(ind, {
        scaleY: 1,
        ease: "none",
        scrollTrigger: {
          trigger: track,
          start: `${start}px top`,
          end: `${end}px top`,
          scrub: true,
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      const slideHeight = window.innerHeight;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        window.scrollBy({ top: slideHeight, behavior: 'smooth' });
      } 
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        window.scrollBy({ top: -slideHeight, behavior: 'smooth' });
      }
    });

    // THE 3-STEP STAGGERED FADE LOGIC (Woman on Left)
    if (phoneFadeLayer && bookFadeLayer && baseHandsLayer) {
      
      // PHASE 1: Fade the phone OUT quickly
      gsap.fromTo(phoneFadeLayer, 
        { opacity: 1 }, 
        {
          opacity: 0,   
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: "top -33%",   
            end: "top -35%",    
            scrub: true,
          }
        }
      );

      // PHASE 2A: Fade the book IN
      gsap.fromTo(bookFadeLayer, 
        { opacity: 0 }, 
        {
          opacity: 1,   
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: "top -35%",  
            end: "top -40%",    
            scrub: true,
          }
        }
      );

      // PHASE 2B: Fade the empty hands OUT at the exact same time
      gsap.fromTo(baseHandsLayer, 
        { opacity: 1 }, 
        {
          opacity: 0,   
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: "top -40%",  // Exactly matches the book fade IN start
            end: "top -50%",    // Exactly matches the book fade IN end
            scrub: true,
          }
        }
      );
    }

    // NEW Train Image Fade (Context Section - Right Side)
    if (trainFadeLayer) {
      gsap.fromTo(trainFadeLayer,
        { opacity: 0 },
        {
          opacity: 0.8, // Match established mix-blend opacity
          ease: "none",
          scrollTrigger: {
            trigger: track,
            // Start fading in after arriving securely in Section 01
            start: () => `${scrollAt(0.07)}px top`,
            end: () => `${scrollAt(0.12)}px top`,
            scrub: true,
          }
        }
      );
    }

    if (dataPaths.length > 0) {
      
      dataPaths.forEach((path: any) => {
        const length = path.getTotalLength();
        gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
      });

      // 1. FADE THE NODES (Clean reveal, no 'flying in')
      gsap.fromTo(dataNodes, 
        { opacity: 0 }, // Just start hidden
        {
          opacity: 1, 
          stagger: 0.08, // Subtle sweep
          ease: "none", // Linear fade feels more 'technical'
          scrollTrigger: {
            trigger: track,
            start: () => `${scrollAt(0.11)}px top`,
            end: () => `${scrollAt(0.13)}px top`,
            scrub: true,
          }
        }
      );

      // 2. DRAW THE PATHS (To match the nodes)
      gsap.to(dataPaths, {
        strokeDashoffset: 0, 
        stagger: 0.1, 
        ease: "power1.inOut",
        scrollTrigger: {
          trigger: track,
          start: () => `${scrollAt(0.12)}px top`,
          end: () => `${scrollAt(0.17)}px top`,
          scrub: true,
        }
      });
    }

    // Biologically Faster Sound (Blur to Focus underlay - Tiger Section)
    if (tigerFocusLayer) {
      gsap.fromTo(tigerFocusLayer,
        { 
          opacity: 0, 
          filter: "blur(30px)", // Starts extremely blurry
        },
        {
          opacity: 0.8,         
          filter: "blur(0px)",  // Snaps into sharp focus
          scale: 1,             
          ease: "power2.out",
          scrollTrigger: {
            trigger: track,
            // Trigger 2.8 screens down (As the Processing Speed section slides in)
            start: () => `${scrollAt(0.18)}px top`,
            end: () => `${scrollAt(0.27)}px top`,
            scrub: true,
          }
        }
      );
    }

    // Thematic Fade for "Visuals Fade" text
    if (visualsFadeText) {
      gsap.fromTo(visualsFadeText,
        { opacity: 1 },
        {
          opacity: 0.05, // Fades to barely visible (or set to 0 to completely vanish)
          ease: "none",
          scrollTrigger: {
            trigger: track,
            // Starts fading as the section reaches the center of the screen
            start: () => `${scrollAt(0.27)}px top`,
            end: () => `${scrollAt(0.32)}px top`,
            scrub: true,
          }
        }
      );
    }

    // 1. Your existing scale logic (leave this exactly as is)
    if (soundGrowText) {
      gsap.fromTo(soundGrowText,
        { scale: 1 },
        {
          scale: 1.2, 
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${scrollAt(0.275)}px top`,
            end: () => `${scrollAt(0.35)}px top`,
            scrub: true,
          }
        }
      );

      // 2. NEW: The continuous vibration effect
      gsap.to(soundGrowText, {
        x: 2,                 // Move 3px to the right
        duration: 0.05,       // Extremely fast (20 times per second)
        repeat: -1,           // Loop infinitely
        yoyo: true,           // Ping-pong back and forth (0 to 3 to 0 to -3...)
        ease: "sine.inOut",   // Smooth direction changes
        scrollTrigger: {
          trigger: track,
          start: () => `${scrollAt(0.3)}px top`,
          end: () => `${scrollAt(0.6)}px top`,
          // Instead of scrubbing, just play/pause the vibration based on visibility
          toggleActions: "play pause resume pause" 
        }
      });
    }

    if (metricsSection && pressureLine && statCards.length > 0) {
      
      // Helper function
      const getScrollPos = (horizontalPos: number) => {
        const totalHorizontal = strip.scrollWidth - window.innerWidth;
        const totalVertical = track.offsetHeight - window.innerHeight;
        return (horizontalPos / totalHorizontal) * totalVertical;
      };

      // 1. Draw the "Pressure" Line
      gsap.fromTo(pressureLine,
        { width: "0%" },
        {
          width: "100%",
          ease: "none",
          scrollTrigger: {
            trigger: track,
            // Start drawing when section is entering
            start: () => `${getScrollPos(metricsSection.offsetLeft - window.innerWidth * 0.4)}px top`,
            // Finish drawing exactly when centered
            end: () => `${getScrollPos(metricsSection.offsetLeft - window.innerWidth * 0.1)}px top`,
            scrub: true,
          }
        }
      );

      // 2. Slide the Cards out horizontally (Locked to physical screen center)
      if (statCards.length > 1) {
        
        // Calculate the total physical distance the cards will fan out (300px per card)
        const cardOffset = 300;
        const maxDealDistance = (statCards.length - 1) * cardOffset; 
        
        // Create a single timeline to sequence the animations
        const cardTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: track,
            // START: When the base card hits exactly the center of the screen
            start: () => `${getScrollPos(metricsSection.offsetLeft - window.innerWidth * 0.2)}px top`,
            // END: Exactly when the physical location of the final card hits the center
            end: () => `${getScrollPos(metricsSection.offsetLeft + maxDealDistance - window.innerWidth * 0.5)}px top`,
            scrub: 1, 
          }
        });

        // Loop through the cards, starting at index 1 (the second card)
        for (let i = 1; i < statCards.length; i++) {
          
          // Select the current card AND all cards underneath it
          const movingStack = statCards.slice(i); 
          
          // Add a step to the timeline
          cardTimeline.to(movingStack, {
            x: i * cardOffset, // Move the stack out 300px
            ease: "none", // CRITICAL: Use "none" so the movement perfectly tracks your scroll wheel 1:1
          });
        }
      }
    } // Ensure this closing brace is here!

    if (roiSection && roiCounter && roiWrapper) {
      const roiObj = { val: 1.0 };
      
      const getScrollPos = (horizontalPos: number) => {
        const totalHorizontal = strip.scrollWidth - window.innerWidth;
        const totalVertical = track.offsetHeight - window.innerHeight;
        return (horizontalPos / totalHorizontal) * totalVertical;
      };

      // Create a master timeline for the whole "Amplification" sequence
      const roiTl = gsap.timeline({
        scrollTrigger: {
          trigger: track,
          // DELAYED START: Wait until the right column is actually visible
          start: () => `${getScrollPos(roiSection.offsetLeft - window.innerWidth * 0.3)}px top`,
          // DELAYED END: Finish deep into the section so you have time to watch it
          end: () => `${getScrollPos(roiSection.offsetLeft + window.innerWidth * 0.6)}px top`,
          scrub: 1, 
        }
      });

      // 0. NEW: Scale the word "ROI." from small (50%) to full size (100%)
      if (roiWord) {
        roiTl.fromTo(roiWord, 
          { scale: 0.5, opacity: 0.5 }, 
          { scale: 1, opacity: 1, ease: "power2.out" }, 
        0); 
      }

      // 1. The Counter: 1.0 to 4.0
      roiTl.to(roiObj, {
        val: 4.0,
        ease: "none",
        onUpdate: () => {
          const currentText = roiObj.val.toFixed(1); 
          
          // Update the main center number
          roiCounter.innerText = currentText; 
          
          // Update the blurred ghost outlines so they count up in perfect sync!
          roiGhosts.forEach(ghost => {
            ghost.innerText = currentText + "x";
          });
        }
      }, 0);

      // 2. (Main Wrapper scale remains unchanged)
      roiTl.fromTo(roiWrapper, 
        { scale: 0.3, opacity: 0 },
        { scale: 1, opacity: 1, ease: "power2.out" }, 
      0);

      // 3. NEW: The Halo Bloom. Ghosts scale centrally behind the main number.
      roiGhosts.forEach((ghost, i) => {
         // Deep blur (index 0) starts HUGE and completely faint.
         // Mid blur (index 1) starts slightly smaller.
         const startScale = i === 0 ? 3 : 2; 
         
         roiTl.fromTo(ghost,
           { 
            // Pinned centrally (x: 0, y: 0)
            x: 0, y: 0, rotation: 0,
            scale: startScale, // Start huge
            opacity: 0,       // Start invisible
           },
           { 
            scale: 1,         // Settle to their HTML defined large size
            opacity: 1,       // Become visible blurred outlines
            ease: "power3.out" 
           },
         0);
      });

      // 4. (Shockwaves remain unchanged)
      roiWaves.forEach((wave, i) => {
         roiTl.to(wave, {
            width: `${60 + (i * 30)}vw`,
            height: `${60 + (i * 30)}vw`,
            opacity: 0, 
            ease: "power2.out"
         }, 0);
      });
    }

    // SUCCESS COUNTER LOGIC
    if (successCounter && successSection && successRing) {

      const getScrollPos = (horizontalPos: number) => {
        const totalHorizontal = strip.scrollWidth - window.innerWidth;
        const totalVertical = track.offsetHeight - window.innerHeight;
        return (horizontalPos / totalHorizontal) * totalVertical;
      };

      // The exact physical scroll window:
      // Starts when the counter enters the right edge (0.5)
      // Ends exactly when it hits dead-center of the screen (0.85)
      const startTrigger = () => `${getScrollPos(successSection.offsetLeft + window.innerWidth * 0.25)}px top`;
      const endTrigger = () => `${getScrollPos(successSection.offsetLeft + window.innerWidth * 0.95)}px top`;

      // 1. Natively animate the SVG Ring
      gsap.fromTo(successRing,
        { strokeDashoffset: 282.7 },
        {
          strokeDashoffset: 0, // 0 means the stroke covers the entire circle!
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: startTrigger,
            end: endTrigger,
            scrub: true,
          }
        }
      );

      // 2. Natively animate the Number using GSAP's text snapping
      gsap.fromTo(successCounter,
        { innerText: 0 },
        {
          innerText: 25,
          snap: { innerText: 1 }, // Forces GSAP to only render clean whole numbers
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: startTrigger,
            end: endTrigger,
            scrub: true,
          }
        }
      );
    }

    // END SCREEN — logo colour shift on arrival, fades back to primary
    // Triggered directly on #end-screen (normal document flow, not tied to scroll track)
    const endScreen = document.querySelector("#end-screen") as HTMLElement;
    const endLogoEl = document.querySelector("#end-logo") as Element;

    if (endScreen && endLogoEl) {
      // Logo shifts cyan → amber → cyan as the end screen scrolls into view
      gsap.timeline({
        scrollTrigger: {
          trigger: endScreen,
          start: "top 75%",
          end: "top 15%",
          scrub: 0.5,
        }
      })
      .to(endLogoEl, {
        attr: { fill: "hsl(var(--accent))", stroke: "hsl(var(--accent))" },
        ease: "power2.out",
        duration: 0.5,
      })
      .to(endLogoEl, {
        attr: { fill: "hsl(var(--primary))", stroke: "hsl(var(--primary))" },
        ease: "power2.in",
        duration: 0.5,
      }, 0.6);
    }
  };

  document.addEventListener('astro:page-load', initStickyScroll);
  if (document.readyState === 'complete') initStickyScroll();
  else window.addEventListener('load', initStickyScroll);

</script>

<style is:global>
  html.is-mobile-snap {
    scroll-snap-type: y mandatory;
  }

  html.is-mobile-snap #scroll-track {
    height: auto !important;
  }

  html.is-mobile-snap #scroll-track > .sticky {
    position: static !important;
    height: auto !important;
    overflow: visible !important;
  }

  html.is-mobile-snap body {
    overflow-x: hidden;
  }

  html.is-mobile-snap #horizontal-strip {
    flex-direction: column !important;
    width: 100vw !important;
    height: auto !important;
  }

  html.is-mobile-snap #horizontal-strip > section {
    width: 100vw !important;
    max-width: 100vw !important;
    height: 100dvh !important;
    min-height: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* REMOVED: display, flex-direction, justify-content — was breaking hidden sections */
    /* padding-right intentionally removed — controlled per content div */
  }

  /* Consistent mobile typography baseline */
  html.is-mobile-snap #horizontal-strip > section p {
    font-size: 1.25rem;
    line-height: 1.75rem;
    margin-top: 0.5rem;
  }

  html.is-mobile-snap #horizontal-strip > section h2 {
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-top: 0.75rem;
    margin-bottom: 1.75rem;
  }

  html.is-mobile-snap #horizontal-strip > section .text-eyebrow {
    margin-bottom: 1.5rem;
  }
</style>