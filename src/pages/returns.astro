---
import Layout from '../layouts/Layout.astro';
import { Button } from "@/components/ui/button";

// The 11 sections mapped strictly for the sidebars
const sections = [
  { id: "00", label: "Status" },
  { id: "01", label: "Context" },
  { id: "02", label: "Architecture" },
  { id: "03", label: "Neurology.Processing" },
  { id: "04", label: "Neurology.Memory" },
  { id: "05", label: "Metrics" },
  { id: "06", label: "Conversion" },
  { id: "07", label: "Credibility" },
  { id: "08", label: "Credibility.Trust" },
  { id: "09", label: "Perception" },
  { id: "10", label: "Culture" },
  { id: "11", label: "Asset.Ownership" },
  { id: "12", label: "Belief" },
  { id: "13", label: "Execution" }
];
---

<Layout
  title="The ROI of Audio Branding | bitmap.audio"
  description="Audio branding delivers 4x brand recall, 25% credibility lift, and measurable conversion gains. Explore the data behind sonic identity."
>
  <main class="bg-background text-foreground selection:bg-accent selection:text-foreground">
    
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
      <div id="parallax-grid" class="absolute top-0 left-0 w-full h-[200vh] bitmap-grid opacity-[0.05] will-change-transform"></div>
      
    </div>

    <div id="scroll-track" class="relative w-full h-[1600vh]">
      
      <div id="sidebar-track" class="absolute left-0 top-0 w-24 h-full z-50 pointer-events-none hidden md:flex flex-col">
        {sections.map((sec, index) => (
          <aside class="h-screen w-full border-r border-border/20 bg-background/80 backdrop-blur-md flex flex-col items-center justify-center gap-8 shadow-[20px_0_40px_-15px_rgba(0,0,0,0.5)]">
            <span class="font-mono text-muted-foreground text-[10px] tracking-widest rotate-180 [writing-mode:vertical-lr] uppercase">{sec.label}</span>
            <div class="h-48 w-[1px] bg-border/30 relative">
              <div class="indicator-line absolute top-0 w-[3px] -left-[1px] bg-accent shadow-[0_0_15px_hsl(var(--accent))] origin-top scale-y-0"></div>
            </div>
            <span class="font-mono text-accent text-[10px]">{sec.id}</span>
          </aside>
        ))}
      </div>

      <div class="sticky top-0 w-full h-screen overflow-hidden pointer-events-auto">
        
        <div id="horizontal-strip" class="flex w-max h-full will-change-transform">

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 00 | Status | DESKTOP WIDTH: w-screen
               "Your brand is Muted." | data-sidebar="0"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-00 | Status | w-screen -->
          <section data-sidebar="0" class="relative w-[75vw] h-full flex-shrink-0 flex flex-col justify-center items-center pl-4 md:pl-0 pr-4 group bg-background z-10 mobile:pl-0">
            <!-- Mobile background image — woman reading, bottom-right -->
            <div class="md:hidden absolute bottom-0 right-0 w-[75vw] h-[70vh] pointer-events-none z-0">
              <img src="/images/listening.woman2.emptyBook.webp" decoding="async" alt=""
                   class="w-full h-full object-contain object-right-bottom opacity-40" />
            </div>
            <div class="mobile:hidden absolute -right-20 bottom-0 text-[35vw] font-mono font-bold text-muted/5 select-none pointer-events-none transition-transform duration-1000 group-hover:scale-105 z-0">00</div>
            <div class="relative z-10 pl-8 py-2">
              <span class="text-eyebrow text-sm mb-8 mobile:mb-3 block">[ Status // Critical ]</span>
              <h2 class="font-mono text-6xl mobile:text-5xl md:text-[8vw] leading-[0.9] tracking-tighter mb-12 mobile:mb-6 uppercase text-foreground">
                Your brand<br/>is <span class="text-accent drop-shadow-[0_0_20px_hsl(var(--accent)/0.3)]">Muted.</span>
              </h2>
              <div class="w-full max-w-2xl bg-background/60 p-6 border-l-2 border-accent">
                <p class="font-sans text-xl mobile:text-xl md:text-2xl text-muted-foreground leading-relaxed">
                  Visuals reach the eyes, but sound hits the nervous system. Competing on screens alone is a losing battle. It's time to weaponise your audio.
                </p>
              </div>
            </div>
          </section>

          <!-- #endregion SLIDE-00 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 0.5 | Woman Image | DESKTOP WIDTH: w-[50vw]
               Listening woman image sequence (phone→book fade via GSAP)
               DESKTOP ONLY (hidden md:flex) | no sidebar
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-0.5 | Woman Image | w-[50vw] | DESKTOP ONLY -->
          <section class="hidden md:flex w-[50vw] h-full md:items-center flex-shrink-0 relative bg-background z-10">
            <div class="absolute top-0 left-0 w-full h-full flex items-end justify-start pointer-events-none opacity-80 mix-blend-screen z-0">
              <div class="relative w-full max-w-2xl -mb-10">
                <img id="base-hands-layer" src="/images/listening.woman2.emptyHands.webp" decoding="async" alt="Woman listening" class="w-full h-auto object-contain object-bottom" />
                <img id="book-fade-layer" src="/images/listening.woman2.emptyBook.webp" decoding="async" alt="Book appearing" class="absolute inset-0 w-full h-auto object-contain object-bottom opacity-0" />
                <img id="phone-fade-layer" src="/images/listening.woman2.webp" decoding="async" alt="Phone disappearing" class="absolute inset-0 w-full h-auto object-contain object-bottom opacity-0" />
              </div>
            </div>
          </section>

          <!-- #endregion SLIDE-0.5 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 01 | Context | DESKTOP WIDTH: w-[50vw] (mobile: w-screen)
               "When everyone is listening." + train fade | data-sidebar="1"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-01 | Context | w-screen md:w-[50vw] -->
          <section data-sidebar="1" class="w-screen md:w-[66vw] h-full flex-shrink-0 flex items-center relative group bg-background z-20">

            <div class="mobile:hidden absolute right-0 bottom-0 text-[35vw] font-mono font-bold text-muted/5 select-none pointer-events-none z-0">01</div>

            <div id="train-fade-layer" class="absolute bottom-0 right-0 w-[33vw] h-full z-0 opacity-0 pointer-events-none mix-blend-screen flex items-end justify-end">
                <img src="/images/listening.woman2.train.webp" decoding="async" alt="Woman and Train" class="w-full h-full object-contain object-right-bottom" />
            </div>

            <div class="w-full flex justify-center mobile:justify-start pr-8 mobile:px-4 md:pr-12 relative z-10">
                <div class="max-w-2xl border-l-2 border-accent pl-8 py-2 bg-background/20 backdrop-blur-sm relative z-10">
                    <span class="text-eyebrow text-sm mb-8 mobile:mb-3 block text-primary">[ Context // Always_On ]</span>
                    <h2 class="font-mono text-5xl md:text-6xl leading-tight mb-8 mobile:mb-4 uppercase text-foreground">When everyone<br/><span class="text-primary drop-shadow-[0_0_20px_hsl(var(--primary)/0.3)]">is listening.</span></h2>
                    <p class="font-sans text-xl text-muted-foreground leading-relaxed max-w-xl">
                      <span class="text-accent">The screenless audience</span> – 80% of consumers form brand memory via audio cues. If you lack an audio-first identity, you have no presence in the moments when eyes are diverted.
                    </p>
                </div>
            </div>
          </section>

          <!-- #endregion SLIDE-01 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 02 | Architecture | DESKTOP WIDTH: w-[150vw]
               SVG data map path-draw animation | data-sidebar="2"
               Layout: flex row — 3 zones (gap · text · diagram · gap)
               Tweak widths here: gap-left=12vw, text=28vw, svg=80vw, gap-right=30vw
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-02 | Architecture SVG | w-[150vw] -->
          <section data-sidebar="2" class="w-[150vw] h-full flex-shrink-0 flex flex-row items-center border-r border-border/20 bg-primary/80 overflow-hidden group z-10">

            <!-- MOBILE: stacked layout — SVG behind, text in front -->
            <div class="md:hidden absolute inset-0 pointer-events-none z-0 opacity-30">
              <svg viewBox="80 250 480 860" class="w-full h-full overflow-visible">
                <g class="stroke-accent" fill="none" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter">
                  <path class="data-path" d="M100,300 H200 V400 H100 Z" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M150,300 V400 M100,350 H200" />
                  <path class="data-path" d="M200,400 H300 V900 H200 Z" />
                  <path class="data-path" d="M250,400 V900" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M200,500 H300 M200,600 H300 M200,700 H300 M200,800 H300" />
                  <path class="data-path" d="M300,500 H600 V800 H500 V900 H300" />
                  <path class="data-path" d="M300,600 H500 V800 H300" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,550 H600" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,850 H500" />
                  <path class="data-path" d="M400,500 V600 M400,800 V900" />
                  <path class="data-path" d="M500,500 V800" />
                  <path class="data-path" d="M500,600 H600 M500,700 H600" />
                </g>
                <g class="fill-accent">
                  <circle class="data-node" cx="100" cy="300" r="4" />
                  <circle class="data-node" cx="200" cy="300" r="6" />
                  <circle class="data-node" cx="150" cy="350" r="3" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="200" cy="400" r="10" />
                  <circle class="data-node" cx="200" cy="600" r="5" />
                  <circle class="data-node" cx="200" cy="900" r="8" />
                  <circle class="data-node" cx="300" cy="400" r="4" />
                  <circle class="data-node" cx="300" cy="600" r="7" />
                  <circle class="data-node" cx="400" cy="500" r="5" />
                  <circle class="data-node" cx="500" cy="500" r="9" />
                  <circle class="data-node" cx="600" cy="500" r="12" stroke="hsl(var(--accent))" stroke-width="3" />
                  <circle class="data-node" cx="400" cy="700" r="4" />
                  <circle class="data-node" cx="500" cy="800" r="6" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="600" cy="800" r="10" />
                  <circle class="data-node" cx="300" cy="900" r="5" />
                </g>
              </svg>
            </div>
            <div class="md:hidden flex flex-col justify-center px-8 relative z-10 border-l-2 border-accent ml-4">
              <span class="text-eyebrow text-sm mb-4 block text-background">[ Architecture // Recall ]</span>
              <h2 class="font-mono text-5xl leading-tight mb-6 uppercase text-foreground">Sound as a<br/><span class="text-accent">Data Map.</span></h2>
              <p class="font-sans text-xl text-background/80 leading-relaxed">Faster Neurological Processing and Lasting Memory.</p>
            </div>

            <!-- DESKTOP: three-zone flex row — change the w-[Xvw] values to adjust spacing -->

            <!-- Zone 1: Blue gap before text — increase to push text further right -->
            <div class="hidden md:block flex-shrink-0 w-[33vw]"></div>

            <!-- Zone 2: Text column -->
            <div class="hidden md:flex flex-shrink-0 w-[33vw] flex-col justify-center">
              <span class="text-eyebrow text-sm mb-8 block text-background">[ Architecture // Recall ]</span>
              <h2 class="font-mono text-8xl leading-tight mb-8 uppercase text-foreground">Sound as a<br/><span class="text-accent drop-shadow-[0_0_20px_hsl(var(--primary)/0.3)]">Data Map.</span></h2>
              <p class="font-sans text-xl text-background/80 leading-relaxed">
                Faster Neurological Processing and Lasting Memory.
              </p>
            </div>

            <!-- Zone 3: SVG diagram — increase w to make it larger, decrease to shrink -->
            <div class="hidden md:block flex-shrink-0 w-[80vw] h-[85vh] opacity-80">
              <svg viewBox="50 200 650 800" class="w-full h-full overflow-visible">
                <g class="stroke-accent" fill="none" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter">
                  <path class="data-path" d="M100,300 H200 V400 H100 Z" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M150,300 V400 M100,350 H200" />
                  <path class="data-path" d="M200,400 H300 V900 H200 Z" />
                  <path class="data-path" d="M250,400 V900" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M200,500 H300 M200,600 H300 M200,700 H300 M200,800 H300" />
                  <path class="data-path" d="M300,500 H600 V800 H500 V900 H300" />
                  <path class="data-path" d="M300,600 H500 V800 H300" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,550 H600" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,850 H500" />
                  <path class="data-path" d="M400,500 V600 M400,800 V900" />
                  <path class="data-path" d="M500,500 V800" />
                  <path class="data-path" d="M500,600 H600 M500,700 H600" />
                </g>
                <g class="fill-accent">
                  <circle class="data-node" cx="100" cy="300" r="4" />
                  <circle class="data-node" cx="200" cy="300" r="6" />
                  <circle class="data-node" cx="150" cy="350" r="3" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="200" cy="400" r="10" />
                  <circle class="data-node" cx="200" cy="600" r="5" />
                  <circle class="data-node" cx="200" cy="900" r="8" />
                  <circle class="data-node" cx="300" cy="400" r="4" />
                  <circle class="data-node" cx="300" cy="600" r="7" />
                  <circle class="data-node" cx="400" cy="500" r="5" />
                  <circle class="data-node" cx="500" cy="500" r="9" />
                  <circle class="data-node" cx="600" cy="500" r="12" stroke="hsl(var(--accent))" stroke-width="3" />
                  <circle class="data-node" cx="400" cy="700" r="4" />
                  <circle class="data-node" cx="500" cy="800" r="6" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="600" cy="800" r="10" />
                  <circle class="data-node" cx="300" cy="900" r="5" />
                </g>
              </svg>
            </div>

            <!-- Zone 4: Blue gap after diagram — increase for more blue breathing room on the right -->
            <div class="hidden md:block flex-shrink-0 w-[30vw]"></div>

          </section>

          <!-- #endregion SLIDE-02 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 03 | Neurology — Processing Speed | DESKTOP WIDTH: w-screen
               Tiger blur-to-focus animation | data-sidebar="3"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-03 | Neurology Processing | w-screen -->
          <section data-sidebar="3" class="w-[150vw] h-full flex-shrink-0 grid grid-cols-1 md:grid-cols-2 border-r border-border/20 bg-card/30 overflow-hidden relative group z-10 mobile:pl-0">

            <!-- Mobile background image — tiger, bottom-right -->
              <div class="md:hidden absolute bottom-0 right-0 w-[100vw] h-[100vh] pointer-events-none z-0">
                <img src="/images/stalking.sabretooth.webp" decoding="async" alt=""
                    class="w-full h-full object-contain object-right-bottom opacity-40" />
              </div>

            <div class="absolute right-30 -bottom-[20vh] w-[100vw] h-full flex items-end justify-end mix-blend-screen pointer-events-none z-0">
               <img id="tiger-focus-layer" src="/images/stalking.sabretooth.webp" decoding="async" alt="Sabretooth snapping a twig"
                    class="w-full h-auto object-contain object-right-bottom opacity-0 blur-[30px] transition-transform duration-1000 group-hover:scale-[1.02]" />
            </div>

            <div class="flex flex-col items-end mobile:items-start justify-center pl-4 pr-4 md:pl-54 md:pr-32 relative z-10 border-l border-border/20 bg-background/20">
              <div class="border-l-2 border-accent bg-background/20 ml-0 md:ml-36 pl-8 py-2">
                <span class="text-eyebrow text-sm mb-8 mobile:mb-3 block text-accent">[ Neurology // Processing_Speed ]</span>
                <h2 class="font-mono text-5xl md:text-6xl leading-tight mb-8 mobile:mb-4 uppercase">Faster than<br/><span class="text-accent">Sight.</span></h2>
                <p class="font-sans text-xl text-muted-foreground leading-relaxed mb-8">
                  Sound is a biological survival mechanism. It reaches the brain 2 to 4 times faster than visual stimuli.<br/><br/>It establishes recognition in just <strong>0.05 seconds</strong> making us aware of our surroundings before we even consciously "see" them.
                </p>
              </div>
            </div>
          </section>

          <!-- #endregion SLIDE-03 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 3.5 | Brain Speed Stat | DESKTOP WIDTH: w-[66vw]
               "8-10ms" stat interstitial | DESKTOP ONLY | no sidebar
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-3.5 | Brain Speed Stat | w-[66vw] | DESKTOP ONLY -->
          <section class="hidden md:flex w-[66vw] bg-primary/80 h-full flex-shrink-0 border-r border-border/20 overflow-hidden relative group z-10 flex-col justify-center">
            <div class="flex flex-col items-center justify-center w-full relative overflow-hidden pointer-events-none z-10 text-center">
               <div class="absolute inset-0 bg-gradient-glow opacity-10"></div>
               <h3 class="font-mono text-[12vw] leading-none text-foreground font-light tracking-tighter drop-shadow-md">
                 8<span class="text-primary">-</span>10<span class="text-2xl tracking-tight text-foreground">ms</span>
               </h3>
               <span class="font-mono text-foreground tracking-[0.5em] uppercase mt-4 drop-shadow-md">Brain Processing Speed</span>
            </div>
          </section>

          <!-- #endregion SLIDE-3.5 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 04 | Neurology — Echoic Memory | DESKTOP WIDTH: w-screen
               "Visuals fade. Sound echoes." + vibration animation | data-sidebar="4"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-04 | Neurology Memory | w-screen -->
          <section data-sidebar="4" class="w-screen h-full flex-shrink-0 flex flex-col justify-center items-center text-right pl-4 pr-4 md:px-48 relative border-r border-border/20 bg-accent/5 overflow-hidden group z-10 mobile:items-start mobile:text-right">
            <div class="absolute inset-0 radial-gradient-center opacity-20 pointer-events-none"></div>
            <div class="pl-8 py-2 max-w-4xl relative z-10 mobile:border-l-2 mobile:border-accent">
              <span class="text-eyebrow text-accent text-sm mb-8 mobile:mb-3 block">[ Neurology // Echoic_Memory ]</span>

              <h2 class="font-mono text-5xl mobile:text-5xl md:text-[6vw] leading-[1.1] tracking-tighter mb-8 mobile:mb-4 uppercase text-foreground">
                <span id="visuals-fade-text" class="inline-block mobile:opacity-40 mobile:text-[80%]">Visuals fade.</span><br/>
                <span id="sound-grow-text" class="text-primary inline-block origin-right">Sound echoes.</span>
              </h2>

              <p class="font-sans text-2xl mobile:text-xl text-muted-foreground leading-relaxed">
                Auditory sensory memory persists for 2-5 seconds - <strong>10 to 20 times longer</strong> than visual memory. It shows significantly better resistance to decay and triggers emotional encoding via the limbic system.
              </p>
            </div>
          </section>

          <!-- #endregion SLIDE-04 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 4.5 | Memory Retention Stat | DESKTOP WIDTH: w-[66vw]
               "20x" stat interstitial | DESKTOP ONLY | no sidebar
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-4.5 | Memory Retention Stat | w-[66vw] | DESKTOP ONLY -->
          <section class="hidden md:flex w-[66vw] bg-foreground/80 h-full flex-shrink-0 border-r border-border/20 overflow-hidden relative group z-10 flex-col justify-center">
            <div class="flex flex-col items-center justify-center w-full relative overflow-hidden pointer-events-none z-10 text-center">
               <div class="absolute inset-0 bg-gradient-glow opacity-10"></div>
               <h3 class="font-mono text-[12vw] leading-none text-foreground font-light tracking-tighter drop-shadow-md">
                 20<span class="tracking-tight text-foreground">x</span>
               </h3>
               <span class="font-mono text-background/50 tracking-[0.5em] uppercase mt-4 drop-shadow-md">Longer Memory Retention</span>
            </div>
          </section>

          <!-- #endregion SLIDE-4.5 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 05 | Metrics | DESKTOP WIDTH: w-screen
               "Recall under Pressure." + fanning stat cards | data-sidebar="5"
               Desktop uses hidden md:flex — mobile has separate slides below
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-05 | Metrics | w-screen | DESKTOP + MOBILE VARIANTS -->
          <section id="metrics-section" data-sidebar="5" class="w-screen h-full flex-shrink-0 hidden md:flex items-center justify-center pl-4 pr-4 md:pl-48 relative border-r border-border/20 bg-card/20 overflow-hidden group z-10">
            <div class="w-full max-w-5xl border-l-2 border-accent pl-8 py-2">
              <span class="text-eyebrow text-sm mb-8 block">[ Metrics // Awareness ]</span>
              
              <h2 class="font-mono text-5xl md:text-7xl leading-[0.9] tracking-tighter mb-16 uppercase text-foreground relative inline-block">
                Recall under<br/>
                <span class="text-accent relative inline-block">
                  Pressure.
                  <div id="pressure-line" class="absolute bottom-0 left-0 h-[4px] bg-accent w-0 origin-left"></div>
                </span>
              </h2>
              
              <div class="relative w-full h-[250px] mt-8">
                
                <div class="stat-card absolute left-0 top-0 w-[280px] h-full border border-border/50 p-8 bg-background/90 backdrop-blur hover:border-accent transition-colors z-[4]">
                  <span class="font-mono text-4xl text-accent block mb-4">191%</span>
                  <p class="font-sans text-muted-foreground text-sm leading-relaxed">Lift in brand awareness within the first two seconds of exposure.</p>
                </div>
                
                <div class="stat-card absolute left-0 top-0 w-[280px] h-full border border-border/50 p-8 bg-background/90 backdrop-blur hover:border-accent transition-colors z-[3]">
                  <span class="font-mono text-4xl text-accent block mb-4">12x</span>
                  <p class="font-sans text-muted-foreground text-sm leading-relaxed">More efficient at driving business results than visual-only advertising.</p>
                </div>
                
                <div class="stat-card absolute left-0 top-0 w-[280px] h-full border border-border/50 p-8 bg-background/90 backdrop-blur hover:border-accent transition-colors z-[2]">
                  <span class="font-mono text-4xl text-accent block mb-4">30%</span>
                  <p class="font-sans text-muted-foreground text-sm leading-relaxed">Brand recall delivered even during "highly distracted" environments.</p>
                </div>
                
                <div class="stat-card absolute left-0 top-0 w-[280px] h-full border border-border/50 p-8 bg-background/90 backdrop-blur hover:border-accent transition-colors z-[1]">
                  <span class="font-mono text-4xl text-accent block mb-4">78%</span>
                  <p class="font-sans text-muted-foreground text-sm leading-relaxed">Recall rate when listeners are actively tuned into audio advertising.</p>
                </div>
              </div>
            </div>
          </section>

          <!-- Mobile: Recall Under Pressure heading slide -->
