---
import Layout from '../layouts/Layout.astro';
import { Button } from "@/components/ui/button";

// ═══════════════════════════════════════════════════════════════════════════════
// SLIDE CONFIG — edit widths, animation timings, and key values here.
// Do not edit anywhere else for these values.
//
// width:      desktop slide width (vw string). Mobile is always "100vw".
//             Changing this here automatically updates layout + GSAP timing.
//
// anim:       scroll-driven animation timing, as viewport-width multipliers
//             relative to each slide's left edge.
//             Negative = before slide enters screen (-0.9 = 90vw ahead of entry).
//             Positive = after slide left edge has passed viewport left edge.
//             Rule: start ≈ -0.9 (just entering right), end ≈ -0.2 to 0 (at mid-screen).
//             scrub: how elastic the animation feels on scroll (0.1 = snappy, 1 = laggy).
//
// counter:    for animated number values (ROI, success ring) — change the numbers here.
// ═══════════════════════════════════════════════════════════════════════════════
const sections = [
  { id: "00", label: "Status",               width: "90vw"  },
  { id: "01", label: "Context",              width: "66vw",  anim: {
    trainFade:   { start: -0.5,  end: -0.0,  scrub: 1 },
  }},
  { id: "02", label: "Architecture",         width: "110vw", anim: {
    nodes:       { start: -0.85, end: 0.5, scrub: 0.5 },
    paths:       { start: -0.75, end: 0.3, scrub: 0.5 },
  }},
  { id: "03", label: "Neurology.Processing", width: "200vw", anim: {
    tigerFocus:  { start: -0.5,  end:  1.5,  scrub: 1 },
  }},
  { id: "04", label: "Neurology.Memory",     width: "100vw", anim: {
    visualsFade: { start: -0.85, end: -0.2,  scrub: 0.5 },
    soundGrow:   { start: -0.8,  end: -0.1,  scrub: 0.5 },
    vibration:   { start: -0.5,  end:  1.0,  scrub: 0.5 },
  }},
  { id: "05", label: "Metrics",              width: "150vw", anim: {
    pressureLine: { start: -0.4, end: -0.1, scrub: 0.5 },
    statCards:    { start: -0.5, end: -0.0, scrub: 0, cardSpacing: 300 },
  }},
  { id: "06", label: "Conversion",           width: "75vw",  anim: {
    roiGrow: { start: -0.8, end: 0.3, scrub: 1 },
  }},
  { id: "07", label: "Credibility",          width: "75vw"  },
  { id: "08", label: "Perception",           width: "100vw" },
  { id: "09", label: "Culture",              width: "125vw" },
  { id: "10", label: "Asset.Ownership",      width: "125vw" },
  { id: "11", label: "Belief",               width: "75vw"  },
  { id: "12", label: "Execution",            width: "100vw" },
];

// Separate tunables for counter animations (not tied to a sidebar entry)
const COUNTERS = {
  roi: {
    from: 1.0, to: 4.0, decimals: 1,
    // timing: vw multipliers relative to roi-section's left edge
    start: -0.7,   // counter starts when roi-section is 30vw before its left edge enters screen
    end: -0.3,      // counter finishes when roi-section has scrolled 60vw past screen left
    scrub: true,   // must be true (not a number) — numeric scrub lags and counter never reaches target
  },
  success: {
    to: 25,
    start: -0.7,   // ring starts filling when section is 25vw past screen left
    end: -0.2,     // ring reaches target at 95vw past screen left
    scrub: true,   // must be true — numeric scrub causes ring to freeze short of 25%
  },
};
// Word highlight config — words that shift colour as their slide scrolls in.
// 'words' must match id="hl-{word}" attributes added to <span> elements in the template.
// start/end: vw multipliers relative to the slide's left edge (same convention as anim entries).
const HIGHLIGHTS = {
  untapped: {
    words: ["untapped", "loyalty", "purchasing", "decisions", "opportunity"],
    start: -0.8, end: -0.1, scrub: 0.5,
    scaleOnly: ["opportunity"],   // stays amber — subtle scale pulse only, no colour change
  },
  belief: {
    words: ["believe", "power"],
    start: -0.8, end: -0.2, scrub: 0.5,
  },
};

// Global config — tune values that affect the overall scroll experience.
const CONFIG = {
  // How many px short of full horizontal travel the strip parks.
  // Increase in increments of 100 until SLIDE-13 heading is centred when vertical scroll takes over.
  stripEndOffset: 0,
};
// ═══════════════════════════════════════════════════════════════════════════════
---

{/*
  LAYOUT AUDIT — returns2.astro
  Spacer divs found:
    - SLIDE-02 Zone 1: <div class="hidden md:block flex-shrink-0 w-[33vw]"> (gap before text col) → REMOVED
    - SLIDE-02 Zone 4: <div class="hidden md:block flex-shrink-0 w-[30vw]"> (gap after SVG) → REMOVED

  Duplicate wrapper patterns:
    - Desktop interstitial sections (SLIDE-3.5, 4.5, 8.5) share: hidden md:flex w-[66vw] ... flex-col justify-center
    - 6+ slides use: flex flex-col justify-center pl-4 pr-4 md:pl-XX ... relative z-10 wrapping border-l-2 border-accent pl-8 py-2
    - Inner content divs on SLIDE-3.5, 4.5, 8.5: flex flex-col items-center justify-center w-full relative overflow-hidden pointer-events-none z-10 text-center

  Positioning-padding removed in this rebuild (md: desktop-only classes):
    - SLIDE-00: md:pl-0 on section
    - SLIDE-01: pr-8 md:pr-12 on outer content wrapper
    - SLIDE-02: spacer divs replaced by grid (Zone 1 w-[33vw], Zone 4 w-[30vw])
    - SLIDE-03: md:pl-54 md:pr-32 on content wrapper; md:ml-36 on inner div
    - SLIDE-04: md:px-48 on section
    - SLIDE-05: md:pl-48 on section
    - SLIDE-06: md:pl-24 md:pr-8 on outer content wrapper
    - SLIDE-07: md:pl-48 md:pr-32 on outer content wrapper
    - SLIDE-09: md:px-48 on section
    - SLIDE-10: md:pl-24 md:pr-16 on section
    - SLIDE-11: md:px-48 on section
    - SLIDE-12: md:pl-48 md:pr-16 on outer content wrapper
    - SLIDE-13: md:pl-48 md:pr-32 on section
*/}

<Layout
  title="The ROI of Audio Branding | bitmap.audio"
  description="Audio branding delivers 4x brand recall, 25% credibility lift, and measurable conversion gains. Explore the data behind sonic identity."
>
  <main class="bg-background text-foreground selection:bg-accent selection:text-foreground grainBG">
    
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
      <div id="parallax-grid" class="absolute top-0 left-0 w-full h-[200vh] bitmap-grid opacity-[0.05] will-change-transform"></div>
      
    </div>

    <div id="scroll-track" class="relative w-full h-[1600vh]">
      
      <div id="sidebar-track" class="absolute left-0 top-0 w-24 h-full z-50 pointer-events-none hidden md:flex flex-col">
        {sections.map((sec, index) => (
          <aside class="h-screen w-full border-r border-border/20 bg-background/80 backdrop-blur-md flex flex-col items-center justify-center gap-8 shadow-[20px_0_40px_-15px_rgba(0,0,0,0.5)]">
            <span class="font-mono text-muted-foreground text-[10px] tracking-widest rotate-180 [writing-mode:vertical-lr] uppercase">{sec.label}</span>
            <div class="h-48 w-[1px] bg-border/30 relative">
              <div class="indicator-line absolute top-0 w-[3px] -left-[1px] bg-accent shadow-[0_0_15px_hsl(var(--accent))] origin-top scale-y-0"></div>
            </div>
            <span class="font-mono text-accent text-[10px]">{sec.id}</span>
          </aside>
        ))}
      </div>

      <div class="sticky top-0 w-full h-screen overflow-hidden pointer-events-auto">
        
        <div id="horizontal-strip" class="flex w-max h-full will-change-transform">

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 00 | Status | DESKTOP WIDTH: w-screen
               "Your brand is Muted." | data-sidebar="0"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-00 | Status | w-screen -->
          <section data-sidebar="0" class="relative h-full flex-shrink-0 flex flex-col justify-center items-center pl-4 pr-4 group bg-background z-10 mobile:pl-0">
            <!-- Mobile background image — woman reading, bottom-right -->
            <div class="md:hidden absolute bottom-0 right-0 w-[75vw] h-[70vh] pointer-events-none z-0">
              <img src="/images/listening.woman2.emptyBook.webp" decoding="async" alt=""
                   class="w-full h-full object-contain object-right-bottom opacity-40" />
            </div>
            <!-- Desktop background image — big bleed, bottom-right, behind text. Left edge masks to
                 transparent so it dissolves into bg-background instead of a hard photo edge where it
                 meets the text column (same treatment as SLIDE-0.5's girl.phone.headphones image). -->
            <div class="mobile:hidden absolute bottom-0 right-0 w-[60vw] h-[90vh] pointer-events-none z-0 opacity-70 mix-blend-screen"
                 style="mask-image: linear-gradient(to right, transparent 0%, black 35%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 35%);">
              <img src="/images/bitmap.cityscape.muted.webp" decoding="async" alt=""
                   class="w-full h-full object-contain object-right-bottom" />
            </div>
            <div class="mobile:hidden absolute -right-20 bottom-0 text-[35vw] font-mono font-bold text-muted/5 select-none pointer-events-none transition-transform duration-1000 group-hover:scale-105 z-0">00</div>
            <!-- 12-col container: pl-24 clears the 96px sidebar; pr-6 matches nav right padding -->
            <div class="md:container md:mx-auto md:pl-24 md:pr-6 md:grid md:grid-cols-12 md:items-center md:w-full">
              <div data-sidebar-anchor class="relative z-10 pl-8 md:pl-0 py-2 md:col-start-2 md:col-span-9">
                <span class="text-eyebrow text-sm mb-8 mobile:mb-3 block">[ Status // Critical ]</span>
                <h2 class="font-mono text-6xl mobile:text-5xl md:text-[8vw] leading-[0.9] tracking-tighter mb-12 mobile:mb-6 uppercase text-foreground">
                  Your brand<br/>is <span class="text-accent drop-shadow-[0_0_20px_hsl(var(--accent)/0.3)]">Muted.</span>
                </h2>
                <div class="w-full max-w-2xl bg-background/60 p-6 border-l-2 border-accent">
                  <p class="font-sans text-xl mobile:text-xl md:text-2xl text-muted-foreground leading-relaxed">
                    Visuals reach the eyes, but sound hits the nervous system. Competing on screens alone is a losing battle. It's time to weaponise your audio.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- #endregion SLIDE-00 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 0.5 | Woman Image | DESKTOP WIDTH: w-[50vw]
               Listening woman image sequence (phone→book fade via GSAP)
               DESKTOP ONLY (hidden md:flex) | no sidebar
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-0.5 | Woman Image | w-[50vw] | DESKTOP ONLY -->
          <section class="hidden md:flex w-[100vw] h-full md:items-center flex-shrink-0 relative bg-background z-10">
            <div class="absolute top-0 left-0 w-full h-full flex items-end justify-start pointer-events-none opacity-80 mix-blend-screen z-0">
              <!-- Single static photo (replaces the old 3-image hands/book/phone cross-fade — see script comment
                   near the removed "3-STEP STAGGERED FADE LOGIC" block). Left/right edges mask to transparent
                   (not a hardcoded colour) so it dissolves into whatever's behind — bg-background on this
                   section, consistently — instead of showing a hard photographic edge. -->
              <div class="relative w-full max-w-8xl -mb-[50vh]"
                   style="mask-image: linear-gradient(to right, transparent 0%, black 5%, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 75%, black 85%, transparent 100%);">
                <img id="base-hands-layer" src="/images/girl.phone.headphones.webp" decoding="async" alt="Woman listening to music on her phone" class="w-full h-auto object-contain object-bottom" />
              </div>
            </div>
          </section>

          <!-- #endregion SLIDE-0.5 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 01 | Context | DESKTOP WIDTH: w-[50vw] (mobile: w-screen)
               "When everyone is listening." + train fade | data-sidebar="1"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-01 | Context | w-screen md:w-[50vw] -->
          <section data-sidebar="1" class="w-screen h-full flex-shrink-0 flex items-center relative group bg-background z-20">

            <div class="mobile:hidden absolute right-0 bottom-0 text-[35vw] font-mono font-bold text-muted/5 select-none pointer-events-none z-0">01</div>

            <div id="train-fade-layer" class="absolute bottom-0 right-0 w-[33vw] h-full z-0 opacity-0 pointer-events-none mix-blend-screen flex items-end justify-end">
                <img src="/images/listening.woman2.train.webp" decoding="async" alt="Woman and Train" class="w-full h-full object-contain object-right-bottom" />
            </div>

            <div class="md:container md:mx-auto md:pl-24 md:pr-6 md:grid md:grid-cols-12 md:items-center md:w-full">
              <div data-sidebar-anchor class="w-full flex justify-center mobile:justify-start mobile:px-4 relative z-10 md:col-start-1 md:col-span-7">
                  <div class="max-w-2xl border-l-2 border-accent pl-8 py-2 bg-background/20 backdrop-blur-sm relative z-10">
                      <span class="text-eyebrow text-sm mb-8 mobile:mb-3 block text-primary">[ Context // Always_On ]</span>
                      <h2 class="font-mono text-5xl md:text-6xl leading-tight mb-8 mobile:mb-4 uppercase text-foreground">When everyone<br/><span class="text-primary drop-shadow-[0_0_20px_hsl(var(--primary)/0.3)]">is listening.</span></h2>
                      <p class="font-sans text-xl text-muted-foreground leading-relaxed max-w-xl">
                        <span class="text-accent">The screenless audience</span> – 80% of consumers form brand memory via audio cues. If you lack an audio-first identity, you have no presence in the moments when eyes are diverted.
                      </p>
                  </div>
              </div>
            </div>
          </section>

          <!-- #endregion SLIDE-01 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 02 | Architecture | DESKTOP WIDTH: w-[125vw]
               SVG data map path-draw animation | data-sidebar="2"
               Layout: flex row — 3 zones (gap · text · diagram · gap)
               Tweak widths here: gap-left=12vw, text=28vw, svg=80vw, gap-right=30vw
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-02 | Architecture SVG | w-[100vw] -->
          <section data-sidebar="2" class="w-screen h-full flex-shrink-0 flex flex-row items-center border-r border-border/20 bg-primary/80 overflow-hidden group z-10 relative">

            <!-- MOBILE: stacked layout — SVG behind, text in front -->
            <div class="md:hidden absolute inset-0 pointer-events-none z-0 opacity-30">
              <svg viewBox="80 250 480 860" class="w-full h-full overflow-visible">
                <g class="stroke-accent" fill="none" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter">
                  <path class="data-path" d="M100,300 H200 V400 H100 Z" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M150,300 V400 M100,350 H200" />
                  <path class="data-path" d="M200,400 H300 V900 H200 Z" />
                  <path class="data-path" d="M250,400 V900" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M200,500 H300 M200,600 H300 M200,700 H300 M200,800 H300" />
                  <path class="data-path" d="M300,500 H600 V800 H500 V900 H300" />
                  <path class="data-path" d="M300,600 H500 V800 H300" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,550 H600" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,850 H500" />
                  <path class="data-path" d="M400,500 V600 M400,800 V900" />
                  <path class="data-path" d="M500,500 V800" />
                  <path class="data-path" d="M500,600 H600 M500,700 H600" />
                </g>
                <g class="fill-accent">
                  <circle class="data-node" cx="100" cy="300" r="4" />
                  <circle class="data-node" cx="200" cy="300" r="6" />
                  <circle class="data-node" cx="150" cy="350" r="3" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="200" cy="400" r="10" />
                  <circle class="data-node" cx="200" cy="600" r="5" />
                  <circle class="data-node" cx="200" cy="900" r="8" />
                  <circle class="data-node" cx="300" cy="400" r="4" />
                  <circle class="data-node" cx="300" cy="600" r="7" />
                  <circle class="data-node" cx="400" cy="500" r="5" />
                  <circle class="data-node" cx="500" cy="500" r="9" />
                  <circle class="data-node" cx="600" cy="500" r="12" stroke="hsl(var(--accent))" stroke-width="3" />
                  <circle class="data-node" cx="400" cy="700" r="4" />
                  <circle class="data-node" cx="500" cy="800" r="6" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="600" cy="800" r="10" />
                  <circle class="data-node" cx="300" cy="900" r="5" />
                </g>
              </svg>
            </div>
            <div class="md:hidden flex flex-col justify-center px-8 relative z-10 border-l-2 border-accent ml-4">
              <span class="text-eyebrow text-sm mb-4 block text-background">[ Architecture // Recall ]</span>
              <h2 class="font-mono text-5xl leading-tight mb-6 uppercase text-foreground">Sound as a<br/><span class="text-accent">Data Map.</span></h2>
              <p class="font-sans text-xl text-background/80 leading-relaxed">Faster Neurological Processing and Lasting Memory.</p>
            </div>

            <!-- DESKTOP: container/12-col — text at col-start-1 (clears sidebar); SVG absolute (full-bleed behind text) -->

            <!-- SVG diagram — absolute positioned, extends right from ~20vw within section, sits behind text (z-0) -->
            <div class="hidden md:block absolute left-[35vw] top-[7.5vh] w-[80vw] h-[85vh] opacity-80 z-0">
              <svg viewBox="50 200 650 800" class="w-full h-full overflow-visible">
                <g class="stroke-accent" fill="none" stroke-width="3" stroke-linecap="square" stroke-linejoin="miter">
                  <path class="data-path" d="M100,300 H200 V400 H100 Z" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M150,300 V400 M100,350 H200" />
                  <path class="data-path" d="M200,400 H300 V900 H200 Z" />
                  <path class="data-path" d="M250,400 V900" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M200,500 H300 M200,600 H300 M200,700 H300 M200,800 H300" />
                  <path class="data-path" d="M300,500 H600 V800 H500 V900 H300" />
                  <path class="data-path" d="M300,600 H500 V800 H300" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,550 H600" />
                  <path class="data-path" stroke-width="1.5" stroke="hsl(var(--background))" d="M300,850 H500" />
                  <path class="data-path" d="M400,500 V600 M400,800 V900" />
                  <path class="data-path" d="M500,500 V800" />
                  <path class="data-path" d="M500,600 H600 M500,700 H600" />
                </g>
                <g class="fill-accent">
                  <circle class="data-node" cx="100" cy="300" r="4" />
                  <circle class="data-node" cx="200" cy="300" r="6" />
                  <circle class="data-node" cx="150" cy="350" r="3" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="200" cy="400" r="10" />
                  <circle class="data-node" cx="200" cy="600" r="5" />
                  <circle class="data-node" cx="200" cy="900" r="8" />
                  <circle class="data-node" cx="300" cy="400" r="4" />
                  <circle class="data-node" cx="300" cy="600" r="7" />
                  <circle class="data-node" cx="400" cy="500" r="5" />
                  <circle class="data-node" cx="500" cy="500" r="9" />
                  <circle class="data-node" cx="600" cy="500" r="12" stroke="hsl(var(--accent))" stroke-width="3" />
                  <circle class="data-node" cx="400" cy="700" r="4" />
                  <circle class="data-node" cx="500" cy="800" r="6" />
                  <circle class="data-node fill-background stroke-accent" stroke-width="2" cx="600" cy="800" r="10" />
                  <circle class="data-node" cx="300" cy="900" r="5" />
                </g>
              </svg>
            </div>

            <!-- Text — container/12-col, sits in front of SVG (z-10) -->
            <div class="md:container md:mx-auto md:pl-24 md:pr-6 md:grid md:grid-cols-12 md:items-center md:w-full md:h-full">
              <div data-sidebar-anchor class="hidden md:flex flex-col justify-center md:col-start-2 md:col-span-6 md:row-start-1 md:z-10">
                <span class="text-eyebrow text-sm mb-8 block text-background">[ Architecture // Recall ]</span>
                <h2 class="font-mono text-8xl leading-tight mb-8 uppercase text-foreground">Sound as a<br/><span class="text-accent drop-shadow-[0_0_20px_hsl(var(--primary)/0.3)]">Data Map.</span></h2>
                <p class="font-sans text-xl text-background/80 leading-relaxed">
                  Faster Neurological Processing and Lasting Memory.
                </p>
              </div>
            </div>

          </section>

          <!-- #endregion SLIDE-02 -->

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 03 | Neurology — Processing Speed | DESKTOP WIDTH: w-screen
               Tiger blur-to-focus animation | data-sidebar="3"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-03 | Neurology Processing | w-screen -->
          <section data-sidebar="3" class="w-screen h-full flex-shrink-0 grid grid-cols-1 border-r border-border/20 bg-card/30 overflow-hidden relative group z-10 mobile:pl-0">

            <!-- Mobile background image — tiger, bottom-right -->
              <div class="md:hidden absolute bottom-0 right-0 w-[100vw] h-[100vh] pointer-events-none z-0">
                <img src="/images/stalking.sabretooth.webp" decoding="async" alt=""
                    class="w-full h-full object-contain object-right-bottom opacity-40" />
              </div>

            <div class="absolute right-[40vw] -bottom-[20vh] w-[100vw] h-full flex items-start justify-end mix-blend-screen pointer-events-none z-0">
               <img 
               id="tiger-focus-layer"
               src="/images/stalking.sabretooth.webp"
               decoding="async"
               alt="Sabretooth snapping a twig"
               class="w-full h-auto object-contain object-right-bottom opacity-0 blur-[30px] transition-transform duration-1000 group-hover:scale-[1.02]" />
            </div>

            <div class="md:pl-24 md:pr-6 md:grid md:grid-cols-12 md:items-center md:w-full">
              <div data-sidebar-anchor class="flex flex-col items-end mobile:items-start justify-center mobile:pl-4 mobile:pr-4 relative z-10 border-l border-border/20 bg-background/20 md:col-start-3 md:col-span-3">
                <div class="border-l-2 border-accent bg-background/20 ml-0 pl-8 py-2">
                  <span class="text-eyebrow text-sm mb-8 mobile:mb-3 block text-accent">[ Neurology // Processing_Speed ]</span>
                  <h2 class="font-mono text-5xl md:text-6xl leading-tight mb-8 mobile:mb-4 uppercase">Faster than<br/><span class="text-accent">Sight.</span></h2>
                  <p class="font-sans text-xl text-muted-foreground leading-relaxed mb-8">
                    Sound is a biological survival mechanism. It reaches the brain 2 to 4 times faster than visual stimuli.<br/><br/>It establishes recognition in just <strong>0.05 seconds</strong> making us aware of our surroundings before we even consciously "see" them.
                  </p>
                </div>
              </div>
            </div>
