---
import Layout from '../layouts/Layout.astro';
import { Button } from "@/components/ui/button";
import ImageSlide from '../components/ImageSlide.astro';

// ═══════════════════════════════════════════════════════════════════════════════
// SLIDE CONFIG — edit widths, animation timings, and key values here.
// Do not edit anywhere else for these values.
//
// width:      desktop slide width (vw string). Mobile is always "100vw".
//             Changing this here automatically updates layout + GSAP timing.
//
// anim:       scroll-driven animation timing, as viewport-width multipliers
//             relative to each slide's left edge.
//             Negative = before slide enters screen (-0.9 = 90vw ahead of entry).
//             Positive = after slide left edge has passed viewport left edge.
//             Rule: start ≈ -0.9 (just entering right), end ≈ -0.2 to 0 (at mid-screen).
//             scrub: how elastic the animation feels on scroll (0.1 = snappy, 1 = laggy).
//
// counter:    for animated number values (ROI, success ring) — change the numbers here.
// ═══════════════════════════════════════════════════════════════════════════════
// ── IMAGE-SLIDE DEFAULTS ─────────────────────────────────────────────────────
// Applied to every type:"image" slide in SLIDES below; override per-slide inline.
//   width — scroll footprint · imgWidth — render width (>100% bleeds over neighbours)
//   imgX — sideways nudge · z — stack vs neighbours · objectPos — photo framing
//   opacity 0–100 · blend — mix-blend-screen (true=dark slide) · fade — edge-mask preset
//   effect — "fade"|"focus" · customMask — explicit mask · ramp — GSAP scroll timing
const IMG_DEFAULTS = {
  width: "100vw",
  imgWidth: "100%",
  imgX: "0px",
  objectPos: "center",
  z: 30,                            // above text slides (z-10/z-20) so shifted images roam OVER
                                    // neighbours instead of tucking behind them. Sidebar (z-50)
                                    // still sits on top. Lower this per-image to tuck one behind.
  opacity: 90,
  bare: true,                       // float on the journey background (no opaque slide bg)
  ramp: { start: -1.2, end: -0.1 }, // default GSAP scroll ramp (vw multipliers off left edge)
};

// ═══════════════════════════════════════════════════════════════════════════════
// SLIDES — THE SINGLE SOURCE OF TRUTH. One ordered list; array order = DOM order.
// Every slide lives here — edit widths / images / timings in this one place.
//
//   type:"text"   — content slide. id, label (sidebar), width (desktop vw),
//                   anim? (GSAP scroll timings, vw multipliers off the slide's left edge).
//   type:"image"  — in-between image/gradient slide. img | gradient + IMG_DEFAULTS keys.
//   type:"behind" — background image rendered INSIDE a text slide at z-0 (id = the DOM
//                   region it sits behind). img?, width, opacity.
//
// The config `id` on text slides is the sidebar-config id (00–12) and does NOT always
// equal the DOM data-sidebar number (there is no data-sidebar 8). Array ORDER, not the
// numeric id, maps config → DOM. Keep entries in true DOM order.
// ═══════════════════════════════════════════════════════════════════════════════
type Slide = {
  id: string;
  type: "text" | "image" | "behind";
  label?: string;
  width?: string;
  anim?: Record<string, { start: number; end: number; scrub?: number; cardSpacing?: number }>;
  content?: { col: [number, number]; align?: "start" | "center" | "end" };
  img?: string; gradient?: string; imgWidth?: string; imgX?: string; objectPos?: string;
  z?: number; opacity?: number; blend?: boolean; fade?: string | { left: number; right: number }; effect?: string;
  bare?: boolean; customMask?: string; ramp?: { start: number; end: number };
  vivid?: boolean;
// type:"behind" only — symmetric dissolve as the slide crosses centre.
  //   window — how far out the ramp starts, in viewport widths, EACH side of centre
  //   hold   — fraction of that span held fully sharp in the middle (0.6 = 60%). Keep this
  //            high: too low and the image is blurry for the whole time it's on screen.
  //   blur   — px blur it fades up from and back into
  // Requires data-behind-layer on the image wrapper in the markup.
  reveal?: { window?: number; hold?: number; blur?: number };
};
const SLIDES: Slide[] = [
  { id: "00",   type: "text",  label: "Status",               width: "80vw", content: { col: [2, 9] }  },
  { id: "0.5",  type: "image", img: "your-brand-is-muted", vivid: true, fade: { left: 0.35, right: 0.65 } },
  { id: "01",   type: "text",  label: "Context",              width: "75vw", content: { col: [1, 7] }  },
  { id: "1.5",  type: "image", img: "when-everyone-is-listening", vivid: true, fade: { left: 0.5, right: 0.5 }, },
  { id: "02",   type: "text",  label: "Architecture",         width: "110vw", content: { col: [2, 6] }, anim: {
      nodes: { start: -0.85, end: 0.5, scrub: 0.5 },
      paths: { start: -0.75, end: 0.3, scrub: 0.5 },
  }},
  { id: "2.5",  type: "image", img: "sound-as-a-data-map", width: "150vw", imgWidth: "150vw", vivid: true, imgX: "-40vw", blend: false, 
    ramp: { start: -0.8, end: 0 },
    fade: { left: 0.5, right: 0.3 } 
  },  
  { id: "03", type: "text", label: "Neurology.Processing", width: "120vw", content: { col: [3, 5] }},
  { id: "3.1",  type: "text",  width: "100vw" },
  { id: "3.25", type: "image", img: "faster-than-sight-2", width: "150vw", imgWidth: "120vw", imgX: "-50vw", z: 50, fade: { left: 0.2, right: 0.7 }, effect: "focus", 
    ramp: { start: -1.5, end: -0.5 } },
  { id: "04",   type: "text",  label: "Neurology.Memory",     width: "80vw", content: { col: [3, 8] }, anim: {
      visualsFade: { start: -0.85, end: -0.2, scrub: 0.5 },
      soundGrow:   { start: -0.8,  end: -0.1, scrub: 0.5 },
      vibration:   { start: -0.5,  end:  1.0, scrub: 0.5 },
  }},
  { id: "4.25", type: "image", img: "visuals-fade-sound-echoes", width:"100vw", imgWidth:"130vw", vivid: true, z: 5, imgX: "-30vw",  fade: { left: 0.3, right: 0.4 }, ramp: { start: -1.2, end: -0.5 }},
  { id: "4.5", type: "behind", img: "brain-processing-speed", opacity: 100, z: 50, vivid: true,
      reveal: { window: 1.5, hold: 0.65, blur: 25 } },
  { id: "05",   type: "text",  label: "Metrics",              width: "150vw", content: { col: [3, 9] }, anim: {
      pressureLine: { start: -0.4, end: -0.1, scrub: 0.5 },
      statCards:    { start: -0.5, end: -0.0, scrub: 0, cardSpacing: 300 },
  }},
  { id: "5.5",  type: "image", img: "recall-under-pressure", vivid: true, imgX: "-75vw", imgWidth: "125vw", z: 5, ramp: { start: -1.7, end: -1.2 }, fade: { left: 0.2, right: 0.5 } },
  { id: "07",   type: "text",  label: "Credibility",          width: "75vw", content: { col: [4, 8] }  },
  { id: "7.25", type: "image", img: "subconscious-trust-2", vivid: true, imgWidth: "100vw", imgX: "-20vw", z: 5, fade: { left: 0.3, right: 0.5 } },
  { id: "08",   type: "text",  label: "Perception",           width: "100vw", content: { col: [5, 7] } },
  { id: "9.25", type: "image", img: "perceived-as-innovators", vivid: true, imgX: "-35vw", imgWidth: "120vw", z: 5, fade: { left: 0.3, right: 0.5 }, ramp: { start: -0.7, end: -0.2 } },
  { id: "09",   type: "text",  label: "Culture",              width: "125vw", content: { col: [4, 6] } },
  { id: "10.5", type: "image", img: "seamless-cultural-resonance", vivid: true, imgX: "-80vw", imgWidth: "80vw", z: 5, fade: { left: 0.5, right: 0.3 }, ramp: { start: -0.5, end: -0 } },
  { id: "10",   type: "text",  label: "Asset.Ownership",      width: "125vw", content: { col: [4, 8] } },
  { id: "10.75", type: "image", img: "sea-of-sameness-2", vivid: true, imgX: "-70vw", imgWidth: "120vw", z: 5, fade: { left: 0.5, right: 0.5 }, ramp: { start: -1, end: -0 } },
  { id: "11",   type: "text",  label: "Belief",               width: "75vw", content: { col: [3, 8] }  },
  { id: "12",   type: "text",  label: "Execution",            width: "100vw", content: { col: [1, 12] } },
  { id: "13",   type: "behind", img: "master-the-signal", width: "75vw", opacity: 55 },
];

// ═══════════════════════════════════════════════════════════════════════════════
// MOBILE IMAGERY MAP — search "MOBILE-IMG" to jump to any of these in the markup.
//
// Mobile backgrounds are NOT in the SLIDES config. SLIDES drives the desktop strip;
// mobile images are plain `md:hidden` <div>s in the markup, full-bleed via `absolute
// inset-0`. (Never w-[100vw]/h-[100vh] — plain `vh` is the LARGE viewport and overflows
// a 100svh slide by one address-bar height.)
//
//   slide 00   your-brand-is-muted            full-bleed
//   slide 01   when-everyone-is-listening     full-bleed
//   slide 02   sound-as-a-data-map            full-bleed
//   slide 03   faster-than-sight              full-bleed  (offset via top-[25%])
//   slide 04   visuals-fade-sound-echoes      full-bleed
//   slide 05   recall-under-pressure          STICKY BACKDROP — held across 5 slides
//   slide 07   subconscious-trust-2           full-bleed
//   slide 08   perceived-as-innovators        full-bleed
//   slide 8.5  untapped-opportunity           full-bleed
//   slide 09   seamless-cultural-resonance    full-bleed
//   slide 10   sea-of-sameness-2              STICKY BACKDROP — held across 2 slides
//   slide 12   master-the-signal              full-bleed  (desktop has its own masked
//                                             version alongside it, mobile:hidden)
//
// STICKY BACKDROP = one image stays still while several slides snap over it. The image
// is `sticky top-0 h-0` inside a wrapper that spans the group — the wrapper is what
// bounds the effect, and those slides are `bg-transparent` so it shows through. Note
// their sections sit one level deeper, which is why the is-mobile-snap rules use a
// DESCENDANT selector (`#horizontal-strip section`). `position: fixed` can't be used:
// #horizontal-strip has will-change:transform, making it the containing block.
//
// Framing controls: `object-position` (e.g. object-[65%_50%]) for the crop, `opacity-*`
// for strength. Both are on the <img> itself.
//
// ── MOBILE BACKGROUND COLOURS — now UNSET, to be defined explicitly ──────────
// The JOURNEY array and #journey-bg are DESKTOP ONLY (#journey-bg is `hidden md:block`
// and the GSAP journey sits behind the isMobile early-return). Mobile never used it —
// what it used instead was a per-slide opaque `bg-*` on each section, chosen to echo the
// journey checkpoint at that point in the scroll.
//
// Those have been removed (2026-07-21). Every mobile-visible section is now transparent
// and falls through to <main class="bg-background">, so the mobile background is a clean
// slate and the new full-bleed imagery isn't fighting a colour behind it.
//
// The pattern that was removed looked like `bg-primary/80 md:bg-transparent` — the
// unprefixed half was the mobile colour, the md: half kept desktop clear for the journey.
// Only the unprefixed half was deleted, so desktop is bit-for-bit unchanged.
//
// TO SET A MOBILE COLOUR: use the `mobile:` variant, e.g. `mobile:bg-card/30`. Do NOT add
// an unprefixed `bg-*` — that would apply at all widths and paint over the desktop journey.
// ═══════════════════════════════════════════════════════════════════════════════

// Text slides only, in DOM order — feeds the sidebar map, the define:vars bridge, and the
// GSAP anim()/width lookups (positional order matches the sorted data-sidebar list).
const sections = SLIDES.filter((s) => s.type === "text");

// Look up a slide by id, and build its inline desktop grid placement from config.
// Tailwind can't JIT dynamic `md:col-start-N` classes, so text-slide columns are set
// via inline `grid-column` (inert on mobile — the wrapper's parent is only a grid at md+).
const slideById: Record<string, Slide> = Object.fromEntries(SLIDES.map((s) => [s.id, s]));
const gridStyle = (id: string): string => {
  const c = slideById[id]?.content;
  if (!c) return "";
  const [start, span] = c.col;
  return `grid-column:${start} / span ${span};` + (c.align ? `justify-self:${c.align};` : "");
};

// Separate tunables for counter animations (not tied to a sidebar entry)
const COUNTERS = {
  roi: {
    from: 1.0, to: 4.0, decimals: 1,
    // timing: vw multipliers relative to roi-section's left edge
    start: -0.7,   // counter starts when roi-section is 30vw before its left edge enters screen
    end: -0.3,      // counter finishes when roi-section has scrolled 60vw past screen left
    scrub: true,   // must be true (not a number) — numeric scrub lags and counter never reaches target
  },
  success: {
    to: 25,
    start: -0.7,   // ring starts filling when section is 25vw past screen left
    end: -0.2,     // ring reaches target at 95vw past screen left
    scrub: true,   // must be true — numeric scrub causes ring to freeze short of 25%
  },
  memory: {
    from: 0, to: 20, decimals: 0,  // "20x Longer Memory Retention" counts 0 → 20
    start: -0.9,   // starts as the 4.5 slide enters
    end: 0,        // hits 20 exactly when the slide is centred (anchorCenter)
    scrub: true,
  },
};
// Word highlight config — words that shift colour as their slide scrolls in.
// 'words' must match id="hl-{word}" attributes added to <span> elements in the template.
// start/end: vw multipliers relative to the slide's left edge (same convention as anim entries).
const HIGHLIGHTS = {
  untapped: {
    words: ["untapped", "loyalty", "purchasing", "decisions", "opportunity"],
    start: -0.8, end: -0.1, scrub: 0.5,
    scaleOnly: ["opportunity"],   // stays amber — subtle scale pulse only, no colour change
  },
  belief: {
    words: ["believe", "power"],
    start: -0.8, end: -0.2, scrub: 0.5,
  },
};

// Global config — tune values that affect the overall scroll experience.
const CONFIG = {
  // How short of full horizontal travel the strip parks, as a FRACTION OF VIEWPORT WIDTH
  // (0.2 = a fifth of the screen). Viewport-relative, so it lands the same on a 1400px laptop
  // and a 2560px monitor — do NOT put a px value here.
  // Increase in steps of 0.05 until the SLIDE-13 heading is framed as you want it when the
  // vertical scroll takes over.
  stripEndOffset: 0.3,

  // AD6 vividness ramp: slides with `vivid: true` desaturate/dim off-centre and hit full
  // colour as their anchor reaches viewport centre, then ease back down as they exit.
  vividFrom: { saturate: 0.2, brightness: 0.5 }, // look when far from centre
  vividTo:   { saturate: 1,   brightness: 1 },    // look at centre (full)
  vividWindow: 0.9, // fraction of viewport width on EACH side of centre the ramp spans
};

// (Image slides, behind-backgrounds & their defaults now live in the SLIDES array above.)

// ── BACKGROUND COLOUR JOURNEY (desktop only) ─────────────────────────────────
// One background layer behind the whole strip drifts through these colours as you
// scroll — a gradual journey instead of hard per-slide background cuts. Each
// checkpoint pins to a slide (data-sidebar id) and eases to the next. Use any CSS
// colour GSAP can tween (hex is safest). MOBILE is untouched — slides keep their own
// backgrounds and snap.
const JOURNEY = [
  { at: "0",  color: "#121C1C" }, // bg-background (Status) 121C1C
  { at: "2",  color: "#ABC4CE" }, // bg-primary/80 (Architecture) ABC4CE
  { at: "3",  color: "#11181A", offset: -0.7 }, // bg-card/30 (Neurology.Processing) 11181A
  { at: "4",  color: "#1E231C" }, // bg-accent/5 (Neurology.Memory) 1E231C
  { at: "4.5", color: "#CDE0DD", offset: 2 }, // Muted abyss teal behind the 20x brain graphic
  { at: "5",  color: "#111A1B" }, // bg-card/20 (Metrics) 111A1B
  { at: "5.5", color: "#1E231C" }, // AD5 TEST — recall-under-pressure right-edge teal (brightened). Anchored to image via data-slide. 1E231C
  { at: "6.5", color: "#121C1C" }, // anchored to the blank spacer (ROI removed) — long dark→white ramp into Credibility
  { at: "7",  color: "#DCDDDD", offset: -0.5 }, // bg-foreground/90 (Credibility) DCDDDD
  { at: "9",  color: "#384648" }, // bg-primary/20 (Perception) 384648
  { at: "10", color: "#121C1C" }, // bg-background (Culture) 121C1C
  { at: "11", color: "#141414" }, // bg-primary/5 (Asset.Ownership) 1C2727
  { at: "12", color: "#FFA61A", offset: 0.5 }, // bg-accent (Belief) FFA61A
  { at: "13", color: "#121C1C", offset: -0.7 }, // bg-background (Execution) 121C1C
];

// Merge defaults + expand image paths → final <ImageSlide> props. (Don't edit below.)
const RETURNS = (n: string) => `/images/returns/${n}.webp`;
const imgSlide: Record<string, any> = Object.fromEntries(
  SLIDES.filter((s) => s.type === "image").map((s) => {
    const { id, type, ...rest } = s as any;
    const p: any = { id, ...IMG_DEFAULTS, ...rest };
    if (p.img) { p.src = RETURNS(p.img); delete p.img; }
    return [id, p];
  })
);
// SLIDE-4.5 brain mask. `closest-side` is load-bearing — WITHOUT it the ellipse defaults to
// `farthest-corner`, whose horizontal radius (~106vw in a 150vw box) extends well past the div's
// own edge at 75vw. The gradient then never reaches transparent inside the box: it's still ~14%
// opaque at the left/right edge, which paints as a hard vertical line. `closest-side` pins the
// radii to the box half-width/half-height, so 100% IS the edge and the fade completes before it.
// Many stops with a long low-alpha tail = the buttery falloff (a 2-stop ramp reads as an edge).
// Tuned gentle: the fully-opaque core runs to 45% (was 24%) and the ramp stays high-alpha well
// past the midpoint, so far more of the brain is legible. The tail is compressed into the last
// ~15% instead of spread over 70% — still enough stops to avoid a visible edge.
const BRAIN_MASK =
  "radial-gradient(ellipse closest-side at center, " +
  "black 0%, black 45%, rgba(0,0,0,0.94) 58%, rgba(0,0,0,0.82) 68%, " +
  "rgba(0,0,0,0.62) 77%, rgba(0,0,0,0.38) 85%, rgba(0,0,0,0.18) 91%, " +
  "rgba(0,0,0,0.06) 96%, transparent 100%)";

// Behind-text background images, keyed by the DOM region id they sit behind.
const BACKGROUNDS: Record<string, any> = Object.fromEntries(
  SLIDES.filter((s) => s.type === "behind").map((s) => [s.id, { width: (s as any).width, opacity: (s as any).opacity }])
);
// ═══════════════════════════════════════════════════════════════════════════════
---

<Layout
  title="The ROI of Audio Branding | bitmap.audio"
  description="Audio branding delivers 4x brand recall, 25% credibility lift, and measurable conversion gains. Explore the data behind sonic identity."
>
  <main class="bg-background text-foreground selection:bg-accent selection:text-foreground grainBG">

    <!-- Background colour "journey" layer — desktop only. GSAP drifts its background-color
         through the JOURNEY checkpoints as you scroll, behind the (transparent-on-desktop)
         slides. Hidden on mobile so the per-slide snap backgrounds are untouched. -->
    <div id="journey-bg" class="hidden md:block fixed inset-0 z-0 pointer-events-none" style="background-color:#111b1b;"></div>

    <!-- DEV control — "Journey only": hides all slide text + imagery so only the background
         journey is visible, for tuning the colour flow. Desktop only. Remove/comment out for production. -->
    <label class="hidden md:flex fixed top-4 right-4 z-[100] items-center gap-2 px-3 py-1.5 rounded-full bg-background/80 backdrop-blur border border-border/40 text-[11px] font-mono uppercase tracking-wider text-muted-foreground cursor-pointer select-none">
      <input type="checkbox" id="journey-only-switch" class="accent-accent cursor-pointer" />
      Journey only
    </label>
    <style is:global>
      /* Journey-only preview: fade the whole slide strip out so #journey-bg shows alone. */
      #horizontal-strip { transition: opacity .35s ease; }
      html.journey-only #horizontal-strip { opacity: 0; pointer-events: none; }
    </style>
    <script is:inline>
      (function () {
        function wire() {
          var sw = document.getElementById('journey-only-switch');
          if (!sw || sw.dataset.wired) return;
          sw.dataset.wired = '1';
          sw.addEventListener('change', function (e) {
            document.documentElement.classList.toggle('journey-only', e.target.checked);
          });
        }
        document.addEventListener('astro:page-load', wire);
        wire();
      })();
    </script>

    <!-- Track height controls overall scroll speed: too fast/twitchy = increase,
         too sluggish = decrease. GSAP anim/counter timings are offsetLeft-relative
         so they self-correct to this value. -->
    <div id="scroll-track" class="relative w-full h-[2050vh]">
      
      <div id="sidebar-track" class="absolute left-0 top-0 w-24 h-full z-50 pointer-events-none hidden md:flex flex-col">
        {sections.filter((sec) => sec.label).map((sec, index) => (
          <aside data-aside-id={sec.id} class="h-screen w-full  bg-background/80 backdrop-blur-md flex flex-col items-center justify-center gap-8 shadow-[20px_0_40px_-15px_rgba(0,0,0,0.5)]">
            <span class="font-mono text-muted-foreground text-[10px] tracking-widest rotate-180 [writing-mode:vertical-lr] uppercase">{sec.label}</span>
            <div class="h-48 w-[1px] bg-border/30 relative">
              <div class="indicator-line absolute top-0 w-[3px] -left-[1px] bg-accent shadow-[0_0_15px_hsl(var(--accent))] origin-top scale-y-0"></div>
            </div>
            <span class="font-mono text-accent text-[10px]">{String(index).padStart(2, "0")}</span>
          </aside>
        ))}
      </div>

      <div class="sticky top-0 w-full h-screen overflow-hidden pointer-events-auto">
        
        <div id="horizontal-strip" class="flex w-max h-full will-change-transform">

          <!-- ═══════════════════════════════════════════════════════════
               SLIDE 00 | Status 
               "Your brand is Muted." | data-sidebar="0"
               ═══════════════════════════════════════════════════════════ -->
          <!-- #region SLIDE-00 | Status -->
          <!-- mobile:items-stretch — the section is `items-center`, which shrinks its children to
               content width. Without stretch the parent block below can't span the device, so its
               px-8 gap wouldn't be symmetric against the screen edges. -->
          <!-- MOBILE: the edge gap lives HERE on the section, so it sits OUTSIDE the content
               block — the block (and its background) is inset from the device edges rather than
               spanning full width with inner padding. Everything inside adds no x-space. -->
          <section data-sidebar="0" data-slide="00" class="relative h-full flex-shrink-0 flex flex-col justify-center items-center md:pl-4 md:pr-4 group md:bg-transparent z-10 mobile:px-8 mobile:items-stretch">
            <!-- Mobile background image — woman reading, bottom-right -->
            <!-- inset-0, NOT w-[100vw] h-[100vh]. Sections are sized in `svh`; plain `vh` is the
                 LARGE viewport, so a 100vh child overflows its parent by one address-bar height.
                 inset-0 pins the image to whatever the section actually is — full-bleed stays
                 full-bleed and can never disagree with the slide it sits in. -->
            <!-- MOBILE-IMG | slide 00 | your-brand-is-muted.webp | full-bleed -->
            <div class="md:hidden absolute inset-0 pointer-events-none z-0">
              <img src="/images/returns/your-brand-is-muted.webp" decoding="async" alt=""
                   class="w-full h-full object-cover opacity-50" />
            </div>
            <!-- 12-col container: pl-24 clears the 96px sidebar; pr-6 matches nav right padding -->
            <div class="md:container mx-auto md:pl-24 md:pr-6 md:grid md:grid-cols-12 md:items-center md:w-full mobile:w-full">
              <!-- ── MOBILE CONTENT BLOCK (road test) ────────────────────────────────
                   THE PARENT owns the edge gap and the vertical rhythm:
                     mobile:px-8            equal gap to BOTH device edges (was pl-8, left-only)
                     mobile:min-h-[40svh]   consistent block size slide-to-slide.
                                            svh NOT vh — vh is the large viewport and would
                                            overshoot the 100svh slide.
                     flex-col justify-center  contents sit centred inside that block
                   THE CONTENTS add no x-space of their own, so eyebrow, heading and body all
                   align to one left edge. -->
