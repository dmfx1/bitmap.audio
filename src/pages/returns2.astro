<script define:vars={{ sections, COUNTERS, HIGHLIGHTS, CONFIG }} is:inline>
  window.__SECTIONS__ = sections;
  window.__COUNTERS__ = COUNTERS;
  window.__HIGHLIGHTS__ = HIGHLIGHTS;
  window.__CONFIG__ = CONFIG;
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  const initStickyScroll = () => {
    const strip = document.querySelector("#horizontal-strip") as HTMLElement;
    const track = document.querySelector("#scroll-track") as HTMLElement;
    const indicators = gsap.utils.toArray(".indicator-line") as HTMLElement[];

    const parallaxGrid = document.querySelector("#parallax-grid");

    // Grab the new Train layer
    const trainFadeLayer = document.querySelector("#train-fade-layer"); // NEW

    // Grab the new SVG Data Map elements
    const dataPaths = gsap.utils.toArray(".data-path");
    const dataNodes = gsap.utils.toArray(".data-node");

    const visualsFadeText = document.querySelector("#visuals-fade-text"); // NEW
    const soundGrowText = document.querySelector("#sound-grow-text"); // NEW

    // Grab the tiger image
    const tigerFocusLayer = document.querySelector("#tiger-focus-layer");

    // METRICS SECTION ANIMATIONS (Pressure Line & Sliding Cards)
    const metricsSection = document.querySelector("#metrics-section") as HTMLElement;
    const pressureLine = document.querySelector("#pressure-line");
    const statCards = gsap.utils.toArray(".stat-card") as HTMLElement[];

    // AMPLIFIED ROI SECTION ANIMATION
    const roiSection = document.querySelector("#roi-section") as HTMLElement;
    const roiCounter = document.querySelector("#roi-counter") as HTMLElement;
    const roiWrapper = document.querySelector("#roi-text-wrapper");
    const roiGhosts = gsap.utils.toArray(".roi-ghost") as HTMLElement[];
    const roiWaves = gsap.utils.toArray(".roi-wave") as HTMLElement[];
    const roiWord = document.querySelector("#roi-word");
    const ghostCounters = document.querySelectorAll(".ghost-counter");

    //Success Counter Elements
    const successSection = document.querySelector("#success-section") as HTMLElement; // Add 'as HTMLElement'
    const successCounter = document.querySelector("#task-success-counter") as HTMLElement; // Add this too for good measure
    const successRing = document.querySelector("#success-ring") as SVGElement;


    if (!strip || !track) return;

    const config = (window as any).__CONFIG__ as { stripEndOffset: number };
    const highlights = (window as any).__HIGHLIGHTS__;

    // Read config bridged from Astro frontmatter via window.__SECTIONS__ / window.__COUNTERS__
    const sectionConfig = (window as any).__SECTIONS__ as Array<{
      id: string; label: string; width?: string;
      anim?: Record<string, { start: number; end: number; scrub?: number }>;
    }>;
    const counters = (window as any).__COUNTERS__ as {
      roi: { from: number; to: number; decimals: number; start: number; end: number; scrub?: number };
      success: { to: number; start: number; end: number; scrub?: number };
    };

    // Returns the timing entry for a given slide id + animation key, or null if not configured.
    const anim = (id: string, key: string) =>
      sectionConfig?.find(s => s.id === id)?.anim?.[key] ?? null;

    // Shared sorted list of all [data-sidebar] sections — used by both applyWidths and sidebar logic.
    // Must be defined before applyWidths so the resize handler can reuse the same reference.
    const sidebarSections = (Array.from(strip.querySelectorAll('[data-sidebar]')) as HTMLElement[])
      .sort((a, b) => parseInt(a.dataset.sidebar!) - parseInt(b.dataset.sidebar!));

    // Apply desktop slide widths from config. Uses positional mapping (same as sidebar script)
    // to avoid data-sidebar ID gaps and leading-zero mismatches.
    const applyWidths = () => {
      sectionConfig?.forEach((sec, i) => {
        if (!sec.width || !sidebarSections[i]) return;
        sidebarSections[i].style.width = window.innerWidth >= 768 ? sec.width : '100vw';
      });
    };
    applyWidths();
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        applyWidths();
        ScrollTrigger.refresh();
      }, 150);
    });

    const isMobile = window.innerWidth < 768;

    if (isMobile) {
      document.documentElement.classList.add('is-mobile-snap');
      // Adjust data map SVG viewBox to better fill 9:16 portrait
      const archSvg = document.querySelector('section[data-sidebar="2"] svg');
      if (archSvg) {
        archSvg.setAttribute('viewBox', '80 250 480 860');
      }
      return;
    }

    // Converts a horizontal strip position to an absolute vertical scroll position.
    // Accounts for stripEndOffset so the strip parks short of full travel when configured.
    const getScrollPos = (horizontalPos: number) => {
      const totalHorizontal = strip.scrollWidth - window.innerWidth - (config?.stripEndOffset ?? 0);
      const totalVertical = track.offsetHeight - window.innerHeight;
      return (horizontalPos / totalHorizontal) * totalVertical;
    };

    // Returns the horizontal position at which a section's [data-sidebar-anchor] is centred in the viewport.
    // Falls back to the section's geometric centre when no anchor is present.
    const anchorCenter = (sec: HTMLElement): number => {
      const anchor = sec.querySelector('[data-sidebar-anchor]') as HTMLElement | null;
      return anchor
        ? sec.offsetLeft + anchor.offsetLeft + anchor.offsetWidth / 2 - window.innerWidth / 2
        : sec.offsetLeft + sec.offsetWidth / 2 - window.innerWidth / 2;
    };

    const slide01 = document.querySelector('[data-sidebar="1"]') as HTMLElement | null;
    const slide02 = document.querySelector('[data-sidebar="2"]') as HTMLElement | null;
    const slide03 = document.querySelector('[data-sidebar="3"]') as HTMLElement | null;
    const slide04 = document.querySelector('[data-sidebar="4"]') as HTMLElement | null;
    const slide06 = document.querySelector('[data-sidebar="6"]') as HTMLElement | null;
    const t06r = anim("06", "roiGrow");

    gsap.to(strip, {
      x: () => -(strip.scrollWidth - window.innerWidth - (config?.stripEndOffset ?? 0)),
      ease: "none",
      scrollTrigger: {
        trigger: track,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.5, 
      }
    });

    if (parallaxGrid) {
      gsap.to(parallaxGrid, {
        y: "-50vh", 
        ease: "none",
        scrollTrigger: {
          trigger: track,
          start: "top top",
          end: "bottom bottom",
          scrub: 0.1, 
        }
      });
    }

    // Measure where each sidebar section actually centers horizontally,
    // then resize asides and set indicator triggers to match those real positions.
    const sidebarEl = document.getElementById('sidebar-track') as HTMLElement;
    const sidebarAsides = sidebarEl ? (Array.from(sidebarEl.querySelectorAll('aside')) as HTMLElement[]) : [];

    const totalH = strip.scrollWidth - window.innerWidth - (config?.stripEndOffset ?? 0);
    const totalV = track.offsetHeight - window.innerHeight;

    // Vertical scroll position at which each section's content anchor is horizontally centered.
    // Uses anchorCenter() which prefers [data-sidebar-anchor] and falls back to section geometric center.
    const sectionScrollPos = sidebarSections.map(sec =>
      Math.max(0, (anchorCenter(sec) / totalH) * totalV)
    );

    // Resize each aside so its vertical center is at the viewport midpoint
    // exactly when scrollY equals that section's horizontal center position.
    let cumTop = 0;
    sidebarAsides.forEach((aside, i) => {
      if (i >= sectionScrollPos.length) return;
      const targetDocCenter = sectionScrollPos[i] + window.innerHeight / 2;
      const height = Math.max(window.innerHeight * 0.5, 2 * (targetDocCenter - cumTop));
      aside.style.height = `${height}px`;
      cumTop += height;
    });

    // Stretch the last aside to fill any remaining sidebar height — otherwise a gap of bare
    // background appears below "12 / Execution" because cumTop stops short of sidebarEl.offsetHeight.
    if (sidebarAsides.length) {
      const last = sidebarAsides[sidebarAsides.length - 1];
      const lastHeight = parseFloat(last.style.height);
      const remaining = sidebarEl.offsetHeight - (cumTop - lastHeight);
      if (remaining > lastHeight) {
        last.style.height = `${remaining}px`;
      }
    }

    // Indicator lines animate across each section's scroll window
    indicators.forEach((ind, i) => {
      if (i >= sectionScrollPos.length) return;
      const start = sectionScrollPos[i];
      const end = i + 1 < sectionScrollPos.length ? sectionScrollPos[i + 1] : totalV;
      gsap.to(ind, {
        scaleY: 1,
        ease: "none",
        scrollTrigger: {
          trigger: track,
          start: `${start}px top`,
          end: `${end}px top`,
          scrub: true,
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      const slideHeight = window.innerHeight;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        window.scrollBy({ top: slideHeight, behavior: 'smooth' });
      } 
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        window.scrollBy({ top: -slideHeight, behavior: 'smooth' });
      }
    });

    // NOTE: the old "3-STEP STAGGERED FADE LOGIC" (hands → phone → book cross-fade across
    // three separate images) lived here. Removed — SLIDE-0.5 now uses a single static photo
    // (girl.phone.headphones.webp), so cross-fading opacity between what would now be three
    // identical images accomplished nothing visually. See the SLIDE-0.5 section template for
    // the replacement.

    // Train fade: starts as SLIDE-01 enters from the right; resolves when text anchor reaches centre
    const t01 = anim("01", "trainFade");
    if (trainFadeLayer && slide01) {
      gsap.fromTo(trainFadeLayer,
        { opacity: 0 },
        {
          opacity: 0.8,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide01.offsetLeft + (t01?.start ?? -0.9) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(slide01.offsetLeft + (t01?.end ?? -0.3) * window.innerWidth)}px top`,
            scrub: t01?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    if (dataPaths.length > 0) {

      dataPaths.forEach((path: any) => {
        const length = path.getTotalLength();
        gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
      });

      const t02n = anim("02", "nodes");
      const t02p = anim("02", "paths");

      // 1. FADE THE NODES — reveal as SLIDE-02 enters; done before anchor reaches centre
      gsap.fromTo(dataNodes,
        { opacity: 0 },
        {
          opacity: 1,
          stagger: 0.08,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02n?.start ?? -0.85) * window.innerWidth)}px top` : "top top",
            end: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02n?.end ?? -0.55) * window.innerWidth)}px top` : "top top",
            scrub: t02n?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );

      // 2. DRAW THE PATHS — start at entry, finish past anchor centre
      gsap.to(dataPaths, {
        strokeDashoffset: 0,
        stagger: 0.1,
        ease: "power1.inOut",
        scrollTrigger: {
          trigger: track,
          start: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02p?.start ?? -0.75) * window.innerWidth)}px top` : "top top",
          end: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02p?.end ?? -0.35) * window.innerWidth)}px top` : "top top",
          scrub: t02p?.scrub ?? true,
          invalidateOnRefresh: true,
        }
      });
    }

    // Tiger blur-to-focus: starts entering from right, resolves sharp at anchor centre + half a screen
    const t03 = anim("03", "tigerFocus");
    if (tigerFocusLayer && slide03) {
      gsap.fromTo(tigerFocusLayer,
        { opacity: 0, filter: "blur(30px)" },
        {
          opacity: 0.8,
          filter: "blur(0px)",
          scale: 1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide03.offsetLeft + (t03?.start ?? -0.8) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(slide03.offsetLeft + (t03?.end ?? 0.1) * window.innerWidth)}px top`,
            scrub: t03?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    const t04v = anim("04", "visualsFade");
    const t04s = anim("04", "soundGrow");
    const t04vib = anim("04", "vibration");

    // "Visuals Fade" text: dims out as SLIDE-04 settles into view
    if (visualsFadeText && slide04) {
      gsap.fromTo(visualsFadeText,
        { opacity: 1 },
        {
          opacity: 0.05,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide04.offsetLeft + (t04v?.start ?? -0.85) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(slide04.offsetLeft + (t04v?.end ?? -0.2) * window.innerWidth)}px top`,
            scrub: t04v?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    // "Sound Echoes" text: grows and vibrates while SLIDE-04 is on screen
    if (soundGrowText && slide04) {
      gsap.fromTo(soundGrowText,
        { scale: 1 },
        {
          scale: 1.2,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide04.offsetLeft + (t04s?.start ?? -0.8) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(slide04.offsetLeft + (t04s?.end ?? -0.1) * window.innerWidth)}px top`,
            scrub: t04s?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );

      gsap.to(soundGrowText, {
        x: 2,
        duration: 0.05,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        scrollTrigger: {
          trigger: track,
          start: () => `${getScrollPos(slide04.offsetLeft + (t04vib?.start ?? -0.5) * window.innerWidth)}px top`,
          end: () => `${getScrollPos(slide04.offsetLeft + (t04vib?.end ?? 1.0) * window.innerWidth)}px top`,
          toggleActions: "play pause resume pause",
          invalidateOnRefresh: true,
        }
      });
    }

    // SLIDE-06: "ROI." word grows as the Conversion slide enters — resolves before roiTl takes over
    const roiWordEl = document.getElementById('roi-word');
    if (slide06 && roiWordEl) {
      gsap.fromTo(roiWordEl,
        { scale: 0.4, opacity: 0.3 },
        {
          scale: 1, opacity: 1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide06.offsetLeft + (t06r?.start ?? -0.8) * window.innerWidth)}px top`,
            end:   () => `${getScrollPos(slide06.offsetLeft + (t06r?.end   ??  0.3) * window.innerWidth)}px top`,
            scrub: t06r?.scrub ?? 0.5,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    const slide05 = document.querySelector('[data-sidebar="5"]') as HTMLElement;
    const t05pl = anim("05", "pressureLine");
    const t05sc = anim("05", "statCards");

    if (metricsSection && pressureLine && statCards.length > 0) {

      // 1. Draw the "Pressure" Line
      gsap.fromTo(pressureLine,
        { width: "0%" },
        {
          width: "100%",
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(metricsSection.offsetLeft + (t05pl?.start ?? -0.4) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(metricsSection.offsetLeft + (t05pl?.end ?? -0.1) * window.innerWidth)}px top`,
            scrub: t05pl?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );

      // 2. Slide the Cards out horizontally (Locked to physical screen center)
      if (statCards.length > 1) {

        // Calculate the total physical distance the cards will fan out
        const cardOffset = (t05sc as any)?.cardSpacing ?? 300;
        const maxDealDistance = (statCards.length - 1) * cardOffset; 
        
        // Create a single timeline to sequence the animations
        const cardTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: track,
            // START: when base card is near centre (configurable via t05sc.start)
            start: () => `${getScrollPos(metricsSection.offsetLeft + (t05sc?.start ?? -0.2) * window.innerWidth)}px top`,
            // END: stays dynamic — computed from the physical card spread
            end: () => `${getScrollPos(metricsSection.offsetLeft + maxDealDistance - window.innerWidth * 0.5)}px top`,
            scrub: t05sc?.scrub ?? 1,
            invalidateOnRefresh: true,
          }
        });

        // Loop through the cards, starting at index 1 (the second card)
        for (let i = 1; i < statCards.length; i++) {
          
          // Select the current card AND all cards underneath it
          const movingStack = statCards.slice(i); 
          
          // Add a step to the timeline
          cardTimeline.to(movingStack, {
            x: i * cardOffset, // Move the stack out 300px
            ease: "none", // CRITICAL: Use "none" so the movement perfectly tracks your scroll wheel 1:1
          });
        }
      }
    } // Ensure this closing brace is here!

    if (roiSection && roiCounter && roiWrapper) {
      const roiObj = { val: counters.roi.from };

      // Create a master timeline for the whole "Amplification" sequence
      const roiTl = gsap.timeline({
        scrollTrigger: {
          trigger: track,
          start: () => `${getScrollPos(roiSection.offsetLeft + counters.roi.start * window.innerWidth)}px top`,
          end:   () => `${getScrollPos(roiSection.offsetLeft + counters.roi.end   * window.innerWidth)}px top`,
          scrub: counters.roi.scrub ?? 1,
          invalidateOnRefresh: true,
        }
      });

      // 0. Scale the word "ROI." from small (50%) to full size (100%)
      // overwrite: 'auto' prevents conflict with the earlier roiGrow animation on the same element.
      if (roiWord) {
        roiTl.fromTo(roiWord,
          { scale: 0.5, opacity: 0.5 },
          { scale: 1, opacity: 1, ease: "power2.out", overwrite: 'auto' },
        0);
      }

      // 1. The Counter: from → to (configured in COUNTERS.roi)
      roiTl.to(roiObj, {
        val: counters.roi.to,
        ease: "none",
        onUpdate: () => {
          const currentText = roiObj.val.toFixed(counters.roi.decimals);

          // Update the main center number
          roiCounter.innerText = currentText;

          // Update the blurred ghost outlines so they count up in perfect sync!
          roiGhosts.forEach(ghost => {
            ghost.innerText = currentText + "x";
          });
        }
      }, 0);

      // 2. (Main Wrapper scale remains unchanged)
      roiTl.fromTo(roiWrapper, 
        { scale: 0.3, opacity: 0 },
        { scale: 1, opacity: 1, ease: "power2.out" }, 
      0);

      // 3. NEW: The Halo Bloom. Ghosts scale centrally behind the main number.
      roiGhosts.forEach((ghost, i) => {
         // Deep blur (index 0) starts HUGE and completely faint.
         // Mid blur (index 1) starts slightly smaller.
         const startScale = i === 0 ? 3 : 2; 
         
         roiTl.fromTo(ghost,
           { 
            // Pinned centrally (x: 0, y: 0)
            x: 0, y: 0, rotation: 0,
            scale: startScale, // Start huge
            opacity: 0,       // Start invisible
           },
           { 
            scale: 1,         // Settle to their HTML defined large size
            opacity: 1,       // Become visible blurred outlines
            ease: "power3.out" 
           },
         0);
      });

      // 4. (Shockwaves remain unchanged)
      roiWaves.forEach((wave, i) => {
         roiTl.to(wave, {
            width: `${60 + (i * 30)}vw`,
            height: `${60 + (i * 30)}vw`,
            opacity: 0, 
            ease: "power2.out"
         }, 0);
      });
    }

    // SUCCESS COUNTER LOGIC
    if (successCounter && successSection && successRing) {

      const startTrigger = () => `${getScrollPos(successSection.offsetLeft + counters.success.start * window.innerWidth)}px top`;
      const endTrigger   = () => `${getScrollPos(successSection.offsetLeft + counters.success.end   * window.innerWidth)}px top`;

      // 1. Animate the SVG Ring
      gsap.fromTo(successRing,
        { strokeDashoffset: 282.7 },
        {
          strokeDashoffset: 0,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: startTrigger,
            end: endTrigger,
            scrub: counters.success.scrub ?? 1,
            invalidateOnRefresh: true,
          }
        }
      );

      // 2. Animate the Number using GSAP's text snapping
      gsap.fromTo(successCounter,
        { innerText: 0 },
        {
          innerText: counters.success.to,
          snap: { innerText: 1 },
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: startTrigger,
            end: endTrigger,
            scrub: counters.success.scrub ?? 1,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    // END SCREEN — logo colour shift on arrival, fades back to primary
    // Triggered directly on #end-screen (normal document flow, not tied to scroll track)
    const endScreen = document.querySelector("#end-screen") as HTMLElement;
    const endLogoEl = document.querySelector("#end-logo") as Element;

    if (endScreen && endLogoEl) {
      // Logo shifts cyan → amber → cyan as the end screen scrolls into view
      gsap.timeline({
        scrollTrigger: {
          trigger: endScreen,
          start: "top 75%",
          end: "top 15%",
          scrub: 0.5,
        }
      })
      .to(endLogoEl, {
        attr: { fill: "hsl(var(--accent))", stroke: "hsl(var(--accent))" },
        ease: "power2.out",
        duration: 0.5,
      })
      .to(endLogoEl, {
        attr: { fill: "hsl(var(--primary))", stroke: "hsl(var(--primary))" },
        ease: "power2.in",
        duration: 0.5,
      }, 0.6);
    }

    // END SCREEN — sidebar indicator line fills as the user scrolls through the end screen
    const endIndicator = document.getElementById('end-indicator-line');
    if (endScreen && endIndicator) {
      gsap.to(endIndicator, {
        scaleY: 1,
        ease: "none",
        scrollTrigger: {
          trigger: endScreen,
          start: "top bottom",
          end: "bottom bottom",
          scrub: true,
        }
      });
    }

    // WORD HIGHLIGHTS — shift specific words from muted → accent as their slide enters
    if (highlights) {
      const animateWords = (
        slideEl: HTMLElement | null,
        cfg: { words: string[]; start: number; end: number; scrub: number; scaleOnly?: string[] },
        fromColour: string,
        toColour: string
      ) => {
        if (!slideEl) return;
        cfg.words.forEach((word, i) => {
          const el = document.getElementById(`hl-${word}`);
          if (!el) return;
          const stagger = i * 0.08 * window.innerWidth;
          const isScaleOnly = cfg.scaleOnly?.includes(word) ?? false;
          const trigger = {
            trigger: track,
            start: () => `${getScrollPos(slideEl.offsetLeft + cfg.start * window.innerWidth + stagger)}px top`,
            end:   () => `${getScrollPos(slideEl.offsetLeft + cfg.end   * window.innerWidth + stagger)}px top`,
            scrub: cfg.scrub ?? 0.5,
            invalidateOnRefresh: true,
          };
          if (isScaleOnly) {
            // Stays its current colour — just pulses scale slightly as scroll hits it
            gsap.fromTo(el, { scale: 1 }, { scale: 1.08, ease: "none", scrollTrigger: trigger });
          } else {
            gsap.fromTo(el, { color: fromColour }, { color: toColour, ease: "none", scrollTrigger: trigger });
          }
        });
      };

      // SLIDE-8.5 (SME/Untapped) — "untapped" shifts to accent
      const slideSme = document.getElementById('slide-sme') as HTMLElement | null;
      if (highlights.untapped) {
        animateWords(slideSme, highlights.untapped, 'hsl(var(--foreground) / 0.6)', 'hsl(var(--accent))');
      }

      // SLIDE-12 (Belief) — "Believe" and "power" shift to primary (readable on amber bg)
      const slide12 = document.querySelector('[data-sidebar="12"]') as HTMLElement | null;
      if (highlights.belief) {
        animateWords(slide12, highlights.belief, 'hsl(var(--background) / 0.5)', 'hsl(var(--primary))');
      }
    }
  };

  document.addEventListener('astro:page-load', initStickyScroll);
  if (document.readyState === 'complete') initStickyScroll();
  else window.addEventListener('load', initStickyScroll);

</script>

<style is:global>
  html.is-mobile-snap {
    scroll-snap-type: y mandatory;
  }

  html.is-mobile-snap #scroll-track {
    height: auto !important;
  }

  html.is-mobile-snap #scroll-track > .sticky {
    position: static !important;
    height: auto !important;
    overflow: visible !important;
  }

  html.is-mobile-snap body {
    overflow-x: hidden;
  }

  html.is-mobile-snap #horizontal-strip {
    flex-direction: column !important;
    width: 100vw !important;
    height: auto !important;
  }

  html.is-mobile-snap #horizontal-strip > section {
    width: 100vw !important;
    max-width: 100vw !important;
    height: 100dvh !important;
    min-height: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* REMOVED: display, flex-direction, justify-content — was breaking hidden sections */
    /* padding-right intentionally removed — controlled per content div */
  }

  /* Consistent mobile typography baseline */
  html.is-mobile-snap #horizontal-strip > section p {
    font-size: 1.25rem;
    line-height: 1.75rem;
    margin-top: 0.5rem;
  }

  html.is-mobile-snap #horizontal-strip > section h2 {
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-top: 0.75rem;
    margin-bottom: 1.75rem;
  }

  html.is-mobile-snap #horizontal-strip > section .text-eyebrow {
    margin-bottom: 1.5rem;
  }
</style>