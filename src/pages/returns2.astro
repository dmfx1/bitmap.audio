<script define:vars={{ SLIDES, sections, COUNTERS, HIGHLIGHTS, CONFIG, JOURNEY }} is:inline>
  window.__SLIDES__ = SLIDES;
  window.__SECTIONS__ = sections;
  window.__COUNTERS__ = COUNTERS;
  window.__HIGHLIGHTS__ = HIGHLIGHTS;
  window.__CONFIG__ = CONFIG;
  window.__JOURNEY__ = JOURNEY;
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);

  const initStickyScroll = () => {
    const strip = document.querySelector("#horizontal-strip") as HTMLElement;
    const track = document.querySelector("#scroll-track") as HTMLElement;
    const indicators = gsap.utils.toArray(".indicator-line") as HTMLElement[];

    // SVG data map elements (SLIDE-02)
    const dataPaths = gsap.utils.toArray(".data-path");
    const dataNodes = gsap.utils.toArray(".data-node");

    // SLIDE-04 text elements
    const visualsFadeText = document.querySelector("#visuals-fade-text");
    const soundGrowText = document.querySelector("#sound-grow-text");

    // METRICS SECTION ANIMATIONS (Pressure Line & Sliding Cards)
    const metricsSection = document.querySelector("#metrics-section") as HTMLElement;
    const pressureLine = document.querySelector("#pressure-line");
    const statCards = gsap.utils.toArray(".stat-card") as HTMLElement[];

    // AMPLIFIED ROI SECTION ANIMATION
    const roiSection = document.querySelector("#roi-section") as HTMLElement;
    const roiCounter = document.querySelector("#roi-counter") as HTMLElement;
    const roiWrapper = document.querySelector("#roi-text-wrapper");
    const roiGhosts = gsap.utils.toArray(".roi-ghost") as HTMLElement[];
    const roiWaves = gsap.utils.toArray(".roi-wave") as HTMLElement[];
    const roiWord = document.querySelector("#roi-word");

    //Success Counter Elements
    const successSection = document.querySelector("#success-section") as HTMLElement; // Add 'as HTMLElement'
    const successCounter = document.querySelector("#task-success-counter") as HTMLElement; // Add this too for good measure
    const successRing = document.querySelector("#success-ring") as SVGElement;


    if (!strip || !track) return;

    const config = (window as any).__CONFIG__ as { stripEndOffset: number; vividFrom: { saturate: number; brightness: number }; vividTo: { saturate: number; brightness: number }; vividWindow: number };
    const highlights = (window as any).__HIGHLIGHTS__;

    // Read config bridged from Astro frontmatter via window.__SECTIONS__ / window.__COUNTERS__
    const sectionConfig = (window as any).__SECTIONS__ as Array<{
      id: string; label: string; width?: string;
      anim?: Record<string, { start: number; end: number; scrub?: number }>;
    }>;
    const counters = (window as any).__COUNTERS__ as {
      roi: { from: number; to: number; decimals: number; start: number; end: number; scrub?: number };
      success: { to: number; start: number; end: number; scrub?: number };
      memory: { from: number; to: number; decimals: number; start: number; end: number; scrub?: number };
    };

    // Returns the timing entry for a given slide id + animation key, or null if not configured.
    const anim = (id: string, key: string) =>
      sectionConfig?.find(s => s.id === id)?.anim?.[key] ?? null;

    // Apply desktop slide widths from config, matching each slide by its exact data-slide id.
    // Exact string match (not numeric) is required: config id "08" lives on DOM data-slide="08"
    // even though that section's data-sidebar is "9" (there is no data-sidebar 8). Desktop uses
    // the config width; mobile forces 100vw for snap.
    const applyWidths = () => {
      const desktop = window.innerWidth >= 768;
      sectionConfig?.forEach((sec) => {
        if (!sec.width) return;
        const el = strip.querySelector(`[data-slide="${sec.id}"]`) as HTMLElement | null;
        if (el) el.style.width = desktop ? sec.width : '100vw';
      });
    };
    applyWidths();
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        applyWidths();
        ScrollTrigger.refresh();
      }, 150);
    });

    const isMobile = window.innerWidth < 768;

    if (isMobile) {
      document.documentElement.classList.add('is-mobile-snap');

      // NOTE: #end-screen is NOT relocated into the scroller any more — it's hidden on mobile
      // entirely (see `html.is-mobile-snap #end-screen` in the style block). Its only content is
      // navigation, which the hamburger already covers, so "Master the Signal" is the last slide.
      // Desktop is unaffected: end-screen stays in normal document flow after the track.

      // Adjust data map SVG viewBox to better fill 9:16 portrait
      const archSvg = document.querySelector('section[data-sidebar="2"] svg');
      if (archSvg) {
        archSvg.setAttribute('viewBox', '80 250 480 860');
      }
      return;
    }

    // stripEndOffset is a FRACTION of viewport width (not px), so the strip parks at the
    // same visual point on a 1400px laptop and a 2560px monitor. Evaluated live, never cached.
    const endOffset = () => (config?.stripEndOffset ?? 0) * window.innerWidth;

    // Converts a horizontal strip position to an absolute vertical scroll position.
    // Accounts for stripEndOffset so the strip parks short of full travel when configured.
    const getScrollPos = (horizontalPos: number) => {
      const totalHorizontal = strip.scrollWidth - window.innerWidth - endOffset();
      const totalVertical = track.offsetHeight - window.innerHeight;
      return (horizontalPos / totalHorizontal) * totalVertical;
    };

    // Returns the horizontal position at which a section's [data-sidebar-anchor] is centred in the viewport.
    // Falls back to the section's geometric centre when no anchor is present.
    const anchorCenter = (sec: HTMLElement): number => {
      const anchor = sec.querySelector('[data-sidebar-anchor]') as HTMLElement | null;
      return anchor
        ? sec.offsetLeft + anchor.offsetLeft + anchor.offsetWidth / 2 - window.innerWidth / 2
        : sec.offsetLeft + sec.offsetWidth / 2 - window.innerWidth / 2;
    };

    const slide02 = document.querySelector('[data-sidebar="2"]') as HTMLElement | null;
    const slide04 = document.querySelector('[data-sidebar="4"]') as HTMLElement | null;
    const slide06 = document.querySelector('[data-sidebar="6"]') as HTMLElement | null;
    const t06r = anim("06", "roiGrow");

    gsap.to(strip, {
      x: () => -(strip.scrollWidth - window.innerWidth - endOffset()),
      ease: "none",
      scrollTrigger: {
        trigger: track,
        start: "top top",
        end: "bottom bottom",
        // MUST be `true`, not a number. A numeric scrub makes the strip lag the scroll, so at the
        // horizontal→vertical handover the strip is still catching up after the page has moved on —
        // that disagreement is the stutter, and reversing direction restarts it. `true` locks the
        // strip 1:1 to scroll position, so the handover is seamless in both directions.
        // Tradeoff: no input smoothing, so a notched mouse wheel reads as discrete steps.
        // If that needs solving, smooth the INPUT (ScrollTrigger.normalizeScroll), not the strip.
        scrub: true,
        // CRITICAL: without this, the function-based `x` above is evaluated ONCE at setup and
        // cached. strip.scrollWidth isn't final at that moment (content-visibility:auto sections
        // aren't laid out, images/fonts still loading), so the strip parks short of full travel
        // and the last slide sits half off-screen until some later refresh snaps it into place.
        invalidateOnRefresh: true,
      }
    });

    // Re-measure once webfonts have settled. Font swap changes text metrics, which changes
    // strip.scrollWidth; this runs async (after init completes) so every trigger already exists.
    if (document.fonts?.ready) {
      document.fonts.ready.then(() => ScrollTrigger.refresh());
    }

    // Measure where each sidebar section actually centers horizontally,
    // then resize asides and set indicator triggers to match those real positions.
    const sidebarEl = document.getElementById('sidebar-track') as HTMLElement;
    const sidebarAsides = sidebarEl ? (Array.from(sidebarEl.querySelectorAll('aside')) as HTMLElement[]) : [];

    const totalH = strip.scrollWidth - window.innerWidth - endOffset();
    const totalV = track.offsetHeight - window.innerHeight;

    // Match each sidebar aside to ITS OWN slide by data-slide (robust to gaps / added slides),
    // instead of a positional map against [data-sidebar] which slips by one when an unlabelled
    // slide (e.g. 3.1) adds an aside with no matching section.
    const asideSecs = sidebarAsides.map(a =>
      strip.querySelector(`[data-slide="${a.dataset.asideId}"]`) as HTMLElement | null
    );
    // Vertical scroll position at which each aside's section is horizontally centered.
    const sectionScrollPos = asideSecs.map(sec =>
      sec ? Math.max(0, (anchorCenter(sec) / totalH) * totalV) : 0
    );

    // Oversized ghost number on each section slide — generated from the SAME order as the sidebar,
    // so the ghost and the sidebar number can never drift apart. Images/spacers get none.
    asideSecs.forEach((sec, i) => {
      if (!sec || sec.querySelector('.slide-ghost-num')) return;
      const g = document.createElement('div');
      
      // Replaced top-0 with top-1/2 and -translate-y-1/2
      g.className = 'slide-ghost-num mobile:hidden absolute right-0 top-1/2 -translate-y-1/2 font-mono font-bold text-foreground blur-4xl select-none pointer-events-none z-0 leading-none mix-blend-overlay opacity-30 z-2 hidden';
      
      g.style.fontSize = '50vw';
      g.textContent = String(i).padStart(2, '0');
      sec.prepend(g);
    });

    // Resize each aside so its vertical center is at the viewport midpoint
    // exactly when scrollY equals that section's horizontal center position.
    let cumTop = 0;
    sidebarAsides.forEach((aside, i) => {
      if (i >= sectionScrollPos.length) return;
      const targetDocCenter = sectionScrollPos[i] + window.innerHeight / 2;
      const height = Math.max(window.innerHeight * 0.5, 2 * (targetDocCenter - cumTop));
      aside.style.height = `${height}px`;
      cumTop += height;
    });

    // Stretch the last aside to fill any remaining sidebar height — otherwise a gap of bare
    // background appears below "12 / Execution" because cumTop stops short of sidebarEl.offsetHeight.
    if (sidebarAsides.length) {
      const last = sidebarAsides[sidebarAsides.length - 1];
      const lastHeight = parseFloat(last.style.height);
      const remaining = sidebarEl.offsetHeight - (cumTop - lastHeight);
      if (remaining > lastHeight) {
        last.style.height = `${remaining}px`;
      }
    }

    // Indicator lines animate across each section's scroll window
    indicators.forEach((ind, i) => {
      if (i >= sectionScrollPos.length) return;
      const start = sectionScrollPos[i];
      const end = i + 1 < sectionScrollPos.length ? sectionScrollPos[i + 1] : totalV;
      gsap.to(ind, {
        scaleY: 1,
        ease: "none",
        scrollTrigger: {
          trigger: track,
          start: `${start}px top`,
          end: `${end}px top`,
          scrub: true,
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      const slideHeight = window.innerHeight;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        window.scrollBy({ top: slideHeight, behavior: 'smooth' });
      } 
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        window.scrollBy({ top: -slideHeight, behavior: 'smooth' });
      }
    });

    // ── IMAGE SLIDES — generalised scroll-driven reveals ─────────────────────
    // Applied by class to every <ImageSlide> wrapper — no per-slide GSAP needed:
    //   .img-slide-fade   → opacity 0→1 (long flowing dissolve)
    //   .img-slide-focus  → opacity 0→1 + blur(30px)→blur(0) reveal
    // Ramp timing comes from IMG_DEFAULTS.ramp / per-slide ramp overrides
    // (bridged via data-ramp-start / data-ramp-end attributes on each section).
    // Convert an imgX value ("-75vw" | "-30px" | "0px") to px, so scroll timings can key to
    // where the IMAGE actually is (shifted by imgX) rather than to its slide's box.
    const parseImgX = (v?: string | null) => {
      if (!v) return 0;
      const n = parseFloat(v);
      if (isNaN(n)) return 0;
      return v.trim().endsWith("vw") ? (n / 100) * window.innerWidth : n;
    };

    const imgSlideTrigger = (sec: HTMLElement) => {
      const startMult = sec.dataset.rampStart ? parseFloat(sec.dataset.rampStart) : -0.9;
      const endMult = sec.dataset.rampEnd ? parseFloat(sec.dataset.rampEnd) : -0.15;
      const shift = () => parseImgX(sec.dataset.imgX); // align ramp to the shifted image

      return {
        trigger: track,
        start: () => `${getScrollPos(sec.offsetLeft + shift() + startMult * window.innerWidth)}px top`,
        end: () => `${getScrollPos(sec.offsetLeft + shift() + endMult * window.innerWidth)}px top`,
        scrub: true,
        invalidateOnRefresh: true,
      };
    };

    document.querySelectorAll(".img-slide-fade").forEach((layer) => {
      const sec = layer.closest("section") as HTMLElement | null;
      if (!sec) return;
      gsap.fromTo(layer, { opacity: 0 }, { opacity: 1, ease: "none", scrollTrigger: imgSlideTrigger(sec) });
    });

    document.querySelectorAll(".img-slide-focus").forEach((layer) => {
      const sec = layer.closest("section") as HTMLElement | null;
      if (!sec) return;
      gsap.fromTo(layer,
        { opacity: 0, filter: "blur(30px)" },
        { opacity: 1, filter: "blur(0px)", ease: "power2.out", scrollTrigger: imgSlideTrigger(sec) }
      );
    });

    // ── BACKGROUND COLOUR JOURNEY (desktop only) ─────────────────────────────
    // Drifts #journey-bg's colour through the JOURNEY checkpoints as the strip scrolls.
    // Each checkpoint pins to a slide's offsetLeft, so it self-corrects to width changes.
    const journeyBg = document.getElementById("journey-bg");
    const journey = (window as any).__JOURNEY__ as Array<{ at: string; color: string; offset?: number }>;
    if (journeyBg && journey?.length) {
      gsap.set(journeyBg, { backgroundColor: journey[0].color });
      for (let i = 0; i < journey.length - 1; i++) {
        const a = journey[i], b = journey[i + 1];
        // Resolve a checkpoint id to a section: text slides use data-sidebar, image
        // slides use data-slide (lets the journey pin a colour to an image slide).
        const findSec = (id: string) =>
          (document.querySelector(`[data-sidebar="${id}"]`) ||
           document.querySelector(`[data-slide="${id}"]`)) as HTMLElement | null;
        const secA = findSec(a.at);
        const secB = findSec(b.at);
        if (!secA || !secB) continue;
        gsap.fromTo(journeyBg,
          { backgroundColor: a.color },
          {
            backgroundColor: b.color,
            ease: "none",
            // Without this, every fromTo paints its `from` colour at creation time and the LAST
            // segment (amber) wins until ScrollTrigger recomputes — causing an amber flash on refresh.
            immediateRender: false,
            scrollTrigger: {
              trigger: track,
              // `offset` (vw) shifts a checkpoint's trigger point: negative = colour arrives
              // earlier (e.g. start the amber behind the image), positive = later.
              start: () => `${getScrollPos(secA.offsetLeft + (a.offset ?? 0) * window.innerWidth)}px top`,
              end: () => `${getScrollPos(secB.offsetLeft + (b.offset ?? 0) * window.innerWidth)}px top`,
              scrub: true,
              invalidateOnRefresh: true,
            },
          }
        );
      }
    }

    // ── AD6: Vividness ramp ─────────────────────────────────────────────────
    // Slides flagged `vivid:true` desaturate/dim off-centre, reach full colour as their
    // anchor hits viewport centre, then ease back down as they exit. Filter is applied to
    // the <img> only (scoped repaint) — never the whole section. Desktop-only (this path).
    const vividFrom = `saturate(${config.vividFrom.saturate}) brightness(${config.vividFrom.brightness})`;
    const vividTo   = `saturate(${config.vividTo.saturate}) brightness(${config.vividTo.brightness})`;
    const vividWin  = () => window.innerWidth * (config?.vividWindow ?? 0.9);
    const slidesCfg = (window as any).__SLIDES__ as Array<{
id: string; type?: string; vivid?: boolean; imgX?: string; opacity?: number;
      reveal?: { window?: number; hold?: number; blur?: number };
}>;
    slidesCfg?.filter((sl) => sl.vivid).forEach((sl) => {
      const sec = strip.querySelector(`[data-slide="${sl.id}"]`) as HTMLElement | null;
      const target = sec?.querySelector("img") as HTMLElement | null;
      if (!sec || !target) return;
      const shift = () => parseImgX(sl.imgX); // peak brightness when the shifted IMAGE is centred
      target.style.willChange = "filter";
      gsap.set(target, { filter: vividFrom });
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: track,
          start: () => `${getScrollPos(anchorCenter(sec) + shift() - vividWin())}px top`,
          end:   () => `${getScrollPos(anchorCenter(sec) + shift() + vividWin())}px top`,
          scrub: 0.5,
          invalidateOnRefresh: true,
        },
      });
      tl.fromTo(target, { filter: vividFrom }, { filter: vividTo, ease: "none" })
        .to(target, { filter: vividFrom, ease: "none" });
});

    // ── BEHIND IMAGES — symmetric dissolve ───────────────────────────────────
    // type:"behind" images live inside a text slide, so they can't use .img-slide-fade
    // (that ramps one-way off the section's LEFT edge — wrong for an image centred in a
    // 300vw slide). This ramps opacity + blur UP as the slide approaches centre and back
    // DOWN as it leaves, so the image emerges from the journey colour and dissolves back
    // into it. Tuned per slide via `reveal: { window, blur }`.
    slidesCfg
      ?.filter((sl) => sl.type === "behind" && sl.reveal)
      .forEach((sl) => {
        const sec = strip.querySelector(`[data-slide="${sl.id}"]`) as HTMLElement | null;
        const layer = sec?.querySelector("[data-behind-layer]") as HTMLElement | null;
        if (!sec || !layer) return;
        const win = () => window.innerWidth * (sl.reveal?.window ?? 1.2);
        const soft = { opacity: 0, filter: `blur(${sl.reveal?.blur ?? 30}px)` };
        const full = { opacity: (sl.opacity ?? 100) / 100, filter: "blur(0px)" };
        // `hold` = the fraction of the span the image sits FULLY sharp. Without it the
        // timeline is a triangle — sharp for one instant at dead centre and blurry the whole
        // time it's actually on screen. The remainder is split evenly between the two edges.
        const hold = sl.reveal?.hold ?? 0.6;
        const edge = Math.max(0, (1 - hold) / 2);
        layer.style.willChange = "opacity, filter";
        gsap.set(layer, soft);
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(anchorCenter(sec) - win())}px top`,
            end:   () => `${getScrollPos(anchorCenter(sec) + win())}px top`,
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        });
        tl.fromTo(layer, soft, { ...full, ease: "none", duration: edge })
          .to(layer, { ...full, ease: "none", duration: hold })
          .to(layer, { ...soft, ease: "none", duration: edge });
    });

    // ── Blur-in text ("coming from the subconscious") — tagged [data-blur-in] blocks start
    // hazy + faint and resolve to full focus as they reach viewport centre. Blur-IN only:
    // once focused they stay focused (the trigger self-kills so reverse scroll can't rewind it).
    document.querySelectorAll('[data-blur-in]').forEach((node) => {
      const target = node as HTMLElement;
      const sec = target.closest('[data-slide]') as HTMLElement | null;
      if (!sec) return;
      const dull = { filter: 'blur(50px)', opacity: 0.15 };
      const sharp = { filter: 'blur(0px)', opacity: 1 };
      const win = () => window.innerWidth * 0.45;
      target.style.willChange = 'filter, opacity';
      gsap.set(target, dull);
      // Blur/fade in only — reaches full focus as it hits centre, then stays sharp (no re-blur).
      gsap.fromTo(target, dull,
        {
          // ease MUST be "none" on a scrubbed tween — scroll position is the playhead, so any
          // easing curve front-loads the change and reads as a jolt. Linear = 1:1 with scroll.
          ...sharp, ease: 'none',
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(anchorCenter(sec) - win())}px top`,
            end:   () => `${getScrollPos(anchorCenter(sec))}px top`,
            scrub: true, // MUST match the strip's scrub, or the blur resolves after the text
                         // has already passed centre. Change both together, never one alone.
            invalidateOnRefresh: true,
            // Lock it once focused — kill the trigger on the way out so scrolling back
            // can't rewind the scrub and re-blur the text.
            onLeave: (self) => { self.kill(); gsap.set(target, sharp); },
          },
        }
      );
    });



    if (dataPaths.length > 0) {

      dataPaths.forEach((path: any) => {
        const length = path.getTotalLength();
        gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
      });

      const t02n = anim("02", "nodes");
      const t02p = anim("02", "paths");

      // 1. FADE THE NODES — reveal as SLIDE-02 enters; done before anchor reaches centre
      gsap.fromTo(dataNodes,
        { opacity: 0 },
        {
          opacity: 1,
          stagger: 0.08,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02n?.start ?? -0.85) * window.innerWidth)}px top` : "top top",
            end: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02n?.end ?? -0.55) * window.innerWidth)}px top` : "top top",
            scrub: t02n?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );

      // 2. DRAW THE PATHS — start at entry, finish past anchor centre
      gsap.to(dataPaths, {
        strokeDashoffset: 0,
        stagger: 0.1,
        ease: "power1.inOut",
        scrollTrigger: {
          trigger: track,
          start: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02p?.start ?? -0.75) * window.innerWidth)}px top` : "top top",
          end: () => slide02 ? `${getScrollPos(slide02.offsetLeft + (t02p?.end ?? -0.35) * window.innerWidth)}px top` : "top top",
          scrub: t02p?.scrub ?? true,
          invalidateOnRefresh: true,
        }
      });
    }

    const t04v = anim("04", "visualsFade");
    const t04s = anim("04", "soundGrow");
    const t04vib = anim("04", "vibration");

    // "Visuals Fade" text: dims out as SLIDE-04 settles into view
    if (visualsFadeText && slide04) {
      gsap.fromTo(visualsFadeText,
        { opacity: 1 },
        {
          opacity: 0.05,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide04.offsetLeft + (t04v?.start ?? -0.85) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(slide04.offsetLeft + (t04v?.end ?? -0.2) * window.innerWidth)}px top`,
            scrub: t04v?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    // "Sound Echoes" text: grows and vibrates while SLIDE-04 is on screen
    if (soundGrowText && slide04) {
      gsap.fromTo(soundGrowText,
        { scale: 1 },
        {
          scale: 1.2,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide04.offsetLeft + (t04s?.start ?? -0.8) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(slide04.offsetLeft + (t04s?.end ?? -0.1) * window.innerWidth)}px top`,
            scrub: t04s?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );

      gsap.to(soundGrowText, {
        x: 2,
        duration: 0.05,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        scrollTrigger: {
          trigger: track,
          start: () => `${getScrollPos(slide04.offsetLeft + (t04vib?.start ?? -0.5) * window.innerWidth)}px top`,
          end: () => `${getScrollPos(slide04.offsetLeft + (t04vib?.end ?? 1.0) * window.innerWidth)}px top`,
          toggleActions: "play pause resume pause",
          invalidateOnRefresh: true,
        }
      });
    }

    // SLIDE-06: "ROI." word grows as the Conversion slide enters — resolves before roiTl takes over
    const roiWordEl = document.getElementById('roi-word');
    if (slide06 && roiWordEl) {
      gsap.fromTo(roiWordEl,
        { scale: 0.4, opacity: 0.3 },
        {
          scale: 1, opacity: 1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide06.offsetLeft + (t06r?.start ?? -0.8) * window.innerWidth)}px top`,
            end:   () => `${getScrollPos(slide06.offsetLeft + (t06r?.end   ??  0.3) * window.innerWidth)}px top`,
            scrub: t06r?.scrub ?? 0.5,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    const slide05 = document.querySelector('[data-sidebar="5"]') as HTMLElement;
    const t05pl = anim("05", "pressureLine");
    const t05sc = anim("05", "statCards");

    if (metricsSection && pressureLine && statCards.length > 0) {

      // 1. Draw the "Pressure" Line
      gsap.fromTo(pressureLine,
        { width: "0%" },
        {
          width: "100%",
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(metricsSection.offsetLeft + (t05pl?.start ?? -0.4) * window.innerWidth)}px top`,
            end: () => `${getScrollPos(metricsSection.offsetLeft + (t05pl?.end ?? -0.1) * window.innerWidth)}px top`,
            scrub: t05pl?.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );

      // 2. Slide the Cards out horizontally (Locked to physical screen center)
      if (statCards.length > 1) {

        // Calculate the total physical distance the cards will fan out
        const cardOffset = (t05sc as any)?.cardSpacing ?? 300;
        const maxDealDistance = (statCards.length - 1) * cardOffset; 
        
        // Create a single timeline to sequence the animations
        const cardTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: track,
            // START: when base card is near centre (configurable via t05sc.start)
            start: () => `${getScrollPos(metricsSection.offsetLeft + (t05sc?.start ?? -0.2) * window.innerWidth)}px top`,
            // END: stays dynamic — computed from the physical card spread
            end: () => `${getScrollPos(metricsSection.offsetLeft + maxDealDistance - window.innerWidth * 0.5)}px top`,
            scrub: t05sc?.scrub ?? 1,
            invalidateOnRefresh: true,
          }
        });

        // Loop through the cards, starting at index 1 (the second card)
        for (let i = 1; i < statCards.length; i++) {
          
          // Select the current card AND all cards underneath it
          const movingStack = statCards.slice(i); 
          
          // Add a step to the timeline
          cardTimeline.to(movingStack, {
            x: i * cardOffset, // Move the stack out 300px
            ease: "none", // CRITICAL: Use "none" so the movement perfectly tracks your scroll wheel 1:1
          });
        }
      }
    } // Ensure this closing brace is here!

    if (roiSection && roiCounter && roiWrapper) {
      const roiObj = { val: counters.roi.from };

      // Create a master timeline for the whole "Amplification" sequence
      const roiTl = gsap.timeline({
        scrollTrigger: {
          trigger: track,
          start: () => `${getScrollPos(roiSection.offsetLeft + counters.roi.start * window.innerWidth)}px top`,
          end:   () => `${getScrollPos(roiSection.offsetLeft + counters.roi.end   * window.innerWidth)}px top`,
          scrub: counters.roi.scrub ?? 1,
          invalidateOnRefresh: true,
        }
      });

      // 0. Scale the word "ROI." from small (50%) to full size (100%)
      // overwrite: 'auto' prevents conflict with the earlier roiGrow animation on the same element.
      if (roiWord) {
        roiTl.fromTo(roiWord,
          { scale: 0.5, opacity: 0.5 },
          { scale: 1, opacity: 1, ease: "power2.out", overwrite: 'auto' },
        0);
      }

      // 1. The Counter: from → to (configured in COUNTERS.roi)
      roiTl.to(roiObj, {
        val: counters.roi.to,
        ease: "none",
        onUpdate: () => {
          const currentText = roiObj.val.toFixed(counters.roi.decimals);

          // Update the main center number
          roiCounter.innerText = currentText;

          // Update the blurred ghost outlines so they count up in perfect sync!
          roiGhosts.forEach(ghost => {
            ghost.innerText = currentText + "x";
          });
        }
      }, 0);

      // 2. (Main Wrapper scale remains unchanged)
      roiTl.fromTo(roiWrapper, 
        { scale: 0.3, opacity: 0 },
        { scale: 1, opacity: 1, ease: "power2.out" }, 
      0);

      // 3. NEW: The Halo Bloom. Ghosts scale centrally behind the main number.
      roiGhosts.forEach((ghost, i) => {
         // Deep blur (index 0) starts HUGE and completely faint.
         // Mid blur (index 1) starts slightly smaller.
         const startScale = i === 0 ? 3 : 2; 
         
         roiTl.fromTo(ghost,
           { 
            // Pinned centrally (x: 0, y: 0)
            x: 0, y: 0, rotation: 0,
            scale: startScale, // Start huge
            opacity: 0,       // Start invisible
           },
           { 
            scale: 1,         // Settle to their HTML defined large size
            opacity: 1,       // Become visible blurred outlines
            ease: "power3.out" 
           },
         0);
      });

      // 4. (Shockwaves remain unchanged)
      roiWaves.forEach((wave, i) => {
         roiTl.to(wave, {
            width: `${60 + (i * 30)}vw`,
            height: `${60 + (i * 30)}vw`,
            opacity: 0, 
            ease: "power2.out"
         }, 0);
      });
    }

    // SUCCESS COUNTER LOGIC
    if (successCounter && successSection && successRing) {

      const startTrigger = () => `${getScrollPos(successSection.offsetLeft + counters.success.start * window.innerWidth)}px top`;
      const endTrigger   = () => `${getScrollPos(successSection.offsetLeft + counters.success.end   * window.innerWidth)}px top`;

      // 1. Animate the SVG Ring
      gsap.fromTo(successRing,
        { strokeDashoffset: 282.7 },
        {
          strokeDashoffset: 0,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: startTrigger,
            end: endTrigger,
            scrub: counters.success.scrub ?? 1,
            invalidateOnRefresh: true,
          }
        }
      );

      // 2. Animate the Number using GSAP's text snapping
      gsap.fromTo(successCounter,
        { innerText: 0 },
        {
          innerText: counters.success.to,
          snap: { innerText: 1 },
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: startTrigger,
            end: endTrigger,
            scrub: counters.success.scrub ?? 1,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    // 20x Longer Memory Retention — counts up to 20 as the 4.5 slide reaches centre
    // (reinstates the removed ROI counter's count-up; tunable via COUNTERS.memory).
    const memSection = document.querySelector('[data-slide="4.5"]') as HTMLElement | null;
    const memCounter = document.querySelector("#mem-counter") as HTMLElement | null;
    if (memSection && memCounter && counters.memory) {
      gsap.fromTo(memCounter,
        { innerText: counters.memory.from },
        {
          innerText: counters.memory.to,
          snap: { innerText: 1 },
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(anchorCenter(memSection) + counters.memory.start * window.innerWidth)}px top`,
            end:   () => `${getScrollPos(anchorCenter(memSection) + counters.memory.end   * window.innerWidth)}px top`,
            scrub: counters.memory.scrub ?? true,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    // END SCREEN — logo colour shift on arrival, fades back to primary
    // Triggered directly on #end-screen (normal document flow, not tied to scroll track)
    const endScreen = document.querySelector("#end-screen") as HTMLElement;
    const endLogoEl = document.querySelector("#end-logo") as Element;

    if (endScreen && endLogoEl) {
      // Logo shifts cyan → amber → cyan as the end screen scrolls into view
      gsap.timeline({
        scrollTrigger: {
          trigger: endScreen,
          start: "top 75%",
          end: "top 15%",
          scrub: 0.5,
        }
      })
      .to(endLogoEl, {
        attr: { fill: "hsl(var(--accent))", stroke: "hsl(var(--accent))" },
        ease: "power2.out",
        duration: 0.5,
      })
      .to(endLogoEl, {
        attr: { fill: "hsl(var(--primary))", stroke: "hsl(var(--primary))" },
        ease: "power2.in",
        duration: 0.5,
      }, 0.6);
    }

    // END SCREEN — sidebar indicator line fills as the user scrolls through the end screen
    const endIndicator = document.getElementById('end-indicator-line');
    if (endScreen && endIndicator) {
      gsap.to(endIndicator, {
        scaleY: 1,
        ease: "none",
        scrollTrigger: {
          trigger: endScreen,
          start: "top bottom",
          end: "bottom bottom",
          scrub: true,
        }
      });
    }

    // ── SOUNDWAVES FADE OUT ─────────────────────────────────────────────────
    // The Tiger's ramp finishes at -0.5 (it is fully established).
    // We start fading the rings out exactly there, finishing as the tiger hits 0.
    const soundwaveRings = document.getElementById("soundwave-rings");
    const slide3_25 = document.querySelector('[data-slide="3.25"]') as HTMLElement | null;

    if (soundwaveRings && slide3_25) {
      gsap.fromTo(soundwaveRings,
        { opacity: 1 },
        {
          opacity: 0,
          ease: "none",
          scrollTrigger: {
            trigger: track,
            start: () => `${getScrollPos(slide3_25.offsetLeft - 1.2 * window.innerWidth)}px top`,
            end: () => `${getScrollPos(slide3_25.offsetLeft -0.7 * window.innerWidth)}px top`,
            scrub: true,
            invalidateOnRefresh: true,
          }
        }
      );
    }

    // WORD HIGHLIGHTS — shift specific words from muted → accent as their slide enters
    if (highlights) {
      const animateWords = (
        slideEl: HTMLElement | null,
        cfg: { words: string[]; start: number; end: number; scrub: number; scaleOnly?: string[] },
        fromColour: string,
        toColour: string
      ) => {
        if (!slideEl) return;
        cfg.words.forEach((word, i) => {
          const el = document.getElementById(`hl-${word}`);
          if (!el) return;
          const stagger = i * 0.08 * window.innerWidth;
          const isScaleOnly = cfg.scaleOnly?.includes(word) ?? false;
          const trigger = {
            trigger: track,
            start: () => `${getScrollPos(slideEl.offsetLeft + cfg.start * window.innerWidth + stagger)}px top`,
            end:   () => `${getScrollPos(slideEl.offsetLeft + cfg.end   * window.innerWidth + stagger)}px top`,
            scrub: cfg.scrub ?? 0.5,
            invalidateOnRefresh: true,
          };
          if (isScaleOnly) {
            // Stays its current colour — just pulses scale slightly as scroll hits it
            gsap.fromTo(el, { scale: 1 }, { scale: 1.08, ease: "none", scrollTrigger: trigger });
          } else {
            gsap.fromTo(el, { color: fromColour }, { color: toColour, ease: "none", scrollTrigger: trigger });
          }
        });
      };

      // SLIDE-8.5 (SME/Untapped) — "untapped" shifts to accent
      const slideSme = document.getElementById('slide-sme') as HTMLElement | null;
      if (highlights.untapped) {
        animateWords(slideSme, highlights.untapped, 'hsl(var(--foreground) / 0.6)', 'hsl(var(--accent))');
      }

      // SLIDE-12 (Belief) — "Believe" and "power" shift to primary (readable on amber bg)
      const slide12 = document.querySelector('[data-sidebar="12"]') as HTMLElement | null;
      if (highlights.belief) {
        animateWords(slide12, highlights.belief, 'hsl(var(--background) / 0.5)', 'hsl(var(--primary))');
      }
    }
  };

  document.addEventListener('astro:page-load', initStickyScroll);
  if (document.readyState === 'complete') initStickyScroll();
  else window.addEventListener('load', initStickyScroll);

</script>

<style is:global>
  /* Flip the "visuals-fade-sound-echoes" image horizontally */
  [data-slide="4.25"] img {
    transform: scaleX(-1);
  }
  
  /* MOBILE SNAP — the scroller is the .sticky container, NOT the document.
     Why: when `html` is the scroller, scrolling up re-shows the browser address bar, which
     shrinks `dvh`. Every 100dvh section then shrinks at once, the scroll height above you
     collapses, and the browser re-snaps — that's the overshoot, and it compounds toward the
     top. Scrolling an inner container means the document never scrolls, so the chrome never
     retracts and `svh` is the true viewport for the whole session. Fixes the overshoot AND
     the next-slide peek together. Desktop is untouched: `.sticky` keeps its sticky/100vh/
     overflow-hidden rules, and `is-mobile-snap` is only added when innerWidth < 768. */
  html.is-mobile-snap {
    /* snap moved to the .sticky container below — must NOT be on html too, or both the
       document and the container try to snap and they fight each other */
    overflow: hidden;
    height: 100%;
  }

  html.is-mobile-snap #scroll-track {
    height: auto !important;
  }

  html.is-mobile-snap #scroll-track > .sticky {
    position: static !important;
    /* svh (static, chrome-showing) — NEVER dvh here. A dynamic height on the scroll container
       reintroduces the exact reflow this change exists to remove. */
    height: 100svh !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    scroll-snap-type: y mandatory;
    overscroll-behavior-y: contain;   /* no pull-to-refresh / scroll chaining out of the strip */
    -webkit-overflow-scrolling: touch;
  }

  html.is-mobile-snap body {
    overflow-x: hidden;
    /* Body must not scroll — the .sticky container owns scrolling now. Without this the
       document keeps a scrollbar and you get two nested scrollers fighting. */
    overflow-y: hidden;
    height: 100%;
  }

  html.is-mobile-snap #horizontal-strip {
    flex-direction: column !important;
    width: 100vw !important;
    height: auto !important;
  }

  /* DESCENDANT selector, not `> section`. Most slides are direct children of the strip, but
     grouped mobile slides (e.g. the Recall-Under-Pressure sticky-backdrop group) sit inside a
     wrapper div and would otherwise lose their height/snap rules and collapse. No sections are
     nested inside other sections, so the looser selector is safe. */
  html.is-mobile-snap #horizontal-strip section {
    width: 100vw !important;
    max-width: 100vw !important;
    /* svh, not dvh — matches the container exactly and is static, so nothing reflows mid-scroll.
       Not `100%` either: #horizontal-strip is height:auto, so a percentage would collapse. */
    height: 100svh !important;
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* REMOVED: display, flex-direction, justify-content — was breaking hidden sections */
    /* padding-right intentionally removed — controlled per content div */
  }

  /* #end-screen is dropped on mobile — it's navigation-only and the hamburger covers that, so
     "Master the Signal" is the final slide. It lives outside #scroll-track, so with the inner
     container owning the scroll it would be unreachable anyway; display:none makes that explicit
     rather than accidental. Desktop keeps it in normal flow after the track. */
  html.is-mobile-snap #end-screen {
    display: none !important;
  }

  /* CTA button — accent on mobile, matching the accent CTAs elsewhere on the site
     (`bg-accent text-background`). Done as a rule rather than Tailwind classes because
     `.is-electric-primary` in global.css sets background/border/colour with !important, so a
     utility class can't reliably beat it. This selector carries an id, so it wins on specificity
     as well as !important — deterministic regardless of stylesheet order.
     DESKTOP UNTOUCHED: scoped to is-mobile-snap, so the primary/electric-blue CTA stays as-is. */
  html.is-mobile-snap #horizontal-strip .is-electric-primary {
    border-color: hsl(var(--accent)) !important;
    background-color: hsl(var(--accent)) !important;
    color: hsl(var(--background)) !important;
    box-shadow: 0 0 30px hsl(var(--accent) / 0.4) !important;
  }

  /* Consistent mobile typography baseline */
  html.is-mobile-snap #horizontal-strip section p {
    font-size: 1.25rem;
    line-height: 1.75rem;
    margin-top: 0.5rem;
  }

  html.is-mobile-snap #horizontal-strip section h2 {
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
    margin-top: 0.75rem;
    margin-bottom: 1.75rem;
  }

  html.is-mobile-snap #horizontal-strip section .text-eyebrow {
    margin-bottom: 1.5rem;
  }
</style>