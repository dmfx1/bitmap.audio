---
/* src/pages/home.astro
 *
 * Homepage on the SCENE-STAGE architecture — a faithful clone of about-v3's PROVEN inline structure.
 * Hero/header stay locked; scroll drives ONE master timeline: "enter the void" (binary-rain zoom +
 * portal bloom + beige fog) → Services → Philosophy (6-stage bitmap scene, ported from About) → CTA (dark,
 * oversized Departure Mono, pixelates in) → release into the footer. No real vertical scroll until then.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/modules/Hero.tsx';
import ServicePillars from '../components/modules/ServicePillars';
import SonicWaves from '../components/modules/SonicWaves.astro';
import UiuxNodes from '../components/modules/UiuxNodes.astro';
import SpatialDepth from '../components/modules/SpatialDepth.astro';
// Pillar draw-in scene imports (SpatialPerspective/UiuxCircuit) removed while the feature is paused — see CLAUDE.md.
// Philosophy.tsx (old typed micro/macro quote) is no longer used here — kept on disk until the port is signed off.
import BinaryField from '../components/modules/BinaryField.astro';
import PhilosophyScene from '../components/modules/PhilosophyScene.astro';
import SoftCta from '../components/modules/SoftCta.astro';
// HowWeWork.astro (cards + chevrons version) is kept on disk but not used — trialling ProcessWords (big type).
import ProcessWords from '../components/modules/ProcessWords.astro';
import CtaScene from '../components/modules/CtaScene.astro';

// ── COPY — edit the home page's scene text here ──
const PHILOSOPHY_CAPTIONS = [
  'Think of your sound like the pixels in an image.',
  'We translate traits of your brand\'s personality into distinct audio "bits".',
  'Then map them together into a unified sonic identity.',
  'The master asset gives you a cohesive sound for your brand.',
  'Modular stems are then pulled from the master, ready for every touchpoint.',
  'The result is complete consistency in how your brand sounds, wherever it appears.',
];
const HOW_STEPS = [
  // icon = a philosophy pixel motif (lib/bit-motifs.ts): 'pixel' · 'bits' · 'map' · 'master' · 'stems' · 'result'
  { n: '00', name: 'Discovery', line: 'Who you are, and what you mean.', icon: 'pixel' },
  { n: '01', name: 'Conceptualise', line: 'Two or three directions to choose from.', icon: 'bits' },
  { n: '02', name: 'Production', line: 'The master sound, built.', icon: 'result' },   // big block, small blocks inside
  { n: '03', name: 'Delivery', line: 'Stems, every version, cut from the master.', icon: 'stems' },
] as const;
---

<Layout
  title="bitmap.audio | sonic branding & immersive audio"
  description="bitmap.audio designs sonic brand systems, UI/UX sound, and immersive audio for digital products and forward-thinking brands."
>
  <div id="page-bar" aria-hidden="true">
    <span class="solaris-text" data-page-label></span>
  </div>

  <div id="stage-track">
    <div class="stage-pin" id="hero-sticky">
      <div class="scene" data-scene="hero" style="z-index:0">
        <Hero client:load />
      </div>
      <div class="stage-fog" data-stage="fog" aria-hidden="true"></div>
      <div class="stage-portal" data-stage="portal" aria-hidden="true"></div>

      {/* Services — fades in through the fog. */}
      <div class="scene theme-oat" data-scene="services" style="z-index:10">
        {/* PILLAR "DRAW-IN" MOTIFS — one per card, revealed when that pillar is active, masked away
            from the cards (void). index 0 → UiuxNodes (network), 1 → SonicWaves (spectrum bars),
            2 → SpatialDepth (perspective tunnel). Toggled in ServicePillars.tsx. */}
        <SonicWaves />
        <UiuxNodes />
        <SpatialDepth />
        <div class="scene-body">
          <ServicePillars client:load />
        </div>
      </div>

      {/* LISTENING BETWEEN THE LINES — oat interstitial (no bar). A field of large 0/1 digits cascades
          down from the top (per-column random speeds) until the section is full; the centre row then
          scrambles into the phrase WITH SCROLL; the field fades away into philosophy. The cascade + fade are
          TRIGGERED (play on their own clock, both scroll directions); the phrase is SCRUBBED.
          Component: BinaryField.astro; animation: lib/scenes/binary-field.ts. Mobile: static, fully instantiated. */}
      <div class="scene field-scene" data-scene="lines" style="z-index:15">
        <BinaryField phrase="listening between the lines" />
      </div>

      {/* Philosophy — the 6-stage bitmap scene (PhilosophyScene.astro + lib/scenes/philosophy.ts), ported from
          About. A stacked layer; the choreography is nested in the master timeline (see PHIL_SPEED). */}
      <div class="scene phil-scene" data-scene="philosophy" style="z-index:20">
        <PhilosophyScene captions={PHILOSOPHY_CAPTIONS} />
      </div>

      {/* SOFT CTA — dark, follows on from philosophy's dark ending. Deliberately LIGHTER than the final CTA
          (mono, smaller, no pixel veil) so the page doesn't "end twice". Same action as the final CTA. */}
      <div class="scene soft-cta-scene" data-scene="soft-cta" style="z-index:25">
        <div class="scene-body">
          <SoftCta
            head="How do you sound"
            accent="right now?"
            sub="Book a free, no-obligation 30-minute call with Dom and Nick to talk about how sound could work for your brand, product or space."
            href="/contact"
            label="Book a free call"
          />{/* TODO: point href at a booking tool once chosen */}
        </div>
      </div>

      {/* OUR PROCESS — oat. Big-type steps that scramble into each other + footer. Component: ProcessWords.astro (HowWeWork.astro = the cards version, unused). */}
      <div class="scene theme-oat how-scene" data-scene="how" style="z-index:27">
        <div class="scene-body">
          <ProcessWords
            heading="How we work together"
            steps={HOW_STEPS}
            aside="Most of the time goes into listening."
            price="Sonic identities start from £4k and typically take 6–10 weeks."
            custom="UI/UX and immersive projects are planned around you."
            linkLead="Agency, or want the detail?"
            linkLabel="See how we price"
            href="/contact"
          />{/* TODO: href → the planned pricing / working-with-us page once it exists */}
        </div>
      </div>

      {/* CTA — dark void, oversized Departure Mono; pixelates in, then the stage releases into the footer. */}
      <div class="scene cta-scene oat-on-mobile mobile-fill" data-scene="cta" style="z-index:30; --veil-color: hsl(var(--background))">
        <div class="cta-mobile-bar-top md:hidden" aria-hidden="true"></div>
        <div class="scene-body container-page">
          <CtaScene head="Ready to define<br/>your sound?" href="/contact" linkLabel="start_project" />
        </div>
      </div>
    </div>
  </div>

  <style>
    #stage-track { position: relative; height: 2880vh; } /* ~106vh per timeline unit (unchanged). Measured 26.11u: hero/services 3.0 + binary field 2.95 + philosophy + soft CTA 1.8 + our process 5.94 + CTA. Re-measure if any scroll knob changes (see CLAUDE.md). */
    .stage-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }

    .scene { position: absolute; top: 0; left: 0; right: 0; height: 100svh; }
    .scene[data-scene="hero"] { display: flex; flex-direction: column; padding-top: var(--header-h); box-sizing: border-box; }
    .scene-body {
      position: absolute; left: 0; right: 0;
      top: calc(var(--header-h) + var(--solaris-height)); height: calc(100svh - var(--header-h) - var(--solaris-height));
      display: flex; flex-direction: column; justify-content: center;
    }

    .stage-fog {
      position: absolute; inset: 0; z-index: 5;
      background-color: hsl(var(--content-background));
      opacity: 0; pointer-events: none;
    }
    .stage-portal {
      position: absolute; inset: 0; z-index: 6;
      transform-origin: 50% 45%;
      background: radial-gradient(circle at 50% 45%,
        rgba(255,250,238,0.7) 0%,
        rgba(255,250,238,0.22) 24%,
        transparent 58%);
      opacity: 0; pointer-events: none;
    }

    /* Philosophy layer styles live in PhilosophyScene.astro. */

    /* SOFT CTA — the scene wrapper is dark; the layout lives in SoftCta.astro. */
    .soft-cta-scene { background-color: hsl(var(--background)); }

    /* .cta-scene + .scene-veil styling is global (global.css); the CTA content is <CtaScene />. */

    #page-bar {
      position: fixed; top: var(--header-h); left: 0; right: 0; z-index: 40;
      height: var(--solaris-height);
      background: linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      box-shadow: var(--solaris-glow);
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
      clip-path: inset(0 0 100% 0);
      transition: background 0.45s ease, box-shadow 0.45s ease;
    }
    #page-bar [data-page-label] { opacity: 0; white-space: nowrap; text-align: center; transition: color 0.45s ease; }

    /* ── MOBILE (≤767px): scenes unstack into a NORMAL vertical scroll (no scroll-snap —
       snapping felt jumpy on touch). Each section still reveals with a subtle rise/fade as
       it enters (progressive-enhanced via .mob-reveal). Desktop GSAP stage is untouched. */
    @media (max-width: 767px) {
      #stage-track { height: auto; }
      .stage-pin { position: static; height: auto; overflow: visible; }
      .scene {
        position: relative; inset: auto;
        height: auto;
        /* cancel the global .scene desktop pin-tail (margin-bottom:-100svh) + scene-lead. */
        margin-bottom: 0; padding-top: 0;
        visibility: visible !important;
      }
      .scene[data-scene="hero"] { min-height: 100svh; }
      /* OPTION B: light scenes go transparent on mobile so the fixed binary rain runs the whole page; content sits on light cards. */
      .scene.theme-oat { background-color: transparent; }
      .scene.theme-oat.how-scene { background-color: hsl(var(--content-background)); }  /* dark text → keep solid oat */
      /* 'In computer science…' reads as LIGHT text straight on the rain (no card) */
      .scene[data-scene="philosophy"] { --foreground: 0 0% 95%; --muted-foreground: 48 18% 82%; }
      .stage-fog, .stage-portal, .scene-veil, #page-bar { display: none; }
      .scene-body {
        position: static; top: auto; height: auto;
        padding-block: 3rem;  /* vertical only — let container-page supply the 16px side gutter (CTA) */
        display: flex; flex-direction: column; justify-content: center;
      }
      /* PHILOSOPHY + SOFT CTA mobile layouts live in their components. */
      .soft-cta-scene { background-color: hsl(var(--background)); }

      /* Philosophy is ~6 screens tall on mobile, so the 0.2 IntersectionObserver threshold can never
         be met — exempt it from the fade-up or it stays invisible (About neutralises this too). */
      .mob-reveal .scene[data-scene="philosophy"] { opacity: 1 !important; transform: none !important; }

      /* entrance transition — only after JS marks the stage (else everything stays visible) */
      .mob-reveal .scene:not([data-scene="hero"]) { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
      .mob-reveal .scene.is-in { opacity: 1; transform: none; }
    }
  </style>

  {/* CTA is the same dark colour as the footer — drop the Solaris seam beam between them. */}
  <style is:global>
    .solaris:has(+ footer) { display: none; }

    /* Binary-field styles live in BinaryField.astro (global there — the digits are built in JS). */
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { createStageTimeline, createPageBar, stageLabels, prepareVoid, enterTheVoid, pushInBar, type BarCfg } from '../lib/stage';
    import { initMobileSceneReveal } from '../lib/pixel-veil';
    import { buildPhilosophyScene } from '../lib/scenes/philosophy';
    import { initBinaryField, createBinaryFieldScene } from '../lib/scenes/binary-field';
    import { buildProcessWordsScene } from '../lib/scenes/process-words';
    gsap.registerPlugin(ScrollTrigger);

    function initStage() {
      const track = document.getElementById('stage-track');
      const pin = track?.querySelector<HTMLElement>('.stage-pin');
      if (!track || !pin || track.dataset.init === '1') return;
      track.dataset.init = '1';
      if (!window.matchMedia('(min-width: 768px)').matches) return; // desktop only

      const fog = pin.querySelector<HTMLElement>('[data-stage="fog"]')!;
      const portal = pin.querySelector<HTMLElement>('[data-stage="portal"]')!;
      const scServices = pin.querySelector<HTMLElement>('.scene[data-scene="services"]')!;
      const scLines = pin.querySelector<HTMLElement>('.scene[data-scene="lines"]')!;
      const scPhil = pin.querySelector<HTMLElement>('.scene[data-scene="philosophy"]')!;
      const scSoft = pin.querySelector<HTMLElement>('.scene[data-scene="soft-cta"]')!;
      const scHow = pin.querySelector<HTMLElement>('.scene[data-scene="how"]')!;
      const scCta = pin.querySelector<HTMLElement>('.scene[data-scene="cta"]')!;
      const vCta = scCta.querySelector<HTMLElement>('[data-cta-veil]')!; // built + started-covered by <CtaScene>
      const gridBg = document.getElementById('grid-bg');

      prepareVoid(fog, portal);
      gsap.set(scServices, { autoAlpha: 0 });
      gsap.set(scLines, { autoAlpha: 0 });
      gsap.set(scPhil, { autoAlpha: 0 });
      gsap.set(scSoft, { autoAlpha: 0 });
      gsap.set(scHow, { autoAlpha: 0 });
      gsap.set(scCta, { autoAlpha: 0 });

      const bar = document.getElementById('page-bar')!;
      const pageBar = createPageBar(bar);
      const SERVICES: BarCfg = { name: 'What we do' };
      const PHIL: BarCfg = { name: 'Our Philosophy', bg: '#ffffff', text: '#141414', glow: '0 0 24px rgba(255,255,255,0.35)' }; // same white bar as About
      // Soft CTA stays in the dark world, so it keeps the WHITE bar — no colour change on a visible bar.
      const SOFT: BarCfg = { name: "Let's Talk", bg: '#ffffff', text: '#141414', glow: '0 0 24px rgba(255,255,255,0.35)' };
      const HOW: BarCfg = { name: 'Our Process' };
      const CONTACT: BarCfg = { name: 'Get In Touch' };

      const T = { heroHold: 0.8, fogStart: 0.8, fogDur: 1.0, portalStart: 0.5, voidScale: 3.0, barPush: 1.72, crossDur: 0.9 };
      // Incoming layer starts fading in only after the outgoing is ~60% gone — a small overlap, not a
      // long simultaneous cross-fade (keeps scenes from smearing into each other).
      const OV = T.crossDur * 0.6;

      const tl = createStageTimeline(track);
      const { boundary, atDir, crossLabel } = stageLabels(tl, pageBar, T.crossDur);
      const dir = () => (tl.scrollTrigger ? tl.scrollTrigger.direction : 1);

      // ENTER THE VOID → Services fades in through the fog.
      enterTheVoid(tl, { fog, portal, gridBg }, T);
      tl.to(scServices, { autoAlpha: 1, ease: 'power2.out', duration: 0.45 }, T.fogStart + T.fogDur);
      pushInBar(tl, bar, T.barPush);
      boundary(1.91, SERVICES, null);
      tl.to({}, { duration: 0.7 }); // settle on services

      // ── LISTENING BETWEEN THE LINES — binary field ──
      //    Scroll knobs are timeline units (home ≈ 106vh of scroll per unit) — re-measure the track if changed.
      //    Cascade/fade timings (seconds) are options of createBinaryFieldScene (defaults in binary-field.ts).
      const L = {
        out: 0.4,     // services + bar fade away
        settle: 0.7,  // room for the cascade to fill before the phrase starts
        decode: 0.9,  // phrase scrambles into words (left → right)
        hold: 0.5,    // readable hold
        blank: 0.45,  // oat beat after the fade, before philosophy
      };
      const fieldScene = createBinaryFieldScene(scLines, { cascadeMin: 0.55, cascadeMax: 1.3, cascadeStagger: 0.35, fadeOut: 0.6 });

      tl.addLabel('linesIn');
      tl.to(scServices, { autoAlpha: 0, ease: 'none', duration: L.out }, 'linesIn')
        .to(bar, { autoAlpha: 0, ease: 'none', duration: L.out * 0.6 }, 'linesIn')
        .set(scLines, { autoAlpha: 1 }, 'linesIn');
      atDir('linesIn', 1, null);                         // down: no bar label during the field
      atDir('linesIn+=' + (L.out * 0.6), -1, SERVICES);  // up: "What we do" returns with the cards
      // Entering from ABOVE → cascade; leaving back UP → fade.
      tl.call(() => { (dir() === 1 ? fieldScene.cascade : fieldScene.fadeAway)(); }, [], 'linesIn+=' + (L.out * 0.5));
      tl.to({}, { duration: L.settle });
      fieldScene.decode(tl, L.decode);
      tl.to({}, { duration: L.hold });
      // Leaving DOWN → fade into philosophy; coming back UP from philosophy → cascade from the top again.
      tl.addLabel('fieldOut', '>');
      tl.call(() => { (dir() === 1 ? fieldScene.fadeAway : fieldScene.cascade)(); }, [], 'fieldOut');
      // The bar's CSS transitions its background over .45s, so recolour it HERE while it's hidden —
      // down: already white when "Our Philosophy" arrives; up: back to solaris before "What we do" returns.
      const SOLARIS_BG = 'linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%)';
      const paintBar = (bg: string, glow: string) => { bar.style.background = bg; bar.style.boxShadow = glow; };
      tl.call(() => {
        if (dir() === 1) paintBar(PHIL.bg!, PHIL.glow!);
        else paintBar(SOLARIS_BG, 'var(--solaris-glow)');
      }, [], 'fieldOut');
      tl.to({}, { duration: L.blank });

      // ── PHILOSOPHY — the oat is seamless with the scene's beige start, so no cross-fade is needed:
      //    the bar returns (white), caption 1 fades in, then the 6-stage choreography plays. ──
      tl.addLabel('philIn', '>');
      tl.set(scLines, { autoAlpha: 0 }, 'philIn')
        .to(scPhil, { autoAlpha: 1, ease: 'none', duration: 0.2 }, 'philIn')
        .to(bar, { autoAlpha: 1, ease: 'none', duration: 0.25 }, 'philIn');
      atDir('philIn+=0.1', 1, PHIL);   // down: "Our Philosophy" scrambles in on the returning bar
      atDir('philIn', -1, null);       // up: bar clears as we go back into the lines
      // Same 6-stage choreography + options as About, built into a CHILD timeline and nested at '>'
      // (still scrubbed by the master — a nested timeline is driven by its parent, it doesn't auto-play).
      // PHIL_SPEED: About scrolls ~3x faster per timeline unit than home, so the scene plays 3x faster
      // here to keep About's tuned pace. Raise = quicker scene / lower = slower. Re-size #stage-track if changed.
      const PHIL_SPEED = 3;
      const phil = gsap.timeline();
      buildPhilosophyScene(phil, scPhil, {
        heroScale: 2.52,                                                   // opening pixel 10% smaller
        orbitRadius: 213, orbitSub: 0.94, orbitMain: 0.66, tetherWidth: 9, // modular stems 18% smaller
        finalScale: 0.96,                                                  // final "result" block ~16% smaller
        masterGrow: false,                                                 // master: glow up (exaggerated), no growth
        exit: 'flicker',                                                   // intro-style flicker-scale out (no TV-out)
      });
      phil.timeScale(PHIL_SPEED);
      // Caption 1 ("Think of your sound…") is set visible by the builder; on home it would play out during
      // the scene's arrival, so hide it and fade it in on the blank oat, just before the pixel appears.
      const cap1 = scPhil.querySelector<HTMLElement>('.scene-cap');
      if (cap1) { gsap.set(cap1, { opacity: 0 }); tl.to(cap1, { opacity: 1, ease: 'none', duration: 0.3 }, 'philIn+=0.15'); }
      tl.add(phil, '>');

      // ── SOFT CTA — fades in over philosophy's dark ending, holds, then hands on. ──
      const SOFT_HOLD = 1.2;   // [scroll units] time on the soft CTA
      tl.addLabel('softIn', '>');
      tl.to(scSoft, { autoAlpha: 1, ease: 'none', duration: 0.6 }, 'softIn')
        .set(scPhil, { autoAlpha: 0 }, 'softIn+=0.6');
      // Own label timing (crossLabel's buffer is sized for the 0.9 cross-fades — far too late here).
      const SOFT_LABEL_AT = 0.3;   // [scroll units] "Let's Talk" scrambles in this far into the 0.6 fade
      atDir('softIn', 1, null);                              // down: philosophy label clears
      atDir('softIn+=' + SOFT_LABEL_AT, 1, SOFT);            // down: "Let's Talk"
      atDir('softIn+=' + SOFT_LABEL_AT, -1, null);           // up: clears as the soft CTA leaves
      atDir('softIn+=0.1', -1, PHIL);                        // up: "Our Philosophy" back
      tl.to({}, { duration: SOFT_HOLD });

      // ── HOW WE WORK — dark soft CTA → oat. The bar HIDES for the switch and is recoloured while hidden
      //    (its CSS fades the background over .45s), so a visible bar never changes colour. ──
      //    (Proof & people will slot in BEFORE this scene.)
      const BAR_OUT = 0.3;    // [scroll units] bar fade out / back in
      tl.addLabel('howIn', '>');
      tl.to(scSoft, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, 'howIn')
        .to(bar, { autoAlpha: 0, ease: 'none', duration: BAR_OUT }, 'howIn')
        .to(scHow, { autoAlpha: 1, ease: 'none', duration: T.crossDur }, 'howIn+=' + OV)
        .to(bar, { autoAlpha: 1, ease: 'none', duration: BAR_OUT }, 'howIn+=' + (OV + BAR_OUT));
      atDir('howIn', 1, null);                                      // down: "Let's Talk" clears
      tl.call(() => {                                               // bar fully hidden → recolour it
        if (dir() === 1) paintBar(SOLARIS_BG, 'var(--solaris-glow)');
        else paintBar(SOFT.bg!, SOFT.glow!);
      }, [], 'howIn+=' + BAR_OUT);
      atDir('howIn+=' + (OV + BAR_OUT), 1, HOW);                    // down: "How We Work" as the bar returns
      atDir('howIn+=' + (OV + BAR_OUT), -1, null);                  // up: clears as the bar hides
      atDir('howIn+=' + (BAR_OUT * 0.8), -1, SOFT);                 // up: "Let's Talk" back (bar already white)
      // Big type: the step title/number/line scramble in, then scramble into each next step; footer last.
      buildProcessWordsScene(tl, scHow, { in: 0.4, hold: 0.5, swap: 0.45, foot: 0.3, end: 0.45 });

      // How we work → final CTA (small overlap); the CTA appears under a dark veil, then pixelates in.
      tl.addLabel('ctaIn', '>');
      tl.to(scHow, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, 'ctaIn')
        .to(scCta, { autoAlpha: 1, ease: 'none', duration: 0.3 }, 'ctaIn+=' + OV);
      crossLabel('ctaIn', CONTACT, HOW);   // down (buffered) → CTA; up (snappy) → how we work
      tl.to(vCta, { '--reveal': 1, ease: 'none', duration: 1.6 }, 'ctaIn+=' + (OV + 0.3));
      // Dwell on the fully-revealed CTA for a good beat BEFORE the stage unpins into the footer, so the
      // pixelation lands and settles before any vertical scroll begins. Tune this to taste.
      tl.to({}, { duration: 2.4 });

      const fonts = (document as any).fonts;
      if (fonts?.ready) fonts.ready.then(() => ScrollTrigger.refresh());
    }

    const boot = () => { initBinaryField(); initStage(); };
    document.addEventListener('astro:page-load', boot);
    if (document.readyState === 'complete') boot();
    else window.addEventListener('load', boot);

    // MOBILE-only: reveal each unstacked scene as it enters (desktop uses the GSAP stage).
    document.addEventListener('astro:page-load', initMobileSceneReveal);
    if (document.readyState === 'complete') initMobileSceneReveal();
    else window.addEventListener('load', initMobileSceneReveal);
  </script>
</Layout>
