---
/* src/pages/home.astro */
import Layout from '../layouts/Layout.astro';
import Solaris from '../components/Solaris.astro';
import Section from '../components/Section.astro';
import FocusScroll from '../components/FocusScroll.astro';
import Hero from '../components/modules/Hero.tsx';
import ServicePillars from '../components/modules/ServicePillars';
import Philosophy from '../components/modules/Philosophy.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="bitmap.audio | sonic branding & experiential audio"
  description="bitmap.audio designs sonic brand systems, UI/UX sound, and experiential spatial audio for digital products and forward-thinking brands."
>
  {/* Hero: fills the viewport and sticks; blurred sections scroll up over it. flex flex-col so
      the hero (flex-1) fills the height and can pin its blurb to the bottom (as about-v2). */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh flex flex-col">
    <Hero client:load />
  </div>

  <div class="hero-runway" aria-hidden="true"></div>

  {/* Beige world — scrolls up over the sticky hero. Each section follows the about-v2 pattern:
      the Solaris bar sticks under the header, the content locks in centred below it, then they
      release and scroll up together. */}
  <div class="relative z-10 theme-oat">
    {/* Services — bar sticks, the pillars lock + cycle below it. */}
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="What we do" /></div>
      <FocusScroll count={3} tailVh={0.7} barOffset id="services" class="!bg-background/50 backdrop-blur-xl border-t-2 border-border">
        <ServicePillars client:visible />
      </FocusScroll>
    </div>

    {/* Philosophy — bar sticks, content locks in below it. */}
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="The micro/macro architecture" /></div>
      <FocusScroll count={1} barOffset id="philosophy" class="!bg-background/50 backdrop-blur-xl">
        <Philosophy client:visible />
      </FocusScroll>
    </div>

    {/* CTA — bar sticks, CTA locks in below it. */}
    <div class="relative">
      <div class="section-bar-hold"><Solaris text="Get In Touch" /></div>
      <FocusScroll count={1} barOffset id="cta" class="!bg-background/50 backdrop-blur-xl">
        <div class="container-page w-full">
          <CTA
            client:visible
            title="Ready to define your sound?"
            description="Explore how sonic branding can strengthen your identity and deepen audience connection."
            buttonText="Start the conversation"
          />
        </div>
      </FocusScroll>
    </div>
  </div>
</Layout>