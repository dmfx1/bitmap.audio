---
/* src/pages/home.astro */
import Layout from '../layouts/Layout.astro';
import Solaris from '../components/Solaris.astro';
import Section from '../components/Section.astro';
import Hero from '../components/modules/Hero.tsx';
import ServicePillars from '../components/modules/ServicePillars';
import Philosophy from '../components/modules/Philosophy.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="bitmap.audio | sonic branding & experiential audio"
  description="bitmap.audio designs sonic brand systems, UI/UX sound, and experiential spatial audio for digital products and forward-thinking brands."
>
  {/* Hero: sticks at top of container, content scrolls over it */}
  <div id="hero-sticky" class="md:sticky top-0 z-[1] min-h-svh">
    <div class="h-full">
      <Hero client:load />
    </div>
  </div>

  <div class="hero-runway" aria-hidden="true"></div>

  {/* Content: scrolls over the sticky hero — sections are frosted glass so hero colours bleed through */}
  <Solaris />

  <div class="relative z-10 theme-oat">
    <Section id="services" delay="0.2s" className="!bg-background/50 backdrop-blur-xl" grainBg>
      <ServicePillars client:visible />
    </Section>

    <Section id="philosophy" invert delay="0.3s" className="!bg-background/50 backdrop-blur-xl">
      <Philosophy client:visible />
    </Section>

    <Section id="cta" delay="0.4s" className="!bg-background/50 backdrop-blur-xl" grainBg>
      <CTA
        client:visible
        title="Ready to define your sound?"
        description="Explore how sonic branding can strengthen your identity and deepen audience connection."
        buttonText="Start the conversation"
      />
    </Section>
  </div>
</Layout>