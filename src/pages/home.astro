---
/* src/pages/home.astro
 *
 * Homepage on the SCENE-STAGE architecture — a faithful clone of about-v3's PROVEN inline structure.
 * Hero/header stay locked; scroll drives ONE master timeline: "enter the void" (binary-rain zoom +
 * portal bloom + beige fog) → Services → micro/macro Philosophy (scroll-typed quote) → CTA (dark,
 * oversized Departure Mono, pixelates in) → release into the footer. No real vertical scroll until then.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/modules/Hero.tsx';
import ServicePillars from '../components/modules/ServicePillars';
import SonicWaves from '../components/modules/SonicWaves.astro';
import UiuxNodes from '../components/modules/UiuxNodes.astro';
import SpatialDepth from '../components/modules/SpatialDepth.astro';
// Pillar draw-in scene imports (SpatialPerspective/UiuxCircuit) removed while the feature is paused — see CLAUDE.md.
import Philosophy from '../components/modules/Philosophy.tsx';
import CtaScene from '../components/modules/CtaScene.astro';
---

<Layout
  title="bitmap.audio | sonic branding & immersive audio"
  description="bitmap.audio designs sonic brand systems, UI/UX sound, and immersive audio for digital products and forward-thinking brands."
>
  <div id="page-bar" aria-hidden="true">
    <span class="solaris-text" data-page-label></span>
  </div>

  <div id="stage-track">
    <div class="stage-pin" id="hero-sticky">
      <div class="scene" data-scene="hero" style="z-index:0">
        <Hero client:load />
      </div>
      <div class="stage-fog" data-stage="fog" aria-hidden="true"></div>
      <div class="stage-portal" data-stage="portal" aria-hidden="true"></div>

      {/* Services — fades in through the fog. */}
      <div class="scene theme-oat" data-scene="services" style="z-index:10">
        {/* PILLAR "DRAW-IN" MOTIFS — one per card, revealed when that pillar is active, masked away
            from the cards (void). index 0 → UiuxNodes (network), 1 → SonicWaves (spectrum bars),
            2 → SpatialDepth (perspective tunnel). Toggled in ServicePillars.tsx. */}
        <SonicWaves />
        <UiuxNodes />
        <SpatialDepth />
        <div class="scene-body">
          <ServicePillars client:load />
        </div>
      </div>

      {/* Philosophy — the micro/macro architecture; the quote types out on scroll (--phil-progress). */}
      <div class="scene theme-oat mobile-fill" data-scene="philosophy" style="z-index:20">
        <div class="scene-body">
          <Philosophy client:load />
        </div>
      </div>

      {/* CTA — dark void, oversized Departure Mono; pixelates in, then the stage releases into the footer. */}
      <div class="scene cta-scene oat-on-mobile mobile-fill" data-scene="cta" style="z-index:30; --veil-color: hsl(var(--background))">
        <div class="cta-mobile-bar-top md:hidden" aria-hidden="true"></div>
        <div class="scene-body container-page">
          <CtaScene head="Ready to define<br/>your sound?" href="/contact" linkLabel="start_project" />
        </div>
      </div>
    </div>
  </div>

  <style>
    #stage-track { position: relative; height: 1300vh; }
    .stage-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }

    .scene { position: absolute; top: 0; left: 0; right: 0; height: 100svh; }
    .scene[data-scene="hero"] { display: flex; flex-direction: column; padding-top: var(--header-h); box-sizing: border-box; }
    .scene-body {
      position: absolute; left: 0; right: 0;
      top: calc(var(--header-h) + var(--solaris-height)); height: calc(100svh - var(--header-h) - var(--solaris-height));
      display: flex; flex-direction: column; justify-content: center;
    }

    .stage-fog {
      position: absolute; inset: 0; z-index: 5;
      background-color: hsl(var(--content-background));
      opacity: 0; pointer-events: none;
    }
    .stage-portal {
      position: absolute; inset: 0; z-index: 6;
      transform-origin: 50% 45%;
      background: radial-gradient(circle at 50% 45%,
        rgba(255,250,238,0.7) 0%,
        rgba(255,250,238,0.22) 24%,
        transparent 58%);
      opacity: 0; pointer-events: none;
    }

    /* .cta-scene + .scene-veil styling is global (global.css); the CTA content is <CtaScene />. */

    #page-bar {
      position: fixed; top: var(--header-h); left: 0; right: 0; z-index: 40;
      height: var(--solaris-height);
      background: linear-gradient(90deg, var(--solaris-from) 0%, var(--solaris-mid) 55%, var(--solaris-to) 100%);
      box-shadow: var(--solaris-glow);
      display: flex; align-items: center; justify-content: center;
      pointer-events: none;
      clip-path: inset(0 0 100% 0);
      transition: background 0.45s ease, box-shadow 0.45s ease;
    }
    #page-bar [data-page-label] { opacity: 0; white-space: nowrap; text-align: center; transition: color 0.45s ease; }

    /* ── MOBILE (≤767px): scenes unstack into a NORMAL vertical scroll (no scroll-snap —
       snapping felt jumpy on touch). Each section still reveals with a subtle rise/fade as
       it enters (progressive-enhanced via .mob-reveal). Desktop GSAP stage is untouched. */
    @media (max-width: 767px) {
      #stage-track { height: auto; }
      .stage-pin { position: static; height: auto; overflow: visible; }
      .scene {
        position: relative; inset: auto;
        height: auto;
        /* cancel the global .scene desktop pin-tail (margin-bottom:-100svh) + scene-lead. */
        margin-bottom: 0; padding-top: 0;
        visibility: visible !important;
      }
      .scene[data-scene="hero"] { min-height: 100svh; }
      /* OPTION B: light scenes go transparent on mobile so the fixed binary rain runs the whole page; content sits on light cards. */
      .scene.theme-oat { background-color: transparent; }
      /* 'In computer science…' reads as LIGHT text straight on the rain (no card) */
      .scene[data-scene="philosophy"] { --foreground: 0 0% 95%; --muted-foreground: 48 18% 82%; }
      .stage-fog, .stage-portal, .scene-veil, #page-bar { display: none; }
      .scene-body {
        position: static; top: auto; height: auto;
        padding-block: 3rem;  /* vertical only — let container-page supply the 16px side gutter (CTA) */
        display: flex; flex-direction: column; justify-content: center;
      }
      /* entrance transition — only after JS marks the stage (else everything stays visible) */
      .mob-reveal .scene:not([data-scene="hero"]) { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
      .mob-reveal .scene.is-in { opacity: 1; transform: none; }
    }
  </style>

  {/* CTA is the same dark colour as the footer — drop the Solaris seam beam between them. */}
  <style is:global>
    .solaris:has(+ footer) { display: none; }
  </style>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { createStageTimeline, createPageBar, stageLabels, prepareVoid, enterTheVoid, pushInBar, type BarCfg } from '../lib/stage';
    import { initMobileSceneReveal } from '../lib/pixel-veil';
    gsap.registerPlugin(ScrollTrigger);

    function initStage() {
      const track = document.getElementById('stage-track');
      const pin = track?.querySelector<HTMLElement>('.stage-pin');
      if (!track || !pin || track.dataset.init === '1') return;
      track.dataset.init = '1';
      if (!window.matchMedia('(min-width: 768px)').matches) return; // desktop only

      const fog = pin.querySelector<HTMLElement>('[data-stage="fog"]')!;
      const portal = pin.querySelector<HTMLElement>('[data-stage="portal"]')!;
      const scServices = pin.querySelector<HTMLElement>('.scene[data-scene="services"]')!;
      const scPhil = pin.querySelector<HTMLElement>('.scene[data-scene="philosophy"]')!;
      const scCta = pin.querySelector<HTMLElement>('.scene[data-scene="cta"]')!;
      const vCta = scCta.querySelector<HTMLElement>('[data-cta-veil]')!; // built + started-covered by <CtaScene>
      const gridBg = document.getElementById('grid-bg');

      prepareVoid(fog, portal);
      gsap.set(scServices, { autoAlpha: 0 });
      gsap.set(scPhil, { autoAlpha: 0 });
      gsap.set(scCta, { autoAlpha: 0 });

      const bar = document.getElementById('page-bar')!;
      const pageBar = createPageBar(bar);
      const SERVICES: BarCfg = { name: 'What we do' };
      const PHIL: BarCfg = { name: 'The micro/macro architecture' };
      const CONTACT: BarCfg = { name: 'Get In Touch' };

      const T = { heroHold: 0.8, fogStart: 0.8, fogDur: 1.0, portalStart: 0.5, voidScale: 3.0, barPush: 1.72, crossDur: 0.9 };
      // Incoming layer starts fading in only after the outgoing is ~60% gone — a small overlap, not a
      // long simultaneous cross-fade (keeps scenes from smearing into each other).
      const OV = T.crossDur * 0.6;

      const tl = createStageTimeline(track);
      const { boundary, crossLabel } = stageLabels(tl, pageBar, T.crossDur);

      // ENTER THE VOID → Services fades in through the fog.
      enterTheVoid(tl, { fog, portal, gridBg }, T);
      tl.to(scServices, { autoAlpha: 1, ease: 'power2.out', duration: 0.45 }, T.fogStart + T.fogDur);
      pushInBar(tl, bar, T.barPush);
      boundary(1.91, SERVICES, null);
      tl.to({}, { duration: 0.7 }); // settle on services

      // Services → Philosophy (small overlap), then the quote types out on scroll.
      tl.addLabel('philIn');
      tl.to(scServices, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, 'philIn')
        .to(scPhil, { autoAlpha: 1, ease: 'none', duration: T.crossDur }, 'philIn+=' + OV);
      crossLabel('philIn', PHIL, SERVICES);   // down (buffered) → philosophy; up (snappy) → services
      gsap.set(scPhil, { '--phil-progress': 0 });
      tl.to(scPhil, { '--phil-progress': 1, ease: 'none', duration: 1.6 }); // scroll-typed micro/macro quote
      tl.to({}, { duration: 0.4 });

      // Philosophy → CTA (small overlap); the CTA appears under a dark veil, then pixelates in.
      tl.addLabel('ctaIn', '>');
      tl.to(scPhil, { autoAlpha: 0, ease: 'none', duration: T.crossDur }, 'ctaIn')
        .to(scCta, { autoAlpha: 1, ease: 'none', duration: 0.3 }, 'ctaIn+=' + OV);
      crossLabel('ctaIn', CONTACT, PHIL);   // down (buffered) → CTA; up (snappy) → philosophy
      tl.to(vCta, { '--reveal': 1, ease: 'none', duration: 1.6 }, 'ctaIn+=' + (OV + 0.3));
      // Dwell on the fully-revealed CTA for a good beat BEFORE the stage unpins into the footer, so the
      // pixelation lands and settles before any vertical scroll begins. Tune this to taste.
      tl.to({}, { duration: 2.4 });

      const fonts = (document as any).fonts;
      if (fonts?.ready) fonts.ready.then(() => ScrollTrigger.refresh());
    }

    document.addEventListener('astro:page-load', initStage);
    if (document.readyState === 'complete') initStage();
    else window.addEventListener('load', initStage);

    // MOBILE-only: reveal each unstacked scene as it enters (desktop uses the GSAP stage).
    document.addEventListener('astro:page-load', initMobileSceneReveal);
    if (document.readyState === 'complete') initMobileSceneReveal();
    else window.addEventListener('load', initMobileSceneReveal);
  </script>
</Layout>
