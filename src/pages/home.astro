---
/* src/pages/home.astro
 *
 * Homepage on the SCENE-STAGE architecture (the about-v3 model, packaged): the hero/header stay
 * locked while scroll drives ONE master timeline that "enters the void" (binary-rain zoom + portal
 * bloom + beige fog) and then cross-fades the content layers in place — Services → micro/macro
 * Philosophy → CTA — with no real vertical scroll until the stage releases into the footer.
 *
 * Content + styling are preserved from the previous FocusScroll build; only the scroll MECHANISM
 * changed (stacked layers instead of pinned scroll-over sections). Reusable pieces live in
 * src/components/scene/* and src/lib/scenes/stage.ts.
 */
import Layout from '../layouts/Layout.astro';
import SceneStage from '../components/scene/SceneStage.astro';
import SceneLayer from '../components/scene/SceneLayer.astro';
import Hero from '../components/modules/Hero.tsx';
import ServicePillars from '../components/modules/ServicePillars';
import Philosophy from '../components/modules/Philosophy.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="bitmap.audio | sonic branding & experiential audio"
  description="bitmap.audio designs sonic brand systems, UI/UX sound, and experiential spatial audio for digital products and forward-thinking brands."
>
  <SceneStage trackVh={1000} bar void>
    {/* Hero — holds while its copy recedes into the void (useHeroSquish anchors to the pin). */}
    <SceneLayer hero z={0}>
      <Hero client:load />
    </SceneLayer>

    {/* Services — fades in through the fog. client:load (not visible): these components self-hide
        until their own reveal effect runs on hydration, and inside a stacked/hidden layer client:visible
        may not hydrate — so they'd stay invisible. */}
    <SceneLayer z={10} label="What we do" hold={1.4}>
      <ServicePillars client:load />
    </SceneLayer>

    {/* Philosophy — the micro/macro architecture. */}
    <SceneLayer z={20} label="The micro/macro architecture" hold={1.4}>
      <Philosophy client:load />
    </SceneLayer>

    {/* CTA — cross-fades in; the stage then releases into the footer. */}
    <SceneLayer z={30} label="Get In Touch" hold={1.4}>
      <div class="container-page w-full">
        <CTA
          client:load
          title="Ready to define your sound?"
          description="Explore how sonic branding can strengthen your identity and deepen audience connection."
          buttonText="Start the conversation"
        />
      </div>
    </SceneLayer>
  </SceneStage>
</Layout>
