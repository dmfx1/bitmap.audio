---
/* src/pages/home.astro */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro'; // Your structural wrapper
import Hero from '../components/modules/Hero.tsx'; // Hero module
import ServicePillars from '../components/modules/ServicePillars'; // Service Boxes
---

<Layout title="Home | bitmap.audio">
  {/* The Hero is the first module in the rack */}
  <Section id="hero" delay="0.1s">
    <Hero client:load /> 
    <ServicePillars client:visible />
  </Section>
</Layout>