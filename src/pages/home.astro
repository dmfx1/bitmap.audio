---
/* src/pages/home.astro */
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Hero from '../components/modules/Hero.tsx';
import ServicePillars from '../components/modules/ServicePillars';
import Philosophy from '../components/modules/Philosophy.tsx';
import CTA from '../components/modules/CTA.tsx';
---

<Layout
  title="Sonic Branding & Immersive Audio Design | bitmap.audio"
  description="bitmap.audio designs sonic brand systems, UI/UX sound, and immersive spatial audio for digital products and forward-thinking brands."
>
  {/* Hero: sticks at top of container, content scrolls over it */}
  <div class="sticky top-0 z-[1] h-svh md:h-[85vh]">
    <div class="h-full pt-16 pb-8">
      <Hero client:load />
    </div>
  </div>

  {/* Content: scrolls over the sticky hero */}
  <div class="relative z-10 bg-background">
    <Section id="services" delay="0.2s">
      <ServicePillars client:visible />
    </Section>

    <Section id="philosophy" invert delay="0.3s">
      <Philosophy client:visible />
    </Section>

    {/* FIXED: Changed ID from philosophy to cta */}
    <Section id="cta" delay="0.4s">
      <CTA
        client:visible
        title="Ready to define your sound?"
        description="Let's explore how a sonic brand can strengthen your identity and deepen audience connection."
        buttonText="Start the conversation"
      />
    </Section>
  </div>
</Layout>