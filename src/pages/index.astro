---
/* src/pages/index.astro */
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/modules/HomeHero.tsx';
---

<Layout title="bitmap.audio | Sonic Infrastructure" hideHeader={true}>
  <section class="flex-1 flex flex-col items-center justify-center text-center mx-auto relative min-h-screen px-6 overflow-hidden">
    {/* REFINED SPOTLIGHT */}
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_0%,hsl(var(--background))_45%)] pointer-events-none"></div>
    
    <HomeHero client:load />
  </section>
</Layout>