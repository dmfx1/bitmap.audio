---
/* src/components/ConceptGrid.astro */
const concepts = [
  { title: "BIT", desc: "The digital pulse, software logic, and raw binary data of technology." },
  { title: "MAP", desc: "The spatial layout, UI/UX flow, and human sensory landscape." },
  { title: "SYNTHESIS", desc: "Micro engineers linking sonic data and human emotion." }
];
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto w-full text-left p-4">
  {concepts.map((item) => (
    <div class="concept-card group relative p-8 border border-primary/20 bg-card/30 backdrop-blur-sm 
                transition-all duration-500 ease-out overflow-hidden
                hover:border-primary/80 hover:bg-card/50 
                hover:shadow-[0_0_30px_hsl(var(--primary)/0.2),inset_0_0_20px_hsl(var(--primary)/0.1)]">
      
      {/* The Title: Electrifies from Muted to Solaris Accent */}
      <h3 class="text-accent/60 font-mono text-xs uppercase tracking-[0.3em] mb-4 
                 group-hover:text-accent group-hover:tracking-[0.4em] transition-all duration-500">
        {item.title}
      </h3>
      
      {/* The Description: Brightens to full white */}
      <p class="text-sm text-muted-foreground leading-relaxed group-hover:text-foreground transition-colors duration-500">
        {item.desc}
      </p>

      {/* Technical Detail: A subtle corner accent that ignites */}
      <div class="absolute top-0 right-0 w-4 h-4 border-t border-r border-transparent 
                  group-hover:border-primary/50 transition-all duration-700 delay-100"></div>
    </div>
  ))}
</div>