---
/* src/components/Section.astro */
import GrainGradientBg from './modules/GrainGradientBg.tsx';

interface Props {
  id?: string;
  className?: string;
  isFullWidth?: boolean;
  noPadding?: boolean;
  animate?: boolean;
  delay?: string;
  invert?: boolean;
  hasBorder?: boolean;
  gridBg?: boolean; // renders bitmap grid + binary rain as full-bleed background
  grainBg?: boolean; // mobile-only moving grain-gradient wash — fills the gap left when the (md:sticky) hero scrolls fully away on mobile. No-ops on desktop.
  bgSrc?: string;   // optional background image URL
  bgFade?: 'right' | 'down' | 'up'; // fade direction: right (default), down (top-visible), up (bottom-visible)
  bgSide?: 'left' | 'right'; // which side image anchors to — determines fade direction (left=fades right, right=fades left)
  bgFlip?: boolean; // horizontally flip the image content (mirror)
  bgWidth?: string; // desktop width of background image, e.g. '55%' (default), '70%', '100%'
}

const {
  id,
  className = "",
  isFullWidth = false,
  noPadding = false,
  animate = true,
  delay = "0s",
  invert = false,
  hasBorder = true,
  gridBg = false,
  grainBg = false,
  bgSrc,
  bgFade = 'right',
  bgSide = 'left',
  bgFlip = false,
  bgWidth = '55%',
} = Astro.props;
---

<section
  id={id}
  class:list={[
    "relative flex justify-center w-full transition-colors duration-700 ease-in-out ",
    /* Vertical padding uses the SAME gutter var as the horizontal edges, so content
       sits p-8 (32px) from every section edge, consistently, site-wide. */
    !noPadding && "py-[var(--page-gutter)]",
    hasBorder && "border-t-2 border-border",
    animate && "reveal-on-scroll opacity-0 translate-y-6",
    invert ? "section-inverted z-20 shadow-2xl" : "bg-background text-foreground z-10",
    className
  ]}
  style={`transition-delay: ${delay};`}
>

  {/* Full-bleed background image — fade direction controlled by bgFade prop */}
  {bgSrc && bgFade === 'right' && bgSide === 'left' && (
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img
        src={bgSrc}
        alt=""
        decoding="async"
        class="absolute inset-y-0 left-0 w-full h-full object-cover object-left"
        style={`max-width: ${bgWidth}; mask-image: linear-gradient(to right, black 0%, black 40%, transparent 100%); -webkit-mask-image: linear-gradient(to right, black 0%, black 40%, transparent 100%); opacity: 0.25;${bgFlip ? ' transform: scaleX(-1);' : ''}`}
      />
    </div>
  )}
  {bgSrc && bgFade === 'right' && bgSide === 'right' && (
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img
        src={bgSrc}
        alt=""
        decoding="async"
        class="absolute inset-y-0 right-0 w-full h-full object-cover object-right"
        style={`max-width: ${bgWidth}; mask-image: linear-gradient(to left, black 0%, black 40%, transparent 100%); -webkit-mask-image: linear-gradient(to left, black 0%, black 40%, transparent 100%); opacity: 0.25;${bgFlip ? ' transform: scaleX(-1);' : ''}`}
      />
    </div>
  )}
  {bgSrc && bgFade === 'down' && (
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img
        src={bgSrc}
        alt=""
        decoding="async"
        class="absolute inset-x-0 top-0 w-full h-full object-cover object-top"
        style={`mask-image: linear-gradient(to bottom, black 0%, black 30%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 30%, transparent 100%); opacity: 0.25;${bgFlip ? ' transform: scaleX(-1);' : ''}`}
      />
    </div>
  )}
  {bgSrc && bgFade === 'up' && (
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img
        src={bgSrc}
        alt=""
        decoding="async"
        class="absolute inset-x-0 bottom-0 w-full h-full object-cover object-bottom"
        style={`mask-image: linear-gradient(to top, black 0%, black 30%, transparent 100%); -webkit-mask-image: linear-gradient(to top, black 0%, black 30%, transparent 100%); opacity: 0.25;${bgFlip ? ' transform: scaleX(-1);' : ''}`}
      />
    </div>
  )}

  {/* Full-bleed bitmap grid + binary rain — sits directly inside <section>, not inside the constrained inner div */}
  {gridBg && (
    <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bitmap-grid" style="opacity: var(--grid-opacity)" />
      <div class="binary-waterfall">
        <div class="binary-layer layer-deep" />
        <div class="binary-layer layer-near" />
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_30%,hsl(var(--background)/0.8)_100%)]" />
    </div>
  )}

  {/* Mobile-only moving grain-gradient wash — see GrainGradientBg.tsx for why this is
      gated to mobile only. client:idle (not client:load — three-plus WebGL shader
      islands all hydrating immediately at page load fights the main thread against
      the hero's own client:load animation, causing visible jank/stutter on load; not
      client:visible either — this island's own initial render is null, which
      client:visible's IntersectionObserver can't key off reliably). client:idle defers
      to the browser's idle callback, after initial paint, regardless of the island's
      render output. */}
  {grainBg && <GrainGradientBg client:idle />}

  {/* Content container — the single source of truth for side gutters + max width.
       - default:      .container-page (capped at --page-max, centred, gutters)
       - isFullWidth:  full-bleed but STILL keeps the same gutters (wide sections)
       - noPadding:    true edge-to-edge (e.g. the client-terminal grid) */}
  <div class:list={[
    "relative z-10",
    !isFullWidth && !noPadding && "container-page",
    isFullWidth && !noPadding && "w-full px-4 md:px-8 lg:px-12",
    noPadding && "w-full",
  ]}>
    <slot />
  </div>

  {/* Optional: Deep texture for inverted sections only */}
  {invert && (
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
         style="background-image: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSIjZmZmIi8+CjxyZWN0IHdpZHRoPSIxIiBoZWlnaHQ9IjEiIGZpbGw9IiMwMDAiLz4KPC9zdmc+');">
    </div>
  )}
</section>

<script>
  let observerStarted = false;

  function startObserving() {
    if (observerStarted) return;
    observerStarted = true;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          target.style.opacity = "1";
          target.style.transform = "translateY(0)";
          target.style.transition = "opacity 0.4s ease, transform 0.4s ease";
          observer.unobserve(target);
        }
      });
    }, { threshold: 0.05, rootMargin: "0px 0px 150px 0px" });

    document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
  }

  // If the page has a hero component, wait for it to fire 'hero-content-ready'
  // before starting the IntersectionObserver. This prevents sections from
  // revealing during the typewriter + description fade-in animation.
  // Non-hero pages (no [data-has-hero] in DOM) observe immediately.
  const hasHero = document.querySelector('[data-has-hero]');

  if (hasHero) {
    const fallback = setTimeout(startObserving, 6000);

    const cleanup = () => {
      clearTimeout(fallback);
      window.removeEventListener('mousemove', onMouseMove);
    };

    // Hero fires this when description fade is done
    window.addEventListener('hero-content-ready', () => {
      cleanup();
      startObserving();
    }, { once: true });

    // First mouse movement = user is engaged, skip remaining wait
    const onMouseMove = () => {
      cleanup();
      startObserving();
    };
    window.addEventListener('mousemove', onMouseMove, { once: true, passive: true });

  } else {
    startObserving();
  }
</script>
