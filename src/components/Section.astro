---
/* src/components/Section.astro */
interface Props {
  id?: string;
  className?: string;
  isFullWidth?: boolean;
  animate?: boolean;
  delay?: string;
}

const { 
  id, 
  className = "", 
  isFullWidth = false, 
  animate = true, 
  delay = "0s" 
} = Astro.props;
---

<section 
  id={id} 
  class:list={[
    "relative py-16 md:py-24 flex justify-center w-full z-10",
    animate && "animate-fade-in-up opacity-0",
    className
  ]}
  style={animate ? `animation-delay: ${delay}; animation-fill-mode: forwards;` : ""}
>
  <div class:list={[
    "w-full px-6 md:px-12",
    /* The Global Inset Parameter: 6xl creates the narrow 'spine' */
    !isFullWidth && "max-w-6xl" 
  ]}>
    <slot />
  </div>
</section>