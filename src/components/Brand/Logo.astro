---
import { Image } from 'astro:assets';
import logoImage from '../../assets/logo-b.png';

interface Props {
  size?: "sm" | "md" | "lg";
  className?: string;
}

const { size = "md", className = "" } = Astro.props;

const sizes = {
  sm: "h-8 w-8",
  md: "h-12 w-12",
  lg: "h-20 w-20"
};
---

<div class={`relative group flex items-center justify-center ${className}`}>
  <div class="absolute inset-0 bg-accent/20 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-full"></div>
  
  <Image 
    src={logoImage} 
    alt="bitmap.audio logo" 
    class={`relative z-10 object-contain animate-fade-in-up ${sizes[size]}`}
    loading="eager"
  />
</div>