---
/* src/components/GridBackground.astro */
---
<div class="fixed inset-0 pointer-events-none z-0">
  {/* Layer 1: The Grid - Boosted slightly to ensure it shows through the tighter gap */}
  <div class="absolute inset-0 bitmap-grid opacity-40"></div>
  
  {/* Layer 2: The Linear Overlay (Optional)
      If you still want a bit of top-to-bottom depth, keep this, 
      otherwise you can remove it for a pure spotlight look.
  */}
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-background/20 to-background"></div>
  
  {/* Layer 3: The Tight Peripheral Fade
      Adjusting 'transparent 5%' to 'hsl(var(--background)) 50%' 
      shrinks the visible grid area significantly.
  */}
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_5%,hsl(var(--background))_50%)]"></div>

  {/* Layer 4: Primary Glow Spot 
      Centered and sharpened (blur reduced) to keep the light localized.
  */}
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[800px] h-[500px] bg-primary/10 rounded-full blur-[140px] opacity-60"></div>
  
  {/* Layer 5: Subtle Content Glow */}
  <div class="absolute top-[40%] left-1/2 -translate-x-1/2 w-[400px] h-[300px] bg-primary/20 rounded-full blur-[100px] opacity-40"></div>
</div>