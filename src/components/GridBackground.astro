---
/* src/components/GridBackground.astro */
interface Props {
  showRain?: boolean;
  showGrid?: boolean;
}

const { showRain = true, showGrid = true } = Astro.props;
---
<div id="grid-bg" class="fixed inset-0 pointer-events-none z-0">
  
  {/* Layer 1: The Grid (conditional via showGrid prop) */}
  {showGrid && <div class="absolute inset-0 bitmap-grid transition-opacity duration-500" style={{ opacity: 'var(--grid-opacity)' }}></div>}

  {/* Layer 1.5: The Binary Parallax Waterfall (CONDITIONAL) */}
  {showRain && (
    <div class="absolute inset-0 binary-waterfall">
      <div id="layer-deep" class="binary-layer layer-deep"></div>
      <div id="layer-near" class="binary-layer layer-near"></div>
    </div>
  )}

  {/* Layer 1.6: Centre light-wash — a LIGHTEN-ONLY bloom sitting OVER the rain, so
      the "light" cast from the middle blows out the glyphs there (harder to read in
      the centre, crisp at the edges) while only ADDING brightness — never darkening,
      so the vignette glow is preserved/reinforced. Viewport-fixed, so the rain
      scrolls through it. Tune the alpha stops (centre strength) + radius. */}
  {showRain && (
    <div
      class="absolute inset-0 pointer-events-none"
      style="mix-blend-mode: screen; background: radial-gradient(circle at 50% 40%, hsl(var(--primary) / 0.20) 0%, hsl(var(--primary) / 0.08) 24%, transparent 48%);"
    ></div>
  )}

  {/* Layer 2: The Fog */}
  <div 
    class="absolute inset-0 bg-gradient-to-b from-transparent via-background/20 to-background transition-opacity duration-1000"
    style={{ opacity: 'var(--fog-strength, 1)' }}
  ></div>
  
  {/* Layer 3: Vignette Mask */}
  <div 
    class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_5%,hsl(var(--background))_50%)] transition-opacity duration-1000"
    style={{ opacity: 'var(--vignette-strength, 1)' }}
  ></div>

  {/* Layer 4: Glows */}
  <div 
    class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/3 w-[800px] h-[500px] bg-primary/10 rounded-full blur-[140px] transition-opacity duration-1000"
    style={{ opacity: 'var(--glow-strength, 0.5)' }}
  ></div>
</div>

<script>
  const deepLayer = document.getElementById('layer-deep');
  const nearLayer = document.getElementById('layer-near');
  const root = document.documentElement;

  // FREEZE support: while <html data-rain-frozen="1"> (set during the About peel), the
  // rain holds still — so the dark sheet reads as being peeled back, not scrolling. On
  // unfreeze, `accum` absorbs the scroll that happened while frozen, so it resumes with
  // no jump.
  let accum = 0;
  let frozen = false;
  let freezeStart = 0;

  const apply = () => {
    const s = window.scrollY - accum;
    // heights match the .layer-deep / .layer-near background-size (400 / 800)
    if (deepLayer) deepLayer.style.transform = `translateY(${(s * 0.1) % 400}px)`;
    if (nearLayer) nearLayer.style.transform = `translateY(${(s * 0.3) % 800}px)`;
  };

  const handleScroll = () => {
    const wantFrozen = root.dataset.rainFrozen === '1';
    if (wantFrozen && !frozen) { frozen = true; freezeStart = window.scrollY; }
    else if (!wantFrozen && frozen) { accum += window.scrollY - freezeStart; frozen = false; }
    if (frozen) return; // hold position
    apply();
  };

  window.addEventListener('scroll', () => {
    window.requestAnimationFrame(handleScroll);
  }, { passive: true });
</script>