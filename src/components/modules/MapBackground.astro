---
/* src/components/modules/MapBackground.astro
 *
 * A procedurally-generated, original bitmappy street map (Manchester-flavoured: winding Irwell,
 * inner ring road, radial arteries, canal, green squares). Pure inline SVG — no external image,
 * no Google Maps, no network cost. Drawn entirely in `currentColor`, so it inherits the section's
 * text colour (dark on the beige theme-oat world) and can be tinted/dimmed from CSS.
 *
 * Drop it as an absolute background layer inside a positioned/overflow-hidden container; keep the
 * real content above it with `relative z-10`.
 *
 * The artwork lives in src/assets/manchester-map.svg (generated by outputs/genmap.py).
 */
import mapSvg from '../../assets/manchester-map.svg?raw';
interface Props { class?: string; opacity?: number; barOffset?: boolean; }
const { class: className = '', opacity = 0.12, barOffset = false } = Astro.props;
---
<div
  class:list={['map-bg pointer-events-none', barOffset && 'map-bg--bar-offset', className]}
  style={`--map-opacity:${opacity}`}
  aria-hidden="true"
  set:html={mapSvg}
/>

<style>
  .map-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    color: hsl(var(--foreground));   /* currentColor for the strokes */
    opacity: var(--map-opacity, 0.12);
  }
  /* When a .section-bar-hold Solaris bar + sticky header sit above (barOffset FocusScroll), inset the
     map's top by the same amount so the map is centred in the CONTENT region (below the header + bar),
     not the raw viewport — the ring road's centre then lines up with the content's centre. */
  .map-bg--bar-offset { top: calc(var(--header-h) + var(--solaris-height, 96px)); }
  .map-bg :global(svg) { width: 100%; height: 100%; display: block; }
</style>
