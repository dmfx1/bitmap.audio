---
/**
 * SonicWaves.astro — Sonic Branding "draw-in" background motif for the Services section. A high-res
 * SPECTRUM / EQ field: fine vertical frequency bars draw in from the top and bottom edges and grow
 * toward a central "void". The centre is masked (a feathered ellipse tracking the real card cluster)
 * so the tallest bars dissolve into the void and nothing is ever painted behind a card — true even
 * for faded/greyed frosted cards.
 *
 * Kept faint — a texture, not an obvious background: low per-bar opacity, thin bars, a few sparse
 * brand-accent (#FF9E1A) peaks, and a slow living drift once revealed.
 *
 * Shares the `.perspective-grid` reveal system with timing overridden locally for a near-immediate
 * start. Toggled by ServicePillars.tsx via `.is-revealing` when the Sonic Branding pillar (index 1,
 * middle card) is active + the section is in focus.
 */
interface Props { page?: boolean }
const { page = false } = Astro.props;
const W = 1600, H = 900, CX = W / 2;
const BARS = 128;              // bars across the width
const MAXH = 0.48 * H;         // tallest bar — reaches toward the void
const MINH = 0.03 * H;
const PAUSE = 0.05;
const WIN = 1.0;               // random draw-in window (s) — bars scatter in

const rnd = (s: number) => { const x = Math.sin(s * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };
// Spectrum envelope — layered harmonics + a little jitter, clamped to 0..1.
function spec(i: number, seed: number) {
  const u = i / (BARS - 1);
  let v = 0.42
    + 0.30 * Math.sin(u * Math.PI * 6 + 0.5 + seed)
    + 0.18 * Math.sin(u * Math.PI * 13 + 1.7 + seed)
    + 0.12 * Math.sin(u * Math.PI * 23 + 3.1 + seed)
    + 0.10 * (rnd(i + seed * 50) * 2 - 1);
  return Math.max(0.05, Math.min(1, v));
}

const sp = W / BARS;
const bars = Array.from({ length: BARS }, (_, i) => {
  const x = (i + 0.5) * sp;
  const hT = MINH + spec(i, 0) * (MAXH - MINH);
  const hB = MINH + spec(i, 1) * (MAXH - MINH);
  const peak = Math.max(spec(i, 0), spec(i, 1));
  const op = (0.1 + 0.13 * peak).toFixed(3);
  const dTop = (PAUSE + rnd(i + 3) * WIN).toFixed(3);     // each bar scatters independently
  const dBot = (PAUSE + rnd(i + 701) * WIN).toFixed(3);
  return {
    top: `M${x.toFixed(1)},0 L${x.toFixed(1)},${hT.toFixed(1)}`,
    bot: `M${x.toFixed(1)},${H} L${x.toFixed(1)},${(H - hB).toFixed(1)}`,
    op, dTop, dBot,
  };
});
---

<div id="sonic-waves" class={page ? "perspective-grid is-revealing is-static" : "perspective-grid sonic-void"} style="color: hsl(180 10% 12%)" aria-hidden="true">
  <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <g class="void-field" fill="none" stroke-linecap="butt" stroke-width="4">
      {bars.map((b) => (
        <>
          <path data-draw d={b.top} pathLength="1" stroke-opacity={b.op}
            stroke="currentColor" style={`--d:${b.dTop}s`} />
          <path data-draw d={b.bot} pathLength="1" stroke-opacity={b.op}
            stroke="currentColor" style={`--d:${b.dBot}s`} />
        </>
      ))}
    </g>
  </svg>
</div>

<style>
  /* Faster start than the shared reveal. */
  #sonic-waves.perspective-grid { transition: opacity 0.4s ease 0s, filter 0.55s ease 0s; }
  #sonic-waves.perspective-grid.is-revealing [data-draw] {
    transition: stroke-dashoffset 1.1s cubic-bezier(0.22, 1, 0.36, 1) var(--d);
  }

  /* Centre void mask — feathered ellipse over the card cluster (measured from the real grid). */
  #sonic-waves.sonic-void {
    -webkit-mask-image: radial-gradient(ellipse var(--void-rx, 44%) var(--void-ry, 30%)
                        at var(--void-cx, 50%) var(--void-cy, 50%),
                        transparent 0%, transparent 84%, #000 118%);
            mask-image: radial-gradient(ellipse var(--void-rx, 44%) var(--void-ry, 30%)
                        at var(--void-cx, 50%) var(--void-cy, 50%),
                        transparent 0%, transparent 84%, #000 118%);
  }

  /* Slow living drift once drawn in. */
  #sonic-waves .void-field { transform-origin: 50% 50%; }
  #sonic-waves.is-revealing .void-field {
    animation: sonic-eq-breath 7s ease-in-out infinite alternate;
  }
  @keyframes sonic-eq-breath {
    from { opacity: 1; }
    to   { opacity: 0.78; }
  }
  @media (prefers-reduced-motion: reduce) {
    #sonic-waves.is-revealing .void-field { animation: none; }
  }
  /* STATIC page-background variant (solutions pages): shown drawn, very faint, no mask/animation. */
  #sonic-waves.is-static { opacity: 0.45 !important; filter: none !important; -webkit-mask-image: none !important; mask-image: none !important; }
  #sonic-waves.is-static [data-draw] { stroke-dashoffset: 0 !important; transition: none !important; }
  #sonic-waves.is-static .void-field { animation: none !important; }
</style>

<script>
  const setup = () => {
    const grid = document.querySelector('[data-pillars-grid]') as HTMLElement | null;
    const field = document.getElementById('sonic-waves');
    const scene = field?.closest('[data-scene]') as HTMLElement | null;
    if (!grid || !field || !scene) return false;
    const measure = () => {
      const g = grid.getBoundingClientRect();
      const s = field.getBoundingClientRect();
      if (!s.width || !s.height) return;
      const pad = 3;
      field.style.setProperty('--void-cx', (((g.left + g.width / 2) - s.left) / s.width * 100).toFixed(2) + '%');
      field.style.setProperty('--void-cy', (((g.top + g.height / 2) - s.top) / s.height * 100).toFixed(2) + '%');
      field.style.setProperty('--void-rx', ((g.width / 2) / s.width * 100 + pad).toFixed(2) + '%');
      field.style.setProperty('--void-ry', ((g.height / 2) / s.height * 100 + pad).toFixed(2) + '%');
    };
    measure();
    const ro = new ResizeObserver(measure);
    ro.observe(grid); ro.observe(scene);
    window.addEventListener('resize', measure, { passive: true });
    [120, 400, 1000].forEach((t) => setTimeout(measure, t));
    return true;
  };
  if (!setup()) {
    let tries = 0;
    const iv = setInterval(() => { if (setup() || ++tries > 40) clearInterval(iv); }, 150);
  }
</script>

<!-- Reveal CSS is shared across the perspective grids in src/styles/global.css (.perspective-grid). -->
