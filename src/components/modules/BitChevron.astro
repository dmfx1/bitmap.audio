---
/* src/components/modules/BitChevron.astro
 *
 * Oversized bitmap chevron (›) — pixel art built from square blocks, tall + narrow. Two stacked copies:
 * a faint BASE and a solaris FILL; the fill's wrapper is clipped from the top ([data-chev-fill]) so a
 * page timeline can "fill" it pixel-row by pixel-row (see lib/scenes/how-we-work.ts).
 * Mobile: rotated to point DOWN and shown fully filled (static).
 *
 * Size: --chev-w on the element (height follows the 6×9 grid). Colours: --chev-base / --chev-fill.
 */
const COLS = 6, ROWS = 9;
// Two blocks per row; the leading edge steps out to the tip at the middle row, then back.
const cells: [number, number][] = [];
for (let r = 0; r < ROWS; r++) {
  const c = Math.min(r, ROWS - 1 - r);
  cells.push([c, r], [c + 1, r]);
}
const Grid = cells.map(([c, r]) => `<rect x="${c}" y="${r}" width="1" height="1"/>`).join('');
---
<span class="bit-chev" aria-hidden="true">
  <svg class="bit-chev__base" viewBox={`0 0 ${COLS} ${ROWS}`} shape-rendering="crispEdges" set:html={Grid} />
  <span class="bit-chev__fillwrap" data-chev-fill>
    <svg class="bit-chev__fill" viewBox={`0 0 ${COLS} ${ROWS}`} shape-rendering="crispEdges" set:html={Grid} />
  </span>
</span>

<style>
  .bit-chev {
    --chev-w: clamp(2.25rem, 3.4vw, 3.75rem);
    position: relative; display: block; flex: 0 0 auto;
    width: var(--chev-w); aspect-ratio: 6 / 9;
  }
  .bit-chev svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .bit-chev__base { fill: var(--chev-base, hsl(var(--foreground) / 0.12)); }
  .bit-chev__fillwrap { position: absolute; inset: 0; display: block; clip-path: inset(0 0 100% 0); }
  .bit-chev__fill { fill: var(--chev-fill, hsl(var(--accent))); }

  @media (max-width: 767px) {
    .bit-chev { --chev-w: 2.5rem; transform: rotate(90deg); margin: 0.5rem auto; }   /* point DOWN */
    .bit-chev__fillwrap { clip-path: none; }                                          /* static, filled */
  }
</style>
