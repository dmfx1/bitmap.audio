---
/* src/components/modules/FocusColumns.astro
 *
 * REUSABLE "focus columns" scroll section — STICKY + SCRUB (not a ScrollTrigger pin). The stage is
 * CSS `position: sticky` inside a tall section, so it FREEZES when you scroll to it (like the hero),
 * holds through the focus cycle, then releases — with NO pin-spacer, so there's no trailing dead
 * space and the next section can be pulled straight up OVER the frozen stage (founders-over-hero).
 *
 * The heading scrambles IN on the way down and OUT on the way back up. Each column comes into focus
 * in turn (grows + its number/title go solaris accent) while the others dull.
 *
 * Props:
 *   heading  — the scrambling top-centre label (e.g. "Our Values")
 *   columns  — [{ id, title, desc }, …] (any count; the cycle + scroll length adapt)
 *
 * Self-contained: does NOT use the src/lib/scene.ts pin framework.
 */
interface Column { id: string; title: string; desc: string; }
interface Props { heading: string; columns: Column[]; }
const { heading, columns } = Astro.props;
// The section is this many viewports tall; sticky-range (= scrub length) is one less than this.
const focusVh = columns.length + 1;
---
<section class="focus-scene" style={`--focus-vh: ${focusVh}`}>
  <div class="focus-sticky">
    <div class="focus-inner">
      <h2
        class="focus-heading font-mono tracking-[0.5em] uppercase text-accent text-base md:text-2xl"
        data-focus-heading
        data-text={heading}
      >{heading}</h2>

      <div class="focus-cols">
        {columns.map((c) => (
          <div class="focus-col" data-focus-col>
            <span class="focus-id font-mono text-5xl md:text-6xl font-light">{c.id}</span>
            <h3 class="focus-title font-mono text-xl md:text-2xl tracking-tight">{c.title}</h3>
            <p class="focus-desc font-mono text-base">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Desktop: a tall scroll region; the stage sticks through it (freezes), then releases — no pin,
     so no trailing dead space. Opaque beige so the dark sticky hero behind doesn't show through. */
  .focus-scene {
    position: relative;
    height: calc(var(--focus-vh, 4) * 100svh);
    background-color: hsl(var(--background));
  }
  .focus-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background-color: hsl(var(--background));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Mobile: no sticky/scrub — just a normal full-height section. */
  @media (max-width: 767px) {
    .focus-scene { height: auto; }
    .focus-sticky { position: static; height: auto; min-height: 100svh; }
  }

  .focus-inner {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .focus-heading {
    position: absolute;
    top: 25svh;            /* a quarter down the viewport */
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .focus-cols {
    width: min(90vw, 82rem);
    display: flex;
    flex-direction: column;
    gap: 6rem;
    /* nudge DOWN by ~half the (responsive) header bar so the centred content isn't read high. */
    position: relative;
    top: var(--scene-inset, calc(var(--header-h) / 2));
  }
  @media (min-width: 768px) {
    .focus-cols { flex-direction: row; gap: clamp(2rem, 6vw, 5rem); }
  }
  .focus-col {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    will-change: transform, opacity;
  }
  .focus-desc { max-width: 20rem; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { scrambleIn } from '../../lib/scene-kit';

  gsap.registerPlugin(ScrollTrigger);

  const CONFIG = {
    focusScale: 1.18,  // the focused column grows in place
    dull: 0.28,        // the other columns' opacity while not in focus
    focusDur: 0.5,     // grow / settle duration
    holdStart: 1.0,    // settle (stuck, columns equal) BEFORE any highlighting begins
    hold: 0.9,         // dwell on each focused column
    holdEnd: 1.2,      // brief pause on the resolved frame before it releases
    scrambleMs: 800,   // heading scramble-in duration
    accent: '#FF9E1A', // active column's number + title (solaris)
    ink: '#241F1A',    // inactive number + title (beige-world foreground)
  };

  function initFocus() {
    document.querySelectorAll<HTMLElement>('.focus-scene').forEach((section) => {
      if (section.dataset.focusInit === '1') return;
      section.dataset.focusInit = '1';

      const heading = section.querySelector<HTMLElement>('[data-focus-heading]');
      const cols = Array.from(section.querySelectorAll<HTMLElement>('[data-focus-col]'));
      if (!cols.length) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const desktop = window.matchMedia('(min-width: 768px)').matches;

      // All columns start DULL (so they don't read as normal body copy on the way in); the focus
      // cycle then lifts one at a time.
      gsap.set(cols, { transformOrigin: '50% 50%', opacity: CONFIG.dull, scale: 1 });
      const hi = cols.map((c) => c.querySelectorAll<HTMLElement>('.focus-id, .focus-title'));
      hi.forEach((h) => gsap.set(h, { color: CONFIG.ink }));

      // Title scrambles IN on scroll-down (onEnter) and hides on scroll-back-up (onLeaveBack) —
      // reliable now the section is sticky, not pinned.
      if (heading) {
        const text = heading.dataset.text || heading.textContent || '';
        gsap.set(heading, { opacity: 0 });
        ScrollTrigger.create({
          trigger: section,
          start: 'top 80%',
          onEnter: () => {
            gsap.to(heading, { opacity: 1, duration: 0.3 });
            scrambleIn(heading, text, { duration: CONFIG.scrambleMs });
          },
          onLeaveBack: () => { gsap.set(heading, { opacity: 0 }); },
        });
      }

      // Focus timeline — each column takes focus in turn (grows + accent), others dull.
      const tl = gsap.timeline({ paused: true });
      tl.to({}, { duration: CONFIG.holdStart }); // settle once stuck, before any highlighting
      cols.forEach((col, i) => {
        tl.addLabel('focus' + i);
        tl.to(col, { scale: CONFIG.focusScale, opacity: 1, duration: CONFIG.focusDur, ease: 'power2.out' }, 'focus' + i);
        tl.to(hi[i], { color: CONFIG.accent, duration: CONFIG.focusDur }, 'focus' + i);
        cols.forEach((other, j) => {
          if (j !== i) {
            tl.to(other, { scale: 1, opacity: CONFIG.dull, duration: CONFIG.focusDur, ease: 'power2.out' }, 'focus' + i);
            tl.to(hi[j], { color: CONFIG.ink, duration: CONFIG.focusDur }, 'focus' + i);
          }
        });
        tl.to({}, { duration: CONFIG.hold });
      });
      // End with the LAST column still highlighted (others dull) — no reset. It just holds this
      // frame, then the sticky section releases and scrolls on.
      tl.to({}, { duration: CONFIG.holdEnd });

      // Mobile / reduced-motion: no scrub — just show the resolved frame.
      if (reduced || !desktop) { tl.progress(1); return; }

      // Scrub the focus timeline across the STICKY range (start = section pinned at top, end =
      // section bottom reaches viewport bottom = sticky about to release). No pin — sticky freezes.
      ScrollTrigger.create({
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.75,
        animation: tl,
        invalidateOnRefresh: true,
      });
    });
  }

  document.addEventListener('astro:page-load', initFocus);
  if (document.readyState === 'complete') initFocus();
  else window.addEventListener('load', initFocus);
</script>
