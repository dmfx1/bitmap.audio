---
/* src/components/modules/FocusColumns.astro
 *
 * REUSABLE "focus columns" scroll section — STICKY + SCRUB (not a ScrollTrigger pin). The stage is
 * CSS `position: sticky` inside a tall section, so it FREEZES when you scroll to it (like the hero),
 * holds through the focus cycle, then releases — with NO pin-spacer, so there's no trailing dead
 * space and the next section can be pulled straight up OVER the frozen stage (founders-over-hero).
 *
 * The heading scrambles IN on the way down and OUT on the way back up. Each column comes into focus
 * in turn (grows + its number/title go solaris accent) while the others dull.
 *
 * Props:
 *   heading  — the scrambling top-centre label (e.g. "Our Values")
 *   columns  — [{ id, title, desc }, …] (any count; the cycle + scroll length adapt)
 *
 * Self-contained: does NOT use the src/lib/scene.ts pin framework.
 */
interface Column { id: string; title: string; desc: string; }
interface Props { heading: string; columns: Column[]; pinnedBar?: boolean; }
// pinnedBar (TRIAL): the section name lives on a sticky Solaris bar pinned under the header
// instead of a floating heading — so hide the heading here and re-centre the columns below the bar.
const { heading, columns, pinnedBar = false } = Astro.props;
// The focus now cycles on a TIMER (not scroll), so the section only needs a BRIEF sticky lock (it
// freezes for ~0.6 viewport while the columns autoplay), then releases. Fixed height (not per
// column) since scroll no longer drives the cycle.
const focusVh = 1.6;
---
<section class:list={["focus-scene", pinnedBar && "focus-scene--pinned"]} style={`--focus-vh: ${focusVh}`}>
  <div class="focus-sticky">
    <div class="focus-inner">
      <h2
        class="focus-heading font-mono tracking-[0.5em] uppercase text-accent text-base md:text-2xl"
        data-focus-heading
        data-text={heading}
      >{heading}</h2>

      <div class="focus-cols">
        {columns.map((c) => (
          <div class="focus-col" data-focus-col>
            <span class="focus-id font-mono text-5xl md:text-6xl font-light">{c.id}</span>
            <h3 class="focus-title font-mono text-xl md:text-2xl tracking-tight">{c.title}</h3>
            <p class="focus-desc font-mono text-base">{c.desc}</p>
            {/* per-column bitmap progress bar — pixels light up with the autoplay timer */}
            <div class="focus-progress bitmap-progress" data-focus-progress></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Desktop: a tall scroll region; the stage sticks through it (freezes), then releases — no pin,
     so no trailing dead space. Opaque beige so the dark sticky hero behind doesn't show through. */
  .focus-scene {
    position: relative;
    height: calc(var(--focus-vh, 4) * 100svh);
    background-color: hsl(var(--background));
  }
  .focus-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background-color: hsl(var(--background));
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Mobile: no sticky/scrub — just a normal full-height section. */
  @media (max-width: 767px) {
    .focus-scene { height: auto; }
    .focus-sticky { position: static; height: auto; min-height: 100svh; }
  }

  .focus-inner {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .focus-heading {
    position: absolute;
    top: 25svh;            /* a quarter down the viewport */
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .focus-cols {
    width: min(90vw, 82rem);
    display: flex;
    flex-direction: column;
    gap: 6rem;
    /* nudge DOWN by ~half the (responsive) header bar so the centred content isn't read high. */
    position: relative;
    top: var(--scene-inset, calc(var(--header-h) / 2));
  }
  @media (min-width: 768px) {
    .focus-cols { flex-direction: row; gap: clamp(2rem, 6vw, 5rem); }
  }
  .focus-col {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    will-change: transform, opacity;
  }
  .focus-desc { max-width: 20rem; }
  /* Per-column progress bar — the pixel look lives in the shared .bitmap-progress (global.css);
     here we just position it under the column. */
  .focus-progress { margin-top: 0.75rem; }

  /* pinnedBar: the section name is carried by a SEPARATE sticky Solaris bar (see .section-bar-hold
     in global.css) that arrives under the header first, then releases in sync with the columns. So
     here we just drop the floating heading and re-centre the columns below the header + bar. */
  .focus-scene--pinned .focus-heading { display: none; }
  .focus-scene--pinned .focus-cols {
    top: calc((var(--header-h) + var(--solaris-height, 96px)) / 2);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { scrambleIn } from '../../lib/scene-kit';

  gsap.registerPlugin(ScrollTrigger);

  const CONFIG = {
    focusScale: 1.18,  // the focused column grows in place
    dull: 0.28,        // the other columns' opacity while not in focus
    focusDur: 0.4,     // grow / settle tween duration
    intervalMs: 4500,  // time each column holds focus before the loop advances
    scrambleMs: 800,   // heading scramble-in duration
  };

  // Colours come from the CSS token map — NO hard-coded hex. GSAP can't tween var(), so resolve
  // the token off the element (picks up the theme, e.g. beige world) to an hsl() string.
  const readToken = (name: string, el: Element): string => {
    const raw = getComputedStyle(el).getPropertyValue(name).trim();
    if (!raw) return '';
    return /^#|^rgb|^hsl/.test(raw) ? raw : `hsl(${raw.split(/\s+/).join(', ')})`;
  };

  function initFocus() {
    document.querySelectorAll<HTMLElement>('.focus-scene').forEach((section) => {
      if (section.dataset.focusInit === '1') return;
      section.dataset.focusInit = '1';

      const heading = section.querySelector<HTMLElement>('[data-focus-heading]');
      const cols = Array.from(section.querySelectorAll<HTMLElement>('[data-focus-col]'));
      if (!cols.length) return;
      const hi = cols.map((c) => c.querySelectorAll<HTMLElement>('.focus-id, .focus-title'));
      const bars = cols.map((c) => c.querySelector<HTMLElement>('[data-focus-progress]'));

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Resolve colours from the token map (bright --accent for the active column; the theme's
      // foreground for the dulled ones) — no hard-coded hex.
      const accent = readToken('--accent', section);
      const ink = readToken('--content-foreground', section) || readToken('--foreground', section);

      gsap.set(cols, { transformOrigin: '50% 50%' });

      // Apply the focus state (grow + accent) to column `active`, dulling the rest.
      const applyFocus = (active: number) => {
        cols.forEach((col, i) => {
          gsap.to(col, { scale: i === active ? CONFIG.focusScale : 1, opacity: i === active ? 1 : CONFIG.dull, duration: CONFIG.focusDur, ease: 'power2.out' });
          gsap.to(hi[i], { color: i === active ? accent : ink, duration: CONFIG.focusDur });
        });
      };
      const setBar = (idx: number, p: number) => {
        bars.forEach((b, i) => { if (b) b.style.setProperty('--progress', String(i === idx ? p : 0)); });
      };

      applyFocus(0);
      setBar(0, 0);

      // Heading scramble IN on enter / hide on leave-back (unchanged).
      if (heading) {
        const text = heading.dataset.text || heading.textContent || '';
        gsap.set(heading, { opacity: 0 });
        ScrollTrigger.create({
          trigger: section,
          start: 'top 80%',
          onEnter: () => {
            gsap.to(heading, { opacity: 1, duration: 0.3 });
            scrambleIn(heading, text, { duration: CONFIG.scrambleMs });
          },
          onLeaveBack: () => { gsap.set(heading, { opacity: 0 }); },
        });
      }

      // Reduced motion: show the first column focused, no loop.
      if (reduced) { applyFocus(0); setBar(0, 1); return; }

      // ── TIMED LOOP + hover (same as the React useTimedFocus hook): ONE persistent rAF + an
      //    elapsed accumulator, so scroll (on/off screen) and hover PAUSE/RESUME the fill instead
      //    of restarting it mid-way (that was the "fills halfway" bug). ────────────────────────
      let active = 0;
      let hover: number | null = null;
      let onScreen = false;
      let elapsed = 0;
      let last: number | undefined;

      const step = (t: number) => {
        const dt = last === undefined ? 0 : t - last;
        last = t;
        if (hover !== null) {
          elapsed = 0;              // paused on hover, bar full on the hovered column
          setBar(hover, 1);
        } else if (onScreen) {
          elapsed += dt;            // only accrue while on screen → off-screen pauses
          const p = Math.min(1, elapsed / CONFIG.intervalMs);
          setBar(active, p);
          if (p >= 1) { active = (active + 1) % cols.length; applyFocus(active); elapsed = 0; }
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);

      // Hover takes precedence over the loop.
      cols.forEach((col, i) => {
        col.addEventListener('mouseenter', () => { hover = i; applyFocus(i); });
        col.addEventListener('mouseleave', () => { hover = null; applyFocus(active); });
      });

      // Accrue the timer only while the section is on screen.
      ScrollTrigger.create({
        trigger: section,
        start: 'top 75%',
        end: 'bottom 25%',
        onToggle: (self: ScrollTrigger) => { onScreen = self.isActive; },
      });
    });
  }

  document.addEventListener('astro:page-load', initFocus);
  if (document.readyState === 'complete') initFocus();
  else window.addEventListener('load', initFocus);
</script>
