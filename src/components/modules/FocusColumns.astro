---
/* src/components/modules/FocusColumns.astro
 *
 * REUSABLE "focus columns" scroll scene (built on src/lib/scene.ts). The section pins full-screen;
 * the heading scrambles in top-centre; then continued scroll brings each column into focus IN TURN
 * — the focused column grows in place while the others dull — before the section releases.
 *
 * Reusable anywhere on the site: pass a `heading` and an array of `{ id, title, desc }`. The
 * `data-scene="focus-columns"` builder is SHARED (registered once), so every instance across the
 * site runs from the same script — a new "focus" section is just this component with new props.
 *
 * Props:
 *   heading  — the scrambling top-centre label (e.g. "Our Values")
 *   columns  — [{ id, title, desc }, …] (any count; the cycle adapts)
 *   lead     — optional per-instance lead-in runway (default 30svh)
 */
interface Column { id: string; title: string; desc: string; }
interface Props { heading: string; columns: Column[]; lead?: string; }
// lead = empty runway BEFORE the pin. Default 0: the stage's own entry (it rises from the bottom
// into centre) is the scroll-in — extra lead padding just adds dead space. Pass a value only to
// separate this scene from busy preceding content.
const { heading, columns, lead = '0svh' } = Astro.props;
---
<section
  data-scene="focus-columns"
  data-scroll={columns.length + 1}
  data-scene-hold
  class="scene focus-scene"
  style={`--scene-lead: ${lead}`}
>
  <div class="scene-stage">
    <div class="focus-inner" data-scene-content>
      <h2
        class="focus-heading font-mono tracking-[0.5em] uppercase text-accent text-base md:text-2xl"
        data-focus-heading
        data-text={heading}
      >{heading}</h2>

      <div class="focus-cols">
        {columns.map((c) => (
          <div class="focus-col" data-focus-col>
            <span class="focus-id font-mono text-5xl md:text-6xl font-light">{c.id}</span>
            <h3 class="focus-title font-mono text-xl md:text-2xl tracking-tight">{c.title}</h3>
            <p class="focus-desc font-mono text-base">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Opaque beige so the (dark, sticky) hero behind the beige world doesn't show through. In the
     theme-oat context --background resolves to the Cool-Oat beige. */
  .focus-scene .scene-stage { background-color: hsl(var(--background)); }

  .focus-inner {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .focus-heading {
    position: absolute;
    top: 25svh;            /* a quarter down the viewport at lock */
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .focus-cols {
    /* wider spread, with a suitable gutter either side */
    width: min(90vw, 82rem);
    display: flex;
    flex-direction: column;
    gap: 6rem;
    /* nudge DOWN so the sticky header bar doesn't make the (viewport-)centred content read high:
       the true optical centre sits below the header, so shift by ~half its height. Tunable. */
    position: relative;
    top: var(--scene-inset, calc(var(--header-h) / 2)); /* half the (responsive) header bar */
  }
  @media (min-width: 768px) {
    .focus-cols { flex-direction: row; gap: clamp(2rem, 6vw, 5rem); }
  }
  .focus-col {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    will-change: transform, opacity;
  }
  .focus-desc { max-width: 20rem; }
</style>

<script>
  import { registerScene } from '../../lib/scene';
  import { gsap } from 'gsap';
  import { scrambleIn } from '../../lib/scene-kit';

  const CONFIG = {
    focusScale: 1.18,  // the focused column grows in place
    dull: 0.28,        // the other columns' opacity while not in focus
    focusDur: 0.5,     // grow / settle duration
    hold: 0.9,         // dwell on each focused column
    holdEnd: 2.2,      // freeze the final frame (pinned) while the next section slides over it
    scrambleMs: 800,   // heading scramble-in duration
    colsDelay: 0.45,   // columns fade in this long AFTER the heading starts scrambling
    accent: '#FF9E1A', // active column's number + title (solaris)
    ink: '#241F1A',    // inactive number + title (beige-world foreground)
  };

  registerScene('focus-columns', (tl, stage) => {
    const heading = stage.querySelector<HTMLElement>('[data-focus-heading]');
    const cols = Array.from(stage.querySelectorAll<HTMLElement>('[data-focus-col]'));
    if (!cols.length) return;

    gsap.set(cols, { transformOrigin: '50% 50%', opacity: 0, scale: 1 }); // hidden until the heading lands
    // the number + title of each column — these turn solaris accent when the column is in focus
    const hi = cols.map((c) => c.querySelectorAll<HTMLElement>('.focus-id, .focus-title'));
    hi.forEach((h) => gsap.set(h, { color: CONFIG.ink }));

    // On enter: the HEADING scrambles in first; the columns fade in a beat later. Independent of
    // the scrub, so it plays once as the section arrives.
    if (heading) {
      const text = heading.dataset.text || heading.textContent || '';
      gsap.set(heading, { opacity: 0 });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            gsap.to(heading, { opacity: 1, duration: 0.3 });
            scrambleIn(heading, text, { duration: CONFIG.scrambleMs });
            gsap.to(cols, { opacity: 1, duration: 0.5, delay: CONFIG.colsDelay, stagger: 0.08, ease: 'power2.out' });
            io.disconnect();
          }
        });
      }, { threshold: 0.4 });
      io.observe(stage);
    } else {
      gsap.set(cols, { opacity: 1 }); // no heading → just show the columns
    }

    // scrubbed focus cycle — each column grows to focus in turn (its number + title go accent);
    // the others dull, shrink back and return to ink.
    cols.forEach((col, i) => {
      tl.addLabel('focus' + i);
      tl.to(col, { scale: CONFIG.focusScale, opacity: 1, duration: CONFIG.focusDur, ease: 'power2.out' }, 'focus' + i);
      tl.to(hi[i], { color: CONFIG.accent, duration: CONFIG.focusDur }, 'focus' + i);
      cols.forEach((other, j) => {
        if (j !== i) {
          tl.to(other, { scale: 1, opacity: CONFIG.dull, duration: CONFIG.focusDur, ease: 'power2.out' }, 'focus' + i);
          tl.to(hi[j], { color: CONFIG.ink, duration: CONFIG.focusDur }, 'focus' + i);
        }
      });
      tl.to({}, { duration: CONFIG.hold });
    });
    // resolve — all columns back to equal + full (and ink)
    tl.to(cols, { scale: 1, opacity: 1, duration: CONFIG.focusDur }, '>');
    hi.forEach((h) => tl.to(h, { color: CONFIG.ink, duration: CONFIG.focusDur }, '<'));
    // HOLD the final frame, FROZEN + pinned (data-scene-hold keeps it from fading). The next
    // section (the client-terminal peel) slides over the top of this held frame — the founders
    // effect. Tune the freeze length with holdEnd / the section's data-scroll.
    tl.to({}, { duration: CONFIG.holdEnd });
  });
</script>
