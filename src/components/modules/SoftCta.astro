---
/* src/components/modules/SoftCta.astro
 *
 * Mid-page "soft" CTA, laid out like the Hero: question centred in the top half (heading-hero, the
 * `accent` line in solaris + the blinking solaris cursor), the support line in the lower half, and the
 * button pinned to the bottom (the Hero's outline button). Deliberately lighter than <CtaScene> — no
 * pixel veil — so the page doesn't "end twice".
 *
 * Place it INSIDE the page's stage wrapper + scene body:
 *   <div class="scene soft-cta-scene" data-scene="soft-cta" style="z-index:25">
 *     <div class="scene-body"><SoftCta head="…" accent="…" sub="…" label="…" /></div>
 *   </div>
 *
 * Static .astro for now. When site AUDIO arrives (see CLAUDE.md), convert to SoftCta.tsx with the SAME props.
 */
import { buttonVariants } from '../ui/button-variants';
import { cn } from '../../lib/utils';

interface Props {
  /** First line of the question. */
  head: string;
  /** Second line, in solaris (optional). */
  accent?: string;
  /** Support line under the question. */
  sub: string;
  href?: string;
  /** Button label (rendered uppercase by the button style). */
  label: string;
  /** TRIAL (2026-11-09): the people you'll talk to — small washed-out halftone portraits beside the button. */
  people?: { name: string; src: string; position?: string }[];
  /** One short line next to the portraits. */
  peopleNote?: string;
}
import { BOOKING_URL, isExternal } from '../../config/booking';
const { head, accent, sub, href = BOOKING_URL, label, people, peopleNote } = Astro.props;
const ext = isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<div class="soft-cta">
  {/* ROW 1 — question, same type + accent-second-line + solaris cursor as the hero title */}
  <div class="container-page relative flex flex-col justify-start min-h-0 soft-cta__top">
    <h2 class="heading-hero mb-8 leading-tight font-medium soft-cta__title">
      {head}{accent && <Fragment><br/><span class="text-accent font-medium">{accent}</span></Fragment>}<span class="inline-block w-[0.5ch] h-[0.9em] bg-accent brightness-125 ml-1 animate-pulse align-middle" aria-hidden="true"></span>
    </h2>
  </div>
  {/* ROW 2 — support line in the lower half; the button PINNED to the bottom */}
  <div class="container-page relative flex flex-col min-h-0">
    <div class="flex-1 flex flex-col justify-center min-h-0">
      <p class="text-foreground/90 type-lead font-mono soft-cta__sub">{sub}</p>
    </div>
    <div class:list={['w-full mt-8 md:mt-0', people && people.length ? 'max-w-3xl' : 'max-w-xl']}>
      <div class="flex flex-col-reverse md:flex-row items-stretch gap-4 w-full">
        <a href={href} {...ext} class:list={['flex-1', people && people.length && 'md:flex-none md:w-[17.5rem]']}>{/* = half of the hero's 2-button row */}
          <span class={cn(buttonVariants({ variant: 'outline', size: 'xl' }), 'morph-accent rounded-none w-full h-14 md:h-24 px-4 md:px-8 text-base md:text-xl')}>{label}</span>
        </a>
        {people && people.length ? (
          <div class="flex-1 sc-people">
            <div class="sc-people__faces">
              {people.map((p) => (
                <figure class="sc-face">
                  <img src={p.src} alt={p.name} loading="lazy" decoding="async" style={p.position ? `object-position:${p.position}` : undefined} />
                </figure>
              ))}
            </div>
            <p class="sc-people__note type-body">
              {people.map((p) => p.name).join(' & ')}
              {peopleNote && <span class="sc-people__sub">{peopleNote}</span>}
            </p>
          </div>
        ) : (
          <span class="flex-1 hidden md:block" aria-hidden="true"></span>
        )}{/* keeps the hero's 2-button width */}
      </div>
    </div>
  </div>
</div>

<style>
  /* Two equal rows filling the scene body (which is sized under the header + bar by the page). */
  .soft-cta {
    height: 100%; display: grid; grid-template-rows: 1fr 1fr;
    padding-block: var(--page-gutter); box-sizing: border-box;
  }
  .soft-cta__title { max-width: min(66vw, 80rem); }   /* = .hero-copy[data-hero-pull="title"] */
  /* TITLE LINES UP WITH EVERY OTHER SECTION (dom, 2026-11-11): top-anchored at the COPY GRID's --grid-top and the
     same size (incl. the short-screen scale), instead of centred in the top half. Only the title moves — the two
     rows (and so the support line + button) stay exactly where they were. */
  @media (min-width: 768px) {
    .soft-cta__top { padding-top: calc(var(--grid-top) - var(--page-gutter)); }
    .soft-cta .soft-cta__title { font-size: calc(var(--type-display) * var(--grid-title-scale)); }
    /* the support line sits a couple of lines HIGHER than dead-centre in its half, so it never runs into the
       button on shorter screens (dom, 2026-11-12). It's centred, so a bottom margin of 2× lifts it 1×. */
    .soft-cta__sub { margin-bottom: calc(2 * var(--sc-sub-lift, 1.25lh));   /* 2lh ran into the title at 1280×800 */ }
  }
  .soft-cta__sub { max-width: min(55vw, 84rem); }     /* = .hero-copy[data-hero-pull="sub"] */
  a { pointer-events: auto; }
  /* The support line is longer than the hero's: step it down a size on short laptop screens so it
     never runs into the pinned button. */
  @media (min-width: 768px) and (max-height: 860px) { .soft-cta__sub { font-size: 2.25rem; line-height: 2.5rem; } }

  /* ── PEOPLE (trial): background-removed cut-outs (public/images/*-cutout.webp — home only; About keeps
     the originals), black-and-white + a touch washed out, shoulders dissolving into the page. ── */
  .sc-people { display: flex; align-items: center; gap: 1rem; min-width: 0; }
  .sc-people__faces { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .sc-face { margin: 0; width: 6rem; height: 6rem; position: relative; overflow: hidden; }   /* = button height (h-24) */
  .sc-face img {
    width: 100%; height: 100%; object-fit: contain; object-position: center bottom; display: block;
    filter: grayscale(1) contrast(1.05) brightness(1.08);
    opacity: 0.85;
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
  }
  .sc-people__note { margin: 0; font-family: var(--font-mono); color: hsl(var(--foreground) / 0.85); line-height: 1.35; }
  .sc-people__sub { display: block; color: hsl(var(--foreground) / 0.55); }

  @media (max-width: 767px) {
    .sc-face { width: 4.5rem; height: 4.5rem; }
    /* stacked like the hero on mobile. padding 2rem + the page's mobile .scene-body 3rem = 5rem */
    .soft-cta { height: auto; display: flex; flex-direction: column; gap: 2rem; padding-block: 0 2rem; }   /* top space = TermTag */
    .soft-cta__title, .soft-cta__sub { max-width: 100%; }
  }
</style>
