---
/* src/components/modules/PhilosophyScene.astro
 *
 * THE PHILOSOPHY SCENE — a scroll-locked bitmap story. The 6-stage choreography now lives in
 * src/lib/scenes/philosophy.ts (buildPhilosophyScene) so it can be reused UNCHANGED by about-v3's
 * scene stage (nested in a master timeline, no separate pin). This component still renders the
 * markup + registers the scene with scene.ts (which pins + scrubs it) for about-v2.
 *
 * See src/lib/scenes/philosophy.ts for the stage-by-stage description + CONFIG.
 */
---
<section data-scene="bitmap-philosophy" data-scroll="6" class="scene" style="--scene-tail: 0svh; --scene-lead: 0svh;">
  <div class="scene-stage">
    <div class="phil-inner" data-scene-content>
      <svg id="sound-canvas" class="sound-canvas" viewBox="0 0 1200 1000"
           preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <g id="bit-group">
          <g id="sub-group"></g>
        </g>
      </svg>
      <div class="scene-caps">
        <p class="scene-cap ">Think of your sound like the pixels in an image.</p>
        <p class="scene-cap">We translate individual traits of your brand's personality into distinct audio "bits".</p>
        <p class="scene-cap">Then map them together into a unified sonic identity.</p>
        <p class="scene-cap">The master asset provides you with a complete, cohesive sound for your brand.</p>
        <p class="scene-cap">Modular stems then give you individual elements pulled from the master, ready for every touchpoint.</p>
        <p class="scene-cap">The result is complete consistency in how your brand sounds, wherever it appears.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .phil-heading {
    position: absolute;
    top: 15svh; /* Keeps it high up and out of the way of the graphics */
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    z-index: 10;
  }
  /* Fill the pinned stage and CENTRE the canvas in the viewport; captions overlay at the
     bottom (typography overlay) so the bit sits at true centre, not pushed up by the copy. */
  .phil-inner {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Big, bold, wide canvas (viewBox 1200×1000 gives room for the line-up). Scales to fit. */
  .sound-canvas {
    width: clamp(360px, 88vmin, 900px);
    aspect-ratio: 1.2 / 1;
    overflow: visible;
  }

  .scene-caps {
  position: absolute;
  left: 50%;
  /* Increased the min, preferred, and max values for more bottom spacing */
  bottom: clamp(7rem, 18vh, 12rem);
  transform: translateX(-50%);
  /* Increased the viewport width percentage and the maximum rem width */
  width: min(96vw, 60rem);
  min-height: 4.6em; /* This will automatically scale up because it uses 'em' */
  text-align: center;
  /* mix-blend-mode: difference makes the caption read LIGHT on the dark scene and DARK on the beige
     world automatically — but that inversion only works if the text colour is pure WHITE. This is a
     blend OPERAND, not a theme colour: do NOT swap it for a token (on the beige world --foreground is
     dark, which breaks the effect). */
  color: #ffffff;
  mix-blend-mode: difference;
}

.scene-cap {
  position: absolute;
  inset: 0;
  margin: 0;
  font-family: var(--font-mono);
  /* Significantly increased the font size limits */
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  line-height: 1.5;
  letter-spacing: 0.02em;
  /* Remove any color or blend modes from here */
}
</style>

<script>
  import { registerScene } from '../../lib/scene';
  import { buildPhilosophyScene } from '../../lib/scenes/philosophy';
  // Same choreography as before — just sourced from the shared module so about-v3 can reuse it.
  registerScene('bitmap-philosophy', buildPhilosophyScene);
</script>
