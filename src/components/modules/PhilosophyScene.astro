---
/* src/components/modules/PhilosophyScene.astro
 *
 * The 6-stage bitmap philosophy scene: an SVG canvas (its bits are built + animated by
 * buildPhilosophyScene in src/lib/scenes/philosophy.ts) plus six captions, each with a pixel motif
 * that shows on MOBILE only (where the animation becomes a vertical read-through).
 *
 * Place it INSIDE the page's stage wrapper (the page owns .scene positioning):
 *   <div class="scene phil-scene" data-scene="philosophy" style="z-index:20">
 *     <PhilosophyScene captions={PHILOSOPHY_CAPTIONS} />
 *   </div>
 *
 * COPY: pass exactly six `captions`, in stage order (pixel → bits → map → master → stems → result).
 * The page timeline cross-fades them; the motifs below are matched to each stage by index.
 */
interface Props {
  captions: string[];
}
import { PHILOSOPHY_MOTIFS } from '../../lib/bit-motifs';
const { captions } = Astro.props;
if (captions.length !== 6) throw new Error('PhilosophyScene needs exactly 6 captions (one per stage).');

// Mobile-only motif per stage (CSS pixel echo of that stage of the animation) — shared, see lib/bit-motifs.ts.
const MOTIFS = PHILOSOPHY_MOTIFS;
---
<div class="phil-inner" data-phil-inner>
  <svg id="sound-canvas" class="sound-canvas" viewBox="0 0 1200 1000"
       preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <g id="bit-group"><g id="sub-group"></g></g>
  </svg>
  <div class="scene-caps">
    {captions.map((text, i) => (
      <p class="scene-cap"><span class="phil-viz" aria-hidden="true" set:html={MOTIFS[i]} />{text}</p>
    ))}
  </div>
</div>

<style>
    /* Philosophy LAYER — its own markup (svg canvas + captions), styled as in PhilosophyScene.astro.
       phil-inner fills the scene; the builder animates its background (beige ↔ void) + the bits. */
    .phil-inner {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      background-color: hsl(var(--background)); /* fallback; builder drives beige↔void */
    }
    :global(.phil-scene) .sound-canvas { width: clamp(360px, 88vmin, 900px); aspect-ratio: 1.2 / 1; overflow: visible; }
    :global(.phil-scene) .scene-caps {
      position: absolute; left: 50%; bottom: clamp(7rem, 18vh, 12rem); transform: translateX(-50%);
      width: min(96vw, 60rem); min-height: 4.6em; text-align: center;
      color: #ffffff; mix-blend-mode: difference; /* blend OPERAND — keep pure white */
    }
    :global(.phil-scene) .scene-cap {
      position: absolute; inset: 0; margin: 0; font-family: var(--font-mono);
      font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.5; letter-spacing: 0.02em;
    }
    .phil-viz { display: none; }  /* motif shown on mobile only */

  @media (max-width: 767px) {
      /* ── PHILOSOPHY — the animation becomes a vertical read-through: each caption is its own
         full-screen slide with a CSS pixel motif echoing that stage of buildPhilosophyScene
         (pixel -> bits -> map -> master -> stems -> consistency). Canvas hidden on mobile. ── */
      .phil-inner { position: relative !important; inset: auto !important; display: block !important; background-color: transparent; }
      :global(.phil-scene) .sound-canvas { display: none; }
      :global(.phil-scene) .scene-caps {
        position: static; transform: none; width: 100%; min-height: 0; display: block;
        text-align: center; mix-blend-mode: normal; color: hsl(var(--foreground));
      }
      :global(.phil-scene) .scene-cap {
        position: static !important; inset: auto !important; margin: 0; max-width: none;
        display: flex !important; flex-direction: column; align-items: center; justify-content: flex-start;
        gap: clamp(1.25rem, 4vh, 2.25rem);          /* motif -> its caption (same on every slide) */
        padding: 1.5rem var(--page-gutter-x);
        font-size: clamp(1.6rem, 6.4vw, 2.4rem); line-height: 1.35; letter-spacing: 0.01em;
        text-shadow: 0 1px 14px hsla(185,24%,3%,0.9), 0 0 3px hsla(185,24%,3%,0.8);
      }
      /* consistent rhythm: caption text -> NEXT motif is identical everywhere */
      :global(.phil-scene) .scene-cap + .scene-cap { margin-top: clamp(9rem, 32vh, 17rem); }
      /* lead-in so the founders section is fully gone before the first slide */
      :global(.phil-scene) .scene-cap:nth-child(1) { margin-top: 42svh; }
      :global(.phil-scene) .scene-caps { padding-bottom: clamp(9rem, 28vh, 15rem); }
      /* motif SVG above each caption (hidden on desktop, sized per slide) */
      .phil-viz { display: block; line-height: 0; }
      .phil-viz :global(svg) { display: block; height: auto; overflow: visible; }
      .scene-cap:nth-child(1) .phil-viz { width: 80px; }
      .scene-cap:nth-child(2) .phil-viz { width: min(76vw, 300px); }
      .scene-cap:nth-child(3) .phil-viz { width: 88px; }
      .scene-cap:nth-child(4) .phil-viz { width: 108px; }
      .scene-cap:nth-child(5) .phil-viz { width: min(57vw, 221px); }
      .scene-cap:nth-child(6) .phil-viz { width: 116px; }
  }
</style>
