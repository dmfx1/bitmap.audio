        mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.0) calc((50% - var(--bin-solid)) * 0.0), rgb(0 0 0 / 0.0034) calc((50% - var(--bin-solid)) * 0.0417), rgb(0 0 0 / 0.0074) calc((50% - var(--bin-solid)) * 0.0833), rgb(0 0 0 / 0.0121) calc((50% - var(--bin-solid)) * 0.125), rgb(0 0 0 / 0.0177) calc((50% - var(--bin-solid)) * 0.1667), rgb(0 0 0 / 0.0243) calc((50% - var(--bin-solid)) * 0.2083), rgb(0 0 0 / 0.0321) calc((50% - var(--bin-solid)) * 0.25), rgb(0 0 0 / 0.0413) calc((50% - var(--bin-solid)) * 0.2917), rgb(0 0 0 / 0.0521) calc((50% - var(--bin-solid)) * 0.3333), rgb(0 0 0 / 0.065) calc((50% - var(--bin-solid)) * 0.375), rgb(0 0 0 / 0.0801) calc((50% - var(--bin-solid)) * 0.4167), rgb(0 0 0 / 0.098) calc((50% - var(--bin-solid)) * 0.4583), rgb(0 0 0 / 0.1192) calc((50% - var(--bin-solid)) * 0.5), rgb(0 0 0 / 0.1442) calc((50% - var(--bin-solid)) * 0.5417), rgb(0 0 0 / 0.1737) calc((50% - var(--bin-solid)) * 0.5833), rgb(0 0 0 / 0.2086) calc((50% - var(--bin-solid)) * 0.625), rgb(0 0 0 / 0.2499) calc((50% - var(--bin-solid)) * 0.6667), rgb(0 0 0 / 0.2985) calc((50% - var(--bin-solid)) * 0.7083), rgb(0 0 0 / 0.3561) calc((50% - var(--bin-solid)) * 0.75), rgb(0 0 0 / 0.4241) calc((50% - var(--bin-solid)) * 0.7917), rgb(0 0 0 / 0.5043) calc((50% - var(--bin-solid)) * 0.8333), rgb(0 0 0 / 0.5992) calc((50% - var(--bin-solid)) * 0.875), rgb(0 0 0 / 0.7113) calc((50% - var(--bin-solid)) * 0.9167), rgb(0 0 0 / 0.8435) calc((50% - var(--bin-solid)) * 0.9583), rgb(0 0 0 / 1.0) calc((50% - var(--bin-solid)) * 1.0), rgb(0 0 0 / 1.0) calc(100% - (50% - var(--bin-solid)) * 1.0), rgb(0 0 0 / 0.8435) calc(100% - (50% - var(--bin-solid)) * 0.9583), rgb(0 0 0 / 0.7113) calc(100% - (50% - var(--bin-solid)) * 0.9167), rgb(0 0 0 / 0.5992) calc(100% - (50% - var(--bin-solid)) * 0.875), rgb(0 0 0 / 0.5043) calc(100% - (50% - var(--bin-solid)) * 0.8333), rgb(0 0 0 / 0.4241) calc(100% - (50% - var(--bin-solid)) * 0.7917), rgb(0 0 0 / 0.3561) calc(100% - (50% - var(--bin-solid)) * 0.75), rgb(0 0 0 / 0.2985) calc(100% - (50% - var(--bin-solid)) * 0.7083), rgb(0 0 0 / 0.2499) calc(100% - (50% - var(--bin-solid)) * 0.6667), rgb(0 0 0 / 0.2086) calc(100% - (50% - var(--bin-solid)) * 0.625), rgb(0 0 0 / 0.1737) calc(100% - (50% - var(--bin-solid)) * 0.5833), rgb(0 0 0 / 0.1442) calc(100% - (50% - var(--bin-solid)) * 0.5417), rgb(0 0 0 / 0.1192) calc(100% - (50% - var(--bin-solid)) * 0.5), rgb(0 0 0 / 0.098) calc(100% - (50% - var(--bin-solid)) * 0.4583), rgb(0 0 0 / 0.0801) calc(100% - (50% - var(--bin-solid)) * 0.4167), rgb(0 0 0 / 0.065) calc(100% - (50% - var(--bin-solid)) * 0.375), rgb(0 0 0 / 0.0521) calc(100% - (50% - var(--bin-solid)) * 0.3333), rgb(0 0 0 / 0.0413) calc(100% - (50% - var(--bin-solid)) * 0.2917), rgb(0 0 0 / 0.0321) calc(100% - (50% - var(--bin-solid)) * 0.25), rgb(0 0 0 / 0.0243) calc(100% - (50% - var(--bin-solid)) * 0.2083), rgb(0 0 0 / 0.0177) calc(100% - (50% - var(--bin-solid)) * 0.1667), rgb(0 0 0 / 0.0121) calc(100% - (50% - var(--bin-solid)) * 0.125), rgb(0 0 0 / 0.0074) calc(100% - (50% - var(--bin-solid)) * 0.0833), rgb(0 0 0 / 0.0034) calc(100% - (50% - var(--bin-solid)) * 0.0417), rgb(0 0 0 / 0.0) calc(100% - (50% - var(--bin-solid)) * 0.0));
      }
      .field-scene .bin-field { --bin-size: 5.5vw; }   /* phrase still fits one row (~89vw) */
      .field-scene .bin-col { clip-path: none; color: hsl(var(--foreground) / 0.16); }
      .field-scene .bin-col .acc { color: hsl(var(--accent) / 0.55); }
      .field-scene .bin-col .ph.on { color: hsl(var(--foreground)); }
