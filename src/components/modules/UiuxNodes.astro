---
/**
 * UiuxNodes.astro — UI/UX Sound "draw-in" background motif for the Services section. A BINARY RAIN:
 * a dense, pin-sharp canvas grid of 0/1 (with the odd bitmap heart — "data meets emotion") whose
 * column intensity builds a receding skyline, raining in top-to-bottom. Device-pixel crisp, no blur.
 * Faint near-black to match the Sonic (spectrum) and Spatial (tunnel) cards.
 *
 * Centre is masked (feathered ellipse over the real card cluster) on the Services card so the field
 * falls away behind the cards; runs full + faint as a static page background (solutions pages).
 * Toggled by ServicePillars via `.is-revealing`.
 */
interface Props { page?: boolean }
const { page = false } = Astro.props;
---

<div id="uiux-nodes" class={`binary-field ${page ? 'is-static' : 'sonic-void'}`} aria-hidden="true">
  <canvas data-binary></canvas>
</div>

<style>
  #uiux-nodes.binary-field {
    position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
    opacity: 0; transition: opacity 0.55s ease;
  }
  #uiux-nodes.binary-field.is-revealing { opacity: 1; }
  #uiux-nodes.binary-field canvas { width: 100%; height: 100%; display: block; }

  /* Centre void mask — feathered ellipse over the card cluster (measured from the real grid). */
  #uiux-nodes.sonic-void {
    -webkit-mask-image: radial-gradient(ellipse var(--void-rx, 44%) var(--void-ry, 30%)
                        at var(--void-cx, 50%) var(--void-cy, 50%),
                        transparent 0%, transparent 82%, #000 116%);
            mask-image: radial-gradient(ellipse var(--void-rx, 44%) var(--void-ry, 30%)
                        at var(--void-cx, 50%) var(--void-cy, 50%),
                        transparent 0%, transparent 82%, #000 116%);
  }
  /* 'What we do' section: match the scene-body (header + solaris) offset so the field centres with
     the cards instead of being top-covered by the header. */
  #uiux-nodes.sonic-void { top: calc(var(--header-h) + var(--solaris-height, 96px)) !important; }

  /* STATIC page-background variant (solutions pages): shown full, faint, no mask. */
  #uiux-nodes.is-static { opacity: 0.5 !important;
    -webkit-mask-image: none !important; mask-image: none !important;
    top: var(--header-h) !important; }
</style>

<script>
  const root = document.getElementById('uiux-nodes') as HTMLElement | null;
  const canvas = root?.querySelector('canvas[data-binary]') as HTMLCanvasElement | null;
  if (root && canvas) {
    const CELL = 15;                       // css px per cell — smaller = denser
    const DARK = '28,34,34';               // hsl(180 10% 12%)
    const ACC = '255,150,26';              // hsl(35 100% 55%)
    const isStatic = root.classList.contains('is-static');
    const rnd = (s: number) => { const x = Math.sin(s * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };
    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    const colInt = (c: number, cols: number) => {
      const x = c / cols;
      const v = 0.5 + 0.28 * Math.sin(x * 13 + 1.3) + 0.2 * Math.sin(x * 29 + 4.7) + 0.22 * (rnd(c * 9.1) - 0.5);
      return clamp(v, 0.1, 1);
    };

    // Resolve the real mono family (canvas ctx.font can't read CSS var()).
    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;visibility:hidden;font-family:var(--font-mono),monospace';
    document.body.appendChild(probe);
    const FONT = getComputedStyle(probe).fontFamily || 'monospace';
    probe.remove();

    let off: HTMLCanvasElement | null = null, WPX = 0, HPX = 0, CELLpx = 0, cols = 0, reveal = isStatic ? 1 : 0;

    const build = () => {
      const r = root.getBoundingClientRect();
      if (!r.width || !r.height) return false;
      const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
      WPX = Math.ceil(r.width * dpr); HPX = Math.ceil(r.height * dpr);
      canvas.width = WPX; canvas.height = HPX;
      CELLpx = Math.max(6, Math.round(CELL * dpr));
      cols = Math.ceil(WPX / CELLpx);
      const rows = Math.ceil(HPX / CELLpx);
      off = document.createElement('canvas'); off.width = WPX; off.height = HPX;
      const o = off.getContext('2d')!;
      o.textBaseline = 'top';
      o.font = Math.round(CELL * 0.92 * dpr) + 'px ' + FONT;
      for (let c = 0; c < cols; c++) {
        const ci = colInt(c, cols);
        for (let rr = 0; rr < rows; rr++) {
          const s = c * 131.1 + rr * 17.7;
          const vfade = 0.45 + 0.55 * (rr / rows);
          let a = 0.10 + ci * vfade * 0.30 * (0.55 + 0.45 * rnd(s + 5));
          if (a > 0.34) a = 0.34;
          const heart = rnd(s + 300) < 0.015;
          const acc = heart ? rnd(s + 7) > 0.45 : rnd(s + 400) < 0.018;
          o.fillStyle = acc ? `rgba(${ACC},${(a * 1.25).toFixed(3)})` : `rgba(${DARK},${a.toFixed(3)})`;
          const ch = heart ? '♥' : (rnd(s + 200) > 0.5 ? '1' : '0');
          o.fillText(ch, c * CELLpx + CELLpx * 0.12, rr * CELLpx + CELLpx * 0.04);
        }
      }
      return true;
    };

    const render = (rv: number) => {
      const ctx = canvas.getContext('2d')!;
      ctx.clearRect(0, 0, WPX, HPX);
      if (!off) return;
      if (rv >= 1) { ctx.drawImage(off, 0, 0); return; }
      for (let c = 0; c < cols; c++) {
        const ph = rnd(c * 2.7) * 0.45;              // per-column rain stagger
        const lr = clamp((rv - ph) / 0.55, 0, 1);
        if (lr <= 0) continue;
        const h = Math.round(lr * HPX);
        ctx.drawImage(off, c * CELLpx, 0, CELLpx, h, c * CELLpx, 0, CELLpx, h);
      }
    };

    let raf = 0;
    const animate = () => {
      cancelAnimationFrame(raf);
      const t0 = performance.now(), dur = 1150;
      const step = (now: number) => {
        let p = (now - t0) / dur; if (p > 1) p = 1;
        reveal = 1 - Math.pow(1 - p, 3);
        render(reveal);
        if (p < 1) raf = requestAnimationFrame(step); else reveal = 1;
      };
      raf = requestAnimationFrame(step);
    };

    const start = () => {
      if (!build()) return false;
      if (isStatic) { render(1); }
      else if (root.classList.contains('is-revealing')) animate();
      else render(1);                                // present but hidden (opacity 0) until revealed
      return true;
    };
    if (!start()) { let n = 0; const iv = setInterval(() => { if (start() || ++n > 40) clearInterval(iv); }, 150); }

    // Re-rain each time the section becomes active.
    if (!isStatic) {
      let was = root.classList.contains('is-revealing');
      new MutationObserver(() => {
        const now = root.classList.contains('is-revealing');
        if (now && !was) animate();
        was = now;
      }).observe(root, { attributes: true, attributeFilter: ['class'] });
    }

    // Crisp rebuild once the mono font is ready, and on resize.
    (document as any).fonts?.ready?.then(() => { if (build()) render(reveal >= 1 || isStatic ? 1 : reveal); });
    let rt = 0;
    new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(() => { if (build()) render(isStatic ? 1 : 1); }, 120); }).observe(root);
  }

  // Centre void-mask measurement (Services card only).
  const setupMask = () => {
    const grid = document.querySelector('[data-pillars-grid]') as HTMLElement | null;
    const field = document.getElementById('uiux-nodes');
    const scene = field?.closest('[data-scene]') as HTMLElement | null;
    if (!grid || !field || !scene || !field.classList.contains('sonic-void')) return !!field;
    const measure = () => {
      const g = grid.getBoundingClientRect();
      const s = field.getBoundingClientRect();
      if (!s.width || !s.height) return;
      const pad = 3;
      field.style.setProperty('--void-cx', (((g.left + g.width / 2) - s.left) / s.width * 100).toFixed(2) + '%');
      field.style.setProperty('--void-cy', (((g.top + g.height / 2) - s.top) / s.height * 100).toFixed(2) + '%');
      field.style.setProperty('--void-rx', ((g.width / 2) / s.width * 100 + pad).toFixed(2) + '%');
      field.style.setProperty('--void-ry', ((g.height / 2) / s.height * 100 + pad).toFixed(2) + '%');
    };
    measure();
    const ro = new ResizeObserver(measure); ro.observe(grid); ro.observe(scene);
    window.addEventListener('resize', measure, { passive: true });
    [120, 400, 1000].forEach((t) => setTimeout(measure, t));
    return true;
  };
  if (!setupMask()) { let n = 0; const iv = setInterval(() => { if (setupMask() || ++n > 40) clearInterval(iv); }, 150); }
</script>
