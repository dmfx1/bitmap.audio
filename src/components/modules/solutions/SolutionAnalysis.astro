---
/* src/components/modules/solutions/SolutionAnalysis.astro
 *
 * Shared "The Challenge / Our Approach" two-column block for the three solutions pages. Replaces
 * SonicAnalysis / UIUXAnalysis / ImmersiveAnalysis (identical markup, different copy).
 *
 * Rendered as static Astro (zero JS). The old versions were React islands hydrated with
 * client:visible, but they have no state or handlers — the boxes' fly-in is driven by the global
 * [data-fly] IntersectionObserver in Layout.astro, which works on static markup too.
 *
 * FUTURE — AUDIO INTERACTIVITY: the site will eventually have audio interactivity (it's the
 * business). If this block gets sound (e.g. hover/scroll-triggered audio, a scramble on the
 * headings), convert it to SolutionAnalysis.tsx and load it with client:visible on the three
 * solutions pages. The props (challenge/approach) can stay exactly the same.
 */
interface Column {
  heading: string;
  paragraphs: string[];
}
interface Props {
  challenge: Column;
  approach: Column;
}
const { challenge, approach } = Astro.props;
const columns = [
  { fly: 'left', eyebrow: 'The Challenge', ...challenge },
  { fly: 'right', eyebrow: 'Our Approach', ...approach },
];
---
<div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-48 md:px-48">
  {columns.map((col) => (
    <div data-fly={col.fly} class="space-y-8 bg-background/50 p-2 md:p-6">
      <div class="space-y-2">
        <p class="text-base font-mono text-accent tracking-[0.4em] uppercase">{col.eyebrow}</p>
        <h2 class="text-3xl font-mono text-foreground leading-tight">{col.heading}</h2>
      </div>
      <div class="space-y-6 text-body-muted text-base font-mono leading-relaxed">
        {col.paragraphs.map((para) => <p class="text-xl">{para}</p>)}
      </div>
    </div>
  ))}
</div>
