---
/* src/components/modules/HowWeWork.astro
 *
 * "How we work together" — four tall, narrow step cards with oversized bitmap chevrons between them,
 * then a quiet footer (aside, price/timing, custom note, detail link). Laid out with the hero's
 * spacing; sizes come from the SHARED TYPE SCALE in global.css (--type-lead / --type-title / --type-body).
 *
 * Desktop: lib/scenes/how-we-work.ts makes it a scroll-built sequence — per card: its pixel icon (shared
 * philosophy motifs) pixels in, the text scrambles in from binary, the border turns TEAL, then the chevron
 * after it fills teal. Per card, ALL AT ONCE over one scroll stretch: the icon pixels in, the text
 * scrambles in, and the teal "level meter" rises (deepening card by card, METER_A) — on the deep cards each
 * element flips light as the teal passes it. Finished cards get a solaris border. Then the footer arrives.
 * Mobile: stacked, chevrons point DOWN, everything static + resolved (meters already filled).
 *
 * Place INSIDE the page's stage wrapper + scene body:
 *   <div class="scene theme-oat how-scene" data-scene="how"><div class="scene-body"><HowWeWork … /></div></div>
 * COPY comes in as props (HOW_* at the top of home.astro).
 */
import BitChevron from './BitChevron.astro';
import { inkedMotif, type MotifName } from '../../lib/bit-motifs';

interface Step { n: string; name: string; line: string; /** pixel icon — a philosophy motif */ icon?: MotifName }
interface Props {
  heading: string;
  steps: readonly Step[];
  /** One honest line under the steps. */
  aside?: string;
  price: string;
  custom?: string;
  linkLead?: string;
  linkLabel?: string;
  href?: string;
}
const { heading, steps, aside, price, custom, linkLead, linkLabel, href = '/contact' } = Astro.props;
// Teal "level meter" strength per card — deepens to full teal on the last. The last two (.how__card--deep)
// flip to light text: from 0.8 the teal is dark enough for it to stay readable.
const METER_A = [0.15, 0.35, 0.8, 1];
---
<div class="how">
  <div class="container-page how__top">{/* desktop: hidden — the "Our Process" bar labels it */}
    <h2 class="type-lead how__heading">{heading}</h2>
  </div>

  <div class="container-page how__row-wrap">
    <ol class="how__row">
      {steps.map((s, i) => (
        <Fragment>
          <li class:list={['how__card', i >= steps.length - 2 && 'how__card--deep']} data-how-card
              style={`--meter-a: ${METER_A[i] ?? 1}`}>
            <span class="how__meter" data-how-meter aria-hidden="true"></span>
            <span class="sr-only">{s.n} {s.name}: {s.line}</span>
            {s.icon && <span class="how__icon-wrap" aria-hidden="true" data-lit><span class:list={['how__icon', `how__icon--${s.icon}`]} data-how-icon set:html={inkedMotif(s.icon)} /></span>}
            <span class="how__n" aria-hidden="true" data-lit>{s.n}</span>
            <h3 class="type-title how__name" aria-hidden="true" data-scramble data-lit>{s.name}</h3>
            <p class="type-body how__line" aria-hidden="true" data-scramble data-lit>{s.line}</p>
          </li>
          {i < steps.length - 1 && <li class="how__chev" aria-hidden="true" data-how-chev><BitChevron /></li>}
        </Fragment>
      ))}
    </ol>
  </div>

  <div class="container-page how__foot" data-how-foot>
    {aside && <p class="type-body how__aside">{aside}</p>}
    <p class="type-body how__price">{price}</p>
    {custom && <p class="type-body how__custom">{custom}</p>}
    {linkLabel && <p class="type-body how__more">{linkLead} <a class="how__link" href={href}>{linkLabel}</a></p>}
  </div>
</div>

<style>
  /* Three rows like the hero: heading / cards / footer, inside the scene body (two on desktop — see below). */
  .how {
    height: 100%; display: grid; grid-template-rows: auto 1fr auto; gap: clamp(1.5rem, 4vh, 3rem);
    padding-block: var(--page-gutter); box-sizing: border-box;
    font-family: var(--font-mono); color: hsl(var(--foreground));
  }
  .how__heading { margin: 0; font-weight: 400; }
  /* desktop: heading hidden (the bar labels it) → two rows, cards take all the spare height */
  @media (min-width: 768px) {
    .how__top { display: none; }
    .how { grid-template-rows: 1fr auto; }
  }

  .how__row-wrap { min-height: 0; display: flex; align-items: center; }   /* cards centred vertically */
  .how__row {
    list-style: none; margin: 0; padding: 0; width: 100%;
    height: 66.667%;                      /* cards at 2/3 of the available height */
    display: flex; align-items: stretch; gap: clamp(0.75rem, 1.6vw, 1.75rem);
  }
  .how__card {
    flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; justify-content: flex-start;
    position: relative; isolation: isolate;
    border: 8px solid hsl(var(--border)); background: hsl(var(--card));
    padding: clamp(1.25rem, 2vw, 2rem);
    transition: border-color .3s ease;
    --icon-ink: hsl(var(--foreground)); --icon-hi: hsl(var(--primary)); --icon-ground: hsl(var(--card)); /* pixel icon inks */
  }
  .how__card.is-on { border-color: hsl(var(--accent)); }            /* finished → solaris frame around the teal */
  /* pixel icon — pinned to the card's exact vertical CENTRE so it lines up with the chevrons; the number +
     name sit at the top, the line at the bottom. Revealed top→down on desktop by the timeline. */
  .how__icon-wrap {
    position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%);
    display: flex; align-items: center; justify-content: center;
    padding-inline: clamp(1.25rem, 2vw, 2rem); pointer-events: none;
  }
  .how__icon { display: block; width: clamp(3.75rem, 5vw, 5.5rem); clip-path: inset(0 0 100% 0); }
  .how__icon--bits { width: 100%; }                 /* a wide row — give it the card's full width */
  .how__icon :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  /* teal "level meter" — every card fills from the bottom in pixel steps, deepening card by card */
  .how__meter { position: absolute; inset: 0; z-index: -1; background: hsl(var(--primary) / var(--meter-a, 1)); clip-path: inset(100% 0 0 0); }
  /* deep cards: each element flips light the moment the rising teal reaches it (.is-lit, set per element
     by the timeline). Result icon: light block, teal holes. */
  .how__card--deep .is-lit { color: hsl(var(--primary-foreground)); --icon-ink: hsl(var(--primary-foreground)); --icon-hi: hsl(var(--primary-foreground)); --icon-ground: hsl(var(--primary)); }
  .how__chev { display: flex; align-items: center; justify-content: center; --chev-fill: hsl(var(--primary)); }
  .how__n { font-size: var(--type-body); color: hsl(var(--primary)); letter-spacing: 0.15em; margin: 0 0 0.5rem; }
  .how__name { margin: 0 0 0.75rem; font-weight: 500; overflow-wrap: anywhere; }
  .how__line { margin: auto 0 0; font-weight: 300; color: hsl(var(--muted-foreground)); }   /* pushed to the bottom */
  /* while scrambling (desktop) the binary reads faint; resolved text is full strength */
  [data-scramble].is-binary { opacity: 0.35; }

  .how__foot p { margin: 0; }
  .how__aside { color: hsl(var(--foreground)); margin-bottom: 0.75rem !important; }
  .how__price, .how__custom, .how__more { color: hsl(var(--muted-foreground)); }
  .how__link { pointer-events: auto; color: hsl(var(--foreground)); text-decoration: underline; text-underline-offset: 0.25em; transition: color .2s ease; }
  .how__link:hover { color: hsl(var(--accent)); }

  @media (max-width: 767px) {
    .how { height: auto; display: flex; flex-direction: column; gap: 2rem; padding-block: 2rem; }
    .how__row { flex-direction: column; align-items: stretch; gap: 0; height: auto; }
    .how__card { min-height: 0; }
    /* mobile: back in normal flow — number + name, icon, line */
    .how__icon-wrap { position: static; transform: none; padding: 1rem 0; order: 2; }
    .how__n { order: 0; } .how__name { order: 1; } .how__line { order: 3; margin-top: 0; }
    /* static on mobile: icons shown, final card already filled (the climax without the scroll) */
    .how__icon { clip-path: none; }
    .how__icon--bits { width: 80%; }
    .how__meter { clip-path: none; }
    .how__card { border-color: hsl(var(--accent)); }   /* finished state */
    .how__card--deep [data-lit] { color: hsl(var(--primary-foreground)); --icon-ink: hsl(var(--primary-foreground)); --icon-hi: hsl(var(--primary-foreground)); --icon-ground: hsl(var(--primary)); }
    .how__chev { padding-block: 0.75rem; }
  }
</style>
