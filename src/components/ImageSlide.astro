---
/**
 * ImageSlide.astro
 */
import fs from 'node:fs';
import path from 'node:path';

const FADES: Record<string, string> = {
  flow:        'linear-gradient(to right, transparent 0%, black 22%, black 78%, transparent 100%)',
  'flow-long': 'linear-gradient(to right, transparent 0%, black 38%, black 62%, transparent 100%)',
  'flow-xlong':'linear-gradient(to right, transparent 0%, black 46%, black 54%, transparent 100%)',
  'in-left':   'linear-gradient(to right, transparent 0%, black 45%)',
  'in-right':  'linear-gradient(to left, transparent 0%, black 45%)',
  radial:      'radial-gradient(ellipse at center, black 30%, transparent 78%)',
};

// Resolve a fade spec to a CSS mask gradient. Accepts either a preset name (sugar) or
// an explicit { left, right } pair as fractions (0–0.5) of the slide width to fade in
// from each edge. e.g. { left: 0.22, right: 0.22 } === the 'flow' preset.
function fadeToMask(f: string | { left: number; right: number } | undefined): string {
  if (f && typeof f === 'object') {
    const p = (n: number) => +n.toFixed(1);
    const L = (f.left ?? 0) * 100;          // left fade zone: 0% → L%
    const R = 100 - (f.right ?? 0) * 100;   // right fade zone: R% → 100%
    // Guard: if left + right > 1 the fade zones overlap. Instead of out-of-order gradient
    // stops (which render as a hard seam), make a single smooth peak at the crossover.
    if (L >= R) {
      const m = (L + R) / 2;
      return `linear-gradient(to right, transparent 0%, rgba(0,0,0,0.15) ${p(m * 0.5)}%, rgba(0,0,0,0.85) ${p(m)}%, rgba(0,0,0,0.15) ${p(m + (100 - m) * 0.5)}%, transparent 100%)`;
    }
    // Eased "buttery" falloff — holds fairly opaque, then tails off gently (kept high enough
    // that long fades don't wash the image out too much).
    const left = L > 0
      ? `transparent 0%, rgba(0,0,0,0.3) ${p(L * 0.35)}%, rgba(0,0,0,0.75) ${p(L * 0.7)}%, black ${p(L)}%`
      : `black 0%`;
    const right = R < 100
      ? `black ${p(R)}%, rgba(0,0,0,0.75) ${p(R + (100 - R) * 0.35)}%, rgba(0,0,0,0.3) ${p(R + (100 - R) * 0.7)}%, transparent 100%`
      : `black 100%`;
    return `linear-gradient(to right, ${left}, ${right})`;
  }
  return (typeof f === 'string' && FADES[f]) || FADES.flow;
}

interface Props {
  id?: string;
  src?: string;
  gradient?: string;
  effect?: 'fade' | 'focus';
  width?: string;
  imgWidth?: string;
  imgX?: string;
  objectPos?: string;
  z?: number;
  opacity?: number;
  blend?: boolean;
  fade?: keyof typeof FADES | { left: number; right: number };
  bare?: boolean;
  label?: string;
  alt?: string;
  customMask?: string; // Taps into the new explicit config
  ramp?: { start: number; end: number }; // Taps into the GSAP timings
}

const {
  id,
  src,
  gradient,
  effect = 'fade',
  width = '50vw',
  imgWidth = '100%',
  imgX = '0px',
  objectPos = 'center',
  z = 10,
  opacity = 90,
  blend = true,
  fade = 'flow',
  bare = false,
  label = 'Image',
  alt = '',
  customMask,
  ramp,
} = Astro.props;

const exists = src ? fs.existsSync(path.join(process.cwd(), 'public', src)) : false;

// Use customMask if provided in returns2.astro, otherwise resolve the fade (preset or {left,right})
const maskImage = customMask || fadeToMask(fade);
const maskStyle = `-webkit-mask-image:${maskImage};mask-image:${maskImage};`;
const effectClass = effect === 'focus' ? 'img-slide-focus' : 'img-slide-fade';
const layerStyle = `left:50%;width:${imgWidth};transform:translateX(-50%) translateX(${imgX});`;
---

<section
  class:list={["hidden md:flex h-full flex-shrink-0 md:items-center relative overflow-visible", bare ? "bg-transparent" : "bg-background"]}
  data-slide={id}
  style={`width:${width};z-index:${z};content-visibility:visible;`}
  data-ramp-start={ramp?.start}
  data-ramp-end={ramp?.end}
  data-img-x={imgX}
>
  {gradient ? (
    <div class:list={["absolute inset-0 bg-gradient-to-r", gradient]} style={maskStyle}></div>
  ) : src && exists ? (
    <div class:list={[effectClass, "absolute inset-y-0 z-0 opacity-0"]} style={layerStyle}>
      <div class:list={["absolute inset-0", blend && "mix-blend-screen"]} style={`opacity:${opacity / 100};${maskStyle}`}>
        <img src={src} decoding="async" alt={alt} class="w-full h-full object-cover" style={`object-position:${objectPos};`} />
      </div>
    </div>
  ) : (
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-card/30 backdrop-blur-sm p-6 text-center">
      <span class="font-mono text-[10px] tracking-[0.4em] uppercase text-accent/70">Image placeholder</span>
      <span class="font-mono text-sm text-muted-foreground">{label}</span>
      {src && <span class="font-mono text-sm text-muted-foreground/50 break-all">{src}</span>}
    </div>
  )}
</section>