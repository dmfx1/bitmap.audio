---
/* src/components/Footer.astro */
import { getImage } from 'astro:assets';
import footerHero from '../assets/images/hero-footer-04.png';
import {
  BitmapMail,
  BitmapInstagram,
  BitmapLinkedin,
  BitmapThreads,
  BitmapChevron
} from "./ui/icons";

const footerImage = await getImage({
  src: footerHero,
  format: 'webp',
  width: 1200,
  quality: 80,
});

const footerFAQs = [
  { q: "How do we start?", href: "/faq#process" },
  { q: "What is 'Sonic UI'?", href: "/faq#definitions" },
  { q: "Licensing terms?", href: "/faq#legal" }
];
---
<footer class="border-t border-border bg-background relative z-10 overflow-hidden">

  <!-- Background hero image — right-aligned, fades left, low opacity so text stays readable -->
  <div
    class="absolute inset-y-0 right-0 w-full md:w-full pointer-events-none z-0"
    style="-webkit-mask-image: linear-gradient(to right, transparent 0%, black 35%); mask-image: linear-gradient(to right, transparent 0%, black 35%);"
  >
    <img
      src={footerImage.src}
      alt=""
      decoding="async"
      loading="lazy"
      class="w-full h-full object-cover object-center opacity-60"
    />
    <!-- Bottom fade into copyright bar -->
    <div class="absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-background to-transparent"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-12 py-24 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-8 bg-background/50 p-4">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2 group mb-4">
          <div class="w-8 h-8 bg-primary flex items-center justify-center">
            <span class="text-primary-foreground font-mono text-xs font-bold">b.</span>
          </div>
          <span class="font-mono text-lg font-light text-foreground group-hover:text-primary transition-colors">
            bitmap<span class="text-accent font-bold">.audio</span>
          </span>
        </a>
        <p class="text-sm text-foreground max-w-xs font-mono">
          Architecting the sonic infrastructure that maps digital data to human emotion.
        </p>
      </div>

      <div class="">
        <h4 class="font-mono text-sm uppercase tracking-wider text-foreground mb-4">FAQ</h4>
        <ul class="space-y-2">
          {footerFAQs.map(faq => (
            <li>
              <a href={faq.href} class="text-sm text-foreground/80 hover:text-accent transition-colors font-mono">
                {faq.q}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a href="/faq" class="text-[10px] uppercase tracking-widest text-primary flex items-center gap-1 group font-bold">
              View All <BitmapChevron client:load className="w-2 h-2 group-hover:translate-x-1 transition-transform" />
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-mono text-sm uppercase tracking-wider text-foreground mb-4">Solutions</h4>
        <ul class="space-y-2">
          <li><a href="/solutions/sonic-branding" class="font-mono text-sm text-foreground/80 hover:text-accent transition-colors">Sonic Branding</a></li>
          <li><a href="/solutions/uiux-sound" class="font-mono text-sm text-foreground/80 hover:text-accent transition-colors">UI/UX Sound</a></li>
          <li><a href="/solutions/immersive-audio" class="font-mono text-sm text-foreground/80 hover:text-accent transition-colors">Immersive Audio</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-mono text-sm uppercase tracking-wider text-foreground mb-4">Connect</h4>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:hello@bitmap.audio" 
             class="w-10 h-10 border border-border flex items-center justify-center hover:border-accent hover:bg-primary/5 text-foreground hover:text-accent transition-all group">
            <BitmapMail client:load className="w-4 h-4" />
          </a>
          <a href="https://instagram.com/bitmap.audio" target="_blank" 
             class="w-10 h-10 border border-border flex items-center justify-center hover:border-accent hover:bg-primary/5 text-foreground hover:text-accent transition-all group">
            <BitmapInstagram client:load className="w-4 h-4" />
          </a>
          <a href="https://threads.net/@bitmap.audio" target="_blank" 
             class="w-10 h-10 border border-border flex items-center justify-center hover:border-accent hover:bg-primary/5 text-foreground hover:text-accent transition-all group">
            <BitmapThreads client:load className="w-4 h-4" />
          </a>
          <a href="https://linkedin.com/company/bitmapaudio" target="_blank" 
             class="w-10 h-10 border border-border flex items-center justify-center hover:border-accent hover:bg-primary/5 text-foreground hover:text-accent transition-all group">
            <BitmapLinkedin client:load className="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- Full-width border + copyright bar, content re-constrained inside -->
  <div class="border-t border-border relative z-10">
    <div class="max-w-7xl mx-auto px-4 md:px-8 lg:px-12 py-8 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
      <p class="text-xs text-muted-foreground font-mono uppercase tracking-widest">
        © 2026 bitmap.audio — All rights reserved.
      </p>
      <p class="text-xs text-muted-foreground font-mono uppercase tracking-widest opacity-60">
        Micro engineers linking sonic data and human emotion.
      </p>
    </div>
  </div>
</footer>